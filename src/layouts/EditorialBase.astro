---
/**
 * Base.astro — 範例站共用的最小 layout：只放 reset、focus、skip link、reduced-motion。
 * 不含任何視覺決策（字體、色彩、版型都由頁面與 tokens 決定），避免所有頁面看起來是同一個模板。
 * theme: 傳入的 CSS 變數覆寫字串，例如 "--ed-paper:#fff;--ed-ink:#111"（見 reading-almanac 與 trust-path）。
 */
import '../styles/editorial-tokens.css';
interface Props { title: string; description: string; theme?: string; themeColor?: string }
const { title, description, theme = '', themeColor = '#f5f1e8' } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
  </head>
  <body style={theme}>
    <a class="skip" href="#main">跳到主要內容</a>
    <slot />
  </body>
</html>
<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body { margin: 0; min-width: 320px; font-family: var(--ed-sans, system-ui, sans-serif); line-height: 1.6; background: var(--ed-paper, #f5f1e8); color: var(--ed-ink, #222018); }
  img, svg { display: block; max-width: 100%; }
  a { color: inherit; }
  button, input, textarea { font: inherit; }
  :focus-visible { outline: 3px solid var(--ed-accent, #9a3b24); outline-offset: 4px; }
  .skip { position: fixed; z-index: 100; top: 8px; left: 8px; padding: .65rem 1rem; background: #fff; color: #111; transform: translateY(-160%); }
  .skip:focus { transform: translateY(0); }
  .editorial-recipe-header { width:min(calc(100% - 40px),1280px); margin:0 auto 45px; padding:28px 0 36px; border-bottom:2px solid var(--ed-ink); color:var(--ed-ink); }
  .editorial-recipe-header > a { display:inline-block; font:500 13px var(--ed-mono); color:var(--ed-accent); text-decoration:none; border-bottom:1px solid currentColor; padding-bottom:6px; margin-bottom:27px; }
  .editorial-recipe-header > div > p:first-child { font:700 11px var(--ed-mono); letter-spacing:.14em; color:var(--ed-accent); }
  .editorial-recipe-header h1 { font:500 clamp(34px,6vw,70px)/1.12 var(--ed-serif); letter-spacing:-.04em; margin:12px 0 18px; }
  .editorial-recipe-header > div > p:last-child { max-width:650px; line-height:1.85; color:var(--ed-ink-2); }
  @media(max-width:600px){.editorial-recipe-header{padding-block:22px;margin-bottom:30px}}
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
  }
</style>