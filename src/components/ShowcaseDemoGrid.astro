---
import { themeMeta, themes, type Kind } from '../data';
import { helperPractice } from '../data/helper-content';
interface Props { kind: Kind; }
const { kind } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="showcase-demo-grid" aria-label={kind === 'knowledge' ? '知識與部落格的四種風格' : '助人與專業服務的四種風格'}>
  {themes.map((theme) => <a class={`demo-card theme-${theme}`} href={`${base}${kind}/${theme}/`}>
    <div class="demo-swatch"><span></span><span></span><span></span></div>
    <small>{themeMeta[theme].label}</small>
    <h3>{themeMeta[theme].zh}{kind === 'helper' ? ' · ' + helperPractice[theme].specialty : ''}</h3>
    <p>{kind === 'helper' ? helperPractice[theme].intro : themeMeta[theme].mood}</p>
    <b>開啟 Demo →</b>
  </a>)}
</div>
<style>
  .showcase-demo-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .showcase-demo-grid .demo-card{min-width:0;display:flex;flex-direction:column;padding:20px}
  .showcase-demo-grid .demo-card h3{font-size:clamp(21px,2vw,27px);line-height:1.35;overflow-wrap:anywhere}
  .showcase-demo-grid .demo-card p{font-size:15px;line-height:1.7;min-height:0}
  .showcase-demo-grid .demo-card b{margin-top:auto;padding-top:14px}
  .showcase-demo-grid .demo-swatch{height:120px;margin-bottom:18px}
  @media(max-width:1000px){.showcase-demo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){
    .showcase-demo-grid{display:flex;overflow-x:auto;gap:12px;padding:3px 2px 18px;scroll-snap-type:x mandatory;scroll-padding-inline:2px;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
    .showcase-demo-grid .demo-card{flex:0 0 min(82vw,320px);scroll-snap-align:start}
  }
</style>
