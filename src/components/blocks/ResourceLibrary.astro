---
import ResourceCard from './ResourceCard.astro';
interface Resource {title:string;description?:string;href?:string;kind?:'video'|'audio'|'book'|'pdf'|'tool'|'link';meta?:string}
interface Props {items:Resource[];title?:string}
const {items,title='資源整理'}=Astro.props;
---
<section class="practical-resource-library" aria-label={title}><h2>{title}</h2><div class="practical-resource-grid">{items.map(item=><ResourceCard {...item}/>)}</div></section>