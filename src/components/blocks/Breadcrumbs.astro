---
interface Crumb {label:string;href?:string}
interface Props {items:Crumb[]}
const {items}=Astro.props;
---
<nav class="practical-breadcrumbs" aria-label="麵包屑導覽"><ol>{items.map((item,i)=><li>{item.href&&i<items.length-1?<a href={item.href}>{item.label}</a>:<span aria-current="page">{item.label}</span>}</li>)}</ol></nav>