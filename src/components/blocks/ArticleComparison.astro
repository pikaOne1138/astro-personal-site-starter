---
interface Props {headers:string[];rows:string[][];caption?:string;}
const {headers,rows,caption='比較表'}=Astro.props;
---
<div class="v2-table-wrap"><table class="v2-table"><caption>{caption}</caption><thead><tr>{headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{rows.map(row=><tr>{row.map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></div>
