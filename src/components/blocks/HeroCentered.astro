---
import Button from './Button.astro';
interface Props {eyebrow?:string;title:string;description:string;action?:string;href?:string;}
const {eyebrow='A PLACE TO BEGIN',title,description,action='探索內容',href='#more'}=Astro.props;
---
<section class="ab-hero ab-hero-centered"><p class="ab-eyebrow">{eyebrow}</p><h1>{title}</h1><p>{description}</p><Button href={href}>{action} →</Button></section>
