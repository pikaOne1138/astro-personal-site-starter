---
interface Props {items:{title:string;description:string;href?:string}[];columns?:2|3;}
import {safeHref} from './safe-href';
const {items,columns=3}=Astro.props;
const cards=items.map(x=>({...x,link:safeHref(x.href)}));
---
<div class:list={['ab-grid',`ab-cols-${columns}`]}>{cards.map((x,i)=>x.link?<a class="ab-feature ab-feature-link" href={x.link}><span class="ab-number">0{i+1}</span><h3>{x.title}</h3><p>{x.description}</p></a>:<article class="ab-feature"><span class="ab-number">0{i+1}</span><h3>{x.title}</h3><p>{x.description}</p></article>)}</div>
<style>
a.ab-feature-link{display:block;text-decoration:none;color:inherit}
a.ab-feature-link:focus-visible{outline:3px solid var(--accent,#9a3b2e);outline-offset:4px}
</style>
