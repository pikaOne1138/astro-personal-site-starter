---
import { pageMap, detailPages } from '../../site-map';
import { kindMeta, type Kind, type Theme } from '../../data';
import { articlesV2 } from '../../data/articles-v2';
interface Props {kind:Kind;theme:Theme;}
const {kind,theme}=Astro.props;
const base=import.meta.env.BASE_URL;
const root=base+kind+'/'+theme+'/';
const pageSummaries:Record<string,string>={
articles:'全部文章、日期與分類索引',topics:'文章主題與分類', 'start-here':'新讀者的起點',
about:'個人故事、背景與理念', resources:'免費資源與工具',
services:'服務項目與合作方式','first-visit':'首次諮詢的流程',faq:'常見問題與解答',booking:'預約與聯絡方式'
};
const index=[
{title:'首頁',description:kindMeta[kind].intro,section:'頁面',href:root,terms:'首頁 home'},
...pageMap[kind].map(p=>({title:p.label,description:pageSummaries[p.id]||'',section:'頁面',href:root+p.id+'/',terms:p.id})),
{title:'文章搜尋與日期日曆',description:'文章標籤、月份封存、日期、搜尋',section:'頁面',href:root+'explore/',terms:'search calendar 標籤 日曆 找文章'},
...articlesV2.map(a=>({title:a.title,description:a.excerpt,section:'文章',href:root+'articles/'+a.slug+'/',terms:[a.category,...a.tags,a.publishedAt].join(' ')})),
...(kind==='helper'?detailPages.services.map(s=>({title:s.title,description:'服務詳情與合作流程',section:'服務',href:root+'services/'+s.slug+'/',terms:'服務 預約 支持 諮詢'})):[])
];
const searchIndex=JSON.stringify(index);
---
<button type="button" class="v2-site-search-trigger" data-search-open aria-label="開啟全站搜尋" aria-haspopup="dialog" aria-controls="v2-site-search-dialog" title="全站搜尋（Ctrl+K / ⌘K）">
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.75" cy="10.75" r="6.75"/><path stroke-linecap="round" d="m16 16 5 5"/></svg>
</button>
<dialog class="v2-site-search-dialog" id="v2-site-search-dialog" aria-labelledby="v2-site-search-title" data-site-search data-index={searchIndex}>
  <div class="v2-search-panel">
    <div class="v2-search-panel-heading">
      <div><p class="v2-search-eyebrow">SEARCH</p><h2 id="v2-site-search-title">全站搜尋</h2></div>
      <button class="v2-search-close" type="button" data-search-close aria-label="關閉搜尋">關閉 <kbd>Esc</kbd></button>
    </div>
    <label class="v2-search-field">
      <span class="sr-only">搜尋頁面、文章與服務</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.75" cy="10.75" r="6.75"/><path stroke-linecap="round" d="m16 16 5 5"/></svg>
      <input data-site-query type="search" autocomplete="off" placeholder="搜尋頁面、文章或服務…" />
    </label>
    <p class="v2-search-help" data-search-status role="status" aria-live="polite">輸入關鍵字來尋找網站內容</p>
    <ul class="v2-search-matches" data-search-results aria-label="搜尋結果"></ul>
    <p class="v2-search-disclaimer">搜尋頁面標題、摘要、分類與關鍵詞；完整文章內文索引尚未開放。</p>
  </div>
</dialog>
<script>
  const dialog=document.querySelector<HTMLDialogElement>('[data-site-search]');
  const field=dialog?.querySelector<HTMLInputElement>('[data-site-query]');
  const resultList=dialog?.querySelector<HTMLUListElement>('[data-search-results]');
  const status=dialog?.querySelector<HTMLElement>('[data-search-status]');
  type Item={title:string;description:string;section:string;href:string;terms:string};
  if(dialog&&field&&resultList&&status){
    const items=JSON.parse(dialog.dataset.index||'[]') as Item[];
    const previous=document.activeElement;
    const render=()=>{
      const query=field.value.trim().toLocaleLowerCase();
      resultList.replaceChildren();
      if(!query){status.textContent='輸入關鍵字來尋找網站內容';return;}
      const matches=items.filter(item=>[item.title,item.description,item.section,item.terms].join(' ').toLocaleLowerCase().includes(query)).slice(0,20);
      status.textContent=matches.length?'找到 '+matches.length+' 筆相符結果（最多顯示 20 筆）':'沒有符合的結果，試試其他關鍵字。';
      for(const item of matches){
        const li=document.createElement('li');
        const a=document.createElement('a');
        a.href=item.href;
        const label=document.createElement('small');
        label.textContent=item.section;
        const title=document.createElement('strong');
        title.textContent=item.title;
        const desc=document.createElement('span');
        desc.textContent=item.description;
        a.append(label,title,desc);
        li.append(a);
        resultList.append(li);
      }
    };
    const open=()=>{if(!dialog.open){dialog.showModal();field.value='';render();field.focus();}};
    document.querySelectorAll<HTMLButtonElement>('[data-search-open]').forEach(button=>button.addEventListener('click',open));
    dialog.querySelector('[data-search-close]')?.addEventListener('click',()=>dialog.close());
    dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
    field.addEventListener('input',render);
    document.addEventListener('keydown',event=>{
      if((event.ctrlKey||event.metaKey)&&event.key.toLowerCase()==='k'){
        event.preventDefault();
        if(dialog.open)dialog.close();else open();
      }
    });
    dialog.addEventListener('close',()=>{const trigger=document.querySelector<HTMLButtonElement>('[data-search-open]');trigger?.focus();});
  }
</script>
