---
import SocialLinks from './SocialLinks.astro';
type SocialItem = {platform:'instagram'|'facebook'|'threads'|'youtube'|'line'|'github'|'linkedin'|'x'|'tiktok'|'pinterest'|'discord'|'telegram'|'spotify'|'email'|'phone'|'website'|'rss';href:string;label?:string};
interface Props {
  brand?:string;
  description?:string;
  links?:{label:string;href:string}[];
  socialLinks?:SocialItem[];
  rssHref?:string;
  themeHref?:string;
  themeLabel?:string;
  copyright?:string;
  eyebrow?:string;
}
const {
 brand='Your Studio',description='把重要的故事留在自己的網站。',links=[],socialLinks=[],
 rssHref,themeHref,themeLabel='視覺風格',copyright,eyebrow
}=Astro.props;
const safeInternal=(s:string)=>s.startsWith('/')||s.startsWith('#');
const safeUrl=(href:string)=>{if(safeInternal(href))return href;try{const url=new URL(href);return url.protocol==='https:'?url.href:undefined}catch{return undefined}};
const menu=links.map(x=>({...x,href:safeUrl(x.href)})).filter(x=>x.href);
const rss=rssHref?safeUrl(rssHref):undefined;
const theme=themeHref?safeUrl(themeHref):undefined;
---
<footer class="ab-footer site-footer">
  <div class="site-footer__main">
    <div class="site-footer__identity">
      {eyebrow&&<p class="site-footer__eyebrow">{eyebrow}</p>}
      <strong>{brand}</strong><p>{description}</p>
    </div>
    {menu.length>0&&<nav class="site-footer__nav" aria-label="頁尾導覽">{menu.map(x=><a href={x.href}>{x.label}</a>)}</nav>}
    {socialLinks.length>0&&<SocialLinks size="sm" title="頁尾社群及聯絡連結" items={socialLinks}/>}
  </div>
  <div class="site-footer__bottom">
    <small>{copyright||('© '+new Date().getFullYear()+' '+brand)}</small>
    {(rss||theme)&&<nav class="site-footer__extras" aria-label="其他網站資訊">
      {rss&&<a href={rss}>RSS 訂閱</a>}
      {theme&&<a href={theme}>{themeLabel}</a>}
    </nav>}
  </div>
</footer>
<style>
  .site-footer{display:grid;gap:24px;padding-block:clamp(24px,4vw,48px);border-top:1px solid var(--line,#ddd6c8);color:var(--text,inherit)}
  .site-footer__main{display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start;justify-content:space-between}
  .site-footer__identity{flex:1 1 260px;max-width:46ch}
  .site-footer__identity strong{display:block;font-size:clamp(20px,2.3vw,27px);line-height:1.3}
  .site-footer__identity p{margin:8px 0 0;color:var(--muted,#655f57)}
  .site-footer__identity .site-footer__eyebrow{margin:0 0 12px;font-size:12px;letter-spacing:.12em;text-transform:uppercase}
  .site-footer__nav,.site-footer__extras{display:flex;flex-wrap:wrap;align-items:center;gap:10px 22px}
  .site-footer__nav a,.site-footer__extras a{color:inherit;text-decoration:none}
  .site-footer__nav a:hover,.site-footer__extras a:hover{text-decoration:underline;text-underline-offset:4px}
  .site-footer__bottom{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;border-top:1px solid var(--line,#ddd6c8);padding-top:16px}
  .site-footer__bottom small{color:var(--muted,#655f57)}
  .site-footer a:focus-visible{outline:2px solid var(--accent,currentColor);outline-offset:4px}
  @media(max-width:640px){.site-footer__main{display:grid;gap:18px}.site-footer__bottom{align-items:flex-start}}
</style>
