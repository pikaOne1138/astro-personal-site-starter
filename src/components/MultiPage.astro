---
import DemoLayout from '../layouts/DemoLayout.astro';
import SiteNav from './SiteNav.astro';
import { kindMeta, themeMeta, type Kind, type Theme } from '../data';
import { detailPages, type PageId } from '../site-map';
import { articlesV2 } from '../data/articles-v2';
import BookingLink from './blocks/BookingLink.astro';
import ContactActions from './blocks/ContactActions.astro';
import PricingDetails from './blocks/PricingDetails.astro';
import TrustInfo from './blocks/TrustInfo.astro';
import MediaEmbed from './blocks/MediaEmbed.astro';
import SocialLinks from './blocks/SocialLinks.astro';
import ResourceLibrary from './blocks/ResourceLibrary.astro';
import LeadMagnetCard from './blocks/LeadMagnetCard.astro';
import NewsletterSignup from './blocks/NewsletterSignup.astro';

interface Props { kind: Kind; theme: Theme; page: PageId; }
const { kind, theme, page } = Astro.props;
const k = kindMeta[kind];
const t = themeMeta[theme];
const base = import.meta.env.BASE_URL;
const root = `${base}${kind}/${theme}/`;

const pageTitle: Record<string,string> = {
  articles: '文章',
  topics: '主題索引',
  'start-here': 'Start Here',
  about: '關於我',
  resources: '資源',
  services: '服務項目',
  'first-visit': '第一次來？',
  faq: '常見問題',
  booking: '預約與聯絡',
};

const articleMeta=articlesV2;
---
<DemoLayout title={`${pageTitle[page]} · ${k.label} · ${t.zh}`} description={k.intro} theme={theme} kind={kind}>
  <div class="page-shell">
    <SiteNav kind={kind} theme={theme} current={page} />
    <main class="v02-page">
      <section class="v02-pagehero" data-reveal>
        <p class="eyebrow">{k.eyebrow} · {t.label}</p>
        <h1>{pageTitle[page]}</h1>
        <p>{page === 'about' ? '不是把履歷全部貼上來，而是讓第一次來的人知道：你在意什麼、怎麼工作、為什麼值得繼續認識。' :
          page === 'articles' ? '把內容整理成可以探索、回訪與累積的入口，而不是把所有文章塞在首頁。' :
          page === 'services' ? '把「我可以怎麼幫你」說清楚，讓訪客可以先理解，再決定是否往下一步。' :
          page === 'first-visit' ? '把未知變成已知：流程、費用、方式、界線與第一次會發生什麼。' :
          page === 'booking' ? '低壓力的下一步：先確認適合度，再開始合作。' :
          '這一頁從首頁拆出來，讓首頁只負責引導，而不是承擔所有資訊。'}</p>
      </section>

      {page === 'articles' && <section class="v02-content" data-reveal>
        <div class="v02-filter"><a href={root+'explore/'}>全部文章</a>{Array.from(new Set(articlesV2.map(article=>article.category))).map(category=><a href={root+'explore/?q='+encodeURIComponent(category)}>{category}</a>)}</div>
        <div class="v02-article-grid">
          {articleMeta.map(({category,title,readingMinutes,slug},i)=><a class="v02-article-card" href={`${root}articles/${slug}/`}>
            <span class="num">0{i+1}</span><small>{category} · {readingMinutes} min</small><h2>{title}</h2><p>{articleMeta[i].excerpt}</p><b>閱讀文章 →</b>
          </a>)}
        </div>
        <p style="margin-top:32px"><a class="button primary" href={root+'explore/'}>搜尋文章／標籤／日曆 →</a></p>
      </section>}

      {page === 'topics' && <section class="v02-content v02-topic-list" data-reveal>
        {['AI × 工作方法','網站與創作','個人知識系統','閱讀與學習'].map((x,i)=><article><span>0{i+1}</span><div><h2>{x}</h2><p>把同一主題的文章收在一起，讓內容量長大後仍然找得到。</p></div><b>{8-i} 篇 →</b></article>)}
      </section>}

      {page === 'start-here' && <section class="v02-content v02-reading-path" data-reveal>
        <article><span>01</span><h2>如果你第一次來</h2><p>先讀三篇最能代表這個網站的文章，而不是從最新文章倒著翻。</p></article>
        <article><span>02</span><h2>如果你正在做網站</h2><p>從首頁、內容架構、CTA 到部署，依照一條路徑閱讀。</p></article>
        <article><span>03</span><h2>如果你只是想逛逛</h2><p>直接從主題索引進入，跟著好奇心走。</p></article>
      </section>}

      {page === 'resources' && <div class="v02-content"><MediaEmbed type="youtube" url="https://www.youtube.com/watch?v=jfKfPfyJRdk" title="YouTube 影音嵌入操作示範" caption="工作坊影片元件示範：請替換為有權使用的影片。" /></div>}
      {page === 'resources' && <section class="v02-content" data-reveal>
        <ResourceLibrary title="可以探索的資源" items={[{kind:'link',title:'閱讀首頁資訊架構',description:'網站結構與導覽入門',href:root+'articles/'+articlesV2[0].slug+'/'},{kind:'video',title:'YouTube 媒體嵌入示範',description:'開啟影音來源',href:'https://www.youtube.com/watch?v=jfKfPfyJRdk'},{kind:'tool',title:'Astro 工作坊範例原始碼',description:'公開 GitHub 範例',href:'https://github.com/pikaOne1138/astro-personal-site-starter'}]}/>
        <LeadMagnetCard title="取得網站範例原始碼" description="可閱讀的免費程式碼素材，無須填寫個資。" href="https://github.com/pikaOne1138/astro-personal-site-starter" format="公開免費資源"/>
        <NewsletterSignup title="訂閱文章更新" description="這份示範網站尚未串接電子報服務，正式網站可指定自己選用的平台。"/>
      </section>}
      {page === 'resources' && <section class="v02-content v02-resource" data-reveal>
        <div><p class="eyebrow">FREE RESOURCE</p><h2>把網站需求整理清楚的 20 個問題</h2><p>示範「低壓 CTA」：免費資源可以承接還不想購買或預約的人。</p><a class="button primary" href="https://github.com/pikaOne1138/astro-personal-site-starter" target="_blank" rel="noopener noreferrer">開啟公開範例資源 <span>→</span></a></div>
        <div class="art-frame"><div class="art-orb"></div><div class="art-note">PDF</div></div>
      </section>}

      {page === 'services' && <section class="v02-content v02-service-list" data-reveal>
        <PricingDetails items={[{name:'第一次對談',duration:'示範：可設定時長',format:'線上／實體需自行設定'},{name:'深度陪伴',duration:'依服務方案確認',note:'此處是範例資訊，不代表實際收費'}]} disclaimer="請填入已確認的服務費用與預約政策；此網站僅為展示。" />
        {detailPages.services.map((s,i)=><a class="v02-service-row" href={`${root}services/${s.slug}/`}><span>0{i+1}</span><div><h2>{s.title}</h2><p>{i===0?'先理解需求、確認適合度，再一起決定下一步。':'需要一段時間整理議題時，提供穩定而有結構的陪伴。'}</p></div><b>了解服務 →</b></a>)}
      </section>}

      {page === 'first-visit' && <section class="v02-content" data-reveal>
        <ol class="steps">
          <li><span>1</span><div><h3>留下需求</h3><p>只需要說現在最想處理的事情，不用先整理成完整故事。</p></div></li>
          <li><span>2</span><div><h3>確認方式與費用</h3><p>時間、形式、費用、取消規則都先說清楚。</p></div></li>
          <li><span>3</span><div><h3>第一次對談</h3><p>先認識彼此與需求，不預設一定要長期合作。</p></div></li>
        </ol>
        <aside class="v02-note"><strong>第一次來最需要的是降低未知。</strong><p>這頁不是銷售頁，而是把會讓人猶豫的問題先回答。</p></aside>
      </section>}

      {page === 'about' && kind === 'helper' && <div class="v02-content"><TrustInfo format="依服務提供者實際提供方式設定" notice="本站為模板示範；專業資格、服務地區與隱私政策應由使用者自行確認填寫。" /></div>}
      {page === 'about' && <section class="v02-content about-split" data-reveal>
        <div class="portrait-placeholder"><span>自然光人像 / 作者照</span></div>
        <div><p class="eyebrow">WHY I DO THIS</p><h2>{kind === 'knowledge' ? '我喜歡把複雜的東西拆開，再重新拼成可以使用的樣子。' : '專業不是站得離你很遠，而是能陪你把眼前的事情看清楚。'}</h2><p>這裡保留完整的故事、工作方式與背景。首頁只放三行短版，想深入認識的人再進來。</p><div class="credentials"><span>工作方法</span><span>經歷時間軸</span><span>專業背景</span></div></div>
      </section>}

      {page === 'faq' && <section class="v02-content faq" data-reveal>
        {['第一次談話會發生什麼？','我不確定自己適不適合，可以先問嗎？','線上與實體怎麼選？','取消或改期怎麼處理？'].map((q,i)=><details open={i===0}><summary>{q}</summary><p>這裡放簡短、具體、降低不確定性的回答。需要更完整的說明，再連到合作方式或預約頁。</p></details>)}
      </section>}

      {page === 'booking' && <section class="v02-content v02-booking" data-reveal>
        <div><p class="eyebrow">NEXT STEP</p><h2>不用一次決定全部，先確認這是不是適合你的下一步。</h2><p>正式模板可以接 Google Form、Tally、Cal.com 或 LINE；這裡只保留網站端的轉換入口，不自己打造 CRM。</p></div>
        <div class="practical-stack"><BookingLink description="這是工作坊網站示範；尚未設定真實預約平台，請先閱讀服務內容。" /><ContactActions /></div>
      </section>}
    </main>
    <footer class="footer"><div><strong>One Studio</strong><p>{t.mood}</p></div><SocialLinks size="sm" items={[{platform:"github",href:"https://github.com/pikaOne1138/astro-personal-site-starter",label:"模板原始碼"},{platform:"website",href:"https://pikaOne1138.github.io/astro-personal-site-starter/",label:"工作坊網站"}]}/><div class="footer-links"><a href={root}>回首頁</a><a href={base}>八種 Demo</a></div><small>Astro Workshop · 多頁式網站</small></footer>
  </div>
</DemoLayout>
