---
import DemoLayout from '../layouts/DemoLayout.astro';
import SiteNav from './SiteNav.astro';
import { kindMeta, themeMeta, type Kind, type Theme } from '../data';
import { detailPages, type PageId } from '../site-map';
import { articlesV2 } from '../data/articles-v2';
import BookingLink from './blocks/BookingLink.astro';
import ContactActions from './blocks/ContactActions.astro';
import PricingDetails from './blocks/PricingDetails.astro';
import TrustInfo from './blocks/TrustInfo.astro';
import MediaEmbed from './blocks/MediaEmbed.astro';
import SocialLinks from './blocks/SocialLinks.astro';
import ResourceLibrary from './blocks/ResourceLibrary.astro';
import LeadMagnetCard from './blocks/LeadMagnetCard.astro';
import NewsletterSignup from './blocks/NewsletterSignup.astro';
import PractitionerCard from './blocks/PractitionerCard.astro';
import ServiceFit from './blocks/ServiceFit.astro';
import ArticleViewSwitcher from './blocks/ArticleViewSwitcher.astro';
import ArticleArchive from './ArticleArchive.astro';
import { helperPractice } from '../data/helper-content';

interface Props { kind: Kind; theme: Theme; page: PageId; }
const { kind, theme, page } = Astro.props;
const k = kindMeta[kind];
const t = themeMeta[theme];
const base = import.meta.env.BASE_URL;
const root = `${base}${kind}/${theme}/`;

const pageTitle: Record<string,string> = {
  articles: '文章',
  topics: '主題索引',
  'start-here': 'Start Here',
  about: '關於我',
  resources: '資源',
  services: '服務項目',
  'first-visit': '第一次來？',
  faq: '常見問題',
  booking: '預約與聯絡',
};

const articleMeta=articlesV2;
const practice=helperPractice[theme];
---
<DemoLayout title={`${pageTitle[page]} · ${kind==='helper'?practice.specialty:k.label} · ${t.zh}`} description={kind==='helper'?practice.intro:k.intro} theme={theme} kind={kind}>
  {page==='articles'&&<link rel="stylesheet" href={base+"blocks-v2.css"}/>}
  <div class="page-shell">
    <SiteNav kind={kind} theme={theme} current={page} />
    <main class="v02-page">
      <section class:list={['v02-pagehero',page==='articles'&&'v02-pagehero--archive']} data-reveal>
        {page!=='articles'&&<p class="eyebrow">{kind==='helper'?practice.eyebrow:k.eyebrow} · {t.label}</p>}
        <h1>{kind==='helper' && page==='services' ? practice.serviceTitle : pageTitle[page]}</h1>
        {page!=='articles'&&<p>{kind==='helper' && page==='about' ? practice.about : kind==='helper' && page==='services' ? practice.intro : kind==='helper' && page==='first-visit' ? practice.visitIntro : kind==='helper' && page==='faq' ? '常見問題依專業類別說明服務形式、限制與你的選擇權。' : kind==='helper' && page==='booking' ? practice.bookingDescription : page === 'about' ? '不是把履歷全部貼上來，而是讓第一次來的人知道：你在意什麼、怎麼工作、為什麼值得繼續認識。' :
          page === 'articles' ? '文章依列表、卡片或網格呈現，也可以按主題、日期與關鍵字篩選。' :
          page === 'services' ? '把「我可以怎麼幫你」說清楚，讓訪客可以先理解，再決定是否往下一步。' :
          page === 'first-visit' ? '把未知變成已知：流程、費用、方式、界線與第一次會發生什麼。' :
          page === 'booking' ? '低壓力的下一步：先確認適合度，再開始合作。' :
          '這一頁從首頁拆出來，讓首頁只負責引導，而不是承擔所有資訊。'}</p>}
      </section>

      {page === 'articles' && <section class="v02-content v02-archive-page" data-reveal>
        <ArticleArchive root={root}/>
        <p class="practical-caption">目前六篇為工作坊示範內容，並非正式發布紀錄。</p>
      </section>}

      {page === 'topics' && <section class="v02-content v02-topic-list" data-reveal>
        {[
          {title:'資訊',description:'從數位工具、科技趨勢到網路生活，整理值得理解的資訊與實用觀察。'},
          {title:'宅文化',description:'聊動畫、漫畫、遊戲與影視作品，收藏那些讓人投入其中的角色和故事。'},
          {title:'心理',description:'從情緒、人際關係到自我覺察，用生活經驗探索內在世界的各種面貌。'},
          {title:'旅遊',description:'記下城市散步、地方風景與旅途見聞，分享路上遇見的人事物。'},
        ].map((topic,i)=><article><span>0{i+1}</span><div><h2>{topic.title}</h2><p>{topic.description}</p></div><b>主題示範</b></article>)}
      </section>}

      {page === 'start-here' && <section class="v02-content v02-reading-path" data-reveal>
        <article><span>01</span><h2>如果你第一次來</h2><p>先讀三篇最能代表這個網站的文章，而不是從最新文章倒著翻。</p></article>
        <article><span>02</span><h2>如果你正在做網站</h2><p>從首頁、內容架構、CTA 到部署，依照一條路徑閱讀。</p></article>
        <article><span>03</span><h2>如果你只是想逛逛</h2><p>直接從主題索引進入，跟著好奇心走。</p></article>
      </section>}

      {page === 'resources' && <div class="v02-content"><MediaEmbed type="youtube" url="https://www.youtube.com/watch?v=jfKfPfyJRdk" title="YouTube 影音嵌入操作示範" caption="工作坊影片元件示範：請替換為有權使用的影片。" /></div>}
      {page === 'resources' && <section class="v02-content" data-reveal>
        <ResourceLibrary title="可以探索的資源" items={[{kind:'link',title:'閱讀首頁資訊架構',description:'網站結構與導覽入門',href:root+'articles/'+articlesV2[0].slug+'/'},{kind:'video',title:'YouTube 媒體嵌入示範',description:'開啟影音來源',href:'https://www.youtube.com/watch?v=jfKfPfyJRdk'},{kind:'tool',title:'Astro 工作坊範例原始碼',description:'公開 GitHub 範例',href:'https://github.com/pikaOne1138/astro-personal-site-starter'}]}/>
        <LeadMagnetCard title="取得網站範例原始碼" description="可閱讀的免費程式碼素材，無須填寫個資。" href="https://github.com/pikaOne1138/astro-personal-site-starter" format="公開免費資源"/>
        <NewsletterSignup title="訂閱文章更新" description="這份示範網站尚未串接電子報服務，正式網站可指定自己選用的平台。"/>
      </section>}
      {page === 'resources' && <section class="v02-content v02-resource" data-reveal>
        <div><p class="eyebrow">FREE RESOURCE</p><h2>把網站需求整理清楚的 20 個問題</h2><p>示範「低壓 CTA」：免費資源可以承接還不想購買或預約的人。</p><a class="button primary" href="https://github.com/pikaOne1138/astro-personal-site-starter" target="_blank" rel="noopener noreferrer">開啟公開範例資源 <span>→</span></a></div>
        <div class="art-frame"><div class="art-orb"></div><div class="art-note">PDF</div></div>
      </section>}

      {page === 'services' && <section class="v02-content v02-service-list" data-reveal>
        <ServiceFit suitable={practice.suitable} notSuitable={practice.notSuitable} notice={practice.fitNotice} />
        <PricingDetails items={practice.services.map(item=>({name:item.title,duration:item.meta,format:'服務形式由提供者確認'}))} disclaimer={practice.pricingNote} />
        {detailPages.services.map((s,i)=><a class="v02-service-row" href={`${root}services/${s.slug}/`}><span>0{i+1}</span><div><h2>{practice.services[i]?.title||s.title}</h2><p>{practice.services[i]?.description||practice.intro}</p></div><b>了解服務 →</b></a>)}
      </section>}

      {page === 'first-visit' && <section class="v02-content" data-reveal>
        <h2>{practice.processTitle}</h2>
        <ol class="steps">{practice.process.map((item,i)=><li><span>{i+1}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></li>)}</ol>
        <aside class="v02-note"><strong>先理解流程，再決定是否參與。</strong><p>{practice.terms}</p></aside>
      </section>}

      {page === 'about' && kind === 'helper' && <div class="v02-content"><PractitionerCard name="示範專業者" role={practice.practiceLabel} bio={practice.about} specialties={practice.concepts} profileHref={root+'services/'} /><TrustInfo format={practice.specialty} policy={practice.terms} notice="本站為模板示範；正式服務請核實資格、地區、聯絡方式及相關政策。" /></div>}
      {page === 'about' && <section class="v02-content about-split" data-reveal>
        <div class="portrait-placeholder"><span>自然光人像 / 作者照</span></div>
        <div><p class="eyebrow">WHY I DO THIS</p><h2>{kind === 'knowledge' ? '我喜歡把複雜的東西拆開，再重新拼成可以使用的樣子。' : practice.aboutTitle}</h2><p>{kind==='helper'?practice.about:'這裡保留完整的故事、工作方式與背景。首頁只放三行短版，想深入認識的人再進來。'}</p><div class="credentials"><span>工作方法</span><span>經歷時間軸</span><span>專業背景</span></div></div>
      </section>}

      {page === 'faq' && <section class="v02-content faq" data-reveal>
        {(kind==='helper'?practice.faqs:[{question:'第一次談話會發生什麼？',answer:'請先閱讀服務說明與合作方式。'}]).map((item,i)=><details open={i===0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}
      </section>}

      {page === 'booking' && <section class="v02-content v02-booking" data-reveal>
        <div><p class="eyebrow">NEXT STEP</p><h2>{practice.bookingTitle}</h2><p>{practice.bookingDescription}</p></div>
        <div class="practical-stack"><BookingLink description={practice.bookingDescription} /><ContactActions /></div>
      </section>}
    </main>
    <footer class="footer"><div><strong>One Studio</strong><p>{t.mood}</p></div><SocialLinks size="sm" items={[{platform:"github",href:"https://github.com/pikaOne1138/astro-personal-site-starter",label:"模板原始碼"},{platform:"website",href:"https://pikaOne1138.github.io/astro-personal-site-starter/",label:"工作坊網站"}]}/><div class="footer-links"><a href={root}>回首頁</a><a href={base}>八種 Demo</a></div><small>Astro Workshop · 多頁式網站</small></footer>
  </div>
</DemoLayout>
