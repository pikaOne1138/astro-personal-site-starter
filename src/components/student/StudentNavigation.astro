---
import config from '../../site.config.json';
const base=import.meta.env.BASE_URL;
const navigation=config.navigation.filter(item=>item.enabled!==false);
const roots=navigation.filter(item=>!item.parentId);
const current=Astro.url.pathname;
const href=item=>base+(item.path??item.id+'/');
const ctaPage=navigation.find(item=>item.id===config.primaryCta?.pageId);
---
<div class="student-nav-wrap">
  <button class="student-nav-toggle" type="button" aria-expanded="false" aria-controls="student-nav-links">選單</button>
    <nav id="student-nav-links" class="student-navigation" aria-label="主要導覽">
      {roots.map(item=>{
        const children=navigation.filter(child=>child.parentId===item.id);
        return children.length ? <details class="student-navigation__group">
          <summary>{item.label}<span aria-hidden="true">⌄</span></summary>
          <div class="student-navigation__submenu">
            <a href={href(item)} aria-current={current===href(item)?'page':undefined}>查看全部{item.label}</a>
            {children.map(child=><a href={href(child)} aria-current={current===href(child)?'page':undefined}>{child.label}</a>)}
          </div>
        </details> : <a href={href(item)} aria-current={current===href(item)?'page':undefined}>{item.label}</a>;
      })}
    </nav>
  {config.nativeLayout&&ctaPage&&<a class="student-navigation__cta" data-primary-cta="navigation" href={href(ctaPage)}>{config.primaryCta.label}</a>}
</div>
<style>
.student-nav-wrap{display:flex;align-items:center;gap:12px;min-width:0}
.student-nav-toggle{display:none}
.student-navigation{display:flex;align-items:center;gap:4px 12px;flex-wrap:wrap;min-width:0}
.student-navigation>a,.student-navigation__group>summary{display:flex;align-items:center;gap:8px;min-height:44px;padding:9px 11px;border-radius:6px;text-decoration:none;cursor:pointer;list-style:none}
.student-navigation summary::-webkit-details-marker{display:none}
.student-navigation__group{position:relative}
.student-navigation__submenu{position:absolute;z-index:30;top:100%;left:0;display:grid;gap:2px;min-width:210px;max-width:320px;padding:8px;background:var(--student-nav-menu-bg);color:var(--student-nav-menu-fg);border:var(--student-nav-menu-border);border-radius:10px;box-shadow:var(--student-nav-menu-shadow)}
.student-navigation__group:not([open]) .student-navigation__submenu{display:none}
.student-navigation__submenu a{display:block;min-height:44px;padding:10px 12px;border-radius:6px;text-decoration:none}
.student-navigation a:hover,.student-navigation summary:hover{background:var(--student-nav-hover-bg)}
.student-nav-wrap :is(a,summary,button):focus-visible{outline:3px solid var(--student-nav-focus-ring,currentColor);outline-offset:3px}
.student-navigation__cta{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:9px 12px;border:1px solid currentColor;border-radius:6px;font-weight:700;max-width:100%;overflow-wrap:anywhere;text-decoration:none}
@media(max-width:740px){
  .student-nav-wrap{flex-wrap:wrap;width:100%}
  .student-nav-toggle{display:inline-flex;align-items:center;min-height:44px;padding:9px 12px;border:1px solid currentColor;border-radius:6px;cursor:pointer}
  .student-nav-wrap.is-enhanced:not(.is-open)>.student-navigation{display:none}
  .student-navigation{display:grid;grid-template-columns:1fr;gap:4px;margin-top:8px;width:100%}
  .student-navigation__group{min-width:0}
  .student-navigation__submenu{position:static;min-width:0;max-width:none;box-shadow:none;margin-top:4px}
  .student-navigation>a,.student-navigation__group>summary{overflow-wrap:anywhere}
}
</style>
<script is:inline>
document.querySelectorAll('.student-nav-wrap').forEach(wrap=>{
  const toggle=wrap.querySelector('.student-nav-toggle');
  if(toggle){
    wrap.classList.add('is-enhanced');
    toggle.addEventListener('click',()=>{
      const open=wrap.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded',String(open));
    });
  }
  wrap.addEventListener('keydown',event=>{
    if(event.key!=='Escape')return;
    const group=event.target.closest('details[open]');
    if(group&&wrap.contains(group)){
      group.open=false;group.querySelector(':scope > summary')?.focus();event.preventDefault();return;
    }
    if(wrap.classList.contains('is-open')){
      wrap.classList.remove('is-open');toggle?.setAttribute('aria-expanded','false');toggle?.focus();event.preventDefault();
    }
  });
});
</script>
