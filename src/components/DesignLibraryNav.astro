---
interface Props { current:'layouts'|'section-patterns'|'effects'|'blocks' }
const {current}=Astro.props;
const base=import.meta.env.BASE_URL;
const items=[{id:'layouts',label:'版型庫',path:'layouts/'},{id:'section-patterns',label:'組合樣板庫',path:'section-patterns/'},{id:'effects',label:'特效庫',path:'effects/'},{id:'blocks',label:'元件庫',path:'blocks/'}] as const;
---
<nav class="design-library-nav" aria-label="四座網站設計庫">
 <a class="design-library-nav__home" href={base}>← 展示總覽</a>
 <div class="design-library-nav__links">
 {items.map(item=><a href={base+item.path} aria-current={current===item.id?'page':undefined}>{item.label}</a>)}
 </div>
</nav>
<style>
.design-library-nav{display:flex;align-items:center;justify-content:space-between;gap:16px 24px;flex-wrap:wrap;border-bottom:1px solid var(--line,#ded6ca);padding:14px 0;margin:0 0 20px;font-size:14px}
.design-library-nav__home{white-space:nowrap;color:var(--muted,#665f58);text-decoration:none}
.design-library-nav__links{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.design-library-nav__links a{display:inline-flex;padding:10px 12px;border-radius:7px;text-decoration:none;color:inherit;line-height:1.3;min-height:44px;align-items:center}
.design-library-nav__links a[aria-current="page"]{background:var(--surface-2,#eee9df);color:var(--text,#211d19);font-weight:700}
.design-library-nav a:hover{text-decoration:underline;text-underline-offset:4px}
.design-library-nav a:focus-visible{outline:3px solid var(--accent,#9a3b2e);outline-offset:3px}
@media(max-width:650px){.design-library-nav{display:block}.design-library-nav__home{display:inline-block;margin-bottom:12px}.design-library-nav__links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.design-library-nav__links a{justify-content:center;text-align:center;border:1px solid var(--line,#ded6ca);padding:12px 6px;font-size:14px}}
</style>
