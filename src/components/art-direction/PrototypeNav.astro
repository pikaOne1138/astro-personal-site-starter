---
interface Props { kind: 'knowledge' | 'helper'; }
const {kind} = Astro.props;
const base = import.meta.env.BASE_URL;
const root = base + 'layouts/' + (kind === 'knowledge' ? 'subject-atlas/' : 'practice-compass/');
const items = kind === 'knowledge'
  ? [['主題目錄', root+'#directory'], ['最近收錄',root+'#latest'], ['全部文章',root+'articles/'], ['關於',root+'about/']]
  : [['先從這裡',root+'#choose'], ['服務適配',root+'#fit'], ['服務說明',root+'services/'], ['關於',root+'about/'], ['FAQ',root+'faq/'], ['聯絡',root+'contact/']];
---
<header class="prototype-nav">
  <a class="brand" href={root}>{kind === 'knowledge' ? '◎ 主題標本室' : '✳ 服務羅盤'}<small>{kind === 'knowledge' ? 'AN ATLAS OF IDEAS' : 'THE PRACTICE COMPASS'}</small></a>
  <nav aria-label="網站導覽">{items.map(([label,href]) => <a href={href} aria-current={!href.includes('#') && Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}<a href={base+'layouts/'}>版型庫</a></nav>
</header>
<style>
.prototype-nav{box-sizing:border-box;line-height:1.4;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid currentColor;min-height:88px}.brand{font-size:20px;font-weight:700;flex-shrink:0}.brand small{display:block;font:12px/1.5 ui-monospace,monospace;letter-spacing:.1em}.prototype-nav a{color:inherit;text-decoration:none;min-height:44px;display:inline-flex;align-items:center}.prototype-nav .brand{display:block}.prototype-nav a:hover{text-decoration:underline;text-underline-offset:4px}.prototype-nav nav{display:flex;flex-wrap:wrap;gap:8px 24px}.prototype-nav a:focus-visible{outline:3px solid currentColor;outline-offset:4px}@media(max-width:950px){.prototype-nav{align-items:flex-start;flex-direction:column;padding:24px 0;gap:8px}}@media(max-width:700px){.prototype-nav nav{gap:8px 16px}}
</style>
