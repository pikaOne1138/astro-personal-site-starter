---
import config from '../../../../site.config.json';
const family=config.layoutSlug;
const intro=config.content?.intro?.trim()||'尚未提供個人介紹。請與 AI 整理真實經歷、網站目的及服務或寫作方式。';
const title=config.brand.name;
const knowledge=config.kind==='knowledge';
const headline=knowledge?'關於寫作、整理與分享':'關於我與我的工作方式';
const purpose=knowledge?'我希望留下什麼？':'我能提供什麼？';
const facts=config.serviceFacts??{};
const evidence=typeof facts.qualification==='string'&&facts.qualification.trim()?facts.qualification:'專業資格資料尚未提供；不應虛構證照、年資或媒體報導。';
const practice=typeof facts.method==='string'&&facts.method.trim()?facts.method:'工作方法與合作界線待站長確認。';
const info=[{label:purpose,body:config.brand.tagline||'這段請使用站長確認的真實介紹。'},{label:knowledge?'如何整理內容':'如何合作',body:knowledge?'請說明自己的整理方法、文章主題與實際來源；不虛構研究成果。':practice},{label:knowledge?'內容與來源':'資格與經歷',body:knowledge?'請使用可核對的文章與作品，沒有就標記待補。':evidence}];
---
<article class="about-composition" data-about-family={family} aria-label="關於網站與作者">
{family==='field-notes'&&<div class="about-ledger"><aside><span>FIELD NOTE / AUTHOR</span><b>A—01</b><span>{title}</span></aside><div><p class="about-label">OBSERVATION / METHOD</p><h2>{headline}</h2><p class="about-lead">{intro}</p><dl>{info.map((x,i)=><div><dt>{String(i+1).padStart(2,'0')} / {x.label}</dt><dd>{x.body}</dd></div>)}</dl></div></div>}
{family==='essayist'&&<div class="about-issue"><div class="about-issue-mast"><span>THE ESSAY / BEHIND THE PAGES</span><span>VOL. 01</span></div><h2>{headline}</h2><p class="about-lead">{intro}</p><div class="about-issue-columns">{info.map((x,i)=><section><span>CHAPTER {i+1}</span><h3>{x.label}</h3><p>{x.body}</p></section>)}</div></div>}
{family==='learning-lab'&&<div class="about-experiment"><div class="about-experiment-head"><span>LEARNING NOTES / BACKGROUND</span><h2>{headline}</h2><p>{intro}</p></div><ol>{info.map((x,i)=><li><b>{String(i+1).padStart(2,'0')}</b><div><h3>{x.label}</h3><p>{x.body}</p></div></li>)}</ol></div>}
{family==='curator'&&<div class="about-cabinet"><div class="about-cabinet-title"><span>THE COLLECTION / ABOUT THE CURATOR</span><h2>{headline}</h2><p>{intro}</p></div><div class="about-cabinet-items">{info.map((x,i)=><section><span>OBJECT {String(i+1).padStart(3,'0')}</span><div class="about-cabinet-mark" aria-hidden="true">{String(i+1).padStart(2,'0')}</div><h3>{x.label}</h3><p>{x.body}</p></section>)}</div></div>}
{family==='radio-letter'&&<div class="about-transmission"><div class="about-transmission-code">TO THE READER / OPEN CHANNEL</div><div class="about-transmission-main"><span>● &nbsp; LETTER FREQUENCY</span><h2>{headline}</h2><p class="about-lead">{intro}</p></div><ol>{info.map((x,i)=><li><span>TRACK {String(i+1).padStart(2,'0')}</span><div><h3>{x.label}</h3><p>{x.body}</p></div></li>)}</ol></div>}
{family==='reading-atlas'&&<div class="about-almanac"><aside><span>ALMANAC / AUTHOR</span><strong>{new Date().getFullYear()}</strong></aside><div><h2>{headline}</h2><p class="about-lead">{intro}</p><ol>{info.map((x,i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><h3>{x.label}</h3><p>{x.body}</p></div></li>)}</ol></div></div>}
{family==='clinician'&&<div class="about-clinical"><div class="about-clinical-head"><span>PERSON / PRACTICE</span><h2>{headline}</h2><p>{intro}</p></div><dl>{info.map((x,i)=><div><dt>{String(i+1).padStart(2,'0')} — {x.label}</dt><dd>{x.body}</dd></div>)}</dl></div>}
{family==='companion'&&<div class="about-letter"><span>A NOTE FROM {title}</span><h2>{headline}</h2><p class="about-lead">{intro}</p><div class="about-letter-pages">{info.map((x,i)=><section><span>一封信 · {i+1}</span><h3>{x.label}</h3><p>{x.body}</p></section>)}</div><p class="about-letter-signature">慢慢認識彼此，<span>{title}</span></p></div>}
{family==='somatic'&&<div class="about-rhythm"><div class="about-rhythm-mark" aria-hidden="true">○</div><div class="about-rhythm-intro"><span>BODY / PRESENCE / PRACTICE</span><h2>{headline}</h2><p>{intro}</p></div><div class="about-rhythm-stations">{info.map((x,i)=><section><span>PAUSE {String(i+1).padStart(2,'0')}</span><h3>{x.label}</h3><p>{x.body}</p></section>)}</div></div>}
{family==='coach'&&<div class="about-coach"><span>MAKE A MOVE / ABOUT</span><h2>{headline}</h2><p class="about-lead">{intro}</p><div class="about-coach-actions">{info.map((x,i)=><section><b>{String(i+1).padStart(2,'0')}</b><div><h3>{x.label}</h3><p>{x.body}</p></div></section>)}</div></div>}
{family==='collective'&&<div class="about-collective"><header><span>COLLECTIVE / HOW WE WORK</span><h2>{headline}</h2><p>{intro}</p></header><div class="about-collective-grid">{info.map((x,i)=><section><span>PRINCIPLE / {String(i+1).padStart(2,'0')}</span><h3>{x.label}</h3><p>{x.body}</p></section>)}</div></div>}
{family==='trust-path'&&<div class="about-path"><div class="about-path-intro"><span>BEFORE WE MEET / THE PATH</span><h2>{headline}</h2><p>{intro}</p></div><ol>{info.map((x,i)=><li><span class="about-node">{String(i+1).padStart(2,'0')}</span><div><h3>{x.label}</h3><p>{x.body}</p></div></li>)}</ol></div>}
</article>
<style>
.about-composition{--about-line:color-mix(in srgb,currentColor 25%,transparent);margin:2rem 0 0;border-top:1px solid var(--about-line)}
.about-meta,.about-ending{display:flex;justify-content:space-between;gap:1rem;font:.7rem/1.5 ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase;padding:1rem 0;border-bottom:1px solid var(--about-line)}
.about-main{display:grid;grid-template-columns:minmax(70px,19%) minmax(0,1fr);gap:clamp(1rem,4vw,4rem);padding:clamp(2rem,5vw,5rem) 0}
.about-index{font:500 clamp(4rem,8vw,10rem)/.9 var(--brand-heading-font,Georgia,serif);letter-spacing:-.08em;opacity:.65}
.about-label,.about-parts section>span{font:.73rem/1.5 ui-monospace,monospace;letter-spacing:.12em}
.about-body h2{font:500 clamp(2.5rem,5vw,5rem)/1.16 var(--brand-heading-font,Georgia,serif);letter-spacing:-.05em;max-width:17ch;margin:1.5rem 0}
.about-lead{font:400 clamp(1.12rem,1.8vw,1.5rem)/1.9 var(--brand-body-font,system-ui,sans-serif);max-width:52ch}
.about-parts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1rem,2vw,2rem);margin-top:clamp(3rem,7vw,7rem)}
.about-parts section{border-top:1px solid var(--about-line);padding-top:1.2rem;min-width:0}
.about-parts h3{font:500 clamp(1.25rem,2vw,2rem)/1.3 var(--brand-heading-font,Georgia,serif)}
.about-parts p{line-height:1.85;overflow-wrap:anywhere}
.about-ending{border-top:1px solid var(--about-line);border-bottom:0}
.about-composition[data-about-family="essayist"] .about-main{grid-template-columns:1fr}.about-composition[data-about-family="essayist"] .about-index{display:none}.about-composition[data-about-family="essayist"] .about-body h2{font-size:clamp(4rem,8vw,8rem);max-width:10ch}.about-composition[data-about-family="essayist"] .about-parts{border-top:3px double currentColor}
.about-composition[data-about-family="curator"] .about-parts{grid-template-columns:repeat(3,minmax(0,1fr))}.about-composition[data-about-family="curator"] .about-parts section{padding:2rem 1rem;border:1px solid var(--about-line);min-height:250px}
.about-composition[data-about-family="learning-lab"] .about-parts section{border-top:6px solid currentColor}.about-composition[data-about-family="learning-lab"] .about-body h2{font-family:system-ui,sans-serif;text-transform:uppercase;font-weight:900}
.about-composition[data-about-family="field-notes"] .about-index{writing-mode:vertical-rl;font-size:clamp(3rem,5vw,6rem)}.about-composition[data-about-family="field-notes"] .about-parts{grid-template-columns:1fr}.about-composition[data-about-family="field-notes"] .about-parts section{display:grid;grid-template-columns:130px 1fr;gap:1rem}
.about-composition[data-about-family="radio-letter"] .about-lead{font-style:italic}.about-composition[data-about-family="radio-letter"] .about-parts section{border-top-style:dashed}
.about-composition[data-about-family="reading-atlas"] .about-index{font-size:clamp(5rem,11vw,12rem)}.about-composition[data-about-family="reading-atlas"] .about-parts{grid-template-columns:1fr 1fr}
.about-composition[data-about-family="clinician"] .about-parts{grid-template-columns:1fr 1fr}.about-composition[data-about-family="clinician"] .about-parts section{padding:1.5rem;border:1px solid var(--about-line)}.about-composition[data-about-family="clinician"] .about-parts section:last-child{grid-column:1/-1}
.about-composition[data-about-family="companion"] .about-main{grid-template-columns:1fr;max-width:740px;margin:auto}.about-composition[data-about-family="companion"] .about-index{display:none}.about-composition[data-about-family="companion"] .about-lead{font-style:italic;line-height:2.25}.about-composition[data-about-family="companion"] .about-parts{grid-template-columns:1fr}
.about-composition[data-about-family="somatic"] .about-main{grid-template-columns:1fr}.about-composition[data-about-family="somatic"] .about-index{display:none}.about-composition[data-about-family="somatic"] .about-body h2{font-size:clamp(4rem,9vw,9rem)}
.about-composition[data-about-family="coach"] .about-body h2{font:900 clamp(3rem,7vw,7rem)/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:-.085em}.about-composition[data-about-family="coach"] .about-parts section{border-top-width:5px}
.about-composition[data-about-family="collective"] .about-parts{grid-template-columns:1fr}.about-composition[data-about-family="collective"] .about-parts section{display:grid;grid-template-columns:140px 1fr;gap:1rem}
.about-composition[data-about-family="trust-path"] .about-parts{grid-template-columns:1fr}.about-composition[data-about-family="trust-path"] .about-parts section{border-left:3px solid currentColor;border-top:0;padding:1rem 0 2rem 2rem;position:relative}
@media(max-width:760px){.about-main{grid-template-columns:1fr}.about-index{display:none}.about-parts,.about-composition[data-about-family="reading-atlas"] .about-parts,.about-composition[data-about-family="clinician"] .about-parts,.about-composition[data-about-family="curator"] .about-parts{grid-template-columns:1fr}.about-composition[data-about-family="field-notes"] .about-parts section,.about-composition[data-about-family="collective"] .about-parts section{grid-template-columns:1fr;gap:0}}

.about-ledger,.about-almanac{display:grid;grid-template-columns:minmax(100px,22%) 1fr;gap:clamp(1.5rem,5vw,5rem);padding:3rem 0}.about-ledger>aside,.about-almanac>aside{border-right:1px solid currentColor;display:flex;flex-direction:column;justify-content:space-between;gap:2rem;font:.7rem ui-monospace,monospace;letter-spacing:.12em}.about-ledger aside b,.about-almanac aside strong{font:400 clamp(3rem,7vw,7rem)/1 Georgia,serif}.about-ledger dl>div{display:grid;grid-template-columns:135px 1fr;gap:1rem;border-top:1px solid currentColor;padding:1rem 0}.about-ledger dt,.about-ledger dd{margin:0;font-size:.95rem}
.about-issue{text-align:center;padding:3rem 0}.about-issue-mast{display:flex;justify-content:space-between;border-block:3px double currentColor;padding:1rem;font:.75rem ui-monospace,monospace}.about-issue h2{font-size:clamp(3.5rem,8vw,8rem);margin:3rem auto;max-width:11ch}.about-issue .about-lead{margin:2rem auto}.about-issue-columns{display:grid;grid-template-columns:repeat(3,1fr);text-align:left;gap:clamp(1rem,3vw,3rem);border-top:1px solid currentColor;padding-top:3rem}.about-issue-columns section>span{font:.7rem ui-monospace,monospace}
.about-experiment{border:5px solid currentColor;margin:3rem 0}.about-experiment-head{padding:clamp(1rem,4vw,4rem);background:color-mix(in srgb,currentColor 9%,transparent)}.about-experiment h2{font:900 clamp(2.7rem,6vw,6rem)/1 system-ui,sans-serif;text-transform:uppercase}.about-experiment ol{list-style:none;margin:0;padding:0}.about-experiment li{display:grid;grid-template-columns:100px 1fr;gap:1.5rem;border-top:3px solid currentColor;padding:2rem}.about-experiment li b{font:900 clamp(2.5rem,5vw,5rem)/1 system-ui}
.about-cabinet{padding:3rem 0}.about-cabinet-title{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;border-bottom:1px solid currentColor;padding-bottom:3rem}.about-cabinet-title>span{grid-column:1/-1;font:.7rem ui-monospace,monospace}.about-cabinet-title h2{margin:0}.about-cabinet-items{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2rem}.about-cabinet-items section{border:1px solid currentColor;padding:1.5rem}.about-cabinet-items section>span{font:.7rem ui-monospace,monospace}.about-cabinet-mark{font:400 6rem/1 Georgia,serif;opacity:.25;text-align:center;padding:1rem}
.about-transmission{border:1px solid currentColor;margin:2rem 0;padding:clamp(1.5rem,4vw,4rem)}.about-transmission-code{font:.7rem ui-monospace,monospace;border-bottom:1px dashed currentColor;padding-bottom:1rem}.about-transmission-main{padding:3rem 0}.about-transmission-main>span{font:.7rem ui-monospace,monospace}.about-transmission h2{font-size:clamp(3rem,6vw,6rem)}.about-transmission ol{list-style:none;margin:0;padding:0}.about-transmission li{display:grid;grid-template-columns:110px 1fr;gap:1.5rem;padding:1.3rem 0;border-top:1px dashed currentColor}.about-transmission li span{font:.75rem ui-monospace,monospace}
.about-almanac aside strong{letter-spacing:-.09em}.about-almanac ol{list-style:none;padding:0;margin-top:3rem}.about-almanac li{display:grid;grid-template-columns:70px 1fr;gap:1rem;padding:1.5rem 0;border-top:1px solid currentColor}.about-almanac li>span{font:400 2rem Georgia,serif}
.about-clinical{padding:3rem 0}.about-clinical-head{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;padding:2rem;border:2px solid currentColor}.about-clinical-head span{grid-column:1/-1;font:.75rem ui-monospace,monospace}.about-clinical-head h2{margin:0}.about-clinical dl{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:currentColor;border:1px solid currentColor;margin-top:2rem}.about-clinical dl>div{background:var(--fp-bg,var(--bg));color:var(--fp-ink,var(--ink));padding:2rem}.about-clinical dt{font-weight:700}.about-clinical dd{margin:1rem 0 0}
.about-letter{max-width:770px;margin:3rem auto;padding:clamp(1.5rem,4vw,4rem);border-left:1px solid currentColor}.about-letter>span{font:.7rem ui-monospace,monospace}.about-letter .about-lead{font-style:italic;line-height:2.15}.about-letter-pages section{margin:3rem 0;border-top:1px solid currentColor;padding-top:1.5rem}.about-letter-pages span{font:.75rem ui-monospace,monospace}.about-letter-signature{font-style:italic;text-align:right}.about-letter-signature span{display:block}
.about-rhythm{padding:3rem 0}.about-rhythm-mark{font:300 clamp(6rem,20vw,20rem)/1 Georgia,serif;opacity:.25}.about-rhythm-intro{max-width:780px;margin:0 auto 5rem}.about-rhythm-intro>span,.about-rhythm-stations span{font:.75rem ui-monospace,monospace}.about-rhythm-stations{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1.5rem,3vw,4rem)}.about-rhythm-stations section{border-top:1px solid currentColor;padding-top:2rem}
.about-coach{padding:3rem 0}.about-coach>span{font:.8rem ui-monospace,monospace}.about-coach h2{font:900 clamp(3.5rem,9vw,9rem)/1 system-ui,sans-serif;text-transform:uppercase}.about-coach-actions{margin-top:4rem}.about-coach-actions section{display:grid;grid-template-columns:120px 1fr;gap:2rem;border-top:5px solid currentColor;padding:2rem 0}.about-coach-actions b{font:900 clamp(3rem,5vw,5rem)/1 system-ui}
.about-collective{padding:3rem 0}.about-collective header{display:block!important;padding:3rem!important;background:color-mix(in srgb,currentColor 10%,transparent)!important;border:2px solid currentColor!important}.about-collective header>span{font:.75rem ui-monospace,monospace}.about-collective h2{font:800 clamp(3rem,7vw,7rem)/1.05 system-ui,sans-serif}.about-collective-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2rem}.about-collective-grid section{border:2px solid currentColor;padding:1.5rem}.about-collective-grid span{font:.75rem ui-monospace,monospace}
.about-path{padding:3rem 0}.about-path-intro{max-width:850px;margin-bottom:3rem}.about-path-intro span{font:.75rem ui-monospace,monospace}.about-path ol{list-style:none;border-left:3px solid currentColor;margin-left:2rem;padding:0 0 0 2rem}.about-path li{position:relative;padding:0 0 3rem;display:grid;grid-template-columns:1fr 1fr;gap:2rem}.about-node{position:absolute;left:-3.4rem;top:0;border:2px solid currentColor;border-radius:50%;width:46px;height:46px;display:grid;place-items:center;background:var(--fp-bg,var(--bg));font:.9rem ui-monospace,monospace}.about-path li h3{margin:0}
@media(max-width:760px){.about-ledger,.about-almanac,.about-cabinet-title,.about-clinical-head,.about-path li{grid-template-columns:1fr}.about-ledger>aside,.about-almanac>aside{border-right:0;border-bottom:1px solid currentColor;padding-bottom:1rem}.about-issue-columns,.about-cabinet-items,.about-rhythm-stations,.about-collective-grid,.about-clinical dl{grid-template-columns:1fr}.about-experiment li,.about-coach-actions section{grid-template-columns:60px 1fr;gap:1rem}.about-transmission li,.about-ledger dl>div{grid-template-columns:1fr}.about-path li{gap:.5rem}}
</style>
