---
import config from '../../../../site.config.json';
const base=import.meta.env.BASE_URL;
const nav=config.navigation.find(n=>n.id==='services');
const action=base+(nav?.path??'services/');
---
<div class="body-shell" data-assembled-layout="somatic" data-long-headline={(config.content?.headline||config.brand.name).length>32}>
  <section class="body-hero" aria-labelledby="body-title">
    <div class="body-hero-copy"><p class="body-kicker">BODY / RHYTHM / SPACE TO NOTICE</p><h1 id="body-title">{config.content?.headline || "先回到，身體與節律。"}</h1><p class="body-brand">{config.brand.name} · {config.brand.tagline}</p><p class="body-intro">{config.content?.intro || "以身體感受、溫柔留白和練習節奏，介紹真實的服務範圍。"}</p><a class="body-cta" href="#arrival">了解練習 ↓</a></div>
    <figure class="body-figure">{config.brand.heroImagePath?<img src={base+config.brand.heroImagePath.replace(/^\//,'')} alt={config.brand.heroImageAlt||'請補上圖片描述'}/>:<div class="body-art" role="img" aria-label="自然光與空間示意"></div>}<figcaption>示範視覺，可替換為自有授權照片</figcaption></figure>
  </section>
  <div class="body-transition"><p>ARRIVE · NOTICE · CHOOSE</p><blockquote>「不用趕著變成別的樣子。我們先留意，現在自己在哪裡。」</blockquote><p>練習與陪伴不代表任何療效承諾；可依身體狀況調整或暫停。</p></div>
  <div class="body-section-list"><section class="body-section" id="arrival"><p class="body-section-tag">01 / ARRIVAL</p><h2>先抵達這裡</h2><p>不必急著改變，先注意環境、呼吸和身體接觸點。</p></section>
<section class="body-section" id="practice"><p class="body-section-tag">02 / PRACTICE</p><h2>先了解工作方式</h2><p>{config.serviceFacts?.method||'實際方法待站長提供；以下為閱讀流程示意。'}</p><ol class="body-source-anchors"><li><span>01</span><div><h3>了解範圍</h3><p>{config.serviceFacts?.scope||'服務範圍待設定。'}</p></div></li><li><span>02</span><div><h3>確認界線</h3><p>{config.serviceFacts?.exclusions||'工作界線待設定。'}</p></div></li><li><span>03</span><div><h3>自行選擇</h3><p>在了解資訊後，再決定自己的下一步。</p></div></li></ol></section>

</div><section class="body-section body-source-sessions" id="sessions"><p class="body-section-tag">03 / SESSIONS</p><h2>服務安排</h2><p>時間、費用與實際服務方式都需由站長填入，不提供療效承諾。</p><a href={action}>查看服務 ↗</a></section>
  <footer class="body-close"><p>版型示範內容，需要站長以真實資料替換。</p><a href={action}>前往服務入口 ↗</a></footer>
</div>
<style>
/*
 * Somatic owns composition; the exported site's brand tokens own color.
 * All derived tones are scoped to this layout. No second cascade of
 * post-prototype overrides: edit the original selector below.
 */
.body-shell {
  --somatic-brand: var(--color-primary);
  --somatic-accent: var(--color-accent);
  --somatic-page: var(--color-surface);
  --somatic-ink: var(--color-content);
  --somatic-hero: color-mix(in srgb, var(--somatic-brand) 78%, var(--color-inverse-surface));
  --somatic-hero-deep: color-mix(in srgb, var(--somatic-hero) 65%, var(--color-inverse-surface));
  --somatic-hero-soft: color-mix(in srgb, var(--somatic-brand) 52%, var(--color-secondary));
  --somatic-on-dark: var(--color-on-inverse);
  --somatic-on-dark-muted: var(--color-on-inverse-muted);
  --somatic-on-dark-accent: color-mix(in srgb, var(--somatic-accent) 38%, var(--color-on-inverse));
  --somatic-section: color-mix(in srgb, var(--somatic-brand) 73%, var(--color-inverse-surface));
  --somatic-section-border: color-mix(in srgb, var(--somatic-on-dark) 30%, transparent);
  --somatic-muted: color-mix(in srgb, var(--somatic-ink) 75%, var(--somatic-page));
  --somatic-line: var(--color-line);
  background: var(--somatic-page);
  color: var(--somatic-ink);
  font-family: var(--font-body);
  min-width: 0;
  max-width: 100%;
}
.body-shell *, .body-shell *::before, .body-shell *::after { box-sizing: border-box; }
.body-shell a:focus-visible { outline: 3px solid var(--somatic-on-dark-accent); outline-offset: 4px; }
.body-kicker, .body-section-tag { font: .7rem var(--font-mono); letter-spacing: .1em; }
.body-hero {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  min-height: min(790px, 90svh);
  width: 100%;
  overflow: hidden;
  padding: clamp(5rem, 9vw, 10rem) clamp(1.5rem, 9vw, 9rem);
  background: linear-gradient(130deg, var(--somatic-hero-soft), var(--somatic-hero) 60%, var(--somatic-hero-deep));
  color: var(--somatic-on-dark);
}
.body-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(90deg, var(--somatic-hero-deep) 0%, color-mix(in srgb, var(--somatic-hero-deep) 78%, transparent) 48%, transparent 100%);
}
.body-hero-copy { position: relative; z-index: 2; width: min(100%, 710px); min-width: 0; }
.body-hero h1 {
  margin: 0;
  max-width: 12ch;
  font: 400 clamp(4.2rem, 10.3vw, 10rem)/1.08 var(--font-heading);
  letter-spacing: -.04em;
  overflow-wrap: break-word;
  word-break: normal;
  line-break: strict;
  text-wrap: pretty;
  color: var(--somatic-on-dark);
}
.body-kicker { color: var(--somatic-on-dark-accent); letter-spacing: .2em; }
.body-brand { color: var(--somatic-on-dark-muted); }
.body-intro { max-width: 460px; font-size: 1.08rem; line-height: 1.85; color: var(--somatic-on-dark-muted); }
.body-cta { display: inline-block; margin-top: 1.5rem; border-bottom: 2px solid var(--somatic-on-dark-accent); padding: .6rem 0; color: var(--somatic-on-dark); text-decoration: none; }
.body-hero .body-figure { position: absolute; inset: 0; margin: 0; z-index: 0; pointer-events: none; overflow: hidden; }
.body-hero .body-figure img { display: block; width: 100%; height: 100%; object-fit: cover; filter: var(--image-filter); }
.body-hero .body-figure:has(img)::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, color-mix(in srgb, var(--somatic-hero-deep) 80%, transparent), color-mix(in srgb, var(--somatic-hero-deep) 42%, transparent) 54%, transparent); }
.body-hero .body-figure:not(:has(img)) { display: none; }
.body-hero figcaption { display: none; }
.body-art { width: 100%; height: 100%; background: linear-gradient(115deg, var(--somatic-hero-deep), var(--somatic-hero), var(--somatic-hero-soft)); }
.body-transition {
  display: grid;
  grid-template-columns: .6fr minmax(0, 1.5fr) .8fr;
  gap: 4vw;
  align-items: start;
  max-width: 1300px;
  margin: 0 auto;
  padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 5vw, 5rem);
}
.body-transition > p:first-child { font: .7rem var(--font-mono); letter-spacing: .14em; }
.body-transition blockquote { margin: 0; color: var(--somatic-brand); font: 400 clamp(1.7rem, 3.7vw, 3.4rem)/1.35 var(--font-heading); letter-spacing: -.035em; overflow-wrap: break-word; line-break: strict; }
.body-transition > p:last-child { font-size: .9rem; line-height: 1.85; }
.body-section-list {
  display: grid;
  grid-template-columns: .75fr minmax(0, 1.25fr);
  gap: 2vw 8vw;
  background: var(--somatic-section);
  color: var(--somatic-on-dark);
  padding: clamp(2rem, 6vw, 6rem) clamp(1rem, 8vw, 8rem);
}
.body-section { min-width: 0; padding: 1.6rem 0; border-bottom: 1px solid var(--somatic-section-border); }
.body-section:nth-child(1) { grid-row: span 2; }
.body-section h2 { margin: 0; font: 400 clamp(1.75rem, 3vw, 3rem)/1.2 var(--font-heading); color: var(--somatic-on-dark-accent); overflow-wrap: break-word; }
.body-section p { max-width: 65ch; line-height: 1.85; overflow-wrap: break-word; }
.body-section a { color: var(--somatic-on-dark); }
.body-section-list #arrival h2 { font-size: clamp(2.5rem, 5vw, 5rem); max-width: 12ch; line-height: 1.15; }
.body-source-anchors { list-style: none; padding: 0; margin: 2rem 0; }
.body-source-anchors li { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 1rem; border-top: 1px solid var(--somatic-section-border); padding: 1.5rem 0; }
.body-source-anchors li > span { font: .75rem var(--font-mono); }
.body-source-anchors h3 { margin: 0; font: 400 1.25rem/1.4 var(--font-heading); }
.body-source-sessions {
  display: grid;
  grid-template-columns: .75fr minmax(0, 1.25fr);
  gap: 1rem 8vw;
  max-width: 1300px;
  margin: auto;
  padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 5vw, 5rem);
  background: var(--somatic-page);
  color: var(--somatic-ink);
}
.body-source-sessions h2 { grid-column: 1; color: var(--somatic-ink); }
.body-source-sessions .body-section-tag { grid-column: 1 / -1; }
.body-source-sessions > p:not(.body-section-tag), .body-source-sessions > a { grid-column: 2; color: inherit; }
.body-close { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding: 3rem 8vw; border-top: 1px solid var(--somatic-line); background: var(--somatic-page); }
.body-close a { color: var(--somatic-ink); }
@media (max-width: 800px) {
  .body-hero { min-height: 600px; padding: 6rem 1.5rem 3rem; }
  .body-hero-copy { width: 100%; }
  .body-hero h1 { font-size: clamp(3rem, 11vw, 6rem); max-width: min(100%, 12ch); }
  .body-transition { grid-template-columns: 1fr; gap: 1rem; }
  .body-section-list { grid-template-columns: minmax(0, 1fr); }
  .body-section:nth-child(1) { grid-row: auto; }
  .body-source-sessions { grid-template-columns: minmax(0, 1fr); }
  .body-source-sessions > p:not(.body-section-tag), .body-source-sessions > a { grid-column: 1; }
}
@media (max-width: 480px) {
  .body-hero { min-height: 520px; padding: 3rem 1.5rem; }
  .body-hero h1 { font-size: clamp(2.5rem, 10vw, 3.5rem); max-width: 100%; letter-spacing: -.025em; }
  .body-close { display: block; }
}
</style>
