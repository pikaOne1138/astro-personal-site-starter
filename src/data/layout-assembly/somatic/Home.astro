---
import config from '../../../../site.config.json';
const base=import.meta.env.BASE_URL;
const nav=config.navigation.find(n=>n.id==='services');
const action=base+(nav?.path??'services/');
---
<div class="body-shell" data-assembled-layout="somatic">
  <section class="body-hero" aria-labelledby="body-title">
    <div class="body-hero-copy"><p class="body-kicker">BODY / RHYTHM / SPACE TO NOTICE</p><h1 id="body-title">{config.content?.headline || "先回到，身體與節律。"}</h1><p class="body-brand">{config.brand.name} · {config.brand.tagline}</p><p class="body-intro">{config.content?.intro || "以身體感受、溫柔留白和練習節奏，介紹真實的服務範圍。"}</p><a class="body-cta" href="#arrival">了解練習 ↓</a></div>
    <figure class="body-figure">{config.brand.heroImagePath?<img src={base+config.brand.heroImagePath.replace(/^\//,'')} alt={config.brand.heroImageAlt||'請補上圖片描述'}/>:<div class="body-art" role="img" aria-label="自然光與空間示意"></div>}<figcaption>示範視覺，可替換為自有授權照片</figcaption></figure>
  </section>
  <div class="body-transition"><p>ARRIVE · NOTICE · CHOOSE</p><blockquote>「不用趕著變成別的樣子。我們先留意，現在自己在哪裡。」</blockquote><p>練習與陪伴不代表任何療效承諾；可依身體狀況調整或暫停。</p></div>
  <div class="body-section-list"><section class="body-section" id="arrival"><p class="body-section-tag">01 / ARRIVAL</p><h2>先抵達這裡</h2><p>不必急著改變，先注意環境、呼吸和身體接觸點。</p></section>
<section class="body-section" id="practice"><p class="body-section-tag">02 / PRACTICE</p><h2>三個練習錨點</h2><p>01 找到支撐／02 留意呼吸／03 自行選擇下一步</p></section>
<section class="body-rest" aria-label="身體與節律中的留白"><div class="body-rest-mark" aria-hidden="true">◯</div><div><span>SLOW DOWN / LAND HERE</span><h2>讓身體的節奏，<em>有地方可以慢下來。</em></h2><p>這是留白與閱讀節奏，不是治療承諾。正式服務資訊請由站長如實說明。</p></div></section>
<section class="body-section" id="sessions"><p class="body-section-tag">03 / SESSIONS</p><h2>服務安排</h2><p>時間、費用與實際服務方式都需由站長填入，不提供療效承諾。</p><a href={action}>查看服務 ↗</a></section></div>
  <footer class="body-close"><p>版型示範內容，需要站長以真實資料替換。</p><a href={action}>前往服務入口 ↗</a></footer>
</div>
<style>
.body-shell{--brand:var(--brand-primary,#58746f);background:var(--bg,#f6f4ee);color:var(--ink,#292821);padding:clamp(1rem,4vw,4rem);font-family:var(--brand-body-font,system-ui,sans-serif)}
.body-hero{max-width:1340px;margin:0 auto 5rem;min-height:430px}. body-hero-copy{min-width:0}
.body-kicker,.body-section-tag{font:.7rem ui-monospace,monospace;letter-spacing:.1em;opacity:.8}
.body-hero h1{line-height:1.06;letter-spacing:-.05em;overflow-wrap:anywhere;font-family:var(--brand-heading-font,Georgia,serif);font-weight:500}
.body-intro{font-size:1.08rem;line-height:1.85;max-width:570px}
.body-cta{display:inline-block;margin-top:1.5rem;border-bottom:2px solid var(--brand);padding:.6rem 0;color:inherit;text-decoration:none}
.body-figure{margin:0;min-width:0}. body-figure img{width:100%;aspect-ratio:3/2;object-fit:cover}
.body-figure img{width:100%;aspect-ratio:3/2;object-fit:cover;filter:var(--brand-image-filter,none)}
.body-figure figcaption{font:.72rem ui-monospace,monospace;margin-top:.5rem}
.body-art{min-height:240px;aspect-ratio:3/2;display:flex;align-items:center;justify-content:center}
.body-section-list{max-width:1250px;margin:0 auto 4rem}
.body-section h2{font:500 clamp(1.75rem,3vw,3rem)/1.2 var(--brand-heading-font,Georgia,serif)}
.body-section p{max-width:65ch;line-height:1.85}. body-section a{color:inherit}
.body-close{max-width:1250px;margin:auto;border-top:1px solid currentColor;padding:2rem 0;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.body-hero{min-height:65vh;display:flex;align-items:center;position:relative}.body-hero-copy{position:relative;z-index:1;max-width:630px}.body-hero h1{font-size:clamp(3rem,7vw,7rem)}.body-art{position:absolute;inset:0 0 0 40%;height:100%;background:linear-gradient(145deg,#e9d6b8,#b6bb9f 60%,#6a8074);opacity:.65}.body-section-list{display:grid;grid-template-columns:1fr 1fr;gap:4vw}.body-section:nth-child(2){grid-column:1/-1;background:#e7e9dc}.body-section{padding:2.5rem;border-bottom:1px solid currentColor}
@media(max-width:800px){.body-hero,.body-section-list{display:grid;grid-template-columns:1fr;gap:1.3rem}.body-hero{min-height:0}.body-hero h1{font-size:clamp(2.8rem,9vw,5.8rem)}.body-hero figure,.body-art{position:static;width:100%;height:auto;min-height:180px}.body-section,.body-section:nth-child(1),.body-section:nth-child(2),.body-section:nth-child(3){grid-column:auto;grid-row:auto;margin:0;min-height:auto}.body-section{padding:1.5rem;border:1px solid currentColor}.trust-hero{padding:1.5rem}.trust-section:before{display:none}}
@media(max-width:480px){.body-shell{padding:1rem}.body-hero h1{font-size:clamp(2.3rem,11vw,4rem)}.body-close{display:block}}
.body-hero .body-art{aspect-ratio:auto;left:40%;right:0;width:60%;max-width:60%;min-width:0;height:100%;overflow:hidden}
@media(max-width:800px){.body-hero .body-art{position:static;left:auto;right:auto;width:100%;max-width:100%;height:auto;min-height:180px;aspect-ratio:3/2}}

/* Prototype fidelity repair: immersive dark field, strong typographic rhythm and a green practice band. */
.body-shell{background:#e8e6dc;color:#283128;padding:0;font-family:var(--brand-body-font,Georgia,serif)}
.body-hero{max-width:none;margin:0;min-height:min(790px,90svh);padding:clamp(5rem,9vw,10rem) clamp(1.5rem,9vw,9rem);background:#394938;color:#ece9dc;isolation:isolate;overflow:hidden}
.body-hero:before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#1c291fed 0%,#27332d9b 48%,transparent 100%)}
.body-hero-copy{max-width:710px}
.body-hero h1{max-width:760px;font-size:clamp(4.2rem,10.3vw,10rem);font-weight:400;line-height:.92;letter-spacing:-.075em;color:#f0eadd}
.body-kicker{color:#ddb295;letter-spacing:.2em}
.body-brand{color:#e9c4a7}.body-intro{color:#e2e2d6;max-width:460px}
.body-cta{color:#fff;border-color:#d8ac90}
.body-hero .body-figure{position:absolute;inset:0;margin:0;z-index:-2;overflow:hidden}
.body-hero .body-figure img{width:100%;height:100%;aspect-ratio:auto;object-fit:cover;filter:var(--brand-image-filter,none)}
.body-hero .body-art{position:absolute;inset:0;width:100%;max-width:100%;height:100%;aspect-ratio:auto;opacity:1;background:linear-gradient(115deg,#223e30 0%,#3b543c 30%,#6c7256 68%,#394938 100%)}
.body-hero .body-figure figcaption{position:absolute;bottom:1.2rem;right:2rem;font-size:.65rem;color:#eee}
.body-transition{display:grid;grid-template-columns:.6fr 1.5fr .8fr;gap:4vw;padding:clamp(3rem,6vw,6rem) clamp(1rem,5vw,5rem);max-width:1300px;margin:0 auto;align-items:start}
.body-transition>p:first-child{font:.7rem ui-monospace,monospace;letter-spacing:.14em}
.body-transition blockquote{font:400 clamp(1.7rem,3.7vw,3.4rem)/1.35 var(--brand-heading-font,Georgia,serif);letter-spacing:-.035em;margin:0;color:#52604b}
.body-transition>p:last-child{font-size:.9rem;line-height:1.85}
.body-section-list{max-width:none;margin:0;background:#3e4b37;color:#ece9dc;padding:clamp(2rem,6vw,6rem) clamp(1rem,8vw,8rem);grid-template-columns:.75fr 1.25fr;gap:2vw 8vw}
.body-section{border:0;padding:1.6rem 0;border-bottom:1px solid #eceddb54}
.body-section:nth-child(1){grid-row:span 2}
.body-section:nth-child(2){grid-column:auto;background:transparent}
.body-section h2{color:#e8bda1;font-weight:400}
.body-section a{color:#fff}
.body-close{margin:0;max-width:none;padding:3rem 8vw;background:#e8e6dc}
@media(max-width:800px){.body-hero{min-height:600px;display:flex;padding:6rem 1.5rem 3rem}.body-hero .body-figure{position:absolute;width:100%;height:100%;max-width:none}.body-hero .body-art{position:absolute;width:100%;height:100%;max-width:100%}.body-hero .body-figure img{height:100%}.body-transition{grid-template-columns:1fr;gap:1rem}.body-section-list{grid-template-columns:1fr}.body-section:nth-child(1),.body-section:nth-child(2){grid-column:auto;grid-row:auto}}
.body-rest{grid-column:1/-1;min-height:440px;background:#263d32;color:#e7e5d1;display:grid;grid-template-columns:1fr 1.5fr;align-items:center;gap:clamp(2rem,7vw,7rem);padding:clamp(2rem,5vw,6rem);overflow:hidden}.body-rest-mark{font:200 clamp(8rem,24vw,23rem)/1 Georgia,serif;color:#b4aa83;opacity:.55;text-align:center}.body-rest span{font:.72rem ui-monospace,monospace;letter-spacing:.14em}.body-rest h2{font:400 clamp(2.5rem,5vw,5rem)/1.25 Georgia,serif!important;max-width:15ch}.body-rest h2 em{display:block;color:#b4aa83;font-weight:400}.body-rest p{max-width:45ch;line-height:2}@media(max-width:700px){.body-rest{grid-template-columns:1fr;min-height:0}.body-rest-mark{font-size:7rem;text-align:left}.body-rest h2{font-size:clamp(2rem,10vw,4rem)!important}}
.body-shell{background:#f4f0e6}.body-hero{max-width:none;margin:0 calc(-1 * clamp(1rem,4vw,4rem)) 4rem;min-height:clamp(480px,74vh,880px);padding:clamp(2rem,6vw,7rem);display:flex;position:relative;align-items:center;background:linear-gradient(130deg,#576a54,#2d493a 60%,#b3b094);overflow:hidden}.body-hero-copy{max-width:740px;z-index:2;color:#f7f1e5;position:relative}.body-hero h1{font:400 clamp(3.3rem,7vw,8rem)/1.1 var(--brand-heading-font,Georgia,serif);max-width:12ch;letter-spacing:-.07em}.body-hero .body-kicker,.body-hero .body-brand{color:#f7f1e5}.body-hero .body-cta{border-color:#f7f1e5;color:#f7f1e5}.body-hero .body-figure{position:absolute;inset:0;margin:0;z-index:0;pointer-events:none}.body-hero .body-figure:has(img):after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,36,25,.76) 0%,rgba(12,36,25,.4) 54%,transparent 100%)}.body-hero .body-figure img{display:block;width:100%;height:100%;aspect-ratio:auto;object-fit:cover;filter:var(--brand-image-filter,none)}.body-hero .body-figure:not(:has(img)){display:none}.body-hero figcaption{display:none}@media(max-width:800px){.body-hero{min-height:520px;padding:2.5rem 1.5rem}.body-hero .body-figure:has(img){position:absolute;inset:0;width:100%;height:100%}.body-hero .body-figure img{height:100%}.body-hero-copy{color:#fff}.body-hero h1{font-size:clamp(2.8rem,11vw,5.5rem)}}
.body-shell{min-width:0;max-width:100%;overflow-x:clip}.body-hero{box-sizing:border-box;width:100%;max-width:100%;margin-left:auto;margin-right:auto}.body-hero-copy{min-width:0}.body-hero h1{overflow-wrap:anywhere;max-width:100%}.body-hero .body-figure{box-sizing:border-box;max-width:100%}
@media(max-width:800px){.body-hero{width:100%;margin-inline:0}.body-hero-copy{max-width:100%}}
.body-hero{min-height:min(790px,90svh);padding:clamp(5rem,9vw,10rem) clamp(1.5rem,9vw,9rem)}.body-hero h1{font-size:clamp(4.2rem,10.3vw,10rem);line-height:1.08;letter-spacing:-.04em;max-width:12ch}.body-hero-copy{max-width:710px}.body-transition{grid-template-columns:.6fr minmax(0,1.5fr) .8fr}@media(max-width:800px){.body-hero{min-height:600px;padding:6rem 1.5rem 3rem}.body-hero h1{font-size:clamp(3rem,11vw,6rem)}.body-transition{grid-template-columns:1fr}}
</style>