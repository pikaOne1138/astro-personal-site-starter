---
import config from '../../../../site.config.json';
const base=import.meta.env.BASE_URL;
const nav=config.navigation.find(n=>n.id==='services');
const action=base+(nav?.path??'services/');
---
<div class="move-shell" data-assembled-layout="coach">
  <section class="move-hero" aria-labelledby="move-title">
    <div class="move-hero-copy"><p class="move-kicker">MAKE A MOVE / NEXT STEP</p><h1 id="move-title">{config.content?.headline || "卡住的事，拆成下一步。"}</h1><p class="move-brand">{config.brand.name} · {config.brand.tagline}</p><p class="move-intro">{config.content?.intro || "先確認問題，釐清選項，再選擇實際可以開始的小行動。"}</p><a class="move-cta" href="#problem">了解方法 ↓</a></div>
    <figure class="move-figure">{config.brand.heroImagePath?<img src={base+config.brand.heroImagePath.replace(/^\//,'')} alt={config.brand.heroImageAlt||'請補上圖片描述'}/>:<div class="move-art" role="img" aria-label="高對比幾何行動箭頭"></div>}<figcaption>示範視覺，可替換為自有授權照片</figcaption></figure>
  </section>
  <div class="move-section-list"><section class="move-section" id="problem"><p class="move-section-tag">01 / PROBLEM</p><h2>先看真正的問題</h2><p>不假設努力不夠，也不保證教練合作能帶來特定結果。</p></section>
<section class="move-source-method" id="method"><div><p class="move-kicker">THE METHOD / 待設定</p><h2>把問題拆開，<em>再決定下一步。</em></h2><p>{config.serviceFacts?.method||'實際工作方法待站長提供。以下為閱讀流程示意。'}</p></div><div class="move-source-steps">{[['了解範圍',config.serviceFacts?.scope||'服務範圍待設定'],['確認界線',config.serviceFacts?.exclusions||'服務界線待設定'],['第一次聯絡',config.serviceFacts?.firstVisit||'初次聯絡流程待設定']].map(([title,text],i)=><details class={'move-source-step move-source-step-'+i} open={i===0}><summary><span>MOVE / {String(i+1).padStart(2,'0')}</span><h3>{title}</h3><b aria-hidden="true">{String(i+1).padStart(2,'0')}</b></summary><p>{text}</p></details>)}</div></section>
<section class="move-section" id="work"><p class="move-section-tag">03 / WORK</p><h2>合作方式</h2><p>服務流程與聯絡方式須由站長確認，不虛構成功案例。</p><a href={action}>查看服務 ↗</a></section></div>
  <footer class="move-close"><p>版型示範內容，需要站長以真實資料替換。</p><a href={action}>前往服務入口 ↗</a></footer>
</div>
<style>
.move-shell{--brand:var(--brand-primary,#58746f);background:var(--bg,#f6f4ee);color:var(--ink,#292821);padding:clamp(1rem,4vw,4rem);font-family:var(--brand-body-font,system-ui,sans-serif)}
.move-hero{max-width:1340px;margin:0 auto 5rem;min-height:430px}. move-hero-copy{min-width:0}
.move-kicker,.move-section-tag{font:.7rem ui-monospace,monospace;letter-spacing:.1em;opacity:.8}
.move-hero h1{line-height:1.06;letter-spacing:-.05em;overflow-wrap:anywhere;font-family:var(--brand-heading-font,Georgia,serif);font-weight:500}
.move-intro{font-size:1.08rem;line-height:1.85;max-width:570px}
.move-cta{display:inline-block;margin-top:1.5rem;border-bottom:2px solid var(--brand);padding:.6rem 0;color:inherit;text-decoration:none}
.move-figure{margin:0;min-width:0}. move-figure img{width:100%;aspect-ratio:3/2;object-fit:cover}
.move-figure img{width:100%;aspect-ratio:3/2;object-fit:cover;filter:var(--brand-image-filter,none)}
.move-figure figcaption{font:.72rem ui-monospace,monospace;margin-top:.5rem}
.move-art{min-height:240px;aspect-ratio:3/2;display:flex;align-items:center;justify-content:center}
.move-section-list{max-width:1250px;margin:0 auto 4rem}
.move-section h2{font:500 clamp(1.75rem,3vw,3rem)/1.2 var(--brand-heading-font,Georgia,serif)}
.move-section p{max-width:65ch;line-height:1.85}. move-section a{color:inherit}
.move-close{max-width:1250px;margin:auto;border-top:1px solid currentColor;padding:2rem 0;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.move-hero{position:relative;min-height:530px}.move-hero h1{position:relative;z-index:2;font-weight:900;text-transform:uppercase;font-size:clamp(4rem,9vw,9rem);max-width:1000px;letter-spacing:-.07em}.move-art{position:absolute;right:0;top:10%;width:46%;height:75%;background:linear-gradient(130deg,#eed35f,#f37443 55%,#1e3c55)}.move-section-list{display:grid;grid-template-columns:1fr 2fr;gap:1.5rem}.move-section:nth-child(2){grid-column:2;background:#dae8e5}.move-section{border:3px solid currentColor;padding:2rem}
@media(max-width:800px){.move-hero,.move-section-list{display:grid;grid-template-columns:1fr;gap:1.3rem}.move-hero{min-height:0}.move-hero h1{font-size:clamp(2.8rem,9vw,5.8rem)}.move-hero figure,.move-art{position:static;width:100%;height:auto;min-height:180px}.move-section,.move-section:nth-child(1),.move-section:nth-child(2),.move-section:nth-child(3){grid-column:auto;grid-row:auto;margin:0;min-height:auto}.move-section{padding:1.5rem;border:1px solid currentColor}.trust-hero{padding:1.5rem}.trust-section:before{display:none}}
@media(max-width:480px){.move-shell{padding:1rem}.move-hero h1{font-size:clamp(2.3rem,11vw,4rem)}.move-close{display:block}}

/* Restore MAKE A MOVE type-led hierarchy, paper/ink contrast and orange/blue punch. */
.move-shell{background:#f1eadb;color:#151d38;font-family:var(--brand-body-font,Arial,sans-serif);padding:0 clamp(1rem,4vw,4rem) 3rem}
.move-hero{min-height:630px;padding:3rem 0 5rem;border-bottom:2px solid #151d38;overflow:hidden}
.move-hero h1{font-family:var(--brand-body-font,Arial,sans-serif);font-size:clamp(4.3rem,11.5vw,11rem);line-height:.9;letter-spacing:-.095em;font-weight:900;max-width:1000px;margin:3rem 0 2rem}
.move-hero h1::first-line{text-decoration:underline;text-decoration-color:#2148d8;text-decoration-thickness:.12em;text-underline-offset:-.045em}
.move-kicker{color:#2148d8;font-weight:700}
.move-hero .move-figure{position:absolute;right:1%;top:17%;width:34%;margin:0;transform:rotate(3deg)}
.move-hero .move-art,.move-hero .move-figure img{position:static;width:100%;height:auto;min-height:220px;aspect-ratio:3/2;border:3px solid #151d38;box-shadow:12px 12px 0 #ee6846;background:linear-gradient(135deg,#f8d86d,#f47b54 55%,#2449d8)}
.move-hero .move-intro{max-width:360px;position:relative;z-index:3}
.move-hero .move-cta{position:relative;z-index:3;border-color:#ee6846;color:#2148d8;font-weight:700}
.move-section-list{grid-template-columns:1fr 1.25fr;gap:2rem 4vw}
.move-section{border:0;border-top:2px solid #151d38;padding:1.5rem 0;background:transparent}
.move-section:nth-child(1){grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:1rem 4rem}
.move-section:nth-child(1) .move-section-tag{grid-column:1/-1}
.move-section:nth-child(2){grid-column:1;background:transparent}
.move-section:nth-child(3){grid-column:2;background:#2148d8;color:#fff;padding:2rem;border-top-color:#ee6846}
.move-section h2{font-family:var(--brand-body-font,Arial,sans-serif);font-weight:800;letter-spacing:-.06em}
.move-close{border-top:2px solid #151d38}
@media(max-width:800px){.move-hero{min-height:0;display:flex;flex-direction:column;padding:2rem 0 3rem}.move-hero h1{font-size:clamp(3.1rem,9vw,5.5rem);margin:1rem 0}.move-hero .move-figure{position:static;width:min(100%,520px);transform:none;order:2;margin-top:1rem}.move-hero .move-art{position:static;width:100%;height:auto;min-height:200px}.move-section-list{grid-template-columns:1fr}.move-section:nth-child(1),.move-section:nth-child(2),.move-section:nth-child(3){grid-column:1;display:block}}
.move-action-score{grid-column:1/-1;background:#2148d8;color:#fff;padding:clamp(1.5rem,4vw,4rem);display:grid;grid-template-columns:1fr 1fr;gap:3rem}.move-action-lead>span{font:.73rem ui-monospace,monospace;letter-spacing:.12em}.move-action-score h2{font:900 clamp(3rem,7vw,7rem)/.98 system-ui,sans-serif!important;letter-spacing:-.08em}.move-action-score h2 em{color:#f7d96d;font-style:normal}.move-action-score ol{list-style:none;padding:0;margin:0;align-self:end}.move-action-score li{display:grid;grid-template-columns:75px 1fr;gap:1rem;border-top:1px solid #fff8;padding:1.6rem 0}.move-action-score li b{font:800 clamp(2rem,4vw,4rem)/1 system-ui}.move-action-score li span{font:600 clamp(1rem,2vw,1.5rem)/1.35 system-ui}@media(max-width:750px){.move-action-score{grid-template-columns:1fr}.move-action-score h2{font-size:clamp(2.6rem,12vw,5rem)!important}}
.move-source-method{grid-column:1/-1;display:grid;grid-template-columns:.72fr minmax(0,1.28fr);gap:5vw;margin:2rem 0 6rem}.move-source-method h2{font:800 clamp(2.8rem,5vw,5.2rem)/1.15 var(--brand-body-font,system-ui);letter-spacing:-.04em}.move-source-method h2 em{display:block;color:#2148d8;font-style:normal}.move-source-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem;align-items:start}.move-source-step{min-width:0;min-height:260px;padding:1rem;background:#d8deee;border-top:8px solid #2148d8}.move-source-step-1{margin-top:2rem;background:#f7c7a6;border-color:#ee6846}.move-source-step-2{margin-top:4rem;background:#d7dfb9;border-color:#7f923b}.move-source-step summary{position:relative;cursor:pointer;list-style:none;min-height:44px}.move-source-step summary::-webkit-details-marker{display:none}.move-source-step summary>span{font:.75rem ui-monospace,monospace}.move-source-step summary h3{font-size:1.75rem;line-height:1.2;margin:2rem 0 .5rem}.move-source-step summary>b{display:block;font-size:3rem;opacity:.25}.move-source-step p{line-height:1.8}.move-source-step summary:after{content:'＋';position:absolute;right:0;top:0}.move-source-step[open] summary:after{content:'−'}@media(max-width:1100px){.move-source-method{grid-template-columns:1fr}}@media(max-width:580px){.move-source-steps{grid-template-columns:1fr}.move-source-step{margin:0;min-height:0}.move-source-step summary>b{position:absolute;right:0;bottom:0}.move-hero h1{line-height:1.08;letter-spacing:-.04em}}
.move-hero h1{line-height:1.08;letter-spacing:-.04em}.move-section#work{grid-column:1/-1;background:#151d38;color:#fff;padding:clamp(1.5rem,4vw,3rem)}
</style>