---
import config from '../../../../site.config.json';
const base=import.meta.env.BASE_URL;
const articles=config.navigation.find(n=>n.id==='articles');
const next=base+(articles?.path??'articles/');
---
<div class="essayist-site" data-assembled-layout="essayist">
  <section class="essayist-cover" aria-labelledby="essayist-title">
    <p class="essayist-overline">ESSAYS / PERSONAL JOURNAL</p>
    <h1 id="essayist-title">{config.content?.headline || config.brand.name}<em>{config.brand.tagline}</em></h1>
    <div class="essayist-cover-bottom"><p>{config.content?.intro || "長文、評論與觀察。這是為願意花時間閱讀的人保留的地方。"}</p><a href="#featured-essay">讀本期文章 ↓</a></div>
    <figure>{config.brand.heroImagePath?<img src={base+config.brand.heroImagePath.replace(/^\//,'')} alt={config.brand.heroImageAlt||'請填入圖片描述'}/>:<div class="essayist-art" role="img" aria-label="紙張與書寫工具的抽象示意插畫"><span>ESSAY<br/>018</span></div>}<figcaption>主視覺可替換為自己的授權照片</figcaption></figure>
    <small class="essayist-marginal">A SLOWER WAY TO THINK</small>
  </section>
  <article class="essayist-feature" id="featured-essay"><header><p>FEATURED ESSAY / 首篇長文</p><h2>把想法慢慢寫完整。</h2><p class="essayist-standfirst">用文章留住值得反覆思考的問題。以下為示意文字，正式內容請由作者提供。</p></header><div class="essayist-prose"><p class="essayist-dropcap">有些問題不必急著回答。在文字裡，我們可以多留一些時間，記錄自己的觀察與理解。</p><blockquote>一本筆記，留給願意慢讀的自己。</blockquote><p>將這段更換成自己的文章導讀，並從下方按鈕開啟完整文章。</p><a href={next}>閱讀文章目錄 ↗</a></div></article>
  <section class="essayist-notebook"><div><p class="essayist-overline">FROM THE NOTEBOOK</p><h2>還在整理的，<i>一些念頭。</i></h2></div><ol>{['文章與觀察','閱讀筆記','寫給讀者'].map((label,i)=><li><span>{String(i+1).padStart(2,'0')}</span><a href={next}>{label} ↗</a></li>)}</ol></section>
</div>
<style>
.essayist-site{--essay-ink:var(--ink,#292722);--essay-red:var(--brand,#b24331);background:var(--bg,#f7f3e9);color:var(--essay-ink);padding:0 clamp(1rem,5vw,5rem) 5rem;font-family:var(--brand-heading-font,Georgia,serif)}
.essayist-overline{font:.72rem ui-monospace,monospace;letter-spacing:.14em;color:var(--essay-red)}.essayist-cover{position:relative;max-width:1280px;margin:auto;padding:clamp(3rem,8vw,8rem) 0 4rem;min-height:600px}.essayist-cover h1{position:relative;z-index:2;font-size:clamp(4rem,11vw,11rem);font-weight:400;line-height:.94;letter-spacing:-.08em;max-width:900px;overflow-wrap:anywhere;margin:1rem 0}.essayist-cover h1 em{display:block;color:var(--essay-red);font-weight:400;font-size:.5em;letter-spacing:-.03em;padding-left:8vw;line-height:1.25}.essayist-cover-bottom{position:relative;z-index:3;margin-left:8vw;display:flex;gap:3rem;align-items:end;max-width:600px}.essayist-cover-bottom p{max-width:330px}.essayist-cover-bottom a,.essayist-prose a{white-space:nowrap;text-decoration:none;border-bottom:1px solid var(--essay-red)}.essayist-cover figure{width:min(33%,430px);position:absolute;right:1%;top:18%;transform:rotate(2deg);margin:0}.essayist-cover figure img,.essayist-art{width:100%;aspect-ratio:3/2;object-fit:cover;filter:var(--brand-image-filter,none)}.essayist-art{background:linear-gradient(140deg,#cfbea9,#eee6d7 58%,#b0a28e);display:flex;align-items:end;justify-content:end;padding:1.5rem}.essayist-art span{font:700 2rem/1 ui-monospace,monospace;color:#564a3a}.essayist-cover figcaption{font:.72rem ui-monospace,monospace;margin-top:.5rem}.essayist-marginal{position:absolute;right:0;bottom:1rem;letter-spacing:.12em}
.essayist-feature{max-width:1080px;margin:0 auto 6rem;display:grid;grid-template-columns:.95fr 1.05fr;gap:6vw;border-top:1px solid currentColor;padding-top:2rem}.essayist-feature>header{display:block!important;padding:0!important;border:0!important;background:none!important}.essayist-feature header>p:first-child{font:.74rem ui-monospace,monospace;color:var(--essay-red)}.essayist-feature h2{font-size:clamp(2.5rem,5vw,5rem);line-height:1.1;font-weight:400;letter-spacing:-.06em}.essayist-standfirst{font-size:1.14rem;line-height:1.85}.essayist-prose{font:1.05rem/2 var(--brand-body-font,system-ui,sans-serif)}.essayist-dropcap:first-letter{float:left;font:4rem/.9 Georgia,serif;color:var(--essay-red);padding-right:.5rem}.essayist-prose blockquote{border-left:2px solid var(--essay-red);padding-left:1rem;font-style:italic;font-size:1.4rem;line-height:1.5;margin:2.5rem 0}.essayist-notebook{max-width:1080px;margin:auto;display:grid;grid-template-columns:1fr 1.2fr;gap:3rem;padding:2.5rem;background:color-mix(in srgb,var(--bg) 85%,var(--brand));transform:rotate(-.5deg)}.essayist-notebook h2{font-size:clamp(2rem,4vw,3.8rem);font-weight:400;line-height:1.2}.essayist-notebook h2 i{color:var(--essay-red)}.essayist-notebook ol{padding:0;list-style:none}.essayist-notebook li{display:grid;grid-template-columns:50px 1fr;gap:1rem;border-bottom:1px solid currentColor;padding:1rem 0}.essayist-notebook a{color:inherit;text-decoration:none}
@media(max-width:760px){.essayist-cover{min-height:0}.essayist-cover h1{font-size:clamp(3rem,13vw,6rem)}.essayist-cover figure{position:static;transform:none;width:min(75%,450px);margin:2rem 0 0 auto}.essayist-cover-bottom{margin:1rem 0;gap:1rem;align-items:start}.essayist-feature,.essayist-notebook{grid-template-columns:1fr;gap:1rem}.essayist-marginal{display:none}}
@media(max-width:480px){.essayist-cover h1 em{padding-left:0}.essayist-cover-bottom{flex-direction:column}.essayist-cover figure{width:100%}.essayist-feature h2{font-size:2.8rem}.essayist-notebook{padding:1.25rem;transform:none}}
</style>
