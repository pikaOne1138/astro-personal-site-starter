---
import config from '../../../../site.config.json';
import {getCollection} from 'astro:content';
const base=import.meta.env.BASE_URL;
const entries=config.navigation.some(n=>n.id==='articles')?(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.publishedAt-a.data.publishedAt):[];
const articleHref=entry=>base+'articles/'+entry.id+'/';
const nav=config.navigation.find(n=>n.id==='articles');
const action=base+(nav?.path??'articles/');
const audio=config.media?.episodeAudioPath;
const hasAudio=typeof audio==='string'&&/^\/audio\/[a-z0-9/_-]+\.(mp3|ogg|wav|m4a)$/i.test(audio);
const transcript=Array.isArray(config.media?.episodeTranscript)?config.media.episodeTranscript.filter(x=>typeof x.time==='string'&&typeof x.text==='string'):[];

---
<div class="radio-shell" data-assembled-layout="radio-letter" data-long-headline={(config.content?.headline||config.brand.name).length>32}>
  <section class="radio-hero" aria-labelledby="radio-title">
    <div class="radio-hero-copy"><p class="radio-kicker">RADIO LETTER / SIGNAL OPEN</p><h1 id="radio-title">{config.content?.headline || "這封信，留給願意聽的人。"}</h1><p class="radio-brand">{config.brand.name} · {config.brand.tagline}</p><p class="radio-intro">{config.content?.intro || "聲音創作與逐字稿並行。未提供授權音訊前不會出現假播放器。"}</p><a class="radio-cta" href="#now">打開逐字稿 ↓</a></div>
    <figure class="radio-figure">{config.brand.heroImagePath?<img src={base+config.brand.heroImagePath.replace(/^\//,'')} alt={config.brand.heroImageAlt||'請補上圖片描述'}/>:<div class="radio-art" role="img" aria-label="深色聲波抽象封面"></div>}<figcaption>示範視覺，可替換為自有授權照片</figcaption></figure>
  </section>
  <div class="radio-wave" role="img" aria-label="裝飾性聲波視覺，尚非真實聲音波形">{Array.from({length:46},(_,i)=><span aria-hidden="true" style={'--bar:'+(((i*17)%7)+2)}></span>)}</div>
  <div class="radio-section-list"><section class="radio-section radio-source-now" id="now"><div class="radio-source-lead"><p class="radio-section-tag">01 / NOW</p><h2>本期聲音</h2>{hasAudio?<audio controls preload="metadata" aria-label="本期節目音訊"><source src={base+audio.replace(/^\//,'')}/>您的瀏覽器不支援音訊播放，請使用逐字稿。</audio>:<p role="status">尚未設定自有授權音檔，未顯示無法播放的音訊播放器。</p>}</div><aside class="radio-source-notes"><span>ABOUT THIS LETTER</span><h3>留下聲音，也留下文字。</h3><p>{config.content?.intro||'本期節目說明待作者提供。'}</p><p>{hasAudio?'音訊來自站長提供的本地檔案。':'音訊尚未設定；不顯示假播放器。'}</p><a href="#transcript">閱讀逐字稿 ↓</a></aside></section>
<section class="radio-section" id="transcript"><p class="radio-section-tag">02 / TRANSCRIPT</p><h2>逐字稿與筆記</h2>{transcript.length>0?<ol class="radio-transcript">{transcript.map(entry=><li><time>{entry.time}</time><p>{entry.text}</p></li>)}</ol>:<p>逐字稿尚未提供。設定 media.episodeTranscript 的 time / text 陣列即可顯示可搜尋文字；不虛構節目內容。</p>}</section>

<section class="radio-section" id="archive"><p class="radio-section-tag">03 / ARCHIVE</p><h2>節目索引</h2><ol class="radio-entry-list">{entries.slice(0,5).map(entry=><li><time>{entry.data.publishedAt.toLocaleDateString('zh-TW')}</time><a href={articleHref(entry)}>{entry.data.title} ↗</a></li>)}</ol>{!entries.length&&<p>目前沒有公開節目筆記。</p>}<a href={action}>閱讀文章 ↗</a></section></div>
  <footer class="radio-close"><p>版型示範內容，需要站長以真實資料替換。</p><a href={action}>前往文章入口 ↗</a></footer>
</div>
<style>
.radio-shell{--brand:var(--brand-primary,#58746f);background:var(--bg,#f6f4ee);color:var(--ink,#292821);padding:clamp(1rem,4vw,4rem);font-family:var(--brand-body-font,system-ui,sans-serif)}
.radio-hero{max-width:1340px;margin:0 auto 5rem;min-height:430px}. radio-hero-copy{min-width:0}
.radio-kicker,.radio-section-tag{font:.7rem ui-monospace,monospace;letter-spacing:.1em;opacity:.8}
.radio-hero h1{line-height:1.06;letter-spacing:-.05em;overflow-wrap:anywhere;font-family:var(--brand-heading-font,Georgia,serif);font-weight:500}
.radio-intro{font-size:1.08rem;line-height:1.85;max-width:570px}
.radio-cta{display:inline-block;margin-top:1.5rem;border-bottom:2px solid var(--brand);padding:.6rem 0;color:inherit;text-decoration:none}
.radio-figure{margin:0;min-width:0}. radio-figure img{width:100%;aspect-ratio:3/2;object-fit:cover}
.radio-figure img{width:100%;aspect-ratio:3/2;object-fit:cover;filter:var(--brand-image-filter,none)}
.radio-figure figcaption{font:.72rem ui-monospace,monospace;margin-top:.5rem}
.radio-art{min-height:240px;aspect-ratio:3/2;display:flex;align-items:center;justify-content:center}
.radio-section-list{max-width:1250px;margin:0 auto 4rem}
.radio-section h2{font:500 clamp(1.75rem,3vw,3rem)/1.2 var(--brand-heading-font,Georgia,serif)}
.radio-section p{max-width:65ch;line-height:1.85}. radio-section a{color:inherit}
.radio-close{max-width:1250px;margin:auto;border-top:1px solid currentColor;padding:2rem 0;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.radio-shell{background:#14222a;color:#f5e5cf}.radio-hero{display:grid;grid-template-columns:1.2fr .8fr;gap:4vw;align-items:center}.radio-hero h1{font-size:clamp(3rem,6vw,6rem)}.radio-section-list{display:grid;grid-template-columns:1fr 1.5fr;gap:2rem}.radio-section:first-child{grid-column:1/-1;border-bottom:1px solid #81939a}.radio-art{background:repeating-linear-gradient(90deg,#d69b67 0 3px,#283b47 3px 14px,#9fb4bd 14px 16px,#283b47 16px 23px)}
@media(max-width:800px){.radio-hero,.radio-section-list{display:grid;grid-template-columns:1fr;gap:1.3rem}.radio-hero{min-height:0}.radio-hero h1{font-size:clamp(2.8rem,9vw,5.8rem)}.radio-hero figure,.radio-art{position:static;width:100%;height:auto;min-height:180px}.radio-section,.radio-section:nth-child(1),.radio-section:nth-child(2),.radio-section:nth-child(3){grid-column:auto;grid-row:auto;margin:0;min-height:auto}.radio-section{padding:1.5rem;border:1px solid currentColor}.trust-hero{padding:1.5rem}.trust-section:before{display:none}}
@media(max-width:480px){.radio-shell{padding:1rem}.radio-hero h1{font-size:clamp(2.3rem,11vw,4rem)}.radio-close{display:block}}
.radio-section audio{display:block;width:min(100%,680px);margin:1.5rem 0}.radio-transcript{list-style:none;padding:0;display:grid;gap:1rem}.radio-transcript li{display:grid;grid-template-columns:6rem 1fr;gap:1rem;border-top:1px solid #81939a;padding-top:1rem}.radio-transcript time{font: .85rem ui-monospace,monospace;color:#e2aa78}@media(max-width:520px){.radio-transcript li{grid-template-columns:1fr;gap:.25rem}}
.radio-shell{background:#12232c;color:#ecebdc;padding:0 clamp(1rem,4vw,4rem) 3rem}
.radio-hero{max-width:1300px;min-height:580px;padding:3.5rem 0 2rem;gap:4vw;margin-bottom:1rem}
.radio-hero h1{font-family:var(--brand-heading-font,Georgia,serif);font-size:clamp(3.7rem,7.5vw,7.7rem);font-weight:500;line-height:1.04;max-width:800px}
.radio-kicker,.radio-section-tag{color:#72c5b0}
.radio-hero .radio-figure{border:1px solid #607981;padding:1rem;background:#172b34;box-shadow:15px 15px 0 #25434b}
.radio-hero .radio-art{background:radial-gradient(circle at 51% 50%,#bd8159 0 4%,transparent 5% 13%,#436d6f 14% 16%,transparent 17%),repeating-radial-gradient(ellipse at center,#1e3e48 0 10px,#345c63 11px 13px,#142b35 14px 25px)}
.radio-hero .radio-figure img{max-height:430px}
.radio-wave{max-width:1300px;margin:0 auto 5rem;display:flex;align-items:center;gap:3px;min-height:100px;overflow:hidden;border-block:1px solid #536c70}
.radio-wave span{display:block;flex:1;min-width:2px;background:#62b6a7;height:calc(var(--bar)*7px);opacity:.7}
.radio-section-list{grid-template-columns:1fr 1.4fr;gap:4vw}
.radio-section:first-child{grid-column:1/-1}
.radio-section{border-top:1px solid #6d888c;padding:2rem 0}
.radio-section h2{font:500 clamp(2rem,4.5vw,4.5rem)/1.05 var(--brand-heading-font,Georgia,serif)}
.radio-close{border-color:#6d888c}
@media(max-width:800px){.radio-hero{min-height:0;grid-template-columns:1fr}.radio-wave{min-height:72px;margin-bottom:2rem}.radio-wave span{height:calc(var(--bar)*4px)}.radio-section-list{grid-template-columns:1fr}}
.radio-signal{grid-column:1/-1;border:1px solid currentColor;padding:clamp(1.2rem,3vw,3rem);background:#182c33;color:#eae9d8;overflow:hidden}.radio-signal-top{display:flex;justify-content:space-between;gap:1rem;border-bottom:1px solid #eae9d855;padding-bottom:1rem;font:.7rem ui-monospace,monospace;letter-spacing:.12em}.radio-signal-middle{display:grid;grid-template-columns:180px 1fr;align-items:center;gap:clamp(1rem,5vw,5rem);padding:3rem 0}.radio-disc{width:180px;height:180px;border:2px solid #e2b289;border-radius:50%;display:grid;place-items:center;box-shadow:inset 0 0 0 28px #182c33,inset 0 0 0 29px #e2b289;text-align:center}.radio-disc span{font:800 1.3rem/1.3 ui-monospace,monospace;letter-spacing:.14em}.radio-signal-middle p{font:400 clamp(2rem,5vw,5rem)/1.3 Georgia,serif;letter-spacing:-.06em}.radio-signal-middle i{display:block;color:#e2b289;font-weight:400}.radio-signal-wave{display:flex;gap:5px;align-items:center;height:52px;border-top:1px solid #eae9d855}.radio-signal-wave span{flex:1;height:var(--rise);background:#e2b289}@media(max-width:650px){.radio-signal-middle{grid-template-columns:1fr}.radio-disc{width:120px;height:120px}.radio-signal-middle p{font-size:clamp(2rem,8vw,3.5rem)}}
.radio-hero{grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);align-items:center;min-height:clamp(500px,68vh,820px);gap:clamp(2rem,5vw,7rem)}.radio-hero h1{font-size:clamp(4.6rem,8vw,9rem);line-height:1.02;max-width:11ch;letter-spacing:-.07em}.radio-hero .radio-figure{align-self:stretch;display:grid;place-content:center;transform:rotate(1deg)}.radio-hero .radio-figure img,.radio-hero .radio-art{min-height:clamp(230px,35vw,460px);height:100%;object-fit:cover}.radio-shell>.radio-wave{min-height:100px;max-width:1400px;margin:0 auto 4rem;display:flex;align-items:center;gap:3px}.radio-shell>.radio-wave span{height:calc(var(--bar)*8px)}@media(max-width:800px){.radio-hero{grid-template-columns:1fr;min-height:0}.radio-hero h1{font-size:clamp(3.1rem,11vw,6rem)}.radio-hero .radio-figure{max-width:700px;justify-self:center;width:100%}}.radio-hero{min-width:0}.radio-hero-copy,.radio-hero .radio-figure{min-width:0;max-width:100%}.radio-hero h1{font-size:clamp(3rem,6.2vw,7rem);max-width:100%;overflow-wrap:anywhere}.radio-shell{min-width:0;max-width:100%;overflow-x:clip}
@media(min-width:801px){.radio-hero{grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(1rem,3vw,3rem)}}
.radio-hero h1{line-height:1.12;letter-spacing:-.04em}.radio-site :is(audio){width:100%;min-width:0}.radio-shell :is(audio){width:100%;min-width:0}
.radio-entry-list{list-style:none;padding:0}.radio-entry-list li{display:grid;grid-template-columns:110px minmax(0,1fr);gap:1rem;padding:1rem 0;border-top:1px solid currentColor}.radio-entry-list time{font:.75rem ui-monospace,monospace}@media(max-width:580px){.radio-entry-list li{grid-template-columns:1fr}}
.radio-source-now{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:6vw;border-top:1px solid currentColor}.radio-source-lead,.radio-source-notes{min-width:0}.radio-source-lead h2{font:400 clamp(2.8rem,5vw,5rem)/1.12 var(--brand-heading-font,Georgia,serif)}.radio-source-notes{border-left:1px solid currentColor;padding-left:2rem;align-self:end}.radio-source-notes>span{font:.75rem ui-monospace,monospace}.radio-source-notes h3{font:400 clamp(1.5rem,3vw,2.5rem)/1.3 var(--brand-heading-font,Georgia,serif)}@media(max-width:800px){.radio-source-now{grid-template-columns:1fr}.radio-source-notes{border-left:0;border-top:1px solid currentColor;padding:1rem 0}}
</style>
