---
import config from '../../../../site.config.json';
const base=import.meta.env.BASE_URL;
const nav=config.navigation.find(n=>n.id==='articles');
const action=base+(nav?.path??'articles/');
const months=['一月','二月','三月','四月','五月','六月','七月','八月','九月','十月','十一月','十二月'];
const sampleMonths=months.map((name,i)=>({month:String(i+1).padStart(2,'0'),name}));
const records=Array.isArray(config.reading?.records)&&config.reading.records.length?config.reading.records.map(x=>({month:x.month,name:months[Number(x.month)-1],title:x.title,note:x.note})):sampleMonths.map(x=>({...x,title:'尚未提供閱讀紀錄',note:'請填入實際讀過的書、評註與來源。'}));
---
<div class="atlas-shell" data-assembled-layout="reading-atlas">
  <section class="atlas-hero" aria-labelledby="atlas-title">
    <div class="atlas-hero-copy"><p class="atlas-kicker">READING ALMANAC / YEAR IN REVIEW</p><h1 id="atlas-title">閱讀年鑑</h1><p class="atlas-brand">{config.brand.name} · {config.brand.tagline}</p><p class="atlas-intro">一整年的閱讀足跡，以月份、評註和年度選書串成索引。</p><a class="atlas-cta" href="#calendar">閱讀年鑑 ↓</a></div>
    <div class="atlas-art" role="img" aria-label="無圖片的年份字樣"></div>
  </section>
  <div class="atlas-section-list"><section class="atlas-section" id="calendar"><p class="atlas-section-tag">01 / CALENDAR</p><h2>十二月閱讀線格</h2><div class="atlas-months" role="group" aria-label="月份篩選"><button type="button" data-atlas-month="all" aria-pressed="true">全年</button>{sampleMonths.map(m=><button type="button" data-atlas-month={m.month} aria-pressed="false">{m.month}<small>{m.name}</small></button>)}</div><p id="atlas-filter-status" role="status" aria-live="polite">顯示全年示範空白紀錄</p></section>
<section class="atlas-section" id="year-book"><p class="atlas-section-tag">02 / YEAR-BOOK</p><h2>年度選讀</h2>{config.reading?.annualBook?<div><h3>{config.reading.annualBook.title}</h3><p>{config.reading.annualBook.note}</p></div>:<p>年度之書尚未設定。只有提供自己真實讀過的書及選擇理由才會顯示。</p>}</section>
<section class="atlas-section" id="catalog"><p class="atlas-section-tag">03 / CATALOG</p><h2>讀書目錄</h2><p>以下是待填紀錄，不代表已讀書目。</p><div class="atlas-records">{records.map(m=><article data-record-month={m.month}><span>{m.month} / {m.name}</span><h3>{m.title}</h3><p>{m.note}</p></article>)}</div><a href={action}>閱讀文章 ↗</a></section></div>
  <footer class="atlas-close"><p>版型示範內容，需要站長以真實資料替換。</p><a href={action}>前往文章入口 ↗</a></footer>
</div>
<script is:inline>
document.querySelectorAll('[data-assembled-layout="reading-atlas"]').forEach(root=>{
 const buttons=[...root.querySelectorAll('[data-atlas-month]')],items=[...root.querySelectorAll('[data-record-month]')];
 buttons.forEach(b=>b.addEventListener('click',()=>{
  const value=b.dataset.atlasMonth;
  buttons.forEach(other=>other.setAttribute('aria-pressed',String(other===b)));
  items.forEach(item=>item.hidden=value!=='all'&&item.dataset.recordMonth!==value);
  root.querySelector('#atlas-filter-status').textContent=value==='all'?'顯示全年示範空白紀錄':'顯示 '+value+' 月示範空白紀錄';
 }));
});
</script>
<style>
.atlas-shell{--brand:var(--brand-primary,#58746f);background:var(--bg,#f6f4ee);color:var(--ink,#292821);padding:clamp(1rem,4vw,4rem);font-family:var(--brand-body-font,system-ui,sans-serif)}
.atlas-hero{max-width:1340px;margin:0 auto 5rem;min-height:430px}. atlas-hero-copy{min-width:0}
.atlas-kicker,.atlas-section-tag{font:.7rem ui-monospace,monospace;letter-spacing:.1em;opacity:.8}
.atlas-hero h1{line-height:1.06;letter-spacing:-.05em;overflow-wrap:anywhere;font-family:var(--brand-heading-font,Georgia,serif);font-weight:500}
.atlas-intro{font-size:1.08rem;line-height:1.85;max-width:570px}
.atlas-cta{display:inline-block;margin-top:1.5rem;border-bottom:2px solid var(--brand);padding:.6rem 0;color:inherit;text-decoration:none}
.atlas-figure{margin:0;min-width:0}. atlas-figure img{width:100%;aspect-ratio:3/2;object-fit:cover}
.atlas-figure img{width:100%;aspect-ratio:3/2;object-fit:cover;filter:var(--brand-image-filter,none)}
.atlas-figure figcaption{font:.72rem ui-monospace,monospace;margin-top:.5rem}
.atlas-art{min-height:240px;aspect-ratio:3/2;display:flex;align-items:center;justify-content:center}
.atlas-section-list{max-width:1250px;margin:0 auto 4rem}
.atlas-section h2{font:500 clamp(1.75rem,3vw,3rem)/1.2 var(--brand-heading-font,Georgia,serif)}
.atlas-section p{max-width:65ch;line-height:1.85}. atlas-section a{color:inherit}
.atlas-close{max-width:1250px;margin:auto;border-top:1px solid currentColor;padding:2rem 0;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.atlas-hero{display:grid;grid-template-columns:1fr 1fr;align-items:center}.atlas-hero h1{font-size:clamp(4rem,12vw,12rem);font-family:Georgia,serif}.atlas-art{background:#e8e4d8}.atlas-art:after{content:"2026";font:900 clamp(4rem,13vw,10rem)/1 Georgia,serif;color:#3e463d}.atlas-section-list{display:grid;grid-template-columns:repeat(12,1fr);gap:.6rem}.atlas-section:first-child{grid-column:1/-1;background:repeating-linear-gradient(90deg,transparent 0 7.9%,#a4aaa0 8% 8.2%);min-height:210px}.atlas-section:nth-child(2){grid-column:1/-1;background:#283832;color:white}.atlas-section:nth-child(3){grid-column:1/-1}
@media(max-width:800px){.atlas-hero,.atlas-section-list{display:grid;grid-template-columns:1fr;gap:1.3rem}.atlas-hero{min-height:0}.atlas-hero h1{font-size:clamp(2.8rem,9vw,5.8rem)}.atlas-hero figure,.atlas-art{position:static;width:100%;height:auto;min-height:180px}.atlas-section,.atlas-section:nth-child(1),.atlas-section:nth-child(2),.atlas-section:nth-child(3){grid-column:auto;grid-row:auto;margin:0;min-height:auto}.atlas-section{padding:1.5rem;border:1px solid currentColor}.trust-hero{padding:1.5rem}.trust-section:before{display:none}}
@media(max-width:480px){.atlas-shell{padding:1rem}.atlas-hero h1{font-size:clamp(2.3rem,11vw,4rem)}.atlas-close{display:block}}
.atlas-months{display:grid;grid-template-columns:repeat(6,1fr);gap:.5rem}.atlas-months button{background:transparent;color:inherit;border:1px solid currentColor;min-height:3.5rem;cursor:pointer}.atlas-months button:first-child{grid-column:span 6}.atlas-months button[aria-pressed="true"]{background:#283832;color:#fff}.atlas-months small{display:block}.atlas-records{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.atlas-records article{padding:1rem;border-top:1px solid currentColor}.atlas-records article[hidden]{display:none}@media(max-width:640px){.atlas-months{grid-template-columns:repeat(3,1fr)}.atlas-months button:first-child{grid-column:span 3}.atlas-records{grid-template-columns:1fr}}</style>