---
import config from '../../../../site.config.json';
const base=import.meta.env.BASE_URL;
const service=config.navigation.find(x=>x.id==='services');
const contact=config.navigation.find(x=>x.id==='booking');
const serviceHref=base+(service?.path??'services/');
const contactHref=contact?base+(contact.path??'booking/'):serviceHref;
---
<div class="clinical-site" data-assembled-layout="clinician">
 <section class="clinical-hero" aria-labelledby="clinical-title">
  <div class="clinical-hero-copy"><p class="clinical-overline">PROFESSIONAL PRACTICE / CLEAR FIRST STEPS</p><h1 id="clinical-title">{config.content?.headline || config.brand.name}<span>{config.brand.tagline}</span></h1><p>{config.content?.intro || "先了解服務範圍、可能適合與不適合的情況，以及初次聯絡會發生什麼，再決定下一步。"}</p><div class="clinical-actions"><a class="clinical-primary" href="#clinical-scope">了解服務範圍 ↓</a><a href={contactHref}>聯絡方式 ↗</a></div><dl class="clinical-meta"><div><dt>服務對象</dt><dd>待填入真實資料</dd></div><div><dt>會談形式</dt><dd>待核實</dd></div><div><dt>專業資格</dt><dd>待核實</dd></div></dl></div>
  <figure class="clinical-room">{config.brand.heroImagePath?<img class="clinical-custom-image" src={base+config.brand.heroImagePath.replace(/^\//,'')} alt={config.brand.heroImageAlt||'網站主視覺，請填寫替代文字'} />:<div role="img" aria-label="以幾何圖形呈現安靜會談空間的示意插畫，非實際服務場所" class="clinical-art"><span class="clinical-window"></span><span class="clinical-seat"></span><span class="clinical-seat clinical-seat--back"></span><span class="clinical-floor"></span></div>}<figcaption>空間概念插畫。正式服務地點與照片請由站長提供。</figcaption></figure>
 </section>
 <section class="clinical-scope" id="clinical-scope"><header><p class="clinical-overline">01 / SCOPE & FIT</p><h2>先確認，<em>是不是合適的支持。</em></h2></header><div class="clinical-fit"><article><span>可能適合</span><h3>你想一起釐清現況</h3><ul><li>需要先知道有哪些選擇</li><li>想了解服務方式與合作界線</li><li>願意先談期待，再決定下一步</li></ul></article><article><span>可能需要其他資源</span><h3>本站不提供緊急協助</h3><ul><li>正處於立即危險或危機</li><li>需要服務範圍以外的醫療處置</li><li>希望立即獲得緊急協助</li></ul><p>此為示範說明，請依所在地及實際服務規範提供合適資源。</p></article></div></section>
 <section class="clinical-process" id="clinical-process"><div><p class="clinical-overline">02 / WHAT HAPPENS NEXT</p><h2>合作流程</h2><p>讓第一次接觸服務的人，知道接下來可能會發生什麼。</p></div><ol><li><details open><summary><b>01</b><strong>一般詢問</strong><span aria-hidden="true">＋</span></summary><p>可詢問服務方式、費用與可聯絡時段；一般表單請勿提交病歷或敏感資料。</p></details></li><li><details><summary><b>02</b><strong>初次會談</strong><span aria-hidden="true">＋</span></summary><p>共同釐清需求與期待；實際安排須由服務者說明。</p></details></li><li><details><summary><b>03</b><strong>後續決定</strong><span aria-hidden="true">＋</span></summary><p>討論是否繼續合作，或尋求其他合適資源。</p></details></li></ol></section>
 <section class="clinical-credentials" id="clinical-credentials"><div><p class="clinical-overline">03 / VERIFIED INFORMATION</p><h2>可核實的專業背景</h2><p>只填入真實、可查證且與提供服務相關的資歷。</p></div><dl><div><dt>專業資格</dt><dd>尚未設定</dd></div><div><dt>服務地區</dt><dd>尚未設定</dd></div><div><dt>服務時間</dt><dd>尚未設定</dd></div></dl></section>
 <section class="clinical-contact"><div><p class="clinical-overline">A CLEAR FIRST STEP</p><h2>先問一個問題，也可以。</h2></div><a href={contactHref}>查看聯絡方式 ↗</a><p>聯絡與預約服務需由站長連結真實平台。此示範不會收集個人或健康資料。</p></section>
</div>
<style>
.clinical-site{--clinical-ink:var(--ink,#18313a);--clinical-line:#cdd8d5;--clinical-blue:var(--brand,#496b78);background:var(--bg,#f4f7f5);color:var(--clinical-ink);padding:2rem clamp(1rem,4vw,4rem) 4rem;font:16px/1.85 "Noto Sans TC",Arial,sans-serif}.clinical-site section{max-width:1260px;margin-left:auto;margin-right:auto}.clinical-scope>header{display:block;padding:0;border:0;background:none}.clinical-overline{font: .78rem ui-monospace,monospace;letter-spacing:.1em;color:var(--clinical-blue)}.clinical-hero{display:grid;grid-template-columns:1.05fr .95fr;gap:6vw;align-items:center;padding:4rem 0 5.5rem}.clinical-hero h1{font-size:clamp(3.1rem,6vw,6.5rem);line-height:1.08;letter-spacing:-.06em;margin:.7rem 0 1.5rem;overflow-wrap:anywhere}.clinical-hero h1 span{display:block;font-size:.58em;font-weight:450;line-height:1.32;letter-spacing:-.03em;margin-top:.25em}.clinical-hero-copy>p:not(.clinical-overline){max-width:530px;color:#53666b}.clinical-actions{display:flex;gap:1.2rem;align-items:center;flex-wrap:wrap;margin:1.8rem 0 2.4rem}.clinical-actions a{padding:.65rem 1rem;min-height:44px;display:inline-flex;align-items:center}.clinical-primary{background:var(--clinical-ink);color:#fff;text-decoration:none}.clinical-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;padding-top:1rem;border-top:1px solid var(--clinical-line);margin:0}.clinical-meta dt{font-size:.74rem;color:#52646b}.clinical-meta dd{margin:0;font-size:.82rem;font-weight:600}.clinical-room{margin:0}.clinical-art{aspect-ratio:4/3;position:relative;overflow:hidden;background:linear-gradient(160deg,#f0eee8 0 64%,#b9c6c1 64%);border:1px solid #c6d0cb}.clinical-window{position:absolute;left:18%;top:12%;width:48%;height:55%;background:linear-gradient(130deg,#eef7f6,#dae8df);border:13px solid #fff;box-shadow:12px 12px 0 #a4b1a8}.clinical-seat{position:absolute;bottom:13%;left:25%;width:32%;height:24%;border-radius:40% 40% 12% 12%;background:#889e98;box-shadow:12px 20px 0 -8px #536b65}.clinical-seat--back{left:65%;bottom:18%;transform:scale(.8);background:#c4a58f}.clinical-floor{position:absolute;bottom:0;left:0;right:0;height:7%;background:#839891}.clinical-custom-image{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;filter:var(--brand-image-filter,none)}.clinical-hero h1,.clinical-scope h2,.clinical-process h2,.clinical-credentials h2,.clinical-contact h2{font-family:var(--brand-heading-font,"Noto Sans TC",sans-serif)}.clinical-room figcaption{font-size:.8rem;color:#53666b;margin-top:.65rem}
.clinical-scope{border-top:1px solid var(--clinical-line);padding-top:2rem;margin-bottom:5rem;display:grid;grid-template-columns:.8fr 1.2fr;gap:5vw}.clinical-scope h2,.clinical-process h2,.clinical-credentials h2,.clinical-contact h2{font-size:clamp(2.2rem,4.5vw,4.7rem);line-height:1.15;letter-spacing:-.04em}.clinical-scope h2 em{display:block;color:var(--clinical-blue);font-family:Georgia,"Noto Serif TC",serif;font-weight:400}.clinical-fit{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--clinical-line)}.clinical-fit article{padding:1.5rem}.clinical-fit article+article{background:#eaf0ed;border-left:1px solid var(--clinical-line)}.clinical-fit article>span{color:var(--clinical-blue);font-size:.8rem}.clinical-fit h3{font-size:1.15rem;line-height:1.35}.clinical-fit ul{padding-left:1.2rem}.clinical-fit p{font-size:.86rem}
.clinical-process{background:#e7eeeb;display:grid;grid-template-columns:.7fr 1.3fr;gap:6vw;padding:clamp(1.5rem,4vw,3rem);margin-bottom:5rem}.clinical-process h2{margin:.5rem 0}.clinical-process ol{list-style:none;margin:0;padding:0}.clinical-process li{border-bottom:1px solid #bfcfca;padding:1rem 0}.clinical-process summary{display:grid;grid-template-columns:50px 1fr 28px;gap:.8rem;align-items:center;min-height:44px;cursor:pointer;list-style:none}.clinical-process summary::-webkit-details-marker{display:none}.clinical-process summary span{text-align:right}.clinical-process details[open] summary span{transform:rotate(45deg)}.clinical-process li p{padding-left:calc(50px + .8rem);margin:.6rem 0}.clinical-credentials{display:grid;grid-template-columns:1fr 1fr;gap:5vw;margin-bottom:5rem}.clinical-credentials dl{margin:0}.clinical-credentials dl div{border-top:1px solid var(--clinical-line);padding:1rem 0;display:grid;grid-template-columns:140px 1fr}.clinical-credentials dd{margin:0}.clinical-contact{background:var(--clinical-ink);color:white;padding:2.5rem;display:grid;grid-template-columns:1fr auto;gap:1.2rem;align-items:center}.clinical-contact .clinical-overline{color:#b2ccc8}.clinical-contact h2{margin:.5rem 0}.clinical-contact>a{color:white}.clinical-contact>p:last-child{grid-column:1/-1;font-size:.84rem;margin:0}
@media(max-width:850px){.clinical-hero,.clinical-scope,.clinical-process,.clinical-credentials{grid-template-columns:1fr}.clinical-room{width:80%;margin-left:auto}.clinical-scope{gap:1rem}}
@media(max-width:580px){.clinical-site{padding:1rem}.clinical-hero{padding:2rem 0 3rem;gap:2rem}.clinical-hero h1{font-size:clamp(2.4rem,11vw,4.4rem)}.clinical-room{width:100%}.clinical-fit{grid-template-columns:1fr}.clinical-fit article+article{border-left:0;border-top:1px solid var(--clinical-line)}.clinical-credentials dl div{grid-template-columns:1fr;gap:.25rem}.clinical-contact{grid-template-columns:1fr;padding:1.5rem}.clinical-meta{gap:.5rem}.clinical-meta dd{font-size:.75rem}}
</style>
