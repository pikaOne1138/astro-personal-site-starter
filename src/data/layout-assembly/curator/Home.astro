---
import config from '../../../../site.config.json';
const base=import.meta.env.BASE_URL;
const nav=config.navigation.find(n=>n.id==='articles');
const action=base+(nav?.path??'articles/');
---
<div class="catalog-shell" data-assembled-layout="curator">
  <section class="catalog-hero" aria-labelledby="catalog-title">
    <div class="catalog-hero-copy"><p class="catalog-kicker">THE CURATOR'S CABINET / COLLECTION</p><h1 id="catalog-title">{config.content?.headline || "把值得留下的，整理成目錄。"}</h1><p class="catalog-brand">{config.brand.name} · {config.brand.tagline}</p><p class="catalog-intro">{config.content?.intro || "書、文章與工具，不是排行榜，而是一份附有選入理由的收藏。"}</p><a class="catalog-cta" href="#collection">進入目錄 ↓</a></div>
    <figure class="catalog-figure">{config.brand.heroImagePath?<img src={base+config.brand.heroImagePath.replace(/^\//,'')} alt={config.brand.heroImageAlt||'請補上圖片描述'}/>:<div class="catalog-art" role="img" aria-label="抽象書籍和物件展牆"></div>}<figcaption>示範視覺，可替換為自有授權照片</figcaption></figure>
  </section>
  <div class="catalog-section-list"><section class="catalog-section" id="collection"><p class="catalog-section-tag">01 / COLLECTION</p><h2>策展目錄</h2><p>01 值得一讀／02 思考工具／03 最近發現</p></section>
<section class="catalog-section" id="shelf"><p class="catalog-section-tag">02 / SHELF</p><h2>本月選集</h2><p>收藏項目有自己的分類、摘要和後續閱讀線索。</p><div class="catalog-drawers"><details><summary><span>01 / BOOK</span><strong>值得一讀</strong><span>展開收藏札記 ↓</span></summary><p>示範欄位：書名、作者與選入理由尚待站長填入。不應宣稱讀過未實際閱讀的書。</p><a href={action}>查看真實文章 ↗</a></details><details><summary><span>02 / TOOL</span><strong>思考工具</strong><span>展開評註 ↓</span></summary><p>示範欄位：工具名稱、適用情境、來源與使用紀錄由站長確認。</p></details><details><summary><span>03 / FIND</span><strong>最近發現</strong><span>展開線索 ↓</span></summary><p>示範欄位：來源網址、發現日期及為何值得收藏，正式內容待補。</p></details></div></section>
<section class="catalog-register" aria-label="收藏分類索引"><div class="catalog-register-head"><span>CATALOG / REGISTER</span><strong>INDEX 001—003</strong></div><ol>{[{n:'01',t:'書寫與閱讀',d:'以內容及來源組織收藏'},{n:'02',t:'方法與工具',d:'記錄使用情境和限制'},{n:'03',t:'最新觀察',d:'依時間保留來源與註記'}].map(item=><li><span>{item.n}</span><strong>{item.t}</strong><p>{item.d}</p><a href={action}>探索條目 ↗</a></li>)}</ol></section>
<section class="catalog-section" id="notes"><p class="catalog-section-tag">03 / NOTES</p><h2>策展札記</h2><p>記錄每件收藏物為何被留下，而不是單純羅列連結。</p><a href={action}>閱讀文章 ↗</a></section></div>
  <footer class="catalog-close"><p>版型示範內容，需要站長以真實資料替換。</p><a href={action}>前往文章入口 ↗</a></footer>
</div>
<style>
.catalog-shell{--brand:var(--brand-primary,#58746f);background:var(--bg,#f6f4ee);color:var(--ink,#292821);padding:clamp(1rem,4vw,4rem);font-family:var(--brand-body-font,system-ui,sans-serif)}
.catalog-hero{max-width:1340px;margin:0 auto 5rem;min-height:430px}. catalog-hero-copy{min-width:0}
.catalog-kicker,.catalog-section-tag{font:.7rem ui-monospace,monospace;letter-spacing:.1em;opacity:.8}
.catalog-hero h1{line-height:1.06;letter-spacing:-.05em;overflow-wrap:anywhere;font-family:var(--brand-heading-font,Georgia,serif);font-weight:500}
.catalog-intro{font-size:1.08rem;line-height:1.85;max-width:570px}
.catalog-cta{display:inline-block;margin-top:1.5rem;border-bottom:2px solid var(--brand);padding:.6rem 0;color:inherit;text-decoration:none}
.catalog-figure{margin:0;min-width:0}. catalog-figure img{width:100%;aspect-ratio:3/2;object-fit:cover}
.catalog-figure img{width:100%;aspect-ratio:3/2;object-fit:cover;filter:var(--brand-image-filter,none)}
.catalog-figure figcaption{font:.72rem ui-monospace,monospace;margin-top:.5rem}
.catalog-art{min-height:240px;aspect-ratio:3/2;display:flex;align-items:center;justify-content:center}
.catalog-section-list{max-width:1250px;margin:0 auto 4rem}
.catalog-section h2{font:500 clamp(1.75rem,3vw,3rem)/1.2 var(--brand-heading-font,Georgia,serif)}
.catalog-section p{max-width:65ch;line-height:1.85}. catalog-section a{color:inherit}
.catalog-close{max-width:1250px;margin:auto;border-top:1px solid currentColor;padding:2rem 0;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.catalog-hero{display:grid;grid-template-columns:1fr 1fr;gap:5vw;align-items:center}.catalog-hero h1{font-size:clamp(3rem,7vw,7rem)}.catalog-section-list{display:grid;grid-template-columns:.7fr 1.3fr;gap:1rem}.catalog-section:first-child{grid-row:span 2}.catalog-section{border:1px solid currentColor;padding:2rem}.catalog-art{background:linear-gradient(90deg,#c8bfae 0 32%,#747263 32% 38%,#dacbc3 38% 65%,#b5a38a 65%)}
@media(max-width:800px){.catalog-hero,.catalog-section-list{display:grid;grid-template-columns:1fr;gap:1.3rem}.catalog-hero{min-height:0}.catalog-hero h1{font-size:clamp(2.8rem,9vw,5.8rem)}.catalog-hero figure,.catalog-art{position:static;width:100%;height:auto;min-height:180px}.catalog-section,.catalog-section:nth-child(1),.catalog-section:nth-child(2),.catalog-section:nth-child(3){grid-column:auto;grid-row:auto;margin:0;min-height:auto}.catalog-section{padding:1.5rem;border:1px solid currentColor}.trust-hero{padding:1.5rem}.trust-section:before{display:none}}
@media(max-width:480px){.catalog-shell{padding:1rem}.catalog-hero h1{font-size:clamp(2.3rem,11vw,4rem)}.catalog-close{display:block}}

/* Curator prototype: typographic museum index with vertical archive and right exhibition shelves. */
.catalog-shell{background:#f6f1eb;color:#332e38;padding:0 clamp(1rem,4vw,4rem) 3rem}
.catalog-hero{max-width:1320px;padding:4rem 0;min-height:570px;grid-template-columns:1.06fr .94fr;gap:5vw;border-bottom:1px solid #605261}
.catalog-hero h1{font:500 clamp(3.8rem,8vw,7.4rem)/1.02 var(--brand-heading-font,Georgia,serif);letter-spacing:-.075em}
.catalog-hero h1::first-line{text-decoration:underline;text-decoration-color:#9a748e;text-decoration-thickness:.08em;text-underline-offset:.08em}
.catalog-kicker{color:#916c7d;letter-spacing:.15em}
.catalog-cta{border-color:#8b6d85}
.catalog-figure{transform:rotate(-1deg)}
.catalog-figure img,.catalog-art{box-shadow:15px 15px 0 #e6e0dd;min-height:340px;aspect-ratio:4/3}
.catalog-section-list{grid-template-columns:.45fr 1.55fr;gap:0 3rem;max-width:1300px;margin-top:3rem}
.catalog-section{border:0;border-bottom:1px solid #aaa1a5;padding:2rem 0}
.catalog-section:first-child{grid-row:span 2;border-top:1px solid #aaa1a5;position:relative}
.catalog-section:first-child h2{font:400 clamp(3rem,5vw,5rem)/1.1 var(--brand-heading-font,Georgia,serif)}
.catalog-section:nth-child(2){background:#eee7e8;padding:2rem;border-top:6px solid #9b718c}
.catalog-section:nth-child(3){background:#fff;padding:2rem;border-top:6px solid #6f617a}
.catalog-section h2{font:400 clamp(2rem,3.5vw,3.3rem)/1.12 var(--brand-heading-font,Georgia,serif)}
.catalog-close{border-top:1px solid #aaa1a5}
@media(max-width:800px){.catalog-hero{grid-template-columns:1fr;min-height:0}.catalog-section-list{grid-template-columns:1fr;gap:1rem}.catalog-section:first-child{grid-row:auto}.catalog-figure img,.catalog-art{min-height:180px}}
.catalog-drawers{display:grid;gap:0;margin-top:1.4rem}.catalog-drawers details{border-top:1px solid #a59ba2;padding:.8rem 0}.catalog-drawers details:last-child{border-bottom:1px solid #a59ba2}.catalog-drawers summary{display:grid;grid-template-columns:6rem 1fr auto;align-items:center;gap:.6rem;cursor:pointer;list-style:none;min-height:3rem}.catalog-drawers summary::-webkit-details-marker{display:none}.catalog-drawers summary span{font:.7rem ui-monospace,monospace}.catalog-drawers summary strong{font:500 clamp(1.1rem,2.1vw,1.7rem) var(--brand-heading-font,Georgia,serif)}.catalog-drawers details[open]{background:#fff8; padding:1rem}.catalog-drawers summary:focus-visible{outline:3px solid #8b6d85;outline-offset:3px}.catalog-drawers details>p{margin-left:6rem}.catalog-drawers details>a{margin-left:6rem}@media(max-width:560px){.catalog-drawers summary{grid-template-columns:1fr auto}.catalog-drawers summary span:first-child{grid-column:1/-1}.catalog-drawers details>p,.catalog-drawers details>a{margin-left:0}}.catalog-register{grid-column:1/-1;border:1px solid currentColor;padding:clamp(1rem,3vw,3rem);background:#e9e5dd}.catalog-register-head{display:flex;justify-content:space-between;gap:1rem;font:.75rem ui-monospace,monospace;letter-spacing:.1em;border-bottom:2px solid currentColor;padding-bottom:1rem}.catalog-register ol{list-style:none;margin:0;padding:0}.catalog-register li{display:grid;grid-template-columns:55px 1fr 1fr auto;gap:1rem;align-items:baseline;border-bottom:1px solid #a6a099;padding:1.2rem 0}.catalog-register li>span{font:1.6rem Georgia,serif}.catalog-register li>strong{font:500 clamp(1.25rem,2.5vw,2rem) Georgia,serif}.catalog-register li p{font-size:.9rem}.catalog-register li a{font-size:.8rem;white-space:nowrap}@media(max-width:750px){.catalog-register li{grid-template-columns:35px 1fr}.catalog-register li p,.catalog-register li a{grid-column:2}}
.catalog-hero{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);align-items:center;min-height:clamp(500px,68vh,820px)}.catalog-hero h1{font-size:clamp(4.1rem,8vw,8rem);max-width:10ch;line-height:1.03}.catalog-figure{max-width:480px;justify-self:center;width:90%;transform:rotate(-2deg);background:#fdfbf7;padding:.75rem;box-shadow:18px 18px 0 #e4d9d0,0 0 0 1px #8b7981}.catalog-figure img,.catalog-art{width:100%;aspect-ratio:4/5;min-height:0;object-fit:cover}.catalog-art{background:repeating-linear-gradient(0deg,#dfd5ca 0 28px,#a0918c 29px 32px,#f2ebe0 33px 62px)}.catalog-figure figcaption{text-align:right;padding-top:.75rem}@media(max-width:800px){.catalog-hero{grid-template-columns:1fr;min-height:0}.catalog-figure{width:min(75%,430px);justify-self:end}}@media(max-width:480px){.catalog-figure{width:87%}}</style>