---
import config from '../../../../site.config.json';
import {getCollection} from 'astro:content';
const base=import.meta.env.BASE_URL;
const entries=config.navigation.some(n=>n.id==='articles')?(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.publishedAt-a.data.publishedAt):[];
const articleHref=entry=>base+'articles/'+entry.id+'/';
const headline=config.content?.headline||config.brand.name;
const intro=config.content?.intro||'首頁介紹待站長提供。';
const nav=config.navigation.find(n=>n.id===config.primaryCta.pageId);
const action=base+(nav?.path??config.primaryCta.pageId+'/');
const pendingDrawers=[{title:'值得一讀',note:'書籍與文章的選入理由待站長提供。'},{title:'思考工具',note:'工具與實際使用經驗待站長提供。'},{title:'最近發現',note:'收藏項目與來源待站長提供。'}];
const drawers=entries.length?entries.slice(0,3).map(entry=>({title:entry.data.title,note:entry.data.description,href:articleHref(entry)})):pendingDrawers;
---
<div class="cu-site" data-assembled-layout="curator" data-long-headline={(config.content?.headline||config.brand.name).length>32}>
<section class="cu-hero"><div class="cu-hero-copy"><p class="cu-kicker">THE COLLECTION / PERSONAL CABINET</p><h1>{headline}</h1><p>{intro}</p><a href="#collection" class="cu-enter">進入收藏目錄 ↓</a></div><figure class="cu-still">{config.brand.heroImagePath?<img src={base+config.brand.heroImagePath.replace(/^\//,'')} alt={config.brand.heroImageAlt||'請填入圖片描述'}/>:<div class="cu-owned-placeholder" aria-label="待設定收藏主視覺"><span>OBJECTS<br/>/ IDEAS</span><b>01</b></div>}<figcaption>{config.brand.heroImagePath?'站長提供的主視覺':'收藏展牆示意 · 可替換為自有圖片'}</figcaption></figure><span class="cu-stamp" aria-hidden="true">CABINET<br/>OF IDEAS</span></section>
<section class="cu-catalog" id="collection"><aside class="cu-index"><p class="cu-kicker">INDEX / 03</p><h2>收藏目錄</h2><ol>{drawers.map((item,i)=><li><a href={'#drawer-'+i}>{String(i+1).padStart(2,'0')} / {item.title}</a></li>)}</ol><p class="cu-index-note">保存選擇的理由。以下為待填內容，不代表站長已推薦任何書籍或工具。</p></aside><div class="cu-shelves" id="shelf"><div class="cu-shelf-head"><p>COLLECTION / NOTES</p><span>{config.brand.name}</span></div>{drawers.slice(0,1).map((item,i)=><details id={'drawer-'+i} class="cu-featured"><summary class="cu-featured-summary"><span class="cu-object-no">{String(i+1).padStart(2,'0')}</span><div><p class="cu-label">{item.href?'ARTICLE / COLLECTION':'待設定 / COLLECTION'}</p><h3>{item.title}</h3><p>{item.note}</p></div><div class="cu-cover" aria-hidden="true"><span>NOTE<br/>{String(i+1).padStart(2,'0')}</span><b>{item.href?'文':'待'}<br/>{item.href?'章':'填'}</b></div></summary><div class="cu-drawer-body"><p>{item.href?'閱讀作者提供的完整內容。':'填入真實收藏、選入理由與來源後，可延伸為完整文章。'}</p><a href={item.href||action}>{item.href?'閱讀完整文章':config.primaryCta.label} ↗</a></div></details>)}<div class="cu-object-row">{drawers.slice(1).map((item,i)=><article id={'drawer-'+(i+1)}><span>{String(i+2).padStart(2,'0')} / {item.href?'ARTICLE':'待設定'}</span><h3>{item.title}</h3><p>{item.note}</p><a href={item.href||action}>{item.href?'閱讀完整文章':config.primaryCta.label} ↗</a></article>)}</div></div></section>
</div>
<style>

.cu-site{--cu-ink:var(--color-content);--cu-plum:var(--color-primary);--cu-paper:var(--color-surface);--cu-gold:color-mix(in srgb,var(--color-accent) 70%,var(--color-content));background:var(--cu-paper);color:var(--cu-ink);min-height:100vh;padding:0 clamp(1rem,4vw,4rem) 2rem;font-family:var(--font-heading)}.cu-header{height:88px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--color-line)}.cu-wordmark{font-size:.85rem;line-height:.92;letter-spacing:.04em;text-decoration:none;color:var(--cu-plum)}.cu-wordmark span{font: .5rem var(--font-mono);letter-spacing:.2em}.cu-header nav{display:flex;gap:1.6rem;font: .75rem var(--font-mono)}.cu-header nav a{text-decoration:none}.cu-edition{font: .6rem var(--font-mono);color:var(--color-content-muted)}.cu-hero{position:relative;max-width:1300px;margin:0 auto;min-height:560px;display:grid;grid-template-columns:1fr .85fr;align-items:center;gap:6vw;padding:5rem 0}.cu-kicker,.cu-label{font: .75rem var(--font-mono);letter-spacing:.14em;color:var(--cu-plum);text-transform:uppercase}.cu-hero h1{font-size:clamp(4.2rem,9vw,9rem);line-height:.9;letter-spacing:-.08em;font-weight:400;margin:.8rem 0 1.3rem}.cu-hero h1 i{font-weight:400;color:var(--cu-plum)}.cu-hero-copy>p:not(.cu-kicker){max-width:440px;line-height:1.85;color:var(--color-content-muted)}.cu-enter{display:inline-block;margin-top:1.2rem;font: .7rem var(--font-mono);color:var(--cu-plum);border-bottom:1px solid var(--cu-gold);padding-bottom:.4rem;text-decoration:none}.cu-enter span{margin-left:.9rem;color:var(--cu-gold)}.cu-still{margin:0;transform:rotate(1.8deg);background:var(--color-surface);padding:.7rem .7rem 2.2rem;box-shadow:0 18px 50px color-mix(in srgb,var(--cu-ink) 10%,transparent)}.cu-still img{width:100%;aspect-ratio:3/2;object-fit:cover}.cu-still figcaption{font: .75rem var(--font-mono);color:var(--color-content-muted);padding:.7rem .2rem 0}.cu-stamp{position:absolute;right:37%;bottom:3.4rem;display:grid;place-items:center;width:94px;height:94px;border:1px solid var(--cu-gold);border-radius:50%;font: .75rem var(--font-mono);color:var(--cu-gold);text-align:center;line-height:1.5;transform:rotate(-13deg)}.cu-catalog{max-width:1300px;margin:0 auto 6rem;border-top:1px solid color-mix(in srgb,var(--cu-ink) 28%,var(--cu-paper));padding-top:1.5rem;display:grid;grid-template-columns:260px 1fr;gap:5vw}.cu-index h2{font-size:3rem;line-height:.9;letter-spacing:-.07em;margin:.6rem 0 1.7rem}.cu-index ol{list-style:none;padding:0;margin:0}.cu-index li{border-top:1px solid var(--color-line);padding:.75rem 0;font: .75rem var(--font-mono)}.cu-index a{text-decoration:none}.cu-index-note{font-size:.8rem;line-height:1.7;color:var(--color-content-muted);max-width:220px;margin-top:2rem}.cu-shelf-head{display:flex;justify-content:space-between;border-bottom:1px solid color-mix(in srgb,var(--cu-ink) 28%,var(--cu-paper));padding:.3rem 0 .6rem;font: .75rem var(--font-mono);color:var(--color-content-muted)}.cu-featured{display:block;border-bottom:1px solid color-mix(in srgb,var(--cu-ink) 28%,var(--cu-paper));padding:1.5rem 0}.cu-featured-summary{position:relative;display:grid;grid-template-columns:42px 1fr 170px;gap:1.2rem;align-items:center;padding-right:2rem;cursor:pointer;list-style:none}.cu-featured-summary::-webkit-details-marker{display:none}.cu-featured-summary::marker{content:""}.cu-featured-summary::after{content:"＋";position:absolute;right:.15rem;top:45%;font: .8rem var(--font-mono);color:var(--cu-plum)}.cu-featured[open] .cu-featured-summary::after{content:"−"}.cu-drawer-body{margin:.8rem 0 0 3.3rem;padding:.9rem 0 .2rem;border-top:1px dashed color-mix(in srgb,var(--cu-ink) 28%,var(--cu-paper));display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center}.cu-drawer-body p{font-size:.82rem;line-height:1.7;color:color-mix(in srgb,var(--cu-ink) 88%,var(--cu-paper));margin:0}.cu-object-no{font: .75rem var(--font-mono);color:var(--cu-gold);align-self:start}.cu-featured h3,.cu-object-row h3{font-size:1.6rem;line-height:1.08;font-weight:400;margin:.4rem 0}.cu-featured p:not(.cu-label),.cu-object-row p{font-size:.82rem;line-height:1.7;color:var(--color-content-muted)}.cu-featured a,.cu-object-row a{font: .75rem var(--font-mono);color:var(--cu-plum)}.cu-cover{width:150px;height:196px;box-shadow:8px 8px 0 color-mix(in srgb,var(--cu-ink) 22%,var(--cu-paper));display:flex;justify-content:space-between;padding:.7rem;background:var(--cu-plum);color:var(--color-on-primary)}.cu-cover--one b{font-size:1.2rem;line-height:1.05;letter-spacing:.1em}.cu-cover span{font: .75rem var(--font-mono)}.cu-object-row{display:grid;grid-template-columns:1fr 1fr}.cu-object-row article{padding:1.3rem 1rem 1rem 0;border-right:1px solid var(--color-line)}.cu-object-row article+article{padding-left:1.3rem;border-right:0}.cu-object-row article>span{font: .75rem var(--font-mono);color:var(--cu-gold)}.cu-object-row h3{font-size:1.2rem}.cu-footer{max-width:1300px;margin:auto;border-top:1px solid var(--color-line);padding:1rem 0;display:flex;justify-content:space-between;gap:1rem;font: .75rem var(--font-mono);color:var(--color-content-muted)}.cu-footer a{color:var(--cu-plum)}@media(max-width:800px){.cu-hero{grid-template-columns:1fr 1fr;gap:2rem}.cu-stamp{right:40%;bottom:2rem}.cu-catalog{grid-template-columns:200px 1fr;gap:2rem}.cu-featured{grid-template-columns:30px 1fr 120px}.cu-cover{width:110px;height:160px}}@media(max-width:600px){.cu-header{height:auto;padding:1rem 0;align-items:flex-start;gap:1rem;flex-wrap:wrap}.cu-header nav{order:3;width:100%;gap:.8rem;font-size:.75rem}.cu-hero{grid-template-columns:1fr;padding:3.5rem 0;gap:2rem}.cu-hero h1{font-size:17vw}.cu-still{width:85%;margin-left:auto}.cu-stamp{right:4%;bottom:1rem;width:74px;height:74px}.cu-catalog{grid-template-columns:1fr;gap:1rem}.cu-index ol{display:flex;flex-wrap:wrap;gap:.5rem 1rem}.cu-index li{border-top:0;padding:.2rem 0}.cu-index-note{max-width:100%;margin:1rem 0}.cu-featured-summary{grid-template-columns:28px 1fr 88px;gap:.6rem}.cu-drawer-body{margin-left:2.4rem;grid-template-columns:1fr;gap:.5rem}.cu-cover{width:82px;height:128px}.cu-featured h3{font-size:1.25rem}.cu-object-row{grid-template-columns:1fr}.cu-object-row article,.cu-object-row article+article{padding:1rem 0;border-right:0;border-bottom:1px solid var(--color-line)}.cu-footer{flex-direction:column}}

.cu-hero h1{font-family:var(--font-heading);line-height:1.08;letter-spacing:-.04em;text-wrap:balance}.cu-owned-placeholder{aspect-ratio:3/2;background:var(--cu-plum);color:var(--cu-paper);padding:2rem;display:flex;justify-content:space-between;align-items:end;font:400 clamp(1.5rem,4vw,4rem)/1.1 var(--font-heading)}.cu-owned-placeholder b{font-size:2em;font-weight:400}.cu-site :is(h2,h3){line-height:1.15;letter-spacing:-.04em}.cu-cover b{font-weight:400;font-size:1.2rem}.cu-featured-summary{min-width:0;grid-template-columns:42px minmax(0,1fr) 170px}.cu-featured-summary:focus-visible{outline:3px solid var(--cu-plum);outline-offset:4px}.cu-index a{display:inline-flex;align-items:center;min-height:44px}.cu-index{min-width:0}@media(max-width:900px){.cu-catalog{grid-template-columns:200px minmax(0,1fr)}.cu-featured-summary{grid-template-columns:30px minmax(0,1fr) 88px}.cu-cover{width:82px;height:128px}}@media(max-width:600px){.cu-catalog{grid-template-columns:minmax(0,1fr)}.cu-stamp{display:none}.cu-featured-summary{grid-template-columns:28px minmax(0,1fr)}.cu-cover{display:none}.cu-hero h1{font-size:clamp(2.8rem,12vw,5rem)}}
@media(max-width:600px){.cu-featured p:not(.cu-label),.cu-object-row p{font-size:1rem}.cu-featured a,.cu-object-row a{font-size:.875rem;display:inline-flex;align-items:center;min-height:44px}}
</style>
