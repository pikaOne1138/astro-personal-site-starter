---
import config from '../../../../site.config.json';
const {entry,previous=null,next=null}=Astro.props;
const family=config.layoutSlug;
const published=entry.data.publishedAt.toLocaleDateString('zh-TW');
const tags=entry.data.tags??[];
const base=import.meta.env.BASE_URL;
---
<div class="story-frame" data-story-family={family}>
  <div class="story-top"><a href={base+'articles/'}>← 文章目錄</a><span>{published}</span></div>
  {family==='essayist'&&<div class="story-issue"><span>THE LONG READ / ISSUE</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="story-issue-rule">— ARTICLE / {published}</div></div>}
  {family==='curator'&&<div class="story-object"><aside><span>CATALOG / RECORD</span><b>01</b><span>{published}</span></aside><div><span>SELECTED OBJECT</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div></div>}
  {family==='field-notes'&&<div class="story-field"><aside>FIELD ENTRY <strong>№ 01</strong><span>OBSERVATION / {published}</span></aside><div><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div></div>}
  {family==='learning-lab'&&<div class="story-lab"><span>LEARNING NOTE / EXPERIMENT</span><div class="story-lab-counter">01 / STUDY</div><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div>}
  {family==='radio-letter'&&<div class="story-broadcast"><span>ON AIR / TRANSCRIPT & NOTES</span><div class="story-broadcast-label">◉ &nbsp; RADIO LETTER</div><h1>{entry.data.title}</h1><p>{entry.data.description}</p><small>此篇是文字內容；未提供音訊時不顯示播放器。</small></div>}
  {family==='reading-atlas'&&<div class="story-almanac"><div><span>READING / INDEX</span><strong>{entry.data.publishedAt.getFullYear()}</strong></div><div><span>ENTRY / {published}</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div></div>}
  {family==='clinician'&&<div class="story-clinical"><aside>PROFESSIONAL NOTES / {published}<span>閱讀前先了解本文範圍</span></aside><div><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div></div>}
  {family==='companion'&&<div class="story-letter"><span>A LETTER / PERSONAL WRITING</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="story-letter-mark" aria-hidden="true">—</div></div>}
  {family==='somatic'&&<div class="story-somatic"><span>BODY / RHYTHM / JOURNAL</span><div class="story-somatic-space" aria-hidden="true">○</div><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div>}
  {family==='coach'&&<div class="story-action"><div class="story-action-index">WORK / 01</div><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div>}
  {family==='collective'&&<div class="story-collective"><span>COLLECTIVE JOURNAL / MULTIPLE PERSPECTIVES</span><div class="story-collective-grid"><div><strong>01 / NOTES</strong><p>{published}</p></div><div><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div></div></div>}
  {family==='trust-path'&&<div class="story-trust"><div class="story-trust-waypoint"><span>01</span><span>KNOW BEFORE DECIDING</span></div><div><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div></div>}
  <div class="story-reading"><aside class="story-marginal"><span>READING / {published}</span>{tags.length>0&&<ul>{tags.map(tag=><li>{tag}</li>)}</ul>}</aside><article class="story-prose"><slot /></article></div>
  <nav class="story-neighbors" aria-label="其他文章">{previous?<a href={base+'articles/'+previous.id+'/'}><span>← 較早的文章</span><strong>{previous.data.title}</strong></a>:<span class="story-neighbor-empty">沒有更早的文章</span>}{next?<a href={base+'articles/'+next.id+'/'}><span>較新的文章 →</span><strong>{next.data.title}</strong></a>:<span class="story-neighbor-empty">沒有更新的文章</span>}</nav>
  <footer class="story-end"><span>END OF ARTICLE</span><a href={base+'articles/'}>返回文章目錄 ↗</a></footer>
</div>
<style>
.story-frame{--sr:color-mix(in srgb,currentColor 25%,transparent);color:inherit;max-width:1320px;margin:0 auto}.story-top,.story-end{display:flex;justify-content:space-between;gap:1rem;font:.73rem/1.5 ui-monospace,monospace;letter-spacing:.1em;border-bottom:1px solid var(--sr);padding:1rem 0}.story-end{border-bottom:0;border-top:1px solid var(--sr);margin-top:4rem}.story-frame a{text-underline-offset:.3em}.story-frame h1{font:500 clamp(2.6rem,5vw,5.5rem)/1.13 var(--student-family-heading-font);letter-spacing:-.06em;margin:.6em 0 .35em}.story-frame p{line-height:1.85}.story-reading{display:grid;grid-template-columns:minmax(0,145px) minmax(0,720px);gap:clamp(1.5rem,6vw,6rem);justify-content:center;padding:clamp(2rem,5vw,5rem) 0}.story-marginal{font:.72rem/1.7 ui-monospace,monospace;letter-spacing:.06em}.story-marginal ul{list-style:none;padding:0}.story-marginal li{border-top:1px solid var(--sr);padding:.7rem 0}.story-prose{font-size:1.1rem;line-height:2;min-width:0;overflow-wrap:anywhere}.story-prose :global(h2){font-size:clamp(1.7rem,3vw,2.7rem);margin-top:2.3em}.story-prose :global(img){height:auto;max-width:100%}.story-prose :global(blockquote){border-left:3px solid currentColor;padding:0 1.5rem;margin:2rem 0;font-style:italic}.story-issue{border-bottom:3px double currentColor;padding:4rem 0;max-width:950px;margin:auto;text-align:center}.story-issue>span,.story-object span,.story-field aside,.story-lab span,.story-broadcast span,.story-almanac span,.story-helper span{font:.74rem ui-monospace,monospace;letter-spacing:.12em}.story-issue h1{display:block;font:400 clamp(3.6rem,8vw,8.5rem)/1.05 Georgia,serif;letter-spacing:-.08em;margin:1rem 0}.story-issue p{max-width:52ch;margin:2rem auto;font-size:1.2rem}.story-issue-rule{font:.76rem ui-monospace,monospace}.story-object,.story-field,.story-almanac{display:grid;grid-template-columns:minmax(110px,25%) 1fr;gap:clamp(1rem,4vw,4rem);border-bottom:1px solid var(--sr);padding:3rem 0}.story-object aside,.story-field aside,.story-almanac>div:first-child{display:flex;flex-direction:column;justify-content:space-between;gap:2rem;border-right:1px solid var(--sr);padding-right:1rem}.story-object aside b,.story-field aside strong,.story-almanac strong{font:400 clamp(3rem,7vw,7rem)/1 Georgia,serif}.story-lab{padding:clamp(2rem,4vw,4rem);border:5px solid currentColor;margin:2rem 0}.story-lab h2{font-family:system-ui,sans-serif;font-weight:900;text-transform:uppercase}.story-lab-counter{font:800 clamp(2rem,5vw,5rem)/1 system-ui;letter-spacing:-.07em;margin:2rem 0}.story-broadcast{padding:4rem 0;border-bottom:2px dashed currentColor}.story-broadcast-label{border:1px solid currentColor;padding:1rem;display:inline-block;margin-top:2rem;font:.9rem ui-monospace,monospace}.story-broadcast small{display:block}.story-almanac strong{letter-spacing:-.08em}.story-helper{padding:3rem 0;border-bottom:2px solid var(--sr)}.story-frame[data-story-family="companion"] .story-reading{grid-template-columns:minmax(0,630px)}.story-frame[data-story-family="companion"] .story-marginal{display:none}.story-frame[data-story-family="coach"] .story-helper h1{font:900 clamp(3rem,7vw,7rem)/1 system-ui,sans-serif;text-transform:uppercase}.story-frame[data-story-family="trust-path"] .story-helper{border-left:5px solid currentColor;padding-left:2rem}.story-frame[data-story-family="somatic"] .story-reading{grid-template-columns:minmax(0,600px)}.story-frame[data-story-family="somatic"] .story-marginal{display:none}.story-frame[data-story-family="collective"] .story-helper{border:3px solid currentColor;padding:3rem}
@media(max-width:760px){.story-reading,.story-object,.story-field,.story-almanac{grid-template-columns:1fr}.story-marginal{border-bottom:1px solid var(--sr);padding-bottom:1rem}.story-object aside,.story-field aside,.story-almanac>div:first-child{border:0;border-bottom:1px solid var(--sr);flex-direction:row;align-items:baseline}.story-frame h1{font-size:clamp(2.3rem,9vw,4rem)}.story-issue h1{font-size:clamp(3rem,12vw,5rem)}}
.story-neighbors{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--sr);margin:3rem 0}.story-neighbors>a,.story-neighbor-empty{padding:1.5rem;background:var(--bg);display:flex;flex-direction:column;gap:.7rem;min-width:0}.story-neighbors a>span,.story-neighbor-empty{font:.8rem/1.6 ui-monospace,monospace}.story-neighbors strong{font:500 clamp(1.1rem,2vw,1.8rem)/1.3 var(--student-family-heading-font);overflow-wrap:anywhere}@media(max-width:600px){.story-neighbors{grid-template-columns:1fr}}.story-clinical,.story-collective-grid,.story-trust{display:grid;grid-template-columns:minmax(130px,27%) 1fr;gap:clamp(1.5rem,4vw,4rem);padding:3rem 0;border-bottom:2px solid var(--sr)}.story-clinical aside{display:flex;flex-direction:column;gap:2rem;font:.75rem ui-monospace,monospace;letter-spacing:.09em;border-right:1px solid var(--sr)}.story-letter{max-width:770px;margin:4rem auto;text-align:left;padding:2.5rem clamp(1.5rem,4vw,4rem);border-left:1px solid var(--sr)}.story-letter>span,.story-somatic>span,.story-action-index,.story-collective>span,.story-trust-waypoint{font:.75rem ui-monospace,monospace;letter-spacing:.12em}.story-letter h1{font-style:italic;font-weight:400}.story-letter-mark{font:400 5rem Georgia,serif;opacity:.4}.story-somatic{padding:3rem 0 5rem;text-align:center}.story-somatic-space{font:300 clamp(7rem,20vw,17rem)/1 Georgia,serif;opacity:.25;padding:2rem 0}.story-somatic h1,.story-somatic p{max-width:770px;margin:1rem auto}.story-action{border-top:10px solid currentColor;border-bottom:10px solid currentColor;padding:3rem 0;margin:2rem 0}.story-action-index{font-size:1rem}.story-action h1{font:900 clamp(3.2rem,8vw,8rem)/.98 system-ui,sans-serif;text-transform:uppercase;letter-spacing:-.09em}.story-collective{border:3px solid currentColor;padding:clamp(1rem,3vw,3rem);margin-top:2rem}.story-collective-grid{border:0;padding:1.5rem 0 0}.story-collective-grid strong{font:700 1.4rem system-ui,sans-serif}.story-trust{grid-template-columns:90px 1fr;margin-top:3rem}.story-trust-waypoint{display:flex;flex-direction:column;gap:1.5rem;border-right:3px solid currentColor;padding-right:1rem}.story-trust-waypoint span:first-child{font:400 3rem Georgia,serif}@media(max-width:760px){.story-clinical,.story-collective-grid,.story-trust{grid-template-columns:1fr}.story-clinical aside,.story-trust-waypoint{border-right:0;border-bottom:1px solid var(--sr);padding-bottom:1rem}.story-somatic-space{padding:1rem 0}}.story-frame{box-sizing:border-box;padding:clamp(2rem,5vw,5rem) clamp(1rem,4vw,4rem)}.story-frame h1,.story-issue h1,.story-action h1{font-family:var(--student-family-heading-font);line-height:1.12;letter-spacing:-.04em;text-wrap:balance}.story-frame[data-story-family="learning-lab"] h1,.story-frame[data-story-family="coach"] h1,.story-frame[data-story-family="collective"] h1{font-family:var(--student-family-body-font);font-weight:800}.story-frame[data-story-family="essayist"] .story-reading{grid-template-columns:minmax(0,720px) 145px}.story-frame[data-story-family="essayist"] .story-prose{grid-row:1;grid-column:1}.story-frame[data-story-family="essayist"] .story-marginal{grid-column:2}.story-frame[data-story-family="curator"] .story-reading{grid-template-columns:190px minmax(0,650px)}.story-frame[data-story-family="reading-atlas"] .story-reading{grid-template-columns:130px minmax(0,720px)}.story-frame[data-story-family="learning-lab"] .story-prose{border-left:4px solid currentColor;padding-left:2rem}.story-frame[data-story-family="radio-letter"] .story-reading{border-block:1px dashed currentColor}.story-frame[data-story-family="coach"] .story-reading{border-top:5px solid currentColor}.story-frame :is(.story-top,.story-end,.story-marginal){font-size:.75rem}.story-frame .story-top a,.story-frame .story-end a{display:inline-flex;align-items:center;min-height:44px}.story-prose :global(pre){overflow-x:auto;max-width:100%;padding:1rem;border:1px solid var(--sr)}.story-prose :global(table){display:block;max-width:100%;overflow-x:auto}.story-prose :global(th),.story-prose :global(td){padding:.5rem;border:1px solid var(--sr)}.story-prose :global(h2),.story-prose :global(h3){line-height:1.3;letter-spacing:-.02em}.story-neighbors{background:none;border-block:1px solid var(--sr);gap:0}.story-neighbors>a,.story-neighbor-empty{background:transparent}.story-neighbors>a+ a,.story-neighbors>*+*{border-left:1px solid var(--sr)}@media(max-width:760px){.story-frame[data-story-family] .story-reading{grid-template-columns:minmax(0,1fr)}.story-frame[data-story-family="essayist"] .story-prose,.story-frame[data-story-family="essayist"] .story-marginal{grid-column:1;grid-row:auto}.story-frame h1,.story-issue h1,.story-action h1{font-size:clamp(2rem,8vw,4rem)}.story-frame[data-story-family="learning-lab"] .story-prose{padding-left:1rem}.story-letter{padding:1.5rem 1rem}.story-lab{padding:1rem}.story-somatic-space{font-size:7rem}.story-clinical aside{padding-right:1rem}}@media(max-width:600px){.story-neighbors>*+*{border-left:0;border-top:1px solid var(--sr)}}
</style>
