---
import config from '../../../../site.config.json';
const {entry}=Astro.props;
const family=config.layoutSlug;
const published=entry.data.publishedAt.toLocaleDateString('zh-TW');
const tags=entry.data.tags??[];
const base=import.meta.env.BASE_URL;
---
<div class="story-frame" data-story-family={family}>
  <div class="story-top"><a href={base+'articles/'}>← 文章目錄</a><span>{published}</span></div>
  {family==='essayist'&&<div class="story-issue"><span>THE LONG READ / ISSUE</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="story-issue-rule">— ARTICLE / {published}</div></div>}
  {family==='curator'&&<div class="story-object"><aside><span>CATALOG / RECORD</span><b>01</b><span>{published}</span></aside><div><span>SELECTED OBJECT</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div></div>}
  {family==='field-notes'&&<div class="story-field"><aside>FIELD ENTRY <strong>№ 01</strong><span>OBSERVATION / {published}</span></aside><div><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div></div>}
  {family==='learning-lab'&&<div class="story-lab"><span>LEARNING NOTE / EXPERIMENT</span><div class="story-lab-counter">01 / STUDY</div><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div>}
  {family==='radio-letter'&&<div class="story-broadcast"><span>ON AIR / TRANSCRIPT & NOTES</span><div class="story-broadcast-label">◉ &nbsp; RADIO LETTER</div><h1>{entry.data.title}</h1><p>{entry.data.description}</p><small>此篇是文字內容；未提供音訊時不顯示播放器。</small></div>}
  {family==='reading-atlas'&&<div class="story-almanac"><div><span>READING / INDEX</span><strong>{entry.data.publishedAt.getFullYear()}</strong></div><div><span>ENTRY / {published}</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div></div>}
  {config.kind==='helper'&&<div class="story-helper"><span>{family==='coach'?'WORKING NOTES':family==='companion'?'A QUIET NOTE':family==='somatic'?'BODY & RHYTHM':family==='collective'?'COLLECTIVE JOURNAL':family==='trust-path'?'KNOW BEFORE DECIDING':'PROFESSIONAL NOTES'}</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div>}
  <div class="story-reading"><aside class="story-marginal"><span>READING / {published}</span>{tags.length>0&&<ul>{tags.map(tag=><li>{tag}</li>)}</ul>}</aside><article class="story-prose"><slot /></article></div>
  <footer class="story-end"><span>END OF ARTICLE</span><a href={base+'articles/'}>返回文章目錄 ↗</a></footer>
</div>
<style>
.story-frame{--sr:color-mix(in srgb,currentColor 25%,transparent);color:inherit;max-width:1320px;margin:0 auto}.story-top,.story-end{display:flex;justify-content:space-between;gap:1rem;font:.73rem/1.5 ui-monospace,monospace;letter-spacing:.1em;border-bottom:1px solid var(--sr);padding:1rem 0}.story-end{border-bottom:0;border-top:1px solid var(--sr);margin-top:4rem}.story-frame a{text-underline-offset:.3em}.story-frame h1{font:500 clamp(2.6rem,5vw,5.5rem)/1.13 var(--brand-heading-font,Georgia,serif);letter-spacing:-.06em;margin:.6em 0 .35em}.story-frame p{line-height:1.85}.story-reading{display:grid;grid-template-columns:minmax(0,145px) minmax(0,720px);gap:clamp(1.5rem,6vw,6rem);justify-content:center;padding:clamp(2rem,5vw,5rem) 0}.story-marginal{font:.72rem/1.7 ui-monospace,monospace;letter-spacing:.06em}.story-marginal ul{list-style:none;padding:0}.story-marginal li{border-top:1px solid var(--sr);padding:.7rem 0}.story-prose{font-size:1.1rem;line-height:2;min-width:0;overflow-wrap:anywhere}.story-prose :global(h2){font-size:clamp(1.7rem,3vw,2.7rem);margin-top:2.3em}.story-prose :global(img){height:auto;max-width:100%}.story-prose :global(blockquote){border-left:3px solid currentColor;padding:0 1.5rem;margin:2rem 0;font-style:italic}.story-issue{border-bottom:3px double currentColor;padding:4rem 0;max-width:950px;margin:auto;text-align:center}.story-issue>span,.story-object span,.story-field aside,.story-lab span,.story-broadcast span,.story-almanac span,.story-helper span{font:.74rem ui-monospace,monospace;letter-spacing:.12em}.story-issue h1{display:block;font:400 clamp(3.6rem,8vw,8.5rem)/1.05 Georgia,serif;letter-spacing:-.08em;margin:1rem 0}.story-issue p{max-width:52ch;margin:2rem auto;font-size:1.2rem}.story-issue-rule{font:.76rem ui-monospace,monospace}.story-object,.story-field,.story-almanac{display:grid;grid-template-columns:minmax(110px,25%) 1fr;gap:clamp(1rem,4vw,4rem);border-bottom:1px solid var(--sr);padding:3rem 0}.story-object aside,.story-field aside,.story-almanac>div:first-child{display:flex;flex-direction:column;justify-content:space-between;gap:2rem;border-right:1px solid var(--sr);padding-right:1rem}.story-object aside b,.story-field aside strong,.story-almanac strong{font:400 clamp(3rem,7vw,7rem)/1 Georgia,serif}.story-lab{padding:clamp(2rem,4vw,4rem);border:5px solid currentColor;margin:2rem 0}.story-lab h2{font-family:system-ui,sans-serif;font-weight:900;text-transform:uppercase}.story-lab-counter{font:800 clamp(2rem,5vw,5rem)/1 system-ui;letter-spacing:-.07em;margin:2rem 0}.story-broadcast{padding:4rem 0;border-bottom:2px dashed currentColor}.story-broadcast-label{border:1px solid currentColor;padding:1rem;display:inline-block;margin-top:2rem;font:.9rem ui-monospace,monospace}.story-broadcast small{display:block}.story-almanac strong{letter-spacing:-.08em}.story-helper{padding:3rem 0;border-bottom:2px solid var(--sr)}.story-frame[data-story-family="companion"] .story-reading{grid-template-columns:minmax(0,630px)}.story-frame[data-story-family="companion"] .story-marginal{display:none}.story-frame[data-story-family="coach"] .story-helper h1{font:900 clamp(3rem,7vw,7rem)/1 system-ui,sans-serif;text-transform:uppercase}.story-frame[data-story-family="trust-path"] .story-helper{border-left:5px solid currentColor;padding-left:2rem}.story-frame[data-story-family="somatic"] .story-reading{grid-template-columns:minmax(0,600px)}.story-frame[data-story-family="somatic"] .story-marginal{display:none}.story-frame[data-story-family="collective"] .story-helper{border:3px solid currentColor;padding:3rem}
@media(max-width:760px){.story-reading,.story-object,.story-field,.story-almanac{grid-template-columns:1fr}.story-marginal{border-bottom:1px solid var(--sr);padding-bottom:1rem}.story-object aside,.story-field aside,.story-almanac>div:first-child{border:0;border-bottom:1px solid var(--sr);flex-direction:row;align-items:baseline}.story-frame h1{font-size:clamp(2.3rem,9vw,4rem)}.story-issue h1{font-size:clamp(3rem,12vw,5rem)}}
</style>
