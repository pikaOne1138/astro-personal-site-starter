---
import config from '../../../../site.config.json';
const base=import.meta.env.BASE_URL;
const articles=config.navigation.find(n=>n.id==='articles');
const cta=articles ? base+(articles.path??'articles/') : base+'about/';
---
<div class="field-site" data-assembled-layout="field-notes">
 <div class="field-top"><span class="field-brand">{config.brand.name}<small>FIELD / NOTES</small></span><span class="field-volume">PERSONAL JOURNAL / FIELD NOTES</span></div>
 <div class="field-frame">
  <aside class="field-rail"><b>01—03</b><span>INDEX</span><a href="#field-ledger">近期筆記</a><a href="#field-question">持續提問</a></aside>
  <section class="field-hero" aria-labelledby="field-title"><p class="field-kicker">一種慢慢觀看世界的方法</p><h1 id="field-title">{config.content?.headline || config.brand.name}<em>{config.brand.tagline}</em></h1><p class="field-intro">{config.content?.intro || "這是你的個人觀察與知識筆記。把真實經驗、閱讀與尚未解開的問題，一點一點整理成文章。"}</p><div class="field-tags"><span>田野觀察</span><span>閱讀札記</span><span>研究問題</span></div><figure class="field-figure">{config.brand.heroImagePath?<img class="field-custom-image" src={base+config.brand.heroImagePath.replace(/^\//,'')} alt={config.brand.heroImageAlt||'網站主視覺，請填寫替代文字'} />:<div class="field-graphic" role="img" aria-label="以植物形狀及紙張線條構成的示意插畫，非實際照片"><span>FIELD<br/>RECORD</span></div>}<figcaption>FIG. 01 / 可替換為自己擁有授權的觀察照片</figcaption></figure></section>
  <aside class="field-margin"><b>MARGIN NOTE / 01</b><p>「一個準確的問題，有時比快速的答案更值得留下。」</p><small>示範文案，請替換</small></aside>
 </div>
 <section class="field-ledger" id="field-ledger"><div><p class="field-kicker">FIELD LEDGER / RECENT ENTRIES</p><h2>最近，我在留意這些事。</h2><p>文章列表將依據正式內容更新。</p></div><div class="field-entries"><a href={cta}><span>01</span><strong>閱讀與觀察記錄</strong><span>閱讀文章 ↗</span></a><a href={cta}><span>02</span><strong>想法整理與主題索引</strong><span>繼續探索 ↗</span></a><a href={cta}><span>03</span><strong>正在追問的問題</strong><span>了解更多 ↗</span></a></div></section>
 <aside class="field-evidence" aria-label="田野筆記的方法與來源"><div class="field-evidence-head"><span>FIELD METHOD / RECORDS</span><span>INDEX — 01</span></div><div class="field-evidence-body"><strong>把觀察留下來，<i>而不是急著下結論。</i></strong><p>文章與來源由作者提供；未經查證的資料不會被呈現為研究成果。</p><a href={base+(config.navigation.find(n=>n.id==='articles')?.path??'articles/')}>閱讀整理後的文章 ↗</a></div></aside>
 <section class="field-question" id="field-question"><span>OPEN QUESTION / 01</span><div><h2>從這裡開始閱讀。</h2><p>這個網站的內容會隨著你的觀察、經驗與持續創作慢慢累積。</p></div><a href={cta}>前往內容入口 ↗</a></section>
</div>
<style>
.field-site{--field-font:var(--brand-heading-font,Georgia,"Noto Serif TC",serif)}.field-site{--field-paper:var(--bg,#f1eee4);--field-ink:var(--ink,#222a20);--field-moss:var(--brand,#59664a);background:var(--field-paper);color:var(--field-ink);padding:0 clamp(1rem,4vw,4rem) 4rem;font-family:var(--field-font)}
.field-top{min-height:86px;display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid currentColor;font-family:ui-monospace,monospace;font-size:.8rem}.field-brand{font-size:1.2rem;font-weight:700}.field-brand small{display:block;font-size:.63rem;letter-spacing:.1em}.field-volume{opacity:.7;font-size:.72rem}
.field-frame{max-width:1360px;margin:auto;display:grid;grid-template-columns:78px minmax(0,1fr) 180px;gap:clamp(1.2rem,4vw,4rem);padding:3rem 0 5rem}.field-rail{display:flex;flex-direction:column;gap:1rem;color:var(--field-moss);font: .72rem ui-monospace,monospace}.field-rail a{writing-mode:vertical-rl;text-decoration:none;color:inherit}.field-hero{min-width:0}.field-kicker{font:.76rem ui-monospace,monospace;letter-spacing:.12em;color:var(--field-moss)}.field-hero h1{font-size:clamp(3.4rem,7.5vw,8.5rem);font-weight:400;line-height:1.1;letter-spacing:-.05em;overflow-wrap:anywhere;margin:.7rem 0 1.4rem}.field-hero h1 em{display:block;font-size:.5em;font-weight:400;color:var(--field-moss);line-height:1.35;margin-top:.35em;letter-spacing:-.02em}.field-intro{font-size:1.12rem;max-width:560px;line-height:1.9}.field-tags{display:flex;gap:.6rem;flex-wrap:wrap;margin:1.3rem 0 2.2rem}.field-tags span{border:1px solid var(--field-moss);padding:.3rem .7rem;border-radius:99px;font-size:.77rem}.field-figure{width:76%;margin-left:auto}.field-graphic{aspect-ratio:4/3;border-radius:46% 46% 3px 3px;background:radial-gradient(ellipse 24% 40% at 63% 47%,transparent 60%,rgba(60,85,55,.35) 63%,transparent 67%),linear-gradient(135deg,#a9b7a0,#d9d5c3 55%,#7a8a6f);display:flex;align-items:flex-end;padding:1.5rem;color:#234032}.field-graphic span{font:700 clamp(1.5rem,4vw,3rem)/.9 Georgia,serif;letter-spacing:.08em}.field-custom-image{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;filter:var(--brand-image-filter,none);border-radius:46% 46% 3px 3px}.field-figure figcaption{border-bottom:1px solid currentColor;padding:.6rem 0;font:.75rem ui-monospace,monospace}.field-margin{border-left:1px solid var(--field-moss);padding-left:1rem;align-self:center}.field-margin b,.field-margin small{font:.72rem ui-monospace,monospace}.field-margin p{font-size:1rem;line-height:1.8}
.field-ledger{max-width:1150px;margin:0 auto 5rem;display:grid;grid-template-columns:.7fr 1.3fr;gap:3rem;border-top:2px solid var(--field-ink);padding-top:2rem}.field-ledger h2{font-weight:400;font-size:clamp(1.8rem,3vw,2.9rem)}.field-ledger>div>p:not(.field-kicker){font-size:.95rem}.field-entries a{display:grid;grid-template-columns:50px 1fr auto;gap:1rem;align-items:center;padding:1.3rem 0;border-bottom:1px solid currentColor;text-decoration:none;font-size:.96rem}.field-entries span{font-size:.76rem}.field-question{max-width:1150px;margin:auto;display:grid;grid-template-columns:.7fr 1.3fr auto;gap:2rem;align-items:start}.field-question>span{font:.75rem ui-monospace,monospace}.field-question h2{margin:0;font-size:2rem;font-weight:400}.field-question a{align-self:start;white-space:nowrap}.field-question p{max-width:540px}
@media(max-width:850px){.field-frame{grid-template-columns:46px minmax(0,1fr)}.field-margin{grid-column:2}.field-ledger,.field-question{grid-template-columns:1fr;gap:1rem}}
@media(max-width:580px){.field-site{padding-inline:1.1rem}.field-volume{display:none}.field-frame{grid-template-columns:24px minmax(0,1fr);gap:.75rem;padding-top:2rem}.field-hero h1{font-size:clamp(2.5rem,12vw,4.7rem)}.field-figure{width:100%}.field-entries a{grid-template-columns:30px 1fr;gap:.5rem}.field-entries a span:last-child{grid-column:2}.field-margin{margin-top:1rem}.field-question a{white-space:normal}}
.field-evidence{max-width:1220px;margin:3rem auto 6rem;border:1px solid currentColor;padding:clamp(1.2rem,3vw,3rem)}.field-evidence-head{display:flex;justify-content:space-between;gap:1rem;border-bottom:1px solid currentColor;padding-bottom:1rem;font:.7rem ui-monospace,monospace;letter-spacing:.12em}.field-evidence-body{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);align-items:end;gap:2rem;padding-top:2rem}.field-evidence-body strong{font:500 clamp(2.2rem,4.5vw,4.4rem)/1.25 var(--brand-heading-font,Georgia,serif);letter-spacing:-.06em}.field-evidence-body i{font-weight:400}.field-evidence-body p{font-size:1rem;line-height:1.9}.field-evidence-body a{font-size:.85rem;text-underline-offset:.3em;grid-column:2}@media(max-width:760px){.field-evidence-body{grid-template-columns:1fr}.field-evidence-body a{grid-column:1}}
.field-hero h1{font-size:clamp(4.3rem,8vw,9.8rem);line-height:1.02;letter-spacing:-.085em;max-width:12ch}.field-hero h1 em{letter-spacing:-.06em}.field-frame{grid-template-columns:78px minmax(0,1fr) minmax(140px,190px);column-gap:clamp(1.25rem,3vw,4rem)}.field-figure{margin-top:clamp(2rem,5vw,5rem)}.field-figure img{max-height:none;object-fit:cover}@media(max-width:850px){.field-frame{grid-template-columns:42px minmax(0,1fr)}.field-hero h1{font-size:clamp(3rem,11vw,6rem)}}@media(max-width:580px){.field-frame{grid-template-columns:22px minmax(0,1fr)}.field-hero h1{font-size:clamp(2.6rem,11.5vw,4.8rem)}}</style>
