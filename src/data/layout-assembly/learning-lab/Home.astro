---
import config from '../../../../site.config.json';
import {getCollection} from 'astro:content';
const base=import.meta.env.BASE_URL;
const entries=config.navigation.some(n=>n.id==='articles')?(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.publishedAt-a.data.publishedAt):[];
const articleHref=entry=>base+'articles/'+entry.id+'/';
const headline=config.content?.headline||config.brand.name;
const intro=config.content?.intro||'首頁介紹待站長提供。';
const nav=config.navigation.find(n=>n.id===config.primaryCta.pageId);
const action=base+(nav?.path??config.primaryCta.pageId+'/');
const lessons=[{n:'01',title:'看見問題',text:'先描述自己想理解什麼。',color:'yellow'},{n:'02',title:'整理線索',text:'整理資料並留下可核對的來源。',color:'blue'},{n:'03',title:'動手練習',text:'用實際練習記錄觀察與修正。',color:'coral'}];
---
<div class="ll-site" data-assembled-layout="learning-lab" data-long-headline={(config.content?.headline||config.brand.name).length>32}>
<section class="ll-hero"><div class="ll-hero-copy"><p class="ll-overline">A CLEARER WAY TO LEARN</p><h1>{headline}</h1><p>{intro}</p><div class="ll-actions"><a class="ll-button" href="#path">看學習路徑 ↓</a><span>{config.brand.tagline}</span></div></div><figure class="ll-hero-art">{config.brand.heroImagePath?<img src={base+config.brand.heroImagePath.replace(/^\//,'')} alt={config.brand.heroImageAlt||'請填入圖片描述'}/>:<div class="ll-owned-placeholder" aria-label="待設定學習地圖"><span>LEARNING<br/>MAP</span><span>01 → 02 → 03</span></div>}<figcaption>{config.brand.heroImagePath?'站長提供的主視覺':'學習地圖示意 · 可替換為自有圖片'}</figcaption></figure><div class="ll-side-index" aria-hidden="true"><span>INTRO</span><span>01 / PATH</span><span>→</span></div></section>
<section class="ll-path" id="path"><header><p class="ll-overline">THE LEARNING PATH / 03 STEPS</p><h2>走一遍，<br/>就知道怎麼繼續。</h2><p>以下為練習路徑示意。勾選只記錄本次操作，重新整理後不保留。</p><div class="ll-progress"><div><label for="ll-progress">本次練習</label><span id="ll-progress-label" aria-live="polite">0 / 3 個步驟</span></div><progress id="ll-progress" max="3" value="0" aria-label="本次練習進度">0 / 3</progress></div></header><ol class="ll-track">{lessons.map(lesson=><li class:list={['ll-unit','ll-unit--'+lesson.color]}><span class="ll-unit-no">{lesson.n}</span><div><p>DEMO / PRACTICE</p><h3>{lesson.title}</h3><span>{lesson.text}</span></div><label class="ll-complete"><input class="ll-check" type="checkbox"/><span>完成</span></label></li>)}</ol></section>
<section class="ll-modules" id="units"><div class="ll-modules-heading"><p class="ll-overline">OPEN MODULES</p><h2>把線索，<i>接成學習路徑。</i></h2><p>單元內容待站長提供；正式文章由文章系統管理。</p><a href={action}>{config.primaryCta.label} ↗</a></div><div class="ll-module-list">{entries.length?entries.slice(0,3).map((entry,i)=><article><span class="ll-module-num">{String(i+1).padStart(2,'0')}</span><div><p>{entry.data.publishedAt.toLocaleDateString('zh-TW')}</p><h3><a href={articleHref(entry)}>{entry.data.title}</a></h3><p>{entry.data.description}</p></div><span class="ll-module-arrow" aria-hidden="true">↗</span></article>):<p>目前没有公開學習筆記。</p>}</div></section>
</div>
<script is:inline>
(()=>{const root=document.querySelector('[data-assembled-layout="learning-lab"]');if(!root)return;const checks=[...root.querySelectorAll('.ll-check')];checks.forEach(box=>box.addEventListener('change',()=>{const done=checks.filter(x=>x.checked).length;root.querySelector('#ll-progress').value=done;root.querySelector('#ll-progress-label').textContent=done+' / '+checks.length+' 個步驟';checks.forEach(x=>x.closest('.ll-unit').classList.toggle('is-done',x.checked));}));})();
</script>
<style>

.ll-site{--ll-ink:#101f52;--ll-blue:var(--brand-primary,#2449d8);--ll-yellow:var(--brand-accent,#ffd23e);--ll-paper:#f4f5ef;background:var(--ll-paper);color:var(--ll-ink);min-height:100vh;padding:0 clamp(1rem,4vw,4.5rem) 2rem;font-family:Arial,"Noto Sans TC",sans-serif}.ll-header{height:84px;display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid var(--ll-ink);gap:1rem}.ll-brand{font-size:.75rem;line-height:1.05;letter-spacing:.08em;font-weight:800;text-decoration:none;display:grid;grid-template-columns:38px 1fr;align-items:center}.ll-brand-mark{grid-row:span 2;background:var(--ll-yellow);width:32px;height:32px;display:grid;place-items:center;font-size:1.1rem;border-radius:50%}.ll-header nav{display:flex;gap:1.6rem;font-size:.77rem;font-weight:700}.ll-header nav a{text-decoration:none}.ll-status{font: .6rem ui-monospace,monospace;letter-spacing:.1em}.ll-status i{display:inline-block;width:8px;height:8px;border-radius:50%;background:#45a667;margin-right:.4rem}.ll-hero{max-width:1320px;margin:0 auto;min-height:590px;display:grid;grid-template-columns:1.02fr .98fr 40px;align-items:center;gap:3rem;padding:4rem 0}.ll-overline{font: .75rem ui-monospace,monospace;letter-spacing:.13em;color:var(--ll-blue);font-weight:700}.ll-hero-copy h1{font-size:clamp(4rem,8.5vw,8.5rem);line-height:.96;letter-spacing:-.09em;margin:1rem 0}.ll-hero-copy h1 span{background:var(--ll-yellow);padding:0 .15em;box-decoration-break:clone}.ll-hero-copy>p:not(.ll-overline){max-width:470px;line-height:1.8;font-size:1rem}.ll-actions{display:flex;align-items:center;gap:1rem;margin-top:2rem}.ll-button{background:var(--ll-blue);color:white;padding:.9rem 1.1rem;text-decoration:none;font-size:.8rem;font-weight:700;box-shadow:4px 4px 0 var(--ll-yellow)}.ll-button b{margin-left:1rem}.ll-actions>span{font-size:.75rem;color:#536080}.ll-hero-art{margin:0;position:relative}.ll-hero-art img{width:100%;aspect-ratio:4/3;object-fit:cover;border:2px solid var(--ll-ink);box-shadow:12px 12px 0 var(--ll-yellow);transform:rotate(1deg)}.ll-hero-art figcaption{font: .75rem ui-monospace,monospace;margin-top:1rem}.ll-side-index{height:260px;border-left:1px solid var(--ll-ink);display:flex;flex-direction:column;justify-content:space-between;align-items:center;font: .6rem ui-monospace,monospace;writing-mode:vertical-rl}.ll-path{max-width:1320px;margin:2rem auto 6rem;display:grid;grid-template-columns:.7fr 1.3fr;gap:6vw;border-top:2px solid var(--ll-ink);padding-top:2rem}.ll-path header h2,.ll-modules-heading h2{font-size:clamp(2.6rem,5vw,5rem);line-height:.98;letter-spacing:-.08em;margin:.5rem 0 1rem}.ll-path header>p:last-child{max-width:350px;line-height:1.8;color:#4c5875}.ll-progress{margin-top:1.4rem;max-width:340px}.ll-progress>div{display:flex;justify-content:space-between;font: .75rem ui-monospace,monospace;color:#354469;margin-bottom:.4rem}.ll-progress progress{width:100%;height:9px;accent-color:var(--ll-blue)}.ll-track{list-style:none;margin:0;padding:0;position:relative}.ll-track::before{content:"";position:absolute;left:27px;top:30px;bottom:30px;width:2px;background:var(--ll-blue)}.ll-unit{position:relative;display:grid;grid-template-columns:58px 1fr 78px;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid #cbd0db;transition:background .2s}.ll-unit.is-done{background:#e9f0df}.ll-complete{display:flex;align-items:center;gap:.4rem;font: .75rem ui-monospace,monospace;color:#354469;cursor:pointer}.ll-check{width:17px;height:17px;accent-color:var(--ll-blue)}.ll-unit-no{width:54px;height:54px;background:var(--ll-yellow);border:2px solid var(--ll-ink);border-radius:50%;display:grid;place-items:center;font: .75rem ui-monospace,monospace;z-index:1}.ll-unit--blue .ll-unit-no{background:#b7c5ff}.ll-unit--coral .ll-unit-no{background:#f28a6a}.ll-unit h3{font-size:1.5rem;margin:.1rem 0}.ll-unit p{font: .75rem ui-monospace,monospace;color:var(--ll-blue);letter-spacing:.12em;margin:0}.ll-unit div>span{font-size:.8rem;color:#505c78}.ll-unit>a{text-decoration:none;color:var(--ll-blue)}.ll-modules{max-width:1320px;margin:0 auto 6rem;background:#e5e8f2;padding:clamp(1.2rem,4vw,3rem);display:grid;grid-template-columns:.72fr 1.28fr;gap:4vw}.ll-modules-heading h2 i{font-family:Georgia,serif;font-weight:400}.ll-modules-heading>a{font-size:.75rem;color:var(--ll-blue)}.ll-module-list article{display:grid;grid-template-columns:48px 1fr 24px;gap:1rem;align-items:center;border-top:1px solid #aab1cb;padding:1rem 0}.ll-module-num{font: .7rem ui-monospace,monospace;color:var(--ll-blue)}.ll-module-list p{font: .6rem ui-monospace,monospace;color:#586688;margin:0}.ll-module-list h3{font-size:1.08rem;margin:.25rem 0}.ll-module-arrow{color:var(--ll-blue)}.ll-footer{max-width:1320px;margin:auto;border-top:2px solid var(--ll-ink);padding:1rem 0;display:flex;justify-content:space-between;gap:1rem;font: .6rem ui-monospace,monospace}.ll-footer a{color:var(--ll-blue)}@media(max-width:900px){.ll-hero{grid-template-columns:1fr 1fr;gap:2rem}.ll-side-index{display:none}.ll-path,.ll-modules{grid-template-columns:1fr;gap:1.5rem}}@media(max-width:600px){.ll-header{height:auto;padding:1rem 0;flex-wrap:wrap}.ll-header nav{order:3;width:100%;justify-content:space-between;gap:.6rem;font-size:.75rem}.ll-status{font-size:.75rem}.ll-hero{grid-template-columns:1fr;padding:3rem 0}.ll-hero-copy h1{font-size:18vw}.ll-hero-art{width:94%;margin-left:auto}.ll-path{margin-bottom:4rem}.ll-unit{grid-template-columns:46px 1fr 68px;gap:.7rem}.ll-complete{font-size:.75rem;gap:.25rem}.ll-check{width:15px;height:15px}.ll-unit-no{width:42px;height:42px}.ll-track::before{left:20px}.ll-unit h3{font-size:1.2rem}.ll-modules{margin-bottom:4rem}.ll-footer{flex-wrap:wrap}}

.ll-hero h1{font-family:var(--brand-body-font,system-ui,sans-serif);line-height:1.08;letter-spacing:-.04em;text-wrap:balance;background:linear-gradient(transparent 75%,var(--ll-yellow) 75%);width:fit-content}.ll-owned-placeholder{aspect-ratio:4/3;background:var(--ll-yellow);border:2px solid var(--ll-ink);box-shadow:12px 12px 0 var(--ll-blue);padding:2rem;display:flex;flex-direction:column;justify-content:space-between;transform:rotate(1deg);font:800 clamp(2rem,5vw,5rem)/1.08 system-ui}.ll-path header{display:block}.ll-track{min-width:0}.ll-unit{min-width:0}.ll-complete{min-height:44px}.ll-unit-no{flex-shrink:0}.ll-site :is(h2,h3){line-height:1.15;letter-spacing:-.04em}.ll-site :is(p,span,figcaption,a){font-size:max(.75rem,1em)}.ll-module-list article{grid-template-columns:48px minmax(0,1fr) 24px}.ll-side-index{font-size:.75rem}@media(max-width:800px){.ll-hero{grid-template-columns:minmax(0,1fr);gap:2rem}.ll-side-index{display:none}.ll-path{grid-template-columns:minmax(0,1fr);gap:2rem}.ll-hero h1{font-size:clamp(2.6rem,11vw,6rem)}.ll-site{padding-inline:1rem}}
</style>
