---
import config from '../../../../site.config.json';
import StudentNavigation from '../../StudentNavigation.astro';
import {getSite} from './content.mjs';
const {route='',entry=null,extra=false}=Astro.props;
const page=route,root=import.meta.env.BASE_URL,base=root;
const site=await getSite(root);
const detailRecord=site.kind==='knowledge'?site.articles.find(a=>a.slug===entry?.id)??site.primary:site.services.find(s=>route==='services/'+s.slug)??site.primary;
const service=detailRecord??{name:'尚未設定服務',title:'尚未設定服務',description:'服務資訊待設定',fit:'待確認',format:'待設定',duration:'待設定',price:'待設定',scope:'待核實',credential:'待核實',body:[],href:undefined};
const articles=site.articles,posts=site.articles,rows=site.articles;
const entries=site.kind==='knowledge'?site.articles:site.questions;
const items=entries.map(a=>a.title??a.question),demo=site.intro;
const chapters=site.questions.map((q,i)=>[String(i+1).padStart(2,'0'),q.question,q.answer]);
const availableServices=site.services;
const facts=[['服務對象',service.fit],['服務形式',service.format],['時間',service.duration],['費用',service.price],['服務界線',service.scope],['資格與來源',service.credential]];
const info=facts,title=site.siteName,name=site.siteName;
const indexUrl=root+(site.kind==='knowledge'?'articles/':'services/'),detailUrl=site.primary?.href??indexUrl;
---


<div data-article-count={route==='articles'?site.articles.length:undefined} data-service-count={route==='services'?site.services.length:undefined} data-native-page="card-journal" class="cards"><div class="shell"><header><a class="logo" href={root}>{site.siteName}</a><StudentNavigation/></header>
{(page===''||page==='articles')&&<><section class="intro"><span class="label">{page===''?'NOTES / START HERE':'ALL POSTS'}</span><h1>{page===''?site.headline:'文章總覽'}</h1><p>{site.intro}</p></section><section class="toolbar"><strong>全部文章 <span>{String(posts.length).padStart(2,'0')}</span></strong><span>觀察　/　閱讀　/　生活</span></section><section class="grid" aria-label="文章卡片">{posts.map(post=><article class="post"><div class="cover">{post.image?<img class="native-story-image" src={post.image.startsWith('/')?root+post.image.slice(1):post.image} alt={post.title}/>:<Fragment><span>RECORD / {post.id}</span><strong>{post.tag}</strong><small>圖片選填</small></Fragment>}</div><div class="card-body"><span class="label">{post.tag} · {post.date}</span><h2>{post.href?<a href={post.href}>{post.title} ↗</a>:post.title}</h2><p>{post.text}</p>{!post.href&&<small>尚無文章全文</small>}</div></article>)}</section>{page===''&&<section class="ending"><h2>先寫第一篇，之後慢慢增加。</h2><p>{site.copy.p2??(route==='about'?site.aboutFields[1]:'')}</p><a href={root+'about/'}>關於作者 →</a></section>}</>}
{(route??'').startsWith('articles/')&&<><div class="article-intro"><span class="label">觀察 · DEMO RECORD 01</span><h1>{detailRecord?.title??'目前沒有公開文章'}</h1><p>{site.copy.p3??(route==='about'?site.aboutFields[2]:'')}</p></div><div class="article-cover">{detailRecord?.image?<img class="native-story-image" src={detailRecord.image.startsWith('/')?root+detailRecord.image.slice(1):detailRecord.image} alt={detailRecord.title}/>:<span>文章圖片選填</span>}</div><article class="prose">{route==='about'?<><p>{site.bio}</p>{site.aboutFields.map(p=><p>{p}</p>)}</>:<slot/>}</article><section class="related"><span class="label">OTHER ARTICLES</span>{posts.slice(1).map(post=><article><h3><a href={post.href}>{post.title}</a></h3></article>)}</section></>}
{page==='about'&&<><section class="intro"><span class="label">ABOUT / THE AUTHOR</span><h1>{site.about}</h1><p>{site.bio}</p></section><section class="about"><div class="avatar">照片<br/>選填</div><div><h2>寫下什麼？</h2><p>{site.aboutFields[0]}</p><h2>如何維護？</h2><p>{site.aboutFields[1]}</p><a href={root+'articles/'}>看全部文章 →</a><h2>背景與來源</h2><p>{site.aboutFields[2]}</p></div></section></>}
{extra&&<section class="native-extra"><slot/></section>}{route==='articles'&&site.articles.length===0&&<p class="archive-empty">目前沒有公開文章。</p>}{route==='services'&&site.services.length===0&&<section class="native-unconfigured"><p>尚未提供正式服務。</p><dl>{[['服務範圍',config.serviceFacts?.scope],['服務方式',config.serviceFacts?.method],['服務時間',config.serviceFacts?.duration],['實際費用',config.serviceFacts?.price],['資格與來源',config.serviceFacts?.qualification],['取消政策',config.serviceFacts?.cancellation]].filter(([,value])=>value).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>}<footer><span>{site.siteName}</span><a href={root}>回首頁 ↑</a></footer></div></div>

<style>
.cards{--ink:#242a24;--line:#c6c8bc;background:#f4f1e8;color:var(--ink);min-height:100vh;font-family:'Noto Sans TC',system-ui,sans-serif;line-height:1.8}.shell{width:min(calc(100% - 48px),1200px);margin:auto}.cards a{color:inherit;text-decoration:none}.cards a:hover{text-decoration:underline;text-underline-offset:4px}.cards header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:32px 0;border-bottom:1px solid var(--line)}.logo{font:400 30px Georgia,'Noto Serif TC',serif}.logo small{display:block;font:12px ui-monospace,monospace}.cards nav{display:flex;flex-wrap:wrap;gap:16px 32px}.cards nav a{display:inline-flex;align-items:center;min-height:44px}.label{font:12px ui-monospace,monospace;letter-spacing:.09em;color:#58645a}.intro{max-width:850px;padding:96px 0 64px}.cards h1{font:400 clamp(40px,5vw,72px)/1.2 Georgia,'Noto Serif TC',serif;letter-spacing:-.02em;text-wrap:balance}.intro p,.article-intro p{font-size:20px;max-width:48ch}.toolbar{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;padding:24px 0;border-top:1px solid var(--ink);border-bottom:1px solid var(--line)}.toolbar strong span{font:12px ui-monospace,monospace;color:#58645a;margin-left:16px}.grid{padding:48px 0 128px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}.post{background:#fffefa;border:1px solid var(--line);min-width:0}.cover{aspect-ratio:4/3;background:#e7ece5;display:flex;flex-direction:column;justify-content:space-between;padding:24px;color:#355747}.cover span,.cover small{font:12px ui-monospace,monospace}.cover strong{font:400 44px Georgia,'Noto Serif TC',serif;text-align:center}.card-body{padding:24px}.card-body h2{font:400 clamp(24px,2.3vw,30px)/1.35 Georgia,'Noto Serif TC',serif}.card-body p{font-size:16px}.card-body small{font-size:13px;color:#58645a}.ending{border-top:1px solid var(--ink);padding:80px 0 128px}.ending h2,.about h2{font:400 clamp(28px,4vw,48px) Georgia,'Noto Serif TC',serif}.ending a,.about a,.prose a{min-height:48px;display:inline-flex;align-items:center;border-bottom:1px solid currentColor}.article-intro{max-width:870px;padding:96px 0 48px}.article-cover{background:#e7ece5;min-height:300px;padding:32px;display:grid;place-content:center;font:24px ui-monospace,monospace;color:#355747}.prose{max-width:720px;margin:96px auto 128px;font-size:18px;line-height:1.95}.prose h2{font:400 36px Georgia,'Noto Serif TC',serif;margin-top:64px}.related{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;border-top:1px solid var(--ink);padding:64px 0 96px}.related>.label{grid-column:1/-1}.related article{border-top:1px solid var(--line);padding:24px 0}.related h3{font:400 24px Georgia,'Noto Serif TC',serif}.about{display:grid;grid-template-columns:1fr 2fr;gap:64px;padding:32px 0 128px}.avatar{background:#e7ece5;min-height:320px;display:grid;place-content:center;text-align:center;font:36px Georgia,'Noto Serif TC',serif}.about p{font-size:18px;max-width:55ch}.cards footer{border-top:1px solid var(--ink);padding:32px 0 64px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;font-size:14px}.cards h1,.cards h2,.cards h3,.cards p{overflow-wrap:anywhere}@media(max-width:950px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.shell{width:min(calc(100% - 40px),1200px)}.cards header{align-items:flex-start;flex-direction:column}.intro,.article-intro{padding:48px 0}.grid{grid-template-columns:1fr;gap:24px;padding-bottom:64px}.cover{aspect-ratio:5/3}.about{display:block}.avatar{min-height:200px;margin-bottom:48px}.prose{margin:48px auto 64px;font-size:17px}.related{display:block}.related article{margin:24px 0}.ending{padding:64px 0}}
.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 system-ui,sans-serif;padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
.article-contract-body{font-size:1rem;line-height:1.8;max-width:65ch}
</style>
<style>.native-extra{padding:48px 0} .native-extra h1{overflow-wrap:anywhere} :global(.student-navigation){min-width:0} h1{overflow-wrap:anywhere;text-wrap:balance} .prose :global(pre),.prose :global(table){max-width:100%;overflow:auto} .prose :global(table){display:block}</style>

<style>.native-story-image{width:100%;max-height:640px;object-fit:cover} p:empty{display:none} .native-owned-image{width:100%;height:100%;object-fit:cover} </style>

<style>dl>div{display:grid;grid-template-columns:minmax(7em,1fr) minmax(0,2fr);gap:16px;padding-block:16px}dd{margin:0}.additional-services article{padding:24px;border:1px solid var(--line);margin-block:24px;background:#fffefa}@media(max-width:600px){dl>div{display:block}dt{margin-bottom:8px}}</style>
