---
import config from '../../../../site.config.json';
import StudentNavigation from '../../StudentNavigation.astro';
import {getSite} from './content.mjs';
const {route='',entry=null,extra=false}=Astro.props;
const page=route,root=import.meta.env.BASE_URL,base=root;
const site=await getSite(root);
const detailRecord=site.kind==='knowledge'?site.articles.find(a=>a.slug===entry?.id)??site.primary:site.services.find(s=>route==='services/'+s.slug)??site.primary;
const service=detailRecord??{name:'尚未設定服務',title:'尚未設定服務',description:'服務資訊待設定',fit:'待確認',format:'待設定',duration:'待設定',price:'待設定',scope:'待核實',credential:'待核實',body:[],href:undefined};
const articles=site.articles,posts=site.articles,rows=site.articles;
const entries=site.kind==='knowledge'?site.articles:site.questions;
const items=entries.map(a=>a.title??a.question),demo=site.intro;
const chapters=site.questions.map((q,i)=>[String(i+1).padStart(2,'0'),q.question,q.answer]);
const availableServices=site.services;
const facts=[['服務對象',service.fit],['服務形式',service.format],['時間',service.duration],['費用',service.price],['服務界線',service.scope],['資格與來源',service.credential]];
const info=facts,title=site.siteName,name=site.siteName;
const indexUrl=root+(site.kind==='knowledge'?'articles/':'services/'),detailUrl=site.primary?.href??indexUrl;
---


<div data-article-count={route==='articles'?site.articles.length:undefined} data-service-count={route==='services'?site.services.length:undefined} data-native-page="studio-chapters" class="chapters"><div class="shell">
<header class="nav"><a class="brand" href={root}>{site.siteName}</a><StudentNavigation/></header>
{route===''&&<><section class="stage"><div class="stage-art">{config.brand.heroImagePath?<img class="native-owned-image" src={root+config.brand.heroImagePath.slice(1)} alt={config.brand.heroImageAlt||'網站持有人提供的圖片'}/>:<Fragment><span>SPACE / OPTIONAL IMAGE</span><span class="stage-art-title">一處能夠<br/>好好說明<br/>工作的地方。</span><small>未使用真實照片，不假裝存在實體工作室。</small></Fragment>}</div><div class="stage-copy"><p class="tag">INTRO / 00</p><h1>{route===''?site.headline:route==='about'?site.about:route==='articles'?'文章索引':route==='services'?'服務資訊':detailRecord?.title}</h1><p>{site.intro}</p><a class="link" href="#sections">閱讀章節 ↓</a></div></section><div id="sections" class="book"><aside class="chapter-nav"><span class="tag">TABLE OF CONTENTS</span>{chapters.map(([n,name])=><a href={'#chapter-'+n}>{n} / {name}</a>)}</aside><div class="chapter-body">{chapters.map(([n,name,desc],i)=><section id={'chapter-'+n} class="chapter"><p class="tag">CHAPTER / {n}</p><h2>{name}</h2><p>{desc}</p>{i===0?<div class="image-space">{config.brand.heroImagePath?<img class="native-owned-image" src={root+config.brand.heroImagePath.slice(1)} alt={config.brand.heroImageAlt||'網站持有人提供的圖片'}/>:<Fragment>IMAGE / UNCONFIGURED</Fragment>}</div>:i===1?<a class="link" href={root+'services/'}>閱讀服務與工作方式 →</a>:<a class="link" href={root+'about/'}>關於提供服務的人 →</a>}</section>)}</div></div></>}
{route==='services'&&<><section class="available-services" aria-label="可編輯服務項目">{availableServices.map(item=><article><h2>{item.name}</h2><p>{item.description}</p><a href={item.href}>詳細服務內容 →</a></article>)}</section><section class="pagehead"><p class="tag">CHAPTER / SERVICE INDEX</p><h1>{route===''?site.headline:route==='about'?site.about:route==='articles'?'文章索引':route==='services'?'服務資訊':detailRecord?.title}</h1><p>{site.copy.p2??(route==='about'?site.aboutFields[1]:'')}</p></section><div class="book"><aside class="chapter-nav"><span class="tag">ON THIS PAGE</span><a href="#service">01 / 一項服務</a><a href="#boundaries">02 / 必要資訊</a></aside><div class="chapter-body"><section class="chapter" id="service"><p class="tag">01 / SERVICE</p><h2>個別專業服務</h2><p>{site.copy.p3??(route==='about'?site.aboutFields[2]:'')}</p><a class="link" href={(site.primary?.href??root+'services/')}>開啟詳細章節 →</a></section><section class="chapter" id="boundaries"><p class="tag">02 / WHAT TO KNOW</p><h2>開始之前，先清楚知道。</h2><dl>{info.map(([name,value])=><div><dt>{name}</dt><dd>{value}</dd></div>)}</dl></section></div></div></>}
{(route??'').startsWith('services/')&&<><section class="pagehead"><p class="tag">SERVICE / CHAPTER 01</p><h1>{detailRecord?.title??'尚未設定服務'}</h1><p>{site.copy.p4??(route==='about'?site.aboutFields[3]:'')}</p></section><div class="book"><aside class="chapter-nav"><span class="tag">READING GUIDE</span><a href="#approach">01 / 如何進行</a><a href="#facts">02 / 事前資訊</a><a href="#next">03 / 聯絡以前</a></aside><div class="chapter-body"><section class="chapter" id="approach"><div class="article-contract-body">{service.body.map(p=><p>{p}</p>)}</div><p class="tag">01 / APPROACH</p><h2>如何進行？</h2><p>{site.copy.p5??(route==='about'?site.aboutFields[0]:'')}</p><div class="image-space">{config.brand.heroImagePath?<img class="native-owned-image" src={root+config.brand.heroImagePath.slice(1)} alt={config.brand.heroImageAlt||'網站持有人提供的圖片'}/>:<Fragment>SERVICE IMAGE / OPTIONAL</Fragment>}</div></section><section class="chapter" id="facts"><p class="tag">02 / FACTS</p><h2>有哪些必要條件？</h2><dl>{info.map(([name,value])=><div><dt>{name}</dt><dd>{value}</dd></div>)}</dl></section><section class="chapter" id="next"><p class="tag">03 / CONTACT</p><h2>聯絡前的知情選擇。</h2><p>{site.copy.p6??(route==='about'?site.aboutFields[1]:'')}</p><a class="link" href={root+'services/'}>← 返回服務總覽</a></section></div></div></>}
{route==='about'&&<><section class="pagehead"><p class="tag">STUDIO / ABOUT</p><h1>{site.about}</h1><p>{site.bio}</p></section><div class="book"><aside class="chapter-nav"><span class="tag">ABOUT CHAPTERS</span><a href="#person">01 / 本人</a><a href="#method">02 / 方法</a><a href="#credentials">03 / 真實背景</a></aside><div class="chapter-body"><section class="chapter" id="person"><p class="tag">01 / PERSON</p><h2>關於我</h2><p>{site.aboutFields.filter(Boolean).join('\n\n')}</p></section><section class="chapter" id="method"><p class="tag">02 / APPROACH</p><h2>我的工作方式</h2><p>{site.aboutFields.filter(Boolean).join('\n\n')}</p><div class="image-space">{config.brand.heroImagePath?<img class="native-owned-image" src={root+config.brand.heroImagePath.slice(1)} alt={config.brand.heroImageAlt||'網站持有人提供的圖片'}/>:<Fragment>WORKSPACE IMAGE / OPTIONAL</Fragment>}</div></section><section class="chapter" id="credentials"><p class="tag">03 / BACKGROUND</p><h2>經歷與資格</h2><p>{site.aboutFields.filter(Boolean).join('\n\n')}</p><a class="link" href={root+'services/'}>閱讀服務章節 →</a></section></div></div></>}
{extra&&<section class="native-extra"><slot/></section>}{route==='articles'&&site.articles.length===0&&<p class="archive-empty">目前沒有公開文章。</p>}{route==='services'&&site.services.length===0&&<p>尚未提供正式服務。</p>}<footer><span>{site.siteName}</span><a href={root}>回首頁 ↑</a></footer>
</div></div>

<style>
.chapters{--ink:#242a24;--rule:#b5bdb1;--soft:#e7ece5;background:#f4f1e8;color:var(--ink);font:17px/1.85 'Noto Sans TC',system-ui,sans-serif;min-height:100vh}.shell{width:min(calc(100% - 48px),1200px);margin:auto}.chapters a{color:inherit;text-decoration:none}.chapters a:hover{text-decoration:underline;text-underline-offset:5px}.nav{display:flex;justify-content:space-between;gap:24px;align-items:center;padding:32px 0;border-bottom:1px solid var(--ink)}.brand{font:400 28px Georgia,'Noto Serif TC',serif}.brand span{display:block;font:12px ui-monospace,monospace}.nav nav{display:flex;gap:16px 32px;flex-wrap:wrap}.nav nav a{display:inline-flex;min-height:44px;align-items:center}.tag{font:12px ui-monospace,monospace;letter-spacing:.1em;color:#496251}.stage{padding:64px 0 128px;display:grid;grid-template-columns:1.15fr 1fr;gap:96px;align-items:center}.stage-art{min-height:560px;background:var(--soft);padding:32px;display:flex;flex-direction:column;justify-content:space-between}.stage-art>span:first-child,.stage-art small{font:12px ui-monospace,monospace;color:#496251}.stage-art-title{font:400 clamp(40px,5vw,76px)/1.3 Georgia,'Noto Serif TC',serif}.chapters h1{font:400 clamp(44px,6vw,76px)/1.2 Georgia,'Noto Serif TC',serif;letter-spacing:-.03em;text-wrap:balance}.stage-copy p:not(.tag),.pagehead p:not(.tag){font-size:20px;max-width:45ch}.link{display:inline-flex;min-height:48px;align-items:center;margin-top:24px;border-bottom:1px solid currentColor}.book{display:grid;grid-template-columns:260px minmax(0,1fr);gap:96px;border-top:1px solid var(--ink);padding:64px 0 128px}.chapter-nav{display:flex;flex-direction:column;gap:8px;position:sticky;top:32px;align-self:start}.chapter-nav .tag{margin-bottom:24px}.chapter-nav a{border-bottom:1px solid var(--rule);padding:12px 0;min-height:48px}.chapter{padding:0 0 96px;scroll-margin-top:32px}.chapter+.chapter{padding-top:96px;border-top:1px solid var(--rule)}.chapter h2{font:400 clamp(36px,4vw,60px)/1.3 Georgia,'Noto Serif TC',serif;letter-spacing:-.02em}.chapter>p{font-size:19px;max-width:52ch}.image-space{background:var(--soft);margin-top:48px;min-height:280px;display:grid;place-items:center;font:12px ui-monospace,monospace;letter-spacing:.08em;color:#496251}.pagehead{padding:96px 0 64px;max-width:900px}.chapter dl{border-top:1px solid var(--rule);margin-top:48px}.chapter dl>div{display:grid;grid-template-columns:180px 1fr;gap:24px;border-bottom:1px solid var(--rule);padding:24px 0}.chapter dt{font-weight:700}.chapter dd{margin:0}.chapters footer{border-top:1px solid var(--ink);padding:32px 0 64px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;font-size:14px}.chapters footer p{flex-basis:100%}.chapters h1,.chapters h2,.chapters p,.chapters dd{overflow-wrap:anywhere}@media(max-width:900px){.stage{gap:48px}.book{grid-template-columns:200px 1fr;gap:48px}}@media(max-width:700px){.shell{width:min(calc(100% - 40px),1200px)}.nav{display:block}.nav nav{margin-top:24px}.stage,.book{display:block}.stage{padding:32px 0 64px}.stage-art{min-height:360px}.stage-copy{margin-top:48px}.book{padding:32px 0 64px}.chapter-nav{position:static;flex-flow:row wrap;gap:8px 16px;border-bottom:1px solid var(--rule);padding-bottom:24px;margin-bottom:48px}.chapter-nav .tag{flex-basis:100%;margin:0}.chapter{padding-bottom:64px}.chapter+.chapter{padding-top:64px}.chapter dl>div{display:block}.chapter dt{margin-bottom:8px}.pagehead{padding:48px 0}.image-space{min-height:200px}}
.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 system-ui,sans-serif;padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
.article-contract-body{font-size:1rem;line-height:1.8;max-width:65ch}
.available-services{display:grid;gap:24px;padding:32px 0}.available-services article{border-bottom:1px solid currentColor;padding:16px 0}.available-services a{display:inline-block;min-height:44px;text-decoration:underline}
</style>
<style>.native-extra{padding:48px 0} .native-extra h1{overflow-wrap:anywhere} :global(.student-navigation){min-width:0} h1{overflow-wrap:anywhere;text-wrap:balance} .prose :global(pre),.prose :global(table){max-width:100%;overflow:auto} .prose :global(table){display:block}</style>

<style>p:empty{display:none} .native-owned-image{width:100%;height:100%;object-fit:cover} </style>
