---
import config from '../../../../site.config.json';
import StudentNavigation from '../../StudentNavigation.astro';
import {getSite} from './content.mjs';
const {route='',entry=null,extra=false}=Astro.props;
const page=route,root=import.meta.env.BASE_URL,base=root;
const site=await getSite(root);
const detailRecord=site.kind==='knowledge'?site.articles.find(a=>a.slug===entry?.id)??site.primary:site.services.find(s=>route==='services/'+s.slug)??site.primary;
const service=detailRecord??{name:'尚未設定服務',title:'尚未設定服務',description:'服務資訊待設定',fit:'待確認',format:'待設定',duration:'待設定',price:'待設定',scope:'待核實',credential:'待核實',body:[],href:undefined};
const articles=site.articles,posts=site.articles,rows=site.articles;
const entries=site.kind==='knowledge'?site.articles:site.questions;
const items=entries.map(a=>a.title??a.question),demo=site.intro;
const chapters=site.questions.map((q,i)=>[String(i+1).padStart(2,'0'),q.question,q.answer]);
const availableServices=site.services;
const facts=[['服務對象',service.fit],['服務形式',service.format],['時間',service.duration],['費用',service.price],['服務界線',service.scope],['資格與來源',service.credential]];
const info=facts,title=site.siteName,name=site.siteName;
const indexUrl=root+(site.kind==='knowledge'?'articles/':'services/'),detailUrl=site.primary?.href??indexUrl;
---


<div data-article-count={route==='articles'?site.articles.length:undefined} data-service-count={route==='services'?site.services.length:undefined} data-native-page="sidebar-journal" class="journal">
  <div class="frame">
    <aside class="rail" aria-label="網站側欄">
      <a class="brand" href={base}>{site.siteName}</a>
      <p class="rail-intro">{site.intro}</p>
      <StudentNavigation/>
      <div class="rail-bottom"><strong>FIELD / 2026</strong><p>{site.copy.p2??(route==='about'?site.aboutFields[1]:'')}</p><a href={root}>回首頁</a></div>
    </aside>
    <div class="body">
      <header class="top"><span>PERSONAL PUBLICATION</span><span>繁體中文</span></header>
      {route==='' && <>
        <section class="intro"><p class="eyebrow">LATEST NOTES / HOME</p><h1>{route===''?site.headline:route==='about'?site.about:route==='articles'?'文章索引':route==='services'?'服務資訊':detailRecord?.title}</h1><p class="lead">{route==='about'?site.bio:detailRecord?.summary??site.intro}</p><a class="line-link" href={base+'articles/'}>翻閱全部文章 ↗</a></section>
        <section class="desk"><div class="desk-label"><p class="eyebrow">ON THE DESK</p><h2>最近的三則</h2><p>{site.copy.p4??(route==='about'?site.aboutFields[3]:'')}</p></div><div class="entries">{articles.map(a=><article class="entry"><div class="meta">{a.id} / {a.date} / {a.tag}</div><h3>{a.href?<a href={a.href}>{a.title}</a>:a.title}</h3><p>{a.summary}</p>{!a.href&&<small>僅為示範標題，尚無全文</small>}</article>)}</div></section>
        <section class="signature"><span class="eyebrow">A SMALL INTRODUCTION</span><p>{site.copy.p5??(route==='about'?site.aboutFields[0]:'')}</p><a href={base+'about/'}>關於這本手記 →</a></section>
      </>}
      {route==='articles' && <><section class="pagehead"><p class="eyebrow">ALL NOTES / 01–03</p><h1>{route===''?site.headline:route==='about'?site.about:route==='articles'?'文章索引':route==='services'?'服務資訊':detailRecord?.title}</h1><p>{site.copy.p6??(route==='about'?site.aboutFields[1]:'')}</p></section><div class="archive">{articles.map(a=><article><span class="meta">{a.date}<br/>{a.tag}</span><div><h2>{a.href?<a href={a.href}>{a.title} ↗</a>:a.title}</h2><p>{a.summary}</p>{!a.href&&<small>尚未撰寫全文</small>}</div></article>)}</div></>}
      {(route??'').startsWith('articles/') && <><article class="reading"><p class="eyebrow">01 / OBSERVATION · 2026-10-14</p><h1>{detailRecord?.title??'目前沒有公開文章'}</h1><p class="lead">{route==='about'?site.bio:detailRecord?.summary??site.intro}</p><div class="prose">{route==='about'?<><p>{site.bio}</p>{site.aboutFields.map(p=><p>{p}</p>)}</>:<slot/>}</div><a class="line-link" href={base+'articles/'}>← 回文章索引</a></article></>}
      {route==='about' && <><section class="pagehead"><p class="eyebrow">AUTHOR / ABOUT</p><h1>{site.about}</h1><p>{site.bio}</p></section><section class="about-grid"><div class="initial" aria-label="尚未配置作者照片">{config.brand.heroImagePath?<img class="native-owned-image" src={root+config.brand.heroImagePath.slice(1)} alt={config.brand.heroImageAlt||'網站持有人提供的圖片'}/>:<Fragment>照片<br/>選填</Fragment>}</div><div><h2>寫作從哪裡開始？</h2><p>{site.aboutFields.filter(Boolean).join('\n\n')}</p><h2>如何持續整理？</h2><p>{site.aboutFields.filter(Boolean).join('\n\n')}</p><a class="line-link" href={base+'articles/'}>看看筆記 →</a></div></section></>}
      {extra&&<section class="native-extra"><slot/></section>}{route==='articles'&&site.articles.length===0&&<p class="archive-empty">目前沒有公開文章。</p>}{route==='services'&&site.services.length===0&&<p>尚未提供正式服務。</p>}<footer><span>{site.siteName}</span><a href={root}>回首頁 ↑</a></footer>
    </div>
  </div>
</div>

<style>
.journal{--j-ink:#242a24;--j-muted:#58645a;--j-rule:#c6c8bc;background:#f4f1e8;color:var(--j-ink);font-family:'Noto Sans TC',system-ui,sans-serif;line-height:1.85;min-height:100vh}.journal a{color:inherit;text-decoration:none}.journal a:hover{text-decoration:underline;text-underline-offset:5px}.frame{max-width:1360px;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) 280px;min-height:100vh}.rail{grid-column:2;grid-row:1;border-left:1px solid var(--j-ink);padding:48px 32px;position:sticky;top:0;align-self:start;height:100vh;display:flex;flex-direction:column}.brand{font-size:24px;font-weight:700;line-height:1.4}.brand span{display:block;font:12px ui-monospace,monospace;letter-spacing:.08em;margin-top:8px}.rail-intro{font-size:16px;max-width:20ch;margin:64px 0}.rail nav{display:grid}.rail nav a{border-top:1px solid var(--j-rule);padding:16px 0;display:flex;gap:24px;font:14px ui-monospace,monospace;min-height:56px}.rail nav a span{font:16px 'Noto Sans TC',sans-serif}.rail nav a[aria-current]{font-weight:700}.rail-bottom{margin-top:auto;font-size:13px;line-height:1.8}.rail-bottom strong,.eyebrow,.meta,.top{font:12px ui-monospace,monospace;letter-spacing:.06em}.rail-bottom a{display:inline-flex;min-height:44px;align-items:center}.body{grid-column:1;grid-row:1;min-width:0;padding:0 64px}.top{padding:24px 0;border-bottom:1px solid var(--j-rule);display:flex;justify-content:space-between;gap:24px}.intro{padding:32px 0 24px;max-width:800px;border-bottom:1px solid var(--j-rule)}.eyebrow,.meta{color:var(--j-muted)}h1,h2,h3,p{overflow-wrap:anywhere}h1{font:400 clamp(44px,5vw,76px)/1.22 Georgia,'Noto Serif TC',serif;letter-spacing:-.025em;text-wrap:balance;margin:32px 0} .intro h1{font-size:clamp(30px,3vw,46px);margin:12px 0}h1 em{display:block;font-style:normal;color:#355747}.lead{font-size:20px;max-width:34ch}.line-link{display:inline-flex;align-items:center;min-height:44px;border-bottom:1px solid currentColor;margin-top:24px}.desk{display:block;padding:24px 0 96px}.desk-label{display:flex;align-items:baseline;justify-content:space-between;gap:24px;flex-wrap:wrap}.desk-label h2{font-size:22px}.desk-label p{max-width:40ch}.desk-label h2{font:400 32px Georgia,'Noto Serif TC',serif}.desk-label p{max-width:25ch}.entry{padding:24px 0 32px;border-bottom:1px solid var(--j-rule)}.entry:first-child{padding-top:0}.entry h3{font:400 clamp(24px,3vw,36px)/1.3 Georgia,'Noto Serif TC',serif;margin:16px 0}.entry p{max-width:52ch}.entry small,.archive small{color:var(--j-muted)}.signature{background:#e7ece5;padding:48px;margin-bottom:96px}.signature>p{font:400 clamp(24px,3vw,40px)/1.5 Georgia,'Noto Serif TC',serif;max-width:26ch}.pagehead{padding:80px 0 64px;max-width:760px}.pagehead>p:last-child{font-size:18px;max-width:50ch}.archive article{display:grid;grid-template-columns:110px minmax(0,1fr);gap:32px;padding:32px 0;border-top:1px solid var(--j-rule)}.archive h2{font:400 clamp(24px,3vw,36px) Georgia,'Noto Serif TC',serif;margin:0}.archive p{max-width:60ch}.reading{padding:80px 0 96px;max-width:780px}.reading h1{font-size:clamp(40px,5vw,68px)}.prose{max-width:65ch;margin:64px 0;font-size:18px;line-height:1.95}.prose h2{font:400 32px Georgia,'Noto Serif TC',serif;margin-top:64px}.prose blockquote{margin:48px 0;border-left:2px solid #355747;padding-left:24px;font:italic 24px/1.7 Georgia,'Noto Serif TC',serif}.about-grid{display:grid;grid-template-columns:1fr 2fr;gap:64px;padding:32px 0 96px}.initial{background:#e7ece5;min-height:320px;display:grid;place-content:center;text-align:center;color:var(--j-muted)}.about-grid h2{font:400 32px Georgia,'Noto Serif TC',serif}.about-grid p{max-width:55ch}.body footer{border-top:1px solid var(--j-rule);padding:32px 0 64px;display:flex;gap:24px;flex-wrap:wrap;justify-content:space-between;font-size:14px}@media(max-width:980px){.frame{grid-template-columns:minmax(0,1fr) 220px}.rail{padding:32px 24px}.body{padding:0 32px}.desk{gap:24px}}@media(max-width:700px){.frame{display:block}.rail{grid-column:auto;grid-row:auto;position:static;height:auto;border-left:0;border-bottom:1px solid var(--j-ink);padding:24px 20px}.rail-intro,.rail-bottom{display:none}.rail nav{display:flex;flex-wrap:wrap;gap:16px;margin-top:16px}.rail nav a{border:0;padding:0;min-height:44px}.rail nav a span{font-size:16px}.body{grid-column:auto;grid-row:auto;padding:0 20px}.top{padding:16px 0;flex-wrap:wrap}.intro{padding:64px 0 96px}.desk{display:block;padding:40px 0 64px}.desk-label{margin-bottom:40px}.signature{margin:0 0 64px;padding:24px}.pagehead,.reading{padding:48px 0}.archive article{grid-template-columns:68px minmax(0,1fr);gap:16px}.about-grid{display:block}.initial{min-height:200px;margin-bottom:32px}.prose{font-size:17px}}
.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 system-ui,sans-serif;padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
.article-contract-body{font-size:1rem;line-height:1.8;max-width:65ch}
</style>
<style>.native-extra{padding:48px 0} .native-extra h1{overflow-wrap:anywhere} :global(.student-navigation){min-width:0} h1{overflow-wrap:anywhere;text-wrap:balance} .prose :global(pre),.prose :global(table){max-width:100%;overflow:auto} .prose :global(table){display:block}</style>

<style>p:empty{display:none} .native-owned-image{width:100%;height:100%;object-fit:cover} </style>
