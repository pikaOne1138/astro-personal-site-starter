---
import config from '../../../../site.config.json';
import StudentNavigation from '../../StudentNavigation.astro';
import {getSite} from './content.mjs';
const {route='',entry=null,extra=false}=Astro.props;
const page=route,root=import.meta.env.BASE_URL,base=root;
const site=await getSite(root);
const detailRecord=site.kind==='knowledge'?site.articles.find(a=>a.slug===entry?.id)??site.primary:site.services.find(s=>route==='services/'+s.slug)??site.primary;
const service=detailRecord??{name:'尚未設定服務',title:'尚未設定服務',description:'服務資訊待設定',fit:'待確認',format:'待設定',duration:'待設定',price:'待設定',scope:'待核實',credential:'待核實',body:[],href:undefined};
const articles=site.articles,posts=site.articles,rows=site.articles;
const entries=site.kind==='knowledge'?site.articles:site.questions;
const items=entries.map(a=>a.title??a.question),demo=site.intro;
const chapters=site.questions.map((q,i)=>[String(i+1).padStart(2,'0'),q.question,q.answer]);
const availableServices=site.services;
const facts=[['服務對象',service.fit],['服務形式',service.format],['時間',service.duration],['費用',service.price],['服務界線',service.scope],['資格與來源',service.credential]];
const info=facts,title=site.siteName,name=site.siteName;
const indexUrl=root+(site.kind==='knowledge'?'articles/':'services/'),detailUrl=site.primary?.href??indexUrl;
---


<div data-article-count={route==='articles'||(route===''&&site.kind==='knowledge')?site.articles.length:undefined} data-service-count={route==='services'?site.services.length:undefined} data-native-page="portrait-profile" class="profile">
 <header class="header"><a class="brand" href={root}>{site.siteName}</a><StudentNavigation/></header>
 {page===''&&<>
 <section class="hero"><div class="picture">{config.brand.heroImagePath?<img class="native-owned-image" src={root+config.brand.heroImagePath.slice(1)} alt={config.brand.heroImageAlt||'網站持有人提供的圖片'}/>:<Fragment><span>PORTRAIT</span><strong class="initial-mark" aria-hidden="true">人</strong><b>個人照片選填</b><small>明確示意，不是真實人物</small></Fragment>}</div><div class="identity"><span class="label">PERSON FIRST / SERVICE SECOND</span><h1>{route===''?site.headline:route==='about'?site.about:route==='articles'?'文章索引':route==='services'?'服務資訊':detailRecord?.title}</h1><p class="lead">{route==='about'?site.bio:route===''?site.intro:detailRecord?.summary??site.intro}</p><a class="cta" data-primary-cta="home" href={site.primaryCta.href}>{site.primaryCta.label} ↗</a><a class="textlink" href={root+'services/'}>了解服務方式 →</a></div></section>
 <section class="statement"><p class="label">01 / APPROACH</p><h2>專業如何被理解，從清楚的介紹開始。</h2><p>{site.copy.p2??(route==='about'?site.aboutFields[1]:'')}</p></section>
 <section class="steps"><div><p class="label">02 / BEFORE CONTACT</p><h2>第一次接觸之前</h2></div><div>{[['閱讀服務範圍','確認是否符合需求，了解哪些事情不在服務範圍。'],['核對實際資料','資格、形式、費用及取消規則須有真實來源。'],['再選擇聯絡方式','確認正式管道完成設定後才展示可使用的按鈕。']].map(([name,desc],i)=><article><b>0{i+1}</b><div><h3>{name}</h3><p>{desc}</p></div></article>)}</div></section>
 <section class="end"><p class="label">SERVICE / NEXT</p><h2>只有一項服務，也能清楚介紹。</h2><a class="cta" href={root+'services/'}>閱讀服務資訊 ↗</a></section>
 </>}
 {page==='services'&&<><section class="pagehead"><p class="label">SERVICES / OVERVIEW</p><h1>{route===''?site.headline:route==='about'?site.about:route==='articles'?'文章索引':route==='services'?'服務資訊':detailRecord?.title}</h1><p class="lead">{route==='about'?site.bio:route===''?site.intro:detailRecord?.summary??site.intro}</p></section><section class="service"><span class="label">01 / SERVICE</span><div><h2>{detailRecord?.title??'尚未設定服務'}</h2><p>{site.copy.p4??(route==='about'?site.aboutFields[3]:'')}</p><a class="textlink" href={(site.primary?.href??root+'services/')}>查看詳細頁 →</a></div></section><section class="facts"><h2>應公開的基本資訊</h2><dl>{facts.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl><div class="additional-services">{site.services.slice(1).map(item=><article><h3>{item.name}</h3><p>{item.description}</p>{item.href?<a href={item.href}>詳細說明 →</a>:<span>尚未公開</span>}</article>)}</div></section></>}
 {(route??'').startsWith('services/')&&<><section class="pagehead"><p class="label">SERVICE / DETAIL</p><h1>{detailRecord?.title??'尚未設定服務'}</h1><p class="lead">{route==='about'?site.bio:route===''?site.intro:detailRecord?.summary??site.intro}</p></section><div class="detail"><aside><span class="label">本頁目錄</span><a href="#fit">適合與限制</a><a href="#terms">必要資訊</a><a href="#contact">下一步</a></aside><div><section id="fit"><div class="article-contract-body">{service.body.map(p=><p>{p}</p>)}</div><h2>先確認服務是否適合</h2><div class="pair"><div><h3>適合誰</h3><p>{site.copy.p6??(route==='about'?site.aboutFields[1]:'')}</p></div><div><h3>不適合與界線</h3><p>{site.copy.p7??(route==='about'?site.aboutFields[2]:'')}</p></div></div></section><section id="terms"><h2>合作資訊</h2><dl>{facts.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></section><section id="contact"><h2>由訪客決定下一步</h2><p>{site.copy.p8??(route==='about'?site.aboutFields[3]:'')}</p><a class="textlink" href={root+'services/'}>← 回服務總覽</a></section></div></div></>}
 {page==='about'&&<><section class="about"><div><p class="label">ABOUT / PERSON</p><h1>{site.about}</h1><p class="lead">{route==='about'?site.bio:route===''?site.intro:detailRecord?.summary??site.intro}</p></div><div class="picture">{config.brand.heroImagePath?<img class="native-owned-image" src={root+config.brand.heroImagePath.slice(1)} alt={config.brand.heroImageAlt||'網站持有人提供的圖片'}/>:<Fragment><span>OPTIONAL IMAGE</span><strong>真實照片<br/>待配置</strong></Fragment>}</div></section><section class="biography"><div><p class="label">MY PRACTICE</p><h2>如何工作，比頭銜更值得清楚說明。</h2></div><div><h3>工作目的</h3><p>{site.aboutFields[0]}</p><h3>工作方式</h3><p>{site.aboutFields[1]}</p><a class="textlink" href={root+'services/'}>理解服務內容 →</a><h2>背景與來源</h2><p>{site.aboutFields[2]}</p></div></section></>}
 {route.startsWith('services/')&&detailRecord?.bookingUrl&&<p class="native-booking"><a href={detailRecord.bookingUrl} rel="noopener noreferrer">前往正式預約頁 ↗</a></p>}{extra&&<section class="native-extra"><slot/></section>}{(route==='articles'||(route===''&&site.kind==='knowledge'))&&site.articles.length===0&&<p class="archive-empty">目前沒有公開文章。</p>}{route==='services'&&site.services.length===0&&<section class="native-unconfigured"><p>尚未提供正式服務。</p><dl>{[['服務範圍',config.serviceFacts?.scope],['服務方式',config.serviceFacts?.method],['服務時間',config.serviceFacts?.duration],['實際費用',config.serviceFacts?.price],['資格與來源',config.serviceFacts?.qualification],['取消政策',config.serviceFacts?.cancellation]].filter(([,value])=>value).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>}<footer><span>{site.siteName}</span><a href={root}>回首頁 ↑</a></footer>
</div>

<style>
.profile{--line:color-mix(in srgb,var(--ink) 30%,var(--bg));--paper:var(--bg);--soft:color-mix(in srgb,var(--brand) 10%,var(--bg));background:var(--paper);color:var(--ink);font-family:'Noto Sans TC',system-ui,sans-serif;line-height:1.85;min-height:100vh}.profile a{color:inherit;text-decoration:none}.profile a:hover{text-decoration:underline;text-underline-offset:4px}.header,.hero,.statement,.steps,.end,.pagehead,.service,.facts,.detail,.about,.biography,footer{padding-inline:max(24px,calc((100% - 1200px)/2))}.header{display:flex;justify-content:space-between;align-items:center;gap:24px;border-bottom:1px solid var(--line);min-height:112px}.brand{font:400 24px var(--serif)}.brand small{display:block;font:12px ui-monospace,monospace}.header nav{display:flex;gap:16px 32px;flex-wrap:wrap}.header nav a{display:inline-flex;align-items:center;min-height:44px}.hero{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,7fr);gap:clamp(32px,6vw,96px);align-items:center;padding-block:64px 96px}.picture{min-height:480px;padding:32px;background:var(--soft);display:flex;flex-direction:column;justify-content:space-between;color:var(--brand);position:relative}.picture:after{position:absolute;content:'';inset:16px;border:1px solid #aab9ac;pointer-events:none}.picture span,.picture small,.label{font:12px ui-monospace,monospace;letter-spacing:.06em}.picture strong{font:400 clamp(32px,4vw,56px)/1.3 var(--serif);text-align:center}.profile h1{font:400 clamp(40px,5vw,76px)/1.2 var(--serif);letter-spacing:-.025em;text-wrap:balance}.profile h1 em{display:block;font-style:normal;color:var(--brand)}.profile h2{font:400 clamp(32px,4vw,48px)/1.3 var(--serif)}.profile h3{font-size:20px}.lead{font-size:20px;max-width:45ch}.cta,.textlink{min-height:48px;display:inline-flex;align-items:center;margin:16px 20px 0 0}.cta{background:var(--ink);color:var(--paper)!important;padding:12px 24px}.textlink{border-bottom:1px solid currentColor}.statement{background:var(--soft);padding-block:96px;display:grid;grid-template-columns:1fr 2fr 1fr;gap:32px}.statement h2{margin:0}.steps{padding-block:128px;display:grid;grid-template-columns:1fr 1.4fr;gap:64px}.steps article{display:grid;grid-template-columns:64px minmax(0,1fr);gap:24px;padding:24px 0;border-top:1px solid var(--line)}.steps article b{font:32px var(--serif)}.steps article h3,.steps article p{margin:0}.end{padding-block:96px 128px;background:var(--soft)}.pagehead{padding-block:96px}.pagehead h1{max-width:14ch}.service{display:grid;grid-template-columns:1fr 2fr;gap:64px;padding-block:64px;border-top:1px solid var(--line)}.facts{padding-block:64px 96px;background:var(--soft)}.facts dl,.detail dl{max-width:850px}.facts dl>div,.detail dl>div{display:grid;grid-template-columns:220px minmax(0,1fr);gap:24px;padding:20px 0;border-bottom:1px solid var(--line)}dd{margin:0}dt{font-weight:700}.detail{display:grid;grid-template-columns:180px minmax(0,1fr);gap:64px;padding-block:64px 128px}.detail aside{align-self:start;position:sticky;top:24px;display:flex;flex-direction:column;gap:8px}.detail aside a{display:flex;align-items:center;min-height:44px}.detail section{padding-block:48px;scroll-margin-top:32px}.detail section+section{border-top:1px solid var(--line)}.pair{display:grid;grid-template-columns:1fr 1fr;gap:24px}.pair>div{background:var(--soft);padding:24px}.about{display:grid;grid-template-columns:1.2fr .8fr;gap:64px;padding-block:96px}.about .picture{min-height:420px}.biography{display:grid;grid-template-columns:1fr 1fr;gap:64px;padding-block:96px 128px;border-top:1px solid var(--line)}.biography p{font-size:18px}.profile footer{display:flex;gap:16px 32px;flex-wrap:wrap;align-items:center;padding-block:48px;border-top:1px solid var(--line);font-size:14px}.profile footer p{flex-basis:100%}.profile h1,.profile h2,.profile p,.profile dd{overflow-wrap:anywhere}@media(max-width:900px){.header{display:block;padding-block:24px}.header nav{margin-top:24px}.statement{grid-template-columns:1fr 2fr}.statement p:last-child{grid-column:2}}@media(max-width:700px){.hero,.statement,.steps,.service,.detail,.about,.biography{display:block}.hero{padding-block:32px 64px}.picture{min-height:320px}.hero .identity{padding-top:48px}.statement,.steps,.end,.pagehead,.about,.biography{padding-block:48px}.statement h2{margin-block:24px}.steps article{grid-template-columns:48px 1fr}.service{padding-block:48px}.detail aside{position:static;border-bottom:1px solid var(--line);padding-bottom:32px}.facts dl>div,.detail dl>div{display:block}.facts dt,.detail dt{margin-bottom:8px}.pair{display:block}.pair>div+div{margin-top:16px}.about .picture{margin-top:48px}.profile h1{font-size:clamp(40px,9vw,56px)}}
.initial-mark{font:400 clamp(88px,12vw,180px)/1 var(--serif);display:block;opacity:.45}.picture b{font-weight:500;letter-spacing:.04em}.picture:has(.initial-mark){align-items:center;text-align:center}.hero .picture{border:1px solid var(--line)}
.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 system-ui,sans-serif;padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
.article-contract-body{font-size:1rem;line-height:1.8;max-width:65ch}
</style>
<style>.native-extra{padding:48px 0} .native-extra h1{overflow-wrap:anywhere} :global(.student-navigation){min-width:0} h1{overflow-wrap:anywhere;text-wrap:balance} .prose :global(pre),.prose :global(table){max-width:100%;overflow:auto} .prose :global(table){display:block}</style>

<style>.native-service-facts>div{display:grid;grid-template-columns:minmax(7em,1fr) minmax(0,3fr);gap:16px;border-bottom:1px solid currentColor;padding:16px 0}.native-service-facts dd{margin:0} p:empty{display:none} .native-owned-image{width:100%;height:100%;object-fit:cover} </style>

<style>dl>div{display:grid;grid-template-columns:minmax(7em,1fr) minmax(0,2fr);gap:16px;padding-block:16px}dd{margin:0}.additional-services article{padding:24px;border:1px solid var(--line);margin-block:24px;background:var(--bg)}@media(max-width:600px){dl>div{display:block}dt{margin-bottom:8px}}</style>

<style>.native-booking{padding:24px;max-width:1200px;margin:auto}.native-booking a{display:inline-flex;min-height:44px;align-items:center;text-decoration:underline}</style>
