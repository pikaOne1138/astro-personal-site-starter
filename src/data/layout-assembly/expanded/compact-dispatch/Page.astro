---
import config from '../../../../site.config.json';
import StudentNavigation from '../../StudentNavigation.astro';
import {getSite} from './content.mjs';
const {route='',entry=null,extra=false}=Astro.props;
const page=route,root=import.meta.env.BASE_URL,base=root;
const site=await getSite(root);
const detailRecord=site.kind==='knowledge'?site.articles.find(a=>a.slug===entry?.id)??site.primary:site.services.find(s=>route==='services/'+s.slug)??site.primary;
const service=detailRecord??{name:'尚未設定服務',title:'尚未設定服務',description:'服務資訊待設定',fit:'待確認',format:'待設定',duration:'待設定',price:'待設定',scope:'待核實',credential:'待核實',body:[],href:undefined};
const articles=site.articles,posts=site.articles,rows=site.articles;
const entries=site.kind==='knowledge'?site.articles:site.questions;
const items=entries.map(a=>a.title??a.question),demo=site.intro;
const chapters=site.questions.map((q,i)=>[String(i+1).padStart(2,'0'),q.question,q.answer]);
const availableServices=site.services;
const facts=[['服務對象',service.fit],['服務形式',service.format],['時間',service.duration],['費用',service.price],['服務界線',service.scope],['資格與來源',service.credential]];
const info=facts,title=site.siteName,name=site.siteName;
const indexUrl=root+(site.kind==='knowledge'?'articles/':'services/'),detailUrl=site.primary?.href??indexUrl;
---


<div class="direction dispatch"  data-native-page="compact-dispatch" data-article-count={route==='articles'?site.articles.length:undefined} data-service-count={route==='services'?site.services.length:undefined}><div class="wrap">
<header class="nav"><a class="brand" href={root}>{site.siteName}</a><StudentNavigation/></header>
{(page===''||page==='articles')&&<><section class="intro"><span class="tiny">KNOWLEDGE / ROWS</span><h1>{route===''?site.headline:route==='about'?site.about:route==='articles'?'文章索引':route==='services'?'服務資訊':detailRecord?.title}</h1><p>{site.intro}</p></section><div class="dispatch-list">{items.map((t,i)=><a href={entries[i]?.href??indexUrl} class="dispatch-row"><time datetime={entries[i]?.date}>{entries[i]?.date}</time><h2>{t}</h2><span>READ ↗</span></a>)}</div></>}
{(route??'').startsWith('articles/')&&<><section class="intro"><span class="tiny">ARTICLE DETAIL</span><h1>{detailRecord?.title??'目前沒有公開文章'}</h1><p>{demo}</p></section><article class="prose narrow">{route==='about'?<><p>{site.bio}</p>{site.aboutFields.map(p=><p>{p}</p>)}</>:<slot/>}</article><div class="contract-body" aria-label="可編輯詳細內容">{(detailRecord?.body??[]).map(paragraph=><p>{paragraph}</p>)}</div><p class="back"><a href={indexUrl}>← 返回索引</a></p></>}
{page==='about'&&<><section class="intro"><span class="tiny">ABOUT / ROWS</span><h1>{site.about}</h1></section><article class="prose narrow">{route==='about'?<><p>{site.bio}</p>{site.aboutFields.map(p=><p>{p}</p>)}</>:<slot/>}</article></>}
{route.startsWith('services/')&&detailRecord?.bookingUrl&&<p class="native-booking"><a href={detailRecord.bookingUrl} rel="noopener noreferrer">前往正式預約頁 ↗</a></p>}{extra&&<section class="native-extra"><slot/></section>}{route==='articles'&&site.articles.length===0&&<p class="archive-empty">目前沒有公開文章。</p>}{route==='services'&&site.services.length===0&&<section class="native-unconfigured"><p>尚未提供正式服務。</p><dl>{[['服務範圍',config.serviceFacts?.scope],['服務方式',config.serviceFacts?.method],['服務時間',config.serviceFacts?.duration],['實際費用',config.serviceFacts?.price],['資格與來源',config.serviceFacts?.qualification],['取消政策',config.serviceFacts?.cancellation]].filter(([,value])=>value).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>}<footer><span>{site.siteName}</span><a href={root}>回首頁 ↑</a></footer>
</div></div>
<style>
.direction{--ink:#242a24;--soft:#e7ece5;--line:#b5bdb1;background:#f4f1e8;color:var(--ink);min-height:100vh;font:17px/1.85 'Noto Sans TC',system-ui,sans-serif}.wrap{width:min(100% - 48px,1180px);margin:auto}.direction a{color:inherit;text-decoration:none}.direction a:hover{text-decoration:underline;text-underline-offset:4px}.direction a:focus-visible{outline:3px solid #355747}.tiny{font:12px ui-monospace,monospace;letter-spacing:.1em;color:#496251}.nav{display:flex;justify-content:space-between;gap:20px;align-items:center;border-bottom:1px solid var(--ink);padding:24px 0}.nav nav{display:flex;flex-wrap:wrap;gap:12px 24px}.nav nav a{display:inline-flex;min-height:44px;align-items:center}.brand{font:400 28px Georgia,'Noto Serif TC',serif}.brand small{display:block;font:12px ui-monospace,monospace}.intro{padding:80px 0 64px;border-bottom:1px solid var(--ink)}.intro h1{font:400 clamp(42px,6vw,76px)/1.22 Georgia,'Noto Serif TC',serif;letter-spacing:-.03em;max-width:18ch}.direction h2{font:400 clamp(29px,4vw,48px)/1.3 Georgia,'Noto Serif TC',serif}.image-sequence{padding:64px 0}.image-story{display:grid;grid-template-columns:7fr 5fr;gap:64px;align-items:center;margin-bottom:112px}.image-story.flip{grid-template-columns:5fr 7fr}.image-story.flip .image-fallback{order:2}.image-fallback{background:var(--soft);min-height:420px;padding:24px;display:flex;align-items:flex-end;font:12px ui-monospace,monospace}.story-copy{max-width:37ch}.dispatch .intro{padding:24px 0 40px}.dispatch .intro h1{font-size:clamp(30px,4vw,52px)}.dispatch-list{padding-bottom:80px}.dispatch-row{display:grid;grid-template-columns:90px 1fr 90px;gap:24px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line)}.dispatch-row h2{font-size:25px;margin:0}.dispatch-row time,.dispatch-row span{font:12px ui-monospace,monospace}.split-reader{display:grid;grid-template-columns:5fr 7fr;gap:64px;padding:64px 0 112px}.lead{background:var(--soft);padding:36px;align-self:start}.article-index>a{display:grid;grid-template-columns:36px 1fr 24px;gap:20px;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)}.article-index h3{font:400 24px Georgia,'Noto Serif TC',serif}.opinion-layout{display:grid;grid-template-columns:7fr 4fr;gap:76px;padding:64px 0 112px}.opinion{font-size:21px}.side-notes{border-top:1px solid var(--ink);padding-top:24px}.side-notes p{padding-bottom:24px;border-bottom:1px solid var(--line)}.question-flow{padding-bottom:80px}.question-row{display:grid;grid-template-columns:3fr 8fr;gap:72px;border-bottom:1px solid var(--line);padding:56px 0}.question{display:flex;gap:24px}.question h2{margin:0}.question span{font:12px ui-monospace,monospace}.answer{font-size:21px;max-width:42ch}.prose{font-size:21px;line-height:2;max-width:65ch;padding:24px 0 80px}.narrow{max-width:46ch}.back{padding:24px 0 80px}.direction footer{border-top:1px solid var(--ink);padding:32px 0 64px;display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;font:12px ui-monospace,monospace}.direction footer p{flex-basis:100%}.direction h1,.direction h2,.direction p{overflow-wrap:anywhere}@media(max-width:800px){.image-story,.opinion-layout,.split-reader,.question-row{gap:32px}}@media(max-width:600px){.wrap{width:min(100% - 40px,1180px)}.nav{display:block}.nav nav{margin-top:20px}.intro{padding:40px 0}.image-story,.image-story.flip,.split-reader,.opinion-layout,.question-row{display:block}.image-story{margin-bottom:72px}.image-story.flip .image-fallback{order:0}.image-fallback{min-height:280px}.story-copy,.answer,.side-notes{margin-top:28px}.dispatch-row{grid-template-columns:70px 1fr;gap:8px}.dispatch-row span{grid-column:2}.question-row{padding:32px 0}}
.content-contract{border-top:1px solid var(--line);padding:24px 0}.content-contract p{margin:4px 0}.contract-body{max-width:64ch;font-size:18px;line-height:1.9;margin:32px 0}
</style>
<style>.native-extra{padding:48px 0} .native-extra h1{overflow-wrap:anywhere} :global(.student-navigation){min-width:0} h1{overflow-wrap:anywhere;text-wrap:balance} .prose :global(pre),.prose :global(table){max-width:100%;overflow:auto} .prose :global(table){display:block}</style>

<style>.native-story-image{width:100%;max-height:640px;object-fit:cover} p:empty{display:none} .native-owned-image{width:100%;height:100%;object-fit:cover} </style>

<style>dl>div{display:grid;grid-template-columns:minmax(7em,1fr) minmax(0,2fr);gap:16px;padding-block:16px}dd{margin:0}.additional-services article{padding:24px;border:1px solid var(--line);margin-block:24px;background:#fffefa}@media(max-width:600px){dl>div{display:block}dt{margin-bottom:8px}}</style>

<style>.native-booking{padding:24px;max-width:1200px;margin:auto}.native-booking a{display:inline-flex;min-height:44px;align-items:center;text-decoration:underline}</style>
