---
import config from '../../../../site.config.json';
import StudentNavigation from '../../StudentNavigation.astro';
import OwnerImage from '../../OwnerImage.astro';
import {getSite} from './content.mjs';
const {route='',entry=null,extra=false}=Astro.props;
const page=route,root=import.meta.env.BASE_URL,base=root;
const site=await getSite(root);
const detailRecord=site.kind==='knowledge'?site.articles.find(a=>a.slug===entry?.id)??site.primary:site.services.find(s=>route==='services/'+s.slug)??site.primary;
const service=detailRecord??{name:'尚未設定服務',title:'尚未設定服務',description:'服務資訊待設定',fit:'待確認',format:'待設定',duration:'待設定',price:'待設定',scope:'待核實',credential:'待核實',body:[],href:undefined};
const articles=site.articles,posts=site.articles,rows=site.articles;
const entries=site.kind==='knowledge'?site.articles:site.questions;
const items=entries.map(a=>a.title??a.question),demo=site.intro;
const chapters=site.questions.map((q,i)=>[String(i+1).padStart(2,'0'),q.question,q.answer]);
const availableServices=site.services;
const facts=[['服務對象',service.fit],['服務形式',service.format],['時間',service.duration],['費用',service.price],['服務界線',service.scope],['資格與來源',service.credential]];
const info=facts,title=site.siteName,name=site.siteName;
const indexUrl=root+(site.kind==='knowledge'?'articles/':'services/'),detailUrl=site.primary?.href??indexUrl;
---


<div data-article-count={route==='articles'||(route===''&&site.kind==='knowledge')?site.articles.length:undefined} data-service-count={route==='services'?site.services.length:undefined} data-native-page="editorial-frontpage" class="publication">
<div class="canvas">
 <header class="masthead"><div class="mast-meta"><span>ISSUE / 001</span><span>獨立個人刊物 · </span></div><a class="brand" href={base}><OwnerImage role="logo"/></a><StudentNavigation/></header>
 {page===''&&<>
 <section class="front"><p class="section-label">FEATURED STORIES / 2026</p><div class="spread"><article class="lead"><span class="tag">{rows[0]?'01 / FEATURE':'THE AUTHOR'}</span><h1>{rows[0]?<a href={rows[0].href}>{rows[0].title}</a>:site.headline}</h1><p class="summary">{rows[0]?.sub??site.intro}</p>{rows[0]?.href?<a class="read" href={rows[0].href}>閱讀本期主文 ↗</a>:<span>目前沒有公開主文</span>}</article><div class="secondary">{rows.slice(1).map(row=><article><span class="tag">{row.no} · {row.topic}</span><h2><a href={row.href}>{row.title}</a></h2><p>{row.sub}</p></article>)}</div></div></section>
 <section class="lower"><div><span class="section-label">EDITOR'S NOTE</span><h2>{site.headline}</h2><p>{site.intro}</p><a class="read" data-primary-cta="home" href={site.primaryCta.href}>{site.primaryCta.label} →</a></div><div><span class="section-label">CONTENTS / ALL</span>{rows.map(row=><article class="contents"><b>{row.no}</b><div><span class="tag">{row.topic}</span>{row.href?<h3><a href={row.href}>{row.title}</a></h3>:<h3><a href={row.href}>{row.title}</a></h3>}</div></article>)}<a class="read" href={base+'articles/'}>全部索引 →</a></div></section>
 </>}
 {page==='articles'&&<><section class="pagehead"><span class="section-label">ISSUE / ARCHIVE</span><h1>{route===''?site.headline:route==='about'?site.about:route==='articles'?'文章索引':route==='services'?'服務資訊':detailRecord?.title}</h1><p>{site.copy.p2??(route==='about'?site.aboutFields[1]:'')}</p></section>{rows.length>0&&<section class="archive"><article class="featured"><span class="tag">FEATURE / {rows[0]?.topic??'尚無主題'}</span><h2><a href={(rows[0]?.href??base+'articles/')}>{(rows[0]?.title??'目前沒有公開文章')}</a></h2><p>{rows[0]?.sub??site.intro}</p><a class="read" href={(rows[0]?.href??base+'articles/')}>閱讀 →</a></article><div>{rows.slice(1).map(row=><article class="archive-row"><span class="tag">{row.no} / {row.topic}</span><h3><a href={row.href}>{row.title}</a></h3><p>{site.copy.p3??(route==='about'?site.aboutFields[2]:'')}</p></article>)}</div></section>}</>}
 {(route??'').startsWith('articles/')&&<><section class="article-head"><span class="tag">ARTICLE / 觀察</span><h1>{detailRecord?.title??'目前沒有公開文章'}</h1><p class="summary">{detailRecord?.summary}</p></section><div class="reading"><aside><span class="section-label">IN THIS ARTICLE</span><a href={indexUrl}>01 看見</a><a href={indexUrl}>02 整理</a><a href={base+'articles/'}>← 文章目錄</a></aside><article class="prose">{route==='about'?<><p>{site.bio}</p>{site.aboutFields.map(p=><p>{p}</p>)}</>:<slot/>}</article></div><section class="related"><span class="section-label">NEXT IN THE ISSUE</span>{rows.slice(1).map(row=><article><span>{row.no} / {row.topic}</span><h3><a href={row.href}>{row.title}</a></h3></article>)}</section></>}
 {page==='about'&&<><section class="pagehead"><span class="section-label">THE WRITER / ABOUT</span><h1>{site.about}</h1><p>{site.bio}</p></section><section class="bio"><div class="initial native-image-slot">{config.brand.heroImagePath?<OwnerImage fill/>:<Fragment><span>AUTHOR IMAGE</span><strong>作者照片<br/>可選填</strong></Fragment>}</div><div><h2>{site.headings?.['h2-01']??<Fragment>寫什麼，為何寫？</Fragment>}</h2><p>{site.aboutFields[0]}</p><h2>{site.headings?.['h2-02']??<Fragment>從哪篇開始？</Fragment>}</h2><p>{site.aboutFields[1]}</p><a class="read" href={(rows[0]?.href??base+'articles/')}>閱讀文章 →</a><h2>{site.headings?.['h2-03']??<Fragment>背景與來源</Fragment>}</h2><p>{site.aboutFields[2]}</p></div></section></>}
 {route.startsWith('services/')&&detailRecord?.bookingUrl&&<p class="native-booking"><a href={detailRecord.bookingUrl} rel="noopener noreferrer">前往正式預約頁 ↗</a></p>}{extra&&<section class="native-extra"><slot/></section>}{(route==='articles'||(route===''&&site.kind==='knowledge'))&&site.articles.length===0&&<p class="archive-empty">目前沒有公開文章。</p>}{route==='services'&&site.services.length===0&&<section class="native-unconfigured"><p>尚未提供正式服務。</p><dl>{[['服務範圍',config.serviceFacts?.scope],['服務方式',config.serviceFacts?.method],['服務時間',config.serviceFacts?.duration],['實際費用',config.serviceFacts?.price],['資格與來源',config.serviceFacts?.qualification],['取消政策',config.serviceFacts?.cancellation]].filter(([,value])=>value).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>}<footer><span>{site.siteName}</span><a href={root}>回首頁 ↑</a></footer>
</div>
</div>

<style>
.publication{--rule:#aeb5ab;background:var(--bg);color:var(--ink);font-family:'Noto Sans TC',system-ui,sans-serif;line-height:1.8;min-height:100vh}.canvas{width:min(calc(100% - 48px),1200px);margin:auto}.publication a{color:inherit;text-decoration:none}.publication a:hover{text-decoration:underline;text-underline-offset:5px}.masthead{border-bottom:3px double var(--ink);padding:24px 0 32px;text-align:center}.mast-meta{display:flex;justify-content:space-between;gap:24px;font:12px ui-monospace,monospace}.brand{display:block;font:400 clamp(40px,6vw,82px)/1.2 var(--serif);margin:32px auto}.masthead nav{display:flex;justify-content:center;flex-wrap:wrap;gap:16px 48px;border-top:1px solid var(--rule);padding-top:16px}.masthead nav a{display:inline-flex;min-height:44px;align-items:center}.section-label,.tag{font:12px ui-monospace,monospace;letter-spacing:.08em;color:color-mix(in srgb,var(--ink) 70%,var(--bg))}.front{padding:64px 0 96px}.spread{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:64px}.lead{padding-top:32px;border-top:3px solid var(--ink)}.publication h1{font:400 clamp(48px,6vw,88px)/1.15 var(--serif);letter-spacing:-.025em;text-wrap:balance}.lead h1{max-width:13ch}.summary{font-size:20px;max-width:42ch}.read{display:inline-flex;min-height:48px;align-items:center;border-bottom:1px solid currentColor;margin-top:24px}.secondary article{padding:24px 0 48px;border-top:1px solid var(--ink)}.secondary article+article{margin-top:32px}.secondary h2{font:400 clamp(28px,3vw,42px)/1.3 var(--serif)}.secondary p{font-size:16px}.lower{display:grid;grid-template-columns:5fr 7fr;gap:96px;padding:96px 0;border-top:1px solid var(--ink)}.lower h2,.bio h2{font:400 clamp(28px,4vw,48px) var(--serif)}.contents{display:grid;grid-template-columns:48px 1fr;gap:16px;padding:20px 0;border-top:1px solid var(--rule)}.contents b{font:24px var(--serif)}.contents h3{font:400 24px var(--serif);margin:8px 0}.pagehead{padding:96px 0 64px;border-bottom:1px solid var(--ink)}.pagehead h1{margin-bottom:24px}.pagehead p{font-size:20px;max-width:48ch}.archive{display:grid;grid-template-columns:7fr 5fr;gap:64px;padding:64px 0 128px}.archive .featured{border-top:3px solid var(--ink);padding-top:24px}.featured h2{font:400 clamp(36px,5vw,64px)/1.25 var(--serif)}.archive-row{border-top:1px solid var(--rule);padding:20px 0 40px}.archive-row h3,.related h3{font:400 28px var(--serif)}.article-head{max-width:1000px;padding:96px 0 64px}.article-head h1{max-width:16ch}.reading{display:grid;grid-template-columns:220px minmax(0,700px);gap:64px;padding:48px 0 128px;border-top:1px solid var(--ink)}.reading aside{display:flex;flex-direction:column;gap:16px;align-self:start;position:sticky;top:24px}.reading aside a{min-height:44px;display:flex;align-items:center}.prose{font-size:18px;line-height:1.95}.prose h2{font:400 36px var(--serif);scroll-margin-top:32px}.prose blockquote{font:italic 28px/1.6 var(--serif);border-left:2px solid currentColor;margin:48px 0;padding-left:24px}.related{display:grid;grid-template-columns:1fr 1fr;gap:32px;border-top:1px solid var(--ink);padding:64px 0 96px}.related>.section-label{grid-column:1/-1}.related article{border-top:1px solid var(--rule);padding:24px 0}.bio{display:grid;grid-template-columns:4fr 7fr;gap:96px;padding:64px 0 128px}.initial{min-height:400px;padding:24px;background:color-mix(in srgb,var(--brand) 10%,var(--bg));display:flex;flex-direction:column;justify-content:space-between}.initial strong{font:400 36px var(--serif);text-align:center}.publication footer{border-top:3px double var(--ink);display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;padding:32px 0 64px;font-size:14px}.publication h1,.publication h2,.publication h3,.publication p{overflow-wrap:anywhere}@media(max-width:850px){.spread,.lower,.archive,.reading,.bio{gap:32px}}@media(max-width:700px){.canvas{width:min(calc(100% - 40px),1200px)}.mast-meta{display:block;text-align:center}.mast-meta span{display:block}.brand{font-size:clamp(36px,10vw,56px)}.masthead nav{gap:8px 24px}.front,.pagehead,.article-head{padding:48px 0}.spread,.lower,.archive,.reading,.bio{display:block;padding:48px 0}.secondary{margin-top:64px}.lower>div+div,.archive>div,.bio>div+div{margin-top:64px}.reading aside{position:static;flex-flow:row wrap;border-bottom:1px solid var(--rule);padding-bottom:24px;margin-bottom:40px}.reading aside .section-label{flex-basis:100%}.reading aside a{margin-right:16px}.related{display:block}.related article{margin-top:24px}.initial{min-height:280px}}
.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 system-ui,sans-serif;padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
.article-contract-body{font-size:1rem;line-height:1.8;max-width:65ch}
.available-services{display:grid;gap:24px;padding:32px 0}.available-services article{border-bottom:1px solid currentColor;padding:16px 0}.available-services a{display:inline-block;min-height:44px;text-decoration:underline}
</style>
<style>.native-extra{padding:48px 0} .native-extra h1{overflow-wrap:anywhere} :global(.student-navigation){min-width:0} h1{overflow-wrap:anywhere;text-wrap:balance} .prose :global(pre),.prose :global(table){max-width:100%;overflow:auto} .prose :global(table){display:block}</style>

<style>.native-story-image{width:100%;max-height:640px;object-fit:cover} p:empty{display:none} .native-owned-image{width:100%;height:100%;object-fit:cover} </style>

<style>dl>div{display:grid;grid-template-columns:minmax(7em,1fr) minmax(0,2fr);gap:16px;padding-block:16px}dd{margin:0}.additional-services article{padding:24px;border:1px solid var(--line);margin-block:24px;background:var(--bg)}@media(max-width:600px){dl>div{display:block}dt{margin-bottom:8px}}</style>

<style>.native-booking{padding:24px;max-width:1200px;margin:auto}.native-booking a{display:inline-flex;min-height:44px;align-items:center;text-decoration:underline}</style>

<style>.native-image-slot{position:relative;overflow:hidden}</style>
