---
import config from '../../../../site.config.json';
import StudentNavigation from '../../StudentNavigation.astro';
import {getSite} from './content.mjs';
const {route='',entry=null,extra=false}=Astro.props;
const page=route,root=import.meta.env.BASE_URL,base=root;
const site=await getSite(root);
const detailRecord=site.kind==='knowledge'?site.articles.find(a=>a.slug===entry?.id)??site.primary:site.services.find(s=>route==='services/'+s.slug)??site.primary;
const service=detailRecord??{name:'尚未設定服務',title:'尚未設定服務',description:'服務資訊待設定',fit:'待確認',format:'待設定',duration:'待設定',price:'待設定',scope:'待核實',credential:'待核實',body:[],href:undefined};
const articles=site.articles,posts=site.articles,rows=site.articles;
const entries=site.kind==='knowledge'?site.articles:site.questions;
const items=entries.map(a=>a.title??a.question),demo=site.intro;
const chapters=site.questions.map((q,i)=>[String(i+1).padStart(2,'0'),q.question,q.answer]);
const availableServices=site.services;
const facts=[['服務對象',service.fit],['服務形式',service.format],['時間',service.duration],['費用',service.price],['服務界線',service.scope],['資格與來源',service.credential]];
const info=facts,title=site.siteName,name=site.siteName;
const indexUrl=root+(site.kind==='knowledge'?'articles/':'services/'),detailUrl=site.primary?.href??indexUrl;
---


<div data-article-count={route==='articles'||(route===''&&site.kind==='knowledge')?site.articles.length:undefined} data-service-count={route==='services'?site.services.length:undefined} data-native-page="service-catalogue" class="catalog"><div class="shell">
<header class="nav"><a class="brand" href={root}>{site.siteName}</a><StudentNavigation/></header>
{route===''&&<><section class="hero"><div><span class="tag">SERVICE DIRECTORY / 001</span><h1>{route===''?site.headline:route==='about'?site.about:route==='articles'?'文章索引':route==='services'?'服務資訊':detailRecord?.title}</h1></div><div><p>{site.intro}</p><a class="action" data-primary-cta="home" href={site.primaryCta.href}>{site.primaryCta.label} ↗</a></div></section><section class="index"><div class="index-head"><span class="tag">01 / AVAILABLE INFORMATION</span><h2>服務目錄</h2><p>{site.copy.p2??(route==='about'?site.aboutFields[1]:'')}</p></div><article class="service-card"><div class="card-number">01 <span>ENTRY</span></div><div><h3>{service.name}</h3><p>{service.description}</p><dl>{facts.slice(0,4).map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>{service.href?<a class="action" href={service.href}>查看完整資訊 →</a>:<span>沒有已公開服務詳細頁</span>}</div></article><div class="additional-services">{site.services.slice(1).map(item=><article><h3>{item.name}</h3><p>{item.description}</p>{item.href?<a href={item.href}>查看服務詳情 →</a>:<span>尚未公開服務詳情</span>}</article>)}</div></section><section class="stripe"><p class="tag">HOW TO CHOOSE</p><h2>服務清楚，不等於必須預約。</h2><p>{site.copy.p3??(route==='about'?site.aboutFields[2]:'')}</p><a href={root+'about/'}>關於提供服務的人 →</a></section></>}
{route==='services'&&<><section class="pagehead"><p class="tag">CATALOGUE / INDEX</p><h1>{route===''?site.headline:route==='about'?site.about:route==='articles'?'文章索引':route==='services'?'服務資訊':detailRecord?.title}</h1><p>{site.copy.p4??(route==='about'?site.aboutFields[3]:'')}</p></section>{site.services.map((item,i)=><article class="service-card wide"><div class="card-number">{String(i+1).padStart(2,'0')} <span>SERVICE</span></div><div><h2>{item.name}</h2><p>{item.description}</p><dl>{[['服務對象',item.fit],['服務形式',item.format],['時間',item.duration],['費用',item.price],['服務界線',item.scope],['資格與來源',item.credential]].map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl><a class="action" href={item.href}>閱讀服務詳細頁 →</a></div></article>)}</>}
{(route??'').startsWith('services/')&&<><section class="pagehead"><p class="tag">CATALOGUE / ENTRY</p><h1>{detailRecord?.name??'尚未設定服務'}</h1><p>{detailRecord?.description??'服務內容待設定'}</p></section><div class="detail"><aside><span class="tag">SERVICE RECORD</span><strong>01</strong><a href={root+'services/'}>← 返回目錄</a></aside><div><section><h2>詳細說明</h2><div class="article-contract-body">{service.body.map(p=><p>{p}</p>)}</div><p>{site.copy.p5??(route==='about'?site.aboutFields[0]:'')}</p><dl>{facts.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></section><section><h2>不適合與界線</h2><p>{service.scope}。如有急迫或危險狀況，應聯繫所在地正式緊急服務。</p></section><section><h2>合作流程</h2><ol><li>閱讀服務範圍及適合對象</li><li>核對實際費用、形式、取消政策及資格</li><li>由服務者配置真實聯絡入口後再詢問</li></ol><p class="notice">{site.copy.p6??(route==='about'?site.aboutFields[1]:'')}</p></section></div></div></>}
{route==='about'&&<><section class="pagehead"><p class="tag">ABOUT / PRACTICE</p><h1>{site.about}</h1><p>{site.bio}</p></section><div class="about"><div><h2>工作方式</h2><p>{site.aboutFields.filter(Boolean).map(value=><span class="native-about-field">{value}</span>)}</p></div><div class="about-ledger"><div><strong>專業身分</strong><span>待真實提供者填寫</span></div><div><strong>可查證資料</strong><span>證照及來源尚未配置</span></div><div><strong>合作方式</strong><span>請參考服務目錄的實際設定</span></div><a class="action" href={root+'services/'}>回服務目錄 →</a></div></div></>}
{route.startsWith('services/')&&detailRecord?.bookingUrl&&<p class="native-booking"><a href={detailRecord.bookingUrl} rel="noopener noreferrer">前往正式預約頁 ↗</a></p>}{extra&&<section class="native-extra"><slot/></section>}{(route==='articles'||(route===''&&site.kind==='knowledge'))&&site.articles.length===0&&<p class="archive-empty">目前沒有公開文章。</p>}{route==='services'&&site.services.length===0&&<section class="native-unconfigured"><p>尚未提供正式服務。</p><dl>{[['服務範圍',config.serviceFacts?.scope],['服務方式',config.serviceFacts?.method],['服務時間',config.serviceFacts?.duration],['實際費用',config.serviceFacts?.price],['資格與來源',config.serviceFacts?.qualification],['取消政策',config.serviceFacts?.cancellation]].filter(([,value])=>value).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>}<footer><span>{site.siteName}</span><a href={root}>回首頁 ↑</a></footer>
</div></div>

<style>
.catalog{--line:color-mix(in srgb,var(--ink) 30%,var(--bg));--soft:color-mix(in srgb,var(--brand) 10%,var(--bg));background:var(--bg);color:var(--ink);font:17px/1.8 'Noto Sans TC',system-ui,sans-serif;min-height:100vh}.shell{width:min(calc(100% - 48px),1200px);margin:auto}.catalog a{color:inherit;text-decoration:none}.catalog a:hover{text-decoration:underline;text-underline-offset:4px}.nav{display:flex;justify-content:space-between;align-items:center;gap:24px;border-bottom:1px solid var(--ink);padding:24px 0}.brand{font:400 28px var(--serif)}.brand span{display:block;font:12px ui-monospace,monospace}.nav nav{display:flex;flex-wrap:wrap;gap:12px 32px}.nav nav a{display:inline-flex;align-items:center;min-height:44px}.tag{font:12px ui-monospace,monospace;letter-spacing:.1em;color:color-mix(in srgb,var(--ink) 70%,var(--bg))}.hero{display:grid;grid-template-columns:7fr 5fr;gap:64px;padding:96px 0 128px;align-items:end}.hero h1,.pagehead h1{font:400 clamp(44px,6vw,80px)/1.18 var(--serif);letter-spacing:-.03em;text-wrap:balance}.hero p{font-size:20px;max-width:35ch}.action{display:inline-flex;min-height:48px;padding:10px 24px;align-items:center;background:var(--ink);color:var(--bg)!important;margin-top:24px}.index{border-top:1px solid var(--ink);padding:64px 0 128px}.index-head{display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:32px;align-items:start;margin-bottom:48px}.index-head h2,.stripe h2,.about h2,.detail h2{font:400 clamp(30px,4vw,48px)/1.3 var(--serif);margin:0}.service-card{display:grid;grid-template-columns:1fr 3fr;gap:48px;border:1px solid var(--ink);background:var(--bg);padding:48px}.card-number{font:400 76px var(--serif);line-height:1}.card-number span{display:block;font:12px ui-monospace,monospace}.service-card h2,.service-card h3{font:400 clamp(30px,4vw,52px)/1.25 var(--serif);margin:0}.service-card dl,.detail dl{border-top:1px solid var(--line)}.service-card dl>div,.detail dl>div{display:grid;grid-template-columns:160px 1fr;gap:24px;border-bottom:1px solid var(--line);padding:16px 0}.catalog dt{font-weight:700}.catalog dd{margin:0}.stripe{background:var(--soft);margin:0 0 128px;padding:64px;display:grid;grid-template-columns:1fr 2fr;gap:24px 64px}.stripe .tag{grid-column:1/-1}.stripe p:not(.tag){max-width:40ch}.stripe a{display:inline-flex;min-height:48px;align-items:center;text-decoration:underline}.pagehead{padding:96px 0 64px;max-width:880px}.pagehead>p:last-child{font-size:20px}.wide{margin-bottom:128px}.detail{display:grid;grid-template-columns:200px 1fr;gap:64px;padding:48px 0 128px;border-top:1px solid var(--ink)}.detail aside{display:flex;flex-direction:column;gap:16px;align-self:start;position:sticky;top:24px}.detail aside strong{font:76px var(--serif)}.detail aside a{min-height:44px;display:flex;align-items:center}.detail section{padding:24px 0 64px}.detail section+section{border-top:1px solid var(--line)}.detail ol li{margin:16px 0}.notice{padding:24px;background:var(--soft)}.about{display:grid;grid-template-columns:1fr 1.5fr;gap:96px;padding:48px 0 128px;border-top:1px solid var(--ink)}.about-ledger>div{display:flex;justify-content:space-between;gap:32px;border-bottom:1px solid var(--line);padding:24px 0}.catalog footer{border-top:1px solid var(--ink);padding:32px 0 64px;display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;font-size:14px}.catalog footer p{flex-basis:100%}.catalog h1,.catalog h2,.catalog h3,.catalog p,.catalog dd{overflow-wrap:anywhere}@media(max-width:900px){.index-head{grid-template-columns:1fr 1fr}.index-head p{grid-column:2}}@media(max-width:700px){.shell{width:min(calc(100% - 40px),1200px)}.nav{display:block}.nav nav{margin-top:24px}.hero,.index-head,.service-card,.stripe,.detail,.about{display:block}.hero{padding:48px 0 64px}.hero>div+div{margin-top:32px}.index{padding:40px 0 64px}.index-head{margin-bottom:32px}.service-card{padding:24px}.card-number{font-size:48px;margin-bottom:32px}.service-card dl>div,.detail dl>div{display:block}.catalog dt{margin-bottom:8px}.stripe{margin-bottom:64px;padding:32px}.pagehead{padding:48px 0}.wide{margin-bottom:64px}.detail aside{position:static;flex-direction:row;flex-wrap:wrap;align-items:center;border-bottom:1px solid var(--line);padding-bottom:24px}.detail aside strong{font-size:40px}.about{padding:40px 0 64px}.about-ledger{margin-top:48px}.about-ledger>div{display:block}}
.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 system-ui,sans-serif;padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
.article-contract-body{font-size:1rem;line-height:1.8;max-width:65ch}
.available-services{display:grid;gap:24px;padding:32px 0}.available-services article{border-bottom:1px solid currentColor;padding:16px 0}.available-services a{display:inline-block;min-height:44px;text-decoration:underline}
</style>
<style>.native-extra{padding:48px 0} .native-extra h1{overflow-wrap:anywhere} :global(.student-navigation){min-width:0} h1{overflow-wrap:anywhere;text-wrap:balance} .prose :global(pre),.prose :global(table){max-width:100%;overflow:auto} .prose :global(table){display:block}</style>

<style>.native-about-field{display:block}.native-service-facts>div{display:grid;grid-template-columns:minmax(7em,1fr) minmax(0,3fr);gap:16px;border-bottom:1px solid currentColor;padding:16px 0}.native-service-facts dd{margin:0} p:empty{display:none} .native-owned-image{width:100%;height:100%;object-fit:cover} </style>

<style>dl>div{display:grid;grid-template-columns:minmax(7em,1fr) minmax(0,2fr);gap:16px;padding-block:16px}dd{margin:0}.additional-services article{padding:24px;border:1px solid var(--line);margin-block:24px;background:var(--bg)}@media(max-width:600px){dl>div{display:block}dt{margin-bottom:8px}}</style>

<style>.native-booking{padding:24px;max-width:1200px;margin:auto}.native-booking a{display:inline-flex;min-height:44px;align-items:center;text-decoration:underline}</style>
