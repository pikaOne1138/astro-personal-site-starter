---
import config from '../../../../site.config.json';
const base=import.meta.env.BASE_URL,root=base;
const paths=[{n:'01',title:'我想先了解服務是否適合',detail:'查看公開服務範圍與界線。',href:'#fit',cta:'查看適配範圍'},{n:'02',title:'我想知道合作怎麼進行',detail:'了解服務形式、必要揭露與聯絡前的資訊。',href:base+'services/',cta:'閱讀服務說明'},{n:'03',title:'我還沒打算聯絡任何人',detail:'先閱讀常見問題，不必留下個人資料。',href:base+'faq/',cta:'閱讀常見問題'}];
const content=config.artDirection;
---
<div class="compass" data-assembled-layout="practice-compass"><div class="shell"><section class="hero"><p class="mono">00 / BEFORE ANY APPOINTMENT</p><div class="hero-grid"><div><p class="eyebrow">{config.brand.tagline}</p><h1>{config.content.headline||config.brand.name}<em>{config.content.intro||'先了解，再決定下一步。'}</em></h1></div><aside><p>先了解提供什麼、不提供什麼，再做知情選擇。</p><p class="disclaimer">服務資料以本網站已公開的資訊為準；未提供的欄位會明確標示待設定。</p><a class="button" href="#choose">從自己的問題開始 ↓</a></aside></div></section></div>
<section class="decision" id="choose"><div class="shell"><p class="mono">01 / VISITOR DECISIONS</p><h2>你現在比較接近哪一種情況？</h2><p>這是閱讀入口，不是診斷工具。</p>{paths.map(p=><article class="decision-row"><div class="num">{p.n}<small>PATH</small></div><div><h3>{p.title}</h3><p>{p.detail}</p></div><a href={p.href}>{p.cta} ↗</a></article>)}</div></section>
<div class="shell"><section class="fit" id="fit"><div><p class="mono">02 / SCOPE & BOUNDARIES</p><h2>適不適合，<em>先看清楚再選擇。</em></h2></div><div class="fit-grid"><article><h3>服務適合的需求</h3>{content.scope.suitable.length?<ul>{content.scope.suitable.map(s=><li>{s}</li>)}</ul>:<p>待由服務提供者確認並公開服務範圍。</p>}</article><article><h3>不適合或需要其他支持</h3>{content.scope.notSuitable.length?<ul>{content.scope.notSuitable.map(s=><li>{s}</li>)}</ul>:<p>待補適用界線；本站不能承接即時危機處理。</p>}</article></div></section><section class="information" id="information"><span class="mono">03 / OPEN INFORMATION</span><div><h2>服務流程，應在聯絡之前看清楚。</h2><p>了解範圍、資格、費用、取消規則與聯絡方式。</p></div><a href={base+'services/'}>閱讀完整服務資訊 ↗</a></section><section class="faq" id="faq"><div><p class="mono">04 / QUESTIONS</p><h2>先問清楚，也可以。</h2></div><div>{content.faq.length?content.faq.map(q=><details><summary>{q.question}</summary><p>{q.answer}</p></details>):<p>尚未提供正式常見問題；請先閱讀<a href={base+'services/'}>服務說明</a>與<a href={base+'contact/'}>聯絡設定</a>。</p>}</div></section></div></div>
<style>
.compass{background:var(--bg);color:var(--ink);font-family:Arial,'Noto Sans TC',sans-serif;line-height:1.8}.shell{width:min(100% - 40px,1250px);margin:auto}.compass a{color:inherit;text-decoration:none}.compass a:hover{text-decoration:underline;text-underline-offset:5px}.compass a:focus-visible,.compass summary:focus-visible{outline:3px solid var(--brand);outline-offset:4px}.header{min-height:88px;border-bottom:1px solid var(--ink);display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font-size:20px;font-weight:800}.brand small{display:block;font:12px ui-monospace,monospace}.header nav{display:flex;flex-wrap:wrap;gap:24px}.header nav a{min-height:44px;display:flex;align-items:center}.mono{font:12px ui-monospace,monospace;letter-spacing:.1em}.hero{padding:64px 0 96px}.hero-grid{display:grid;grid-template-columns:2fr 1fr;gap:64px;align-items:end}.eyebrow{color:var(--brand)}.compass h1{text-wrap:balance;font:400 clamp(44px,6.5vw,92px) Georgia,'Noto Serif TC',serif;line-height:1.18;letter-spacing:-.03em;margin:24px 0 0}.compass h1 span,.compass h1 em{display:block}.compass h1 em{color:var(--brand)}.hero aside{padding-left:32px;border-left:1px solid var(--line)}.hero aside>p:first-child{font-size:20px}.disclaimer{font-size:14px}.button{display:inline-flex;align-items:center;background:var(--brand);color:#fff!important;padding:12px 24px;min-height:48px}.decision{background:var(--ink);color:var(--bg);padding:64px 0 80px}.decision h2,.fit h2,.faq h2{text-wrap:balance;font:400 clamp(32px,4vw,54px) Georgia,'Noto Serif TC',serif;line-height:1.25}.decision-row{display:grid;grid-template-columns:100px 1fr 210px;gap:32px;align-items:center;border-top:1px solid #85938c;padding:32px 0}.decision-row:first-of-type{margin-top:48px}.num{font:36px Georgia,serif}.num small{display:block;font:12px ui-monospace,monospace}.decision-row h3{font-size:24px;font-weight:500;margin:0}.decision-row p{font-size:16px;color:#d8dfd9}.decision-row>a{border:1px solid #ced8d0;min-height:48px;display:flex;align-items:center;justify-content:center;padding:8px}.fit{padding:112px 0;display:grid;grid-template-columns:1fr 1.5fr;gap:48px}.fit h2 em{color:var(--brand)}.fit-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.fit-grid article{background:color-mix(in srgb,var(--brand) 10%,var(--bg));border-top:4px solid var(--brand);padding:24px}.fit-grid article:last-child{background:color-mix(in srgb,var(--accent) 10%,var(--bg));border-color:var(--accent)}.fit-grid li{margin:16px 0}.fit-grid h3{font-size:20px}.information{display:grid;grid-template-columns:140px 1fr 220px;gap:32px;align-items:center;border-block:1px solid var(--ink);padding:64px 0}.information h2{font:400 36px Georgia,'Noto Serif TC',serif}.information>a{border-bottom:1px solid var(--brand);padding-bottom:12px}.faq{padding:112px 0;display:grid;grid-template-columns:1fr 1.5fr;gap:48px}.faq details{border-top:1px solid var(--line);padding:24px 0}.faq details:last-child{border-bottom:1px solid var(--line)}.faq summary{min-height:44px;font-size:18px;font-weight:700;cursor:pointer}.compass footer{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;border-top:1px solid var(--line);background:color-mix(in srgb,var(--brand) 10%,var(--bg));padding:48px}.compass footer strong{font:36px Georgia,'Noto Serif TC',serif}@media(max-width:950px){.header{flex-wrap:wrap;padding:20px 0}.hero-grid{gap:24px}.decision-row{grid-template-columns:64px 1fr;gap:16px}.decision-row>a{grid-column:2}.fit{display:block}.fit-grid{margin-top:32px}.information{grid-template-columns:1fr 2fr}.information>a{grid-column:2}.faq{gap:24px}}@media(max-width:700px){.hero{padding:40px 0 64px}.hero-grid{display:block}.compass h1{font-size:clamp(40px,10vw,60px)}.hero aside{border-left:0;border-top:1px solid var(--line);padding:24px 0 0;margin-top:32px}.decision{padding:48px 0}.decision-row h3{font-size:20px}.fit{padding:64px 0}.fit-grid{grid-template-columns:1fr}.information{display:block;padding:48px 0}.information>a{display:inline-block;margin-top:24px}.faq{display:block;padding:64px 0}.faq details:first-child{margin-top:32px}.compass footer{padding:32px 0}}
</style>