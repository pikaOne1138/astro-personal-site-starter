---
import config from '../../../site.config.json';
import SiteLayout from '../../layouts/SiteLayout.astro';
const base=import.meta.env.BASE_URL;
const fields=[['寫作與服務目的',config.about?.purpose],['工作方式',config.about?.approach],['背景與來源',config.about?.background]].filter(([,v])=>v);
const bio=config.about?.bio||config.pageContent.about?.join('\n')||'關於資訊尚未設定';
---
<SiteLayout title="關於"><div class="practice-about"><section class="introduction interior"><span class="eyebrow">THE PERSON / BEFORE CONTACT</span><h1>關於{config.brand.name}</h1><div class="intro-grid"><p class="lede">{bio}</p><aside><p>先認識工作方式，再確認服務是否適合。</p><a href={base+'services/'}>閱讀服務與必要資訊 ↗</a></aside></div></section><section class="practice-records"><div class="interior">{fields.map(([label,value],i)=><article><span class="number">0{i+1}</span><div><h2>{label}</h2><p>{value}</p></div></article>)}</div></section><section class="interior next"><h2>下一步，由你決定。</h2><a href={base+'contact/'}>查看正式聯絡方式 ↗</a></section></div></SiteLayout>
<style>.introduction{padding-block:64px 80px}.intro-grid{display:grid;grid-template-columns:2fr 1fr;gap:64px}.lede{font-size:24px}.intro-grid aside{border-left:1px solid var(--line);padding-left:32px}.practice-records{background:var(--ink);color:var(--bg)}.practice-records article{display:grid;grid-template-columns:100px minmax(0,750px);gap:32px;padding-block:40px;border-top:1px solid currentColor}.number{font:40px var(--serif)}.practice-records h2{margin-top:0}.practice-records p{font-size:18px;white-space:pre-line}.next{display:flex;justify-content:space-between;align-items:center;gap:32px}@media(max-width:760px){.intro-grid,.next{display:block}.intro-grid aside{padding-left:0;border-left:0;border-top:1px solid var(--line);padding-top:24px}.practice-records article{grid-template-columns:48px minmax(0,1fr);gap:16px}}</style>
