---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime());
const base=import.meta.env.BASE_URL;
---
<SiteLayout title="文章檔案"><section class="interior"><p class="eyebrow">CATALOGUE / PUBLISHED ENTRIES</p><h1>全部文章</h1><p>{posts.length} 篇公開文章，依主題連接閱讀路徑。</p>{posts.length?<div class="table-wrap"><table><caption>公開文章清單</caption><thead><tr><th scope="col">編號</th><th scope="col">主題</th><th scope="col">文章</th></tr></thead><tbody>{posts.map((p,i)=><tr><td>{String(i+1).padStart(2,'0')}</td><td>{p.data.topics.map(t=><a href={base+'topics/'+t+'/'}>{t} </a>)}</td><td><a href={base+'articles/'+p.id+'/'}>{p.data.title} ↗</a></td></tr>)}</tbody></table></div>:<p class="notice">目前沒有公開文章。</p>}</section></SiteLayout>
