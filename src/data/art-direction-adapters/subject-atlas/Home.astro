---
import config from '../../../../site.config.json';
import {getCollection} from 'astro:content';
const base=import.meta.env.BASE_URL,root=base;
const topics=config.artDirection.topics;
const posts=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime());
const latest=posts[0];
---
<div class="atlas" data-assembled-layout="subject-atlas"><div class="shell">
<section class="hero"><p class="mono">PERSONAL KNOWLEDGE LIBRARY / AN OPEN INDEX</p><div class="hero-grid"><div><span>{config.content.intro||config.brand.tagline}</span><h1>{config.content.headline||config.brand.name}<em>{config.brand.tagline}</em></h1></div><aside><div class="count"><strong>{String(topics.length).padStart(2,'0')}</strong>主題入口</div><p>先選擇自己在意的主題，再沿著文章閱讀。</p><a class="action" href="#directory">打開主題索引 ↓</a><p class="note">目前有 {posts.length} 篇公開文章。</p></aside></div></section>
<div class="columns"><aside class="rail" aria-label="主題快速導航"><p class="mono">INDEX / TOPICS</p>{topics.map((t,i)=><a href={'#topic-'+t.slug}><span>{String(i+1).padStart(2,'0')}</span>{t.title}</a>)}</aside><div class="body"><section id="directory"><p class="mono">01 / TOPIC DIRECTORY</p><h2>循著主題，找到閱讀路徑。</h2><div class="topics">{topics.length?topics.map((t,i)=><article class:list={['topic',{'lead-topic':i===0}]} id={'topic-'+t.slug}><div class="top"><span>{String(i+1).padStart(2,'0')} / {t.slug.toUpperCase()}</span><span>{posts.filter(p=>p.data.topics.includes(t.slug)).length} ENTRIES</span></div><h3>{t.title}</h3><a class="action" href={base+'topics/'+t.slug+'/'}>探索{t.title}主題 ↗</a><ol>{posts.filter(p=>p.data.topics.includes(t.slug)).map((p,j)=><li><span>{String(j+1).padStart(2,'0')}</span><a href={base+'articles/'+p.id+'/'}>{p.data.title} ↗</a></li>)}</ol>{!posts.some(p=>p.data.topics.includes(t.slug))&&<p>這個主題目前沒有公開文章。</p>}</article>):<p class="notice">尚未設定主題，請在 site.config.json 填入 artDirection.topics。</p>}</div></section><section class="latest" id="latest"><div><p class="mono">02 / MOST RECENT NOTE</p><h2>最近新增的線索。</h2></div><div>{latest?<><h3>{latest.data.title}</h3><p>{latest.data.description}</p><a class="action" href={base+'articles/'+latest.id+'/'}>閱讀文章 ↗</a></>:<p>目前没有公開文章，沒有假示範跳轉。</p>}</div></section><section class="foot-cta" id="archive"><p>你不必從第一篇開始。</p><a class="action" href={base+'articles/'}>開啟完整檔案清單 ↗</a></section></div></div>
</div></div>
<style>
.entry-status{display:block;font-size:12px;color:var(--brand)}.atlas{background:var(--bg);color:var(--ink);min-height:100vh;font-family:Arial,'Noto Sans TC',sans-serif;line-height:1.8}.shell{width:min(100% - 40px,1320px);margin:auto}.atlas a{color:inherit;text-decoration:none}.atlas a:hover{text-decoration:underline;text-underline-offset:5px}.atlas a:focus-visible{outline:3px solid var(--brand);outline-offset:4px}.nav{display:flex;justify-content:space-between;align-items:center;min-height:80px;gap:24px;border-bottom:1px solid var(--ink)}.brand{font-size:20px;font-weight:bold}.brand small{display:block;font:12px ui-monospace,monospace;letter-spacing:.1em}.nav nav{display:flex;gap:24px;flex-wrap:wrap}.nav nav a{min-height:44px;display:flex;align-items:center}.mono,.top,footer{font:12px ui-monospace,monospace;letter-spacing:.1em}.hero{padding:64px 0 96px}.hero-grid{display:grid;grid-template-columns:minmax(0,3fr) minmax(250px,1fr);gap:64px;align-items:end}.hero-grid>div>span{color:var(--brand)}.hero h1{text-wrap:balance;font:400 clamp(44px,7vw,104px) Georgia,'Noto Serif TC',serif;line-height:1.16;letter-spacing:-.035em;max-width:12em;margin:24px 0 0}.hero h1 em{display:block;color:var(--brand);font-weight:400}.hero aside{border-left:1px solid var(--line);padding-left:32px}.count{display:flex;align-items:baseline;gap:16px}.count strong{font:90px Georgia,serif}.hero aside p{font-size:16px}.action{display:inline-block;border-bottom:1px solid currentColor;min-height:44px;padding:8px 0;font-weight:700}.note{font-size:13px!important}.columns{display:grid;grid-template-columns:160px minmax(0,1fr);gap:48px;border-top:1px solid var(--ink)}.rail{align-self:start;position:sticky;top:24px;padding:32px 0}.rail>a{display:flex;gap:20px;padding:12px 0;border-bottom:1px solid var(--line);min-height:44px}.rail>a span{font:12px ui-monospace,monospace}.body{min-width:0;padding:32px 0}.atlas h2{font:400 clamp(30px,4vw,50px) Georgia,'Noto Serif TC',serif}.topics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}.topic{padding:32px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);min-width:0}.lead-topic{grid-column:span 2;background:color-mix(in srgb,var(--brand) 10%,var(--bg))}.top{display:flex;justify-content:space-between;gap:16px}.topic h3{font:400 64px Georgia,'Noto Serif TC',serif;margin:24px 0}.topic ol{margin:0;padding:0;list-style:none}.topic li{display:grid;grid-template-columns:32px 1fr;gap:12px;padding:12px 0;border-top:1px solid var(--line)}.topic li>span{font:12px ui-monospace,monospace}.latest{display:grid;grid-template-columns:1fr 1.5fr;gap:48px;padding:48px;background:var(--brand);color:white;margin-top:64px}.latest h3{font:400 30px Georgia,'Noto Serif TC',serif}@media(min-width:701px) and (max-width:950px){.latest{grid-template-columns:1fr;padding:32px}}.foot-cta{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:64px 0}.foot-cta p{font:32px Georgia,'Noto Serif TC',serif}footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;padding:32px 0;border-top:1px solid var(--line)}@media(max-width:900px){.nav{flex-wrap:wrap;padding:20px 0}.hero-grid{gap:24px}.columns{grid-template-columns:110px minmax(0,1fr);gap:24px}.topic{padding:24px}}@media(max-width:700px){.hero{padding:40px 0}.hero-grid{display:block}.hero h1{font-size:clamp(40px,10vw,64px)}.hero aside{border-left:0;border-top:1px solid var(--line);padding:24px 0 0;margin-top:32px}.count strong{font-size:64px}.columns{display:block}.rail{position:static;display:flex;flex-wrap:wrap;gap:12px}.rail p{width:100%}.rail>a{display:block}.topics{grid-template-columns:1fr}.lead-topic{grid-column:auto}.topic h3{font-size:50px}.latest{display:block;margin-top:40px;padding:32px}.foot-cta{padding:40px 0;display:block}}
</style>