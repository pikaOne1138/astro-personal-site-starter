---
import config from '../../site.config.json';
import StudentNavigation from '../components/StudentNavigation.astro';
import SelectedPatterns from '../components/SelectedPatterns.astro';
const {title,description=config.brand.tagline,searchable=true}=Astro.props;
const base=import.meta.env.BASE_URL;
const cta=config.navigation.find(x=>x.id===config.primaryCta.pageId);
const palette=config.brand.palette;
const sans="Arial,'Noto Sans TC',sans-serif";const serif="Georgia,'Noto Serif TC',serif";
const fontVariables=config.brand.typography==='clear-sans'?`--serif:${sans};`:`--serif:${serif};`;
const variables=fontVariables+(palette ? `--brand:${palette.primary};--ink:${palette.text};--bg:${palette.background};--panel:${palette.secondary};--accent:${palette.accent};` : `--brand:${config.brand.primaryColor};`);
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title===config.brand.name?title:`${title}｜${config.brand.name}`}</title><meta name="description" content={description}/><meta name="robots" content={process.env.SITE_INDEXABLE==='true'?'index, follow':'noindex, nofollow, noarchive'}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site??Astro.url).href}/><link rel="stylesheet" href={base+'site.css'}/></head><body style={variables} data-layout={config.layoutSlug}><a class="skip" href="#main">跳到主要內容</a><header class="site-header"><a class="site-brand" href={base}>{config.brand.name}<small>{config.kind==='knowledge'?'AN ATLAS OF IDEAS':'THE PRACTICE COMPASS'}</small></a><StudentNavigation />{cta&&<a class="action" href={base+cta.path}>{config.primaryCta.label}</a>}</header><main id="main" data-pagefind-body={searchable?true:undefined}><slot/></main>{config.sectionPatterns?.some(x=>x.patternId.startsWith('footer-'))?<SelectedPatterns page="site-wide"/>:<footer class="site-footer"><span>{config.brand.name}</span><nav aria-label="頁尾導覽">{config.navigation.map(x=><a href={base+x.path}>{x.label}</a>)}</nav></footer>}</body></html>
