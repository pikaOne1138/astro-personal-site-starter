---
import config from '../../site.config.json';
import {getCollection} from 'astro:content';
import FeaturedWorkPattern from './patterns/FeaturedWorkSection.astro';
import TrustServicePattern from './patterns/TrustServiceSection.astro';
const {position='page-end'}=Astro.props;
const base=import.meta.env.BASE_URL;
const relative=Astro.url.pathname.slice(base.length).replace(/^\/+|\/+$/g,'');
const page=relative===''?'/':config.navigation.find(n=>(n.path??n.id+'/').replace(/\/$/,'')===relative)?.id;
const chosen=(config.sectionPatterns??[]).filter(p=>!p.patternId.startsWith('footer-')&&p.targetPage===page&&p.insertAfter===position);
const published=chosen.some(p=>p.patternId==='featured-work')?await getCollection('articles',({data})=>!data.draft):[];
const action=value=>value?{label:value.label,href:value.url??base+config.navigation.find(n=>n.id===value.pageId).path}:undefined;
---
{chosen.length>0&&<div class="pattern-slot" data-pattern-position={position}>
 {chosen.map(p=>{
  const c=p.content;
  const items=p.patternId==='featured-work'?[...c.items.map(item=>({title:item.title,description:item.description,href:item.url})),...c.articleSlugs.flatMap(slug=>{const entry=published.find(e=>e.id===slug);return entry?[{title:entry.data.title,description:entry.data.description,href:base+'articles/'+entry.id+'/'}]:[]})]:[];
  return <div data-section-pattern={p.patternId}>
   {p.patternId==='featured-work'?<FeaturedWorkPattern title={c.title} description={c.description} items={items} action={action(c.action)}/>:<TrustServicePattern {...c} action={action(c.action)}/>}
  </div>;
 })}
</div>}
<style is:global>
/* Embedded Patterns inherit their owning canvas. No global Blocks/gallery styles. */
.pattern-slot{--text:var(--color-content);--muted:color-mix(in srgb,var(--color-content) 70%,var(--color-surface));--accent:var(--color-primary);min-width:0;width:100%;color:var(--color-content);background:var(--color-surface)}
.pattern-slot .sp-section,.pattern-slot .sp-trust{width:100%;max-width:none;margin:0;padding:48px 0;border-top:1px solid var(--line)}
.pattern-slot .sp-heading,.pattern-slot .sp-trust__heading{max-width:65ch;margin-bottom:32px}
.pattern-slot .sp-heading h2,.pattern-slot .sp-trust__heading h2{font:400 clamp(28px,4vw,48px)/1.3 var(--font-heading);margin:8px 0;text-wrap:balance}
.pattern-slot p,.pattern-slot li,.pattern-slot dd{font-size:16px;line-height:1.85;overflow-wrap:anywhere}
.pattern-slot .sp-eyebrow,.pattern-slot .sp-trust__eyebrow{font-size:12px}
.pattern-slot .ab-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.pattern-slot .ab-grid:has(>.ab-feature:only-child){grid-template-columns:minmax(0,1fr)}
.pattern-slot .ab-cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}
.pattern-slot .ab-feature{min-width:0;border-top:1px solid var(--line);padding:24px 0;color:inherit}
.pattern-slot .ab-feature h3{font:400 24px/1.4 var(--font-heading);margin:16px 0;overflow-wrap:anywhere}
.pattern-slot .ab-number{font-size:12px;color:var(--color-primary)}
.pattern-slot .sp-trust__grid{gap:32px}
.pattern-slot .practical-service-fit h2,.pattern-slot .ab-cta h2{font:400 24px/1.4 var(--font-heading);margin:0 0 16px}
.pattern-slot .practical-service-fit__cols{display:grid;gap:16px}
.pattern-slot .practical-service-fit h3,.pattern-slot .practical-trust h3{font-size:18px;line-height:1.5;margin:0 0 16px}
.pattern-slot ul{padding-left:24px}.pattern-slot li+li{margin-top:8px}
.pattern-slot dl{margin:0}.pattern-slot dl>div{display:block;border-top:1px solid var(--line);padding:16px 0}
.pattern-slot dt{font-weight:700}.pattern-slot dd{margin:8px 0 0}
.pattern-slot .ab-cta{margin-top:32px;padding:24px;background:var(--color-secondary)}
.pattern-slot a{min-height:44px}.pattern-slot .ab-button,.pattern-slot .sp-next{display:inline-flex;align-items:center;padding:8px 0;max-width:100%;color:inherit;white-space:normal}
.pattern-slot a:focus-visible{outline:3px solid var(--color-primary);outline-offset:4px}
@media(max-width:980px){[data-native-page="sidebar-journal"] .pattern-slot .ab-grid,[data-native-page="sidebar-journal"] .pattern-slot .sp-trust__grid{grid-template-columns:1fr}}
@media(max-width:760px){.pattern-slot .ab-grid{grid-template-columns:1fr}.pattern-slot .sp-section,.pattern-slot .sp-trust{padding:32px 0}}
</style>
