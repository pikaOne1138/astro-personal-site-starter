---
import config from '../../site.config.json';
import SiteLayout from '../layouts/SiteLayout.astro';
import SelectedPatterns from '../components/SelectedPatterns.astro';
export function getStaticPaths(){return config.navigation.filter(x=>!config.artDirection.explicitPageIds.includes(x.id)).map(item=>({params:{page:item.path.slice(0,-1)},props:{item}}));}
const {item}=Astro.props;
const paragraphs=config.pageContent[item.id]||[];
---
<SiteLayout title={item.label}><section class="interior"><p class="eyebrow">{item.id.toUpperCase()}</p><h1>{item.label}</h1>{paragraphs.length?paragraphs.map(p=><p>{p}</p>):<p class="notice">尚未填入本站正式內容，請由網站持有人提供並確認。</p>}<SelectedPatterns page={item.id}/></section></SiteLayout>
