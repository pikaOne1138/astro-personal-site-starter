---
import WorkshopNav from '../../components/WorkshopNav.astro';
const base = import.meta.env.BASE_URL;
const resources = [
  {
    id: 'seo-coach',
    category: 'SEO／網站經營',
    title: 'SEO Coach — AI SEO 陪跑教練',
    description: '網站上線後，讓 AI 依照實際網站狀況，一步步帶你學習搜尋引擎優化、關鍵字與內容分析，並驗證每次修改的結果。',
    audience: '適合：想開始學 SEO、經營內容或了解 Google 搜尋成效的網站主人',
    url: 'https://github.com/akseolabs-seo/seo-coach',
    docs: 'https://github.com/akseolabs-seo/seo-coach/blob/main/README.zh-TW.md',
    prompt: '請幫我閱讀並評估這個 GitHub 專案的 SEO Coach Skill 是否適合我的網站及目前使用的 AI 工具：https://github.com/akseolabs-seo/seo-coach 。如果適合，先說明安裝位置、必要的檔案與權限，再協助我安裝並驗證 Skill 可以使用。不要擅自啟用選用的 Hooks、改動我的網站或部署正式版本。'
  },
  {
    id: 'kittenjam-motion',
    category: '設計／動效靈感',
    title: 'KittenJam Motion Library — 動效與 AI 提示詞靈感庫',
    description: '瀏覽會動的文字效果、滑過互動與標題演出，依名稱、標籤和示範找出想要的動感，再請 AI 評估是否適合你的網站。',
    audience: '適合：想改善標題、閱讀互動或品牌細節，並希望用範例跟 AI 說明效果的網站主人',
    url: 'https://kittenjam-motion-library.vercel.app/',
    docs: 'https://kittenjam-motion-library.vercel.app/',
    linkLabel: '瀏覽動效示範 ↗',
    docsLabel: '查看效果與提示詞 ↗',
    prompt: '請先查看 KittenJam Motion Library：https://kittenjam-motion-library.vercel.app/ ，依我指定的效果名稱或編號，評估是否適合我的 Astro 個人網站。先確認該效果的實際行為、技術需求與授權，並檢查網站是否已有同類動效，不要直接安裝未知套件或照搬原始程式碼。提出低強度的實作方式，保持文字可讀、鍵盤可用、手機合理降級，支援 prefers-reduced-motion，無 JavaScript 時內容仍可見。任何修改先走 Branch 與 PR，由我確認後再合併。'
  }
];
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>延伸資源｜AI 個人網站工作坊</title>
  <meta name="description" content="網站上線後可選用的 AI 工具、Skills 與學習資源。" />
  <style>
    :root{--bg:#f7f5f0;--ink:#272822;--green:#254e3d;--line:#d8ded4;--muted:#59635b}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.8 system-ui,"Noto Sans TC",sans-serif}
    a{color:var(--green)}a:focus-visible,button:focus-visible{outline:3px solid #b47848;outline-offset:3px}
    .top{background:#fffefa;border-bottom:1px solid var(--line);padding:17px max(24px,calc((100vw - 1050px)/2));display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
    .tabs{display:flex;gap:9px;flex-wrap:wrap}.tabs a{border:1px solid var(--line);border-radius:7px;padding:6px 14px;text-decoration:none}.tabs [aria-current=page]{background:var(--green);color:white}
    main{max-width:1050px;margin:auto;padding:48px 24px 85px}h1{font:600 clamp(34px,5vw,54px)/1.25 Georgia,serif;margin:8px 0 12px}h2{line-height:1.35}
    .eyebrow{font-size:13px;font-weight:700;letter-spacing:.12em;color:var(--green)}.lead{max-width:730px;font-size:18px}.muted{color:var(--muted)}
    .resource-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,310px),1fr));gap:18px;margin-top:34px}
    .resource-card{display:flex;flex-direction:column;gap:12px;background:#fffefa;border:1px solid var(--line);border-radius:12px;padding:26px;min-width:0}
    .resource-card h2,.resource-card p{margin:0}.resource-card h2{font-size:23px}
    .tag{align-self:flex-start;border:1px solid var(--line);border-radius:999px;padding:2px 10px;font-size:13px;color:var(--green)}
    .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:auto;padding-top:10px}
    .button{font:inherit;cursor:pointer;background:var(--green);color:white;text-decoration:none;border:1px solid var(--green);border-radius:7px;padding:9px 14px;display:inline-block}
    .button.alt{color:var(--green);background:white}.hint{margin-top:32px;padding:18px 21px;border-left:4px solid #ad7955;background:#fff4e9}
    footer{padding:30px;text-align:center;border-top:1px solid var(--line)}
    @media(max-width:650px){main{padding:28px 19px 65px}.top{padding:14px 19px}}
  </style>
</head>
<body>
<WorkshopNav current="resources" />
<main>
  <p class="eyebrow">AFTER LAUNCH · OPTIONAL RESOURCES</p>
  <h1>網站上線後，還能做些什麼？</h1>
  <p class="lead">這裡收集適合網站經營者自行探索的 AI 工具與 Skill。它們都不是完成工作坊的必要條件，有需求時再使用即可。</p>
  <div class="resource-grid">
    {resources.map(resource => <article class="resource-card" id={resource.id}>
      <span class="tag">{resource.category}</span>
      <h2>{resource.title}</h2>
      <p>{resource.description}</p>
      <p class="muted">{resource.audience}</p>
      <div class="actions">
        <a class="button" href={resource.url} target="_blank" rel="noopener noreferrer">{resource.linkLabel ?? "GitHub 專案 ↗"}</a>
        <a class="button alt" href={resource.docs} target="_blank" rel="noopener noreferrer">{resource.docsLabel ?? "繁體中文介紹 ↗"}</a>
        <button class="button alt" type="button" data-copy={resource.id}>複製給 AI 的指令</button>
      </div>
    </article>)}
  </div>
  <div class="hint">外部工具與 Skill 由原作者維護，版本、授權與功能可能變動。使用前請 AI 先核對來源、授權和必要權限；瀏覽靈感不代表需要安裝套件，也不必為了參考資源而重新部署網站。</div>
</main>
<footer>AI 個人網站工作坊 · <a href={base+'guide/'}>回建站指南</a></footer>
<script define:vars={{copyTexts:Object.fromEntries(resources.map(({id,prompt})=>[id,prompt]))}}>
  document.querySelectorAll('[data-copy]').forEach(button => {
    button.addEventListener('click', async () => {
      const original=button.textContent;
      try { await navigator.clipboard.writeText(copyTexts[button.dataset.copy]); button.textContent='已複製'; }
      catch { button.textContent='複製失敗，請手動複製'; }
      setTimeout(()=>{button.textContent=original},1700);
    });
  });
</script>
</body>
</html>