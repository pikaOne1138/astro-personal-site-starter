---
import WorkshopNav from '../../components/WorkshopNav.astro';
import {layoutDefinitions} from '../../data/layout-assembly/definitions.mjs';
const assembledLayoutCount=layoutDefinitions.filter(layout=>layout.adapter).length;
import startBuildPrompt from '../../../docs/student-builder-pack/START-BUILD-PROMPT.txt?raw';
const routePrompts=[
'我已上傳「AI-replica-skill-pack.zip」，想將我擁有或已獲授權的網站以 Astro 重建。原網站網址：【貼上網址】。請先讀 START-HERE.md 與復刻 Skill，實際盤點首頁、文章、分類、深層頁面、圖片、手機版和互動，列出可還原與無法取得之處。請先確認你有檔案操作、網站建置和真實預覽能力，再提出重建計畫。一次只問一個必要問題。完成後提供對應最新 Commit 的可開啟預覽網址；未經我同意，不得合併或正式發布。',
'我已上傳「AI-from-zero-skill-pack.zip」，想直接和 AI 討論並建立自己的 Astro 網站。我不會寫程式，也不需要先填規劃器或製作 Site Brief JSON。請先讀 START-HERE.md 和 astro-site-from-zero Skill，確認你能否操作檔案、建置與預覽。接著用白話一次問我一個重要問題，有足夠資訊就整理網站方向讓我確認，之後建立可長期維護的網站。完成後提供實際可開啟、對應最新 Commit 的預覽；我同意前不要合併或正式發布。'
];
const base=import.meta.env.BASE_URL;
const link=(path:string)=>base+path.replace(/^\//,'');
const steps=[
{n:'01',name:'完成網站規劃並下載 Site Brief',intro:'先在 Starter 選擇版型、品牌與頁面，整理要交給建站 AI 的網站需求。AI 需求訪談與 Logo 設計都在 Starter 第 04 步選用；不需要可跳過。',you:['進入 Starter，選擇版型、填寫已知的網站資訊','若有進行 AI 訪談，將 AI 整理的文字摘要貼回 Starter 第 04 步的「AI 訪談結果」欄位','確認 Starter 的選擇與訪談摘要，在第 07 步下載 Site Brief JSON（my-astro-site-plan.json）'],ai:''},
{n:'02',name:'下載完整建站包，交給 AI',intro:'下載下方的 AI 建站資料包 ZIP，連同 Starter 產生的 Site Brief JSON 一起交給具備專案操作能力的 AI，再複製正式建站提示詞。若有做過訪談，文字摘要已在 Site Brief 裡，不用再提供訪談包。',you:['先將 Starter 下載的 Site Brief JSON 提供給建站 AI','點下方按鈕下載 AI 建站資料包 ZIP，連同 Site Brief 交給同一個建站 AI','貼上「開始建站」提示詞'],ai:''},
{n:'03',name:'AI 製作網站',intro:'AI 建立網站後，打開預覽連結查看。',you:['請 AI 告訴你下一步要確認什麼','收到網站預覽連結後，實際打開看首頁、About 與文章／服務頁'],ai:''},
{n:'04',name:'讓網站可以預覽',intro:'沿用前置準備選定的發布方式，取得網站預覽網址。',you:['依 AI 提示在託管平台完成必要的連接與授權','打開 AI 提供的網址，看圖文與連結是否正常'],ai:''},
{n:'05',name:'提出修改意見',intro:'截圖告訴 AI 需要修改的地方。',you:['用手機和電腦看實際頁面','截圖圈出問題、說明希望改成什麼','重開更新後的預覽連結確認'],ai:''},
{n:'06',name:'確認後正式發布',intro:'確認內容、圖片與連結後再發布。',you:['檢查網站資訊、主要按鈕、文章／服務與手機畫面','確認沒有不願公開的資料','滿意後再明確同意發布'],ai:''},
{n:'07',name:'上線後更新網站',intro:'更新內容時，先預覽再發布。',you:['收藏自己的正式網址與 GitHub 倉庫網址','下次修改時先請 AI 提供預覽，不直接覆蓋正式站'],ai:''}
];
const prompts=[
{title:'開始建站',text:startBuildPrompt.trim()},
{title:'請 AI 引導連接網站託管',text:'我想把這個網站放上網路，使用【Cloudflare Pages／GitHub Pages】。請依我眼前的網站畫面，一次教我按一個步驟。碰到畫面不一樣就請我截圖，不要猜測按鈕位置。程式設定由你處理；每一步請告訴我完成後應看到什麼。先取得可打開的測試網址，不要擅自發布正式版本。'},
{title:'請 AI 幫我修正畫面',text:'這是我的網站預覽連結：【貼網址】。這是我想修改的地方：【用自己的話描述，也可以附截圖】。請只修改這次提到的問題，保留原本選擇的設計風格。修好後給我新的預覽連結，並用白話告訴我改了什麼。先不要合併或發布。'},
{title:'請 AI 進行上線前檢查',text:'我正在確認網站能不能正式公開。請替我檢查頁面、圖片、連結、搜尋、手機畫面與不應公開的資料。請用「正常／有問題／需要我親自看」三類白話回報，並提供預覽網址。我還沒有同意合併或發布，請先等我確認。'},
{title:'請 AI 幫我日後更新',text:'我想修改自己已上線的網站：【說明想改什麼】。請先製作一份不影響目前正式網站的預覽版本，提供網址讓我查看。確認沒問題再問我是否同意發布。'}

];
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>開始建置｜個人網站指南</title>
<style>
:root{--bg:#f7f5f0;--ink:#272822;--green:#254e3d;--line:#d8ded4;--muted:#59635b}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.8 system-ui,"Noto Sans TC",sans-serif}h1,h2{line-height:1.3}h1{font:600 clamp(35px,5vw,58px)/1.25 Georgia,serif}h2{font-size:27px}a{color:var(--green)}button{font:inherit;cursor:pointer}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #b47848;outline-offset:3px}.top{background:#fffefa;border-bottom:1px solid var(--line);padding:17px max(24px,calc((100vw - 1050px)/2));display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}.tabs{display:flex;gap:9px}.tabs a{border:1px solid var(--line);border-radius:7px;padding:6px 14px;text-decoration:none}.tabs [aria-current=page]{background:var(--green);color:white}.wrap{max-width:1050px;margin:auto;padding:45px 24px 80px}.lead{font-size:19px;max-width:740px}.section{padding:32px 0;border-top:1px solid var(--line);scroll-margin-top:16px}.section-head{display:flex;gap:20px;align-items:baseline}.number{font:24px Georgia,serif;color:var(--green)}.card{background:#fffefa;border:1px solid var(--line);border-radius:11px;padding:20px 24px;margin:20px 0}.you{font-weight:700;margin-bottom:10px}.todo{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid #edf0e9}.todo input{margin-top:9px;width:17px;height:17px;accent-color:var(--green)}.button{background:var(--green);color:white;border:0;border-radius:7px;padding:9px 16px;text-decoration:none;display:inline-block}.button.alt{background:white;color:var(--green);border:1px solid var(--green)}.route-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:24px 0}.route-choice{text-align:left;font:inherit;background:#fffefa;color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:18px;cursor:pointer;line-height:1.6}.route-choice strong{display:block}.route-choice span{display:block;color:var(--muted);font-size:14px;margin-top:8px}.route-choice[aria-pressed=true]{border:2px solid var(--green);background:#edf1ea}.route-content{padding:22px;background:#fffefa;border:1px solid var(--line);border-radius:10px;margin:15px 0}.route-content[hidden],.starter-only[hidden],.quick[hidden]{display:none!important}.prompt{background:#ecf1ea;border:1px solid #d1ddce;border-radius:10px;padding:17px 19px;margin:20px 0;white-space:pre-wrap;overflow-wrap:anywhere}.prompt-head{display:flex;gap:12px;justify-content:space-between;align-items:center;margin-bottom:8px}.prompt p{margin:0}.small{color:var(--muted);font-size:14px}.note{border-left:4px solid #ad7955;background:#fff4e9;padding:15px 20px}.quick{display:flex;flex-wrap:wrap;gap:12px;padding:15px 0 38px}.quick a{border:1px solid var(--line);padding:7px 12px;border-radius:7px;background:white;text-decoration:none}.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}.two>div{background:#fffefa;border:1px solid var(--line);border-radius:10px;padding:18px}.last{padding:30px 0}footer{padding:32px;text-align:center;border-top:1px solid var(--line)}@media(max-width:650px){.route-grid{grid-template-columns:1fr}.two{grid-template-columns:1fr}.wrap{padding:24px 19px 65px}.top{padding:14px 19px}.prompt-head{align-items:flex-start;flex-direction:column}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style></head><body>
<WorkshopNav current="build" />
<main class="wrap"><p class="small">SITE BUILDING / 全程網頁操作</p><h1>開始建置自己的網站</h1><p class="lead">先選一種適合你的建站方式。不必三種都做；後續檢查預覽、修改與正式發布的流程相同。</p>
<p><a href={link('guide/faq/')}>第一次使用有困難？先看課前安心檢查與常見問題 →</a></p>
<div class="route-grid" role="group" aria-label="選擇建站方式">
<button class="route-choice" type="button" data-route="replica" aria-pressed="false"><strong>我已經有網站，想重新製作</strong><span>提供自己擁有或獲授權的網站網址，請 AI 重建版面與深層內容。</span></button>
<button class="route-choice" type="button" data-route="starter" aria-pressed="true"><strong>我想先看設計、挑喜歡的版型</strong><span>使用 ATP Starter 規劃器，挑選版型與品牌。</span></button>
<button class="route-choice" type="button" data-route="chat" aria-pressed="false"><strong>我想直接跟 AI 討論</strong><span>不必先填規劃器，從一句話開始讓 AI 陪你規劃。</span></button>
</div>
<section id="replica-route" class="route-content" hidden aria-label="復刻既有網站">
<h2>重建你原有的網站</h2><p>準備有權使用的原網站網址即可。AI 會先盤點可公開取得的頁面、圖片及互動；無法存取的頁面需要你後續提供資料。請使用有專案檔案操作能力的 AI。</p>
<ol><li>下載復刻 Skill ZIP，與網址一起提供 AI。</li><li>複製下方提示詞，讓 AI 先盤點網站與確認範圍。</li><li>檢查 AI 產生的網站路由清單及預覽；不要在確認前覆蓋原站。</li></ol>
<p><a class="button" href={link('AI-replica-skill-pack.zip')} download>下載復刻 Skill ZIP ↓</a></p>
<div class="prompt"><div class="prompt-head"><strong>開始重建網站</strong><button class="button alt route-copy" type="button" data-route-prompt="0">複製提示詞</button></div><p>{routePrompts[0]}</p></div></section>
<section id="chat-route" class="route-content" hidden aria-label="直接與 AI 討論">
<h2>從對話開始建自己的網站</h2><p>不知道設計、網站名稱或需要哪些頁面都沒關係。AI 會一次問一個問題，先整理需求再製作。<strong>不需要 Site Brief JSON。</strong></p>
<ol><li>下載從零建站 Skill ZIP 並上傳到有專案操作能力的 AI。</li><li>複製下方提示詞，直接描述你想做什麼。</li><li>確認 AI 整理的方向，讓它建站並提供實際預覽。</li></ol>
<p><a class="button" href={link('AI-from-zero-skill-pack.zip')} download>下載直接對話 Skill ZIP ↓</a></p>
<div class="prompt"><div class="prompt-head"><strong>開始和 AI 討論網站</strong><button class="button alt route-copy" type="button" data-route-prompt="1">複製提示詞</button></div><p>{routePrompts[1]}</p></div></section>
<div id="starter-route" class="starter-only"><p class="lead">選用現有 Starter，依序選版型、下載 Site Brief 與完整建站包，再交給 AI。</p><p><a class="button alt" href={link('guide/prepare/')}>我還沒準備好，先去前置準備 →</a></p>
</div><nav class="quick" aria-label="步驟快速跳轉">{steps.map(x=><a href={'#step-'+x.n}>{x.n} {x.name}</a>)}</nav>
{steps.map((st,i)=><section class={'section'+(i<2?' starter-only':'')} id={'step-'+st.n}><div class="section-head"><span class="number">{st.n}</span><h2>{st.name}</h2></div><p>{st.intro}</p>
{i===0 && <Fragment><p><a class="button" href={link('starter/')}>開啟 Starter 規劃網站 →</a></p></Fragment>}
{i===1 && <Fragment><div class="card"><h3>下載完整 AI 建站資料包 ZIP</h3><p>完整離線建站資料包包含網站生成器、版型、元件、設計 Skills 與相關原始碼。請將 <strong>AI 建站資料包 ZIP</strong> 與 <strong>Site Brief JSON</strong> 一起交給 AI。訪談包只用於前面的需求訪談；完成訪談後的摘要已寫入 Site Brief，建站時不用再傳訪談包。</p><button class="button" type="button" id="download-builder-zip">下載 AI 建站資料包 ZIP ↓</button><details class="note"><summary><strong>Beta 測試版：目前能做什麼、還需要 AI 做什麼？</strong></summary><p>資料包提供 {assembledLayoutCount} 種可產生獨立網站的設計選項，以及網站規劃、文章或服務頁、個人介紹、品牌與導覽設定。AI 可依資料包建立你自己的 Astro 專案，不必複製老師的 Repo。</p><p>部分新增設計仍在測試；選擇設計不代表網站已完成驗收。AI 仍需與你確認真實文字、圖片、服務資訊及內頁細節，完成電腦與手機預覽，並由你授權連接 GitHub 與發布平台；下載 ZIP 本身不會直接發布網站。</p><p>測試時請記下所選版型、遇到的困難，並把相關畫面截圖回報給工作坊。不要把示範資格、預約、書目、音訊或服務資訊當成真實資料。</p></details><p class="small">如果 AI 無法接收 ZIP，請改用能上傳<strong>完整資料夾或多檔專案</strong>的工具，解壓後保留 <code>.ai/</code>、<code>src/</code>、<code>scripts/</code> 等原始目錄結構；不能只傳 README 或幾份 Markdown。若工具無法保留檔案路徑，請先換成支援 ZIP／專案檔案的 AI 工作模式，再開始建站。</p></div></Fragment>}
<div class="card"><div class="you">你要做的事</div>{st.you.map((x,j)=><label class="todo"><input type="checkbox" data-task={st.n+'-'+j}/><span>{x}</span></label>)}</div>
{i===1 && <Fragment><div class="prompt"><div class="prompt-head"><strong>{prompts[0].title}</strong><button class="button alt copy" type="button" data-prompt="0">複製提示詞</button></div><p>{prompts[0].text}</p></div></Fragment>}
{i===3 && <Fragment><div class="two"><div><strong>Cloudflare Pages</strong><p>B 路線：保留私人原始碼、方便預覽。</p><a href="https://dash.cloudflare.com/" target="_blank" rel="noopener noreferrer">打開 Cloudflare ↗</a></div><div><strong>GitHub Pages</strong><p>A 路線：簡單免費，原始碼公開。</p><a href="https://github.com/" target="_blank" rel="noopener noreferrer">打開 GitHub ↗</a></div></div><p><a href={link("guide/prepare/#hosting")}>查看 A／B 發布方式設定步驟 →</a></p><div class="prompt"><div class="prompt-head"><strong>{prompts[1].title}</strong><button class="button alt copy" type="button" data-prompt="1">複製提示詞</button></div><p>{prompts[1].text}</p></div></Fragment>}
{i===4 && <Fragment><div class="prompt"><div class="prompt-head"><strong>{prompts[2].title}</strong><button class="button alt copy" type="button" data-prompt="2">複製提示詞</button></div><p>{prompts[2].text}</p></div></Fragment>}
{i===5 && <Fragment><div class="prompt"><div class="prompt-head"><strong>{prompts[3].title}</strong><button class="button alt copy" type="button" data-prompt="3">複製提示詞</button></div><p>{prompts[3].text}</p></div></Fragment>}
{i===6 && <Fragment><div class="prompt"><div class="prompt-head"><strong>{prompts[4].title}</strong><button class="button alt copy" type="button" data-prompt="4">複製提示詞</button></div><p>{prompts[4].text}</p></div></Fragment>}
</section>)}
<section class="section"><h2>看不懂畫面，怎麼辦？</h2><p>把你現在看到的網頁截圖傳給 AI，告訴它「請照這張畫面，一次只教我下一個要按的按鈕。」</p><div class="note">截圖前遮住密碼、驗證碼與私人資料。</div></section>
<section class="last"><h2>GitHub 常用頁面</h2><p><strong>Pull requests</strong> 查看修改，<strong>Actions</strong> 查看建置。</p><p>請 AI 提供你自己網站的 GitHub Repository 網址，進入該 Repo 的 <strong>Pull requests</strong> 和 <strong>Actions</strong>。不需要進入老師的研究 Repo。</p><p class="small">請 AI 提供你的網站 PR 與 Actions 連結。</p><p id="progress" aria-live="polite"></p></section>
</main><footer>個人網站建置指南 · <a href={link('guide/prepare/')}>前置準備</a></footer>
<script is:inline define:vars={{prompts:prompts.map(x=>x.text),routePrompts,siteBase:base}}>
const choices=[...document.querySelectorAll('[data-route]')];
function chooseRoute(which){
 for(const b of choices)b.setAttribute('aria-pressed',String(b.dataset.route===which));
 document.getElementById('replica-route').hidden=which!=='replica';
 document.getElementById('chat-route').hidden=which!=='chat';
 for(const x of document.querySelectorAll('.starter-only'))x.hidden=which!=='starter';
 document.querySelector('.quick').hidden=which!=='starter';
}
choices.forEach(b=>b.addEventListener('click',()=>chooseRoute(b.dataset.route)));
chooseRoute('starter');
document.querySelectorAll('.route-copy').forEach(b=>b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(routePrompts[Number(b.dataset.routePrompt)]);b.textContent='已複製'}catch{b.textContent='請手動選取'}setTimeout(()=>b.textContent='複製提示詞',1500)}));
const tasks=[...document.querySelectorAll('[data-task]')];
function refresh(){let n=tasks.filter(x=>x.checked).length;document.getElementById('progress').textContent='完成 '+n+' / '+tasks.length+' 項'}
tasks.forEach(x=>{try{x.checked=localStorage.getItem('workshop-guide-v2-'+x.dataset.task)==='1'}catch{}x.addEventListener('change',()=>{try{localStorage.setItem('workshop-guide-v2-'+x.dataset.task,x.checked?'1':'0')}catch{}refresh()})});refresh();
document.querySelectorAll('.copy').forEach(b=>b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(prompts[Number(b.dataset.prompt)]);b.textContent='已複製'}catch{b.textContent='請手動選取'}setTimeout(()=>b.textContent='複製提示詞',1500)}));
let packCommit='';
fetch(siteBase+'builder-pack-version.json',{cache:'no-store'}).then(r=>{if(!r.ok)throw Error('manifest unavailable');return r.json()}).then(info=>{
 const sha=typeof info.sourceCommit==='string'?info.sourceCommit:'';
 if(!/^[a-f0-9]{40}$/.test(sha))throw Error('unversioned distribution');
 packCommit=sha;

}).catch(()=>{packCommit='';});
document.getElementById('download-builder-zip')?.addEventListener('click',()=>{const a=document.createElement('a');a.href=siteBase+'AI-建站資料包.zip'+(packCommit?'?v='+packCommit:'');a.download='AI-建站資料包.zip';document.body.appendChild(a);a.click();a.remove()});

</script></body></html>