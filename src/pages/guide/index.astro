<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>開始建置｜Astro 工作坊</title>
<style>
:root{--bg:#f7f5f0;--ink:#272822;--green:#254e3d;--line:#d8ded4;--muted:#59635b}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.8 system-ui,"Noto Sans TC",sans-serif}h1,h2{line-height:1.3}h1{font:600 clamp(35px,5vw,58px)/1.25 Georgia,serif}h2{font-size:27px}a{color:var(--green)}button{font:inherit;cursor:pointer}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #b47848;outline-offset:3px}.top{background:#fffefa;border-bottom:1px solid var(--line);padding:17px max(24px,calc((100vw - 1050px)/2));display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}.tabs{display:flex;gap:9px}.tabs a{border:1px solid var(--line);border-radius:7px;padding:6px 14px;text-decoration:none}.tabs [aria-current=page]{background:var(--green);color:white}.wrap{max-width:1050px;margin:auto;padding:45px 24px 80px}.lead{font-size:19px;max-width:740px}.section{padding:32px 0;border-top:1px solid var(--line);scroll-margin-top:16px}.section-head{display:flex;gap:20px;align-items:baseline}.number{font:24px Georgia,serif;color:var(--green)}.card{background:#fffefa;border:1px solid var(--line);border-radius:11px;padding:20px 24px;margin:20px 0}.you{font-weight:700;margin-bottom:10px}.todo{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid #edf0e9}.todo input{margin-top:9px;width:17px;height:17px;accent-color:var(--green)}.button{background:var(--green);color:white;border:0;border-radius:7px;padding:9px 16px;text-decoration:none;display:inline-block}.button.alt{background:white;color:var(--green);border:1px solid var(--green)}.prompt{background:#ecf1ea;border:1px solid #d1ddce;border-radius:10px;padding:17px 19px;margin:20px 0;white-space:pre-wrap;overflow-wrap:anywhere}.prompt-head{display:flex;gap:12px;justify-content:space-between;align-items:center;margin-bottom:8px}.prompt p{margin:0}.small{color:var(--muted);font-size:14px}.note{border-left:4px solid #ad7955;background:#fff4e9;padding:15px 20px}.quick{display:flex;flex-wrap:wrap;gap:12px;padding:15px 0 38px}.quick a{border:1px solid var(--line);padding:7px 12px;border-radius:7px;background:white;text-decoration:none}.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}.two>div{background:#fffefa;border:1px solid var(--line);border-radius:10px;padding:18px}.last{padding:30px 0}footer{padding:32px;text-align:center;border-top:1px solid var(--line)}@media(max-width:650px){.two{grid-template-columns:1fr}.wrap{padding:24px 19px 65px}.top{padding:14px 19px}.prompt-head{align-items:flex-start;flex-direction:column}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style></head><body>
<header class="top"><strong>ASTRO WORKSHOP / 操作指南</strong><nav class="tabs" aria-label="教學頁面"><a href={link('guide/prepare/')}>前置準備</a><a href={link('guide/')} aria-current="page">開始建置</a></nav></header>
<main class="wrap"><p class="small">SITE BUILDING / 全程網頁操作</p><h1>開始建置自己的網站</h1><p class="lead">你只需要操作網頁、上傳檔案、貼上提示詞，然後檢查網站畫面。AI 負責程式與檢查。還沒建立 GitHub 帳號、網站內容或 Logo？先到前置準備。</p><p><a class="button alt" href={link('guide/prepare/')}>我還沒準備好，先去前置準備 →</a></p>
<nav class="quick" aria-label="步驟快速跳轉">{steps.map(x=><a href={'#step-'+x.n}>{x.n} {x.name}</a>)}</nav>
{steps.map((st,i)=><section class="section" id={'step-'+st.n}><div class="section-head"><span class="number">{st.n}</span><h2>{st.name}</h2></div><p>{st.intro}</p>
{#if i===0}<p><a class="button" href={link('starter/')}>開啟網站規劃器 →</a></p>{/if}
{#if i===1}<div class="card"><h3>下載給 AI 的建站資料包</h3><p>這份資料包收好 AI 所需的設計規則與參考文件，不需要自己讀。下載後和 Site Brief JSON 一起上傳 AI 對話。</p><button class="button" type="button" id="download-builder-zip">下載 AI 建站資料包 ZIP ↓</button><p class="small">若 AI 不支援 ZIP，可以先解壓縮再上傳文件。技術資料由 AI 自行處理。</p></div>{/if}
<div class="card"><div class="you">你要做的事</div>{st.you.map((x,j)=><label class="todo"><input type="checkbox" data-task={st.n+'-'+j}/><span>{x}</span></label>)}</div>
{#if i===1}<div class="prompt"><div class="prompt-head"><strong>{prompts[0].title}</strong><button class="button alt copy" type="button" data-prompt="0">複製提示詞</button></div><p>{prompts[0].text}</p></div>{/if}
{#if i===3}<div class="two"><div><strong>Cloudflare Pages</strong><p>建議希望使用私有 GitHub 倉庫、方便預覽的學員選擇。</p><a href="https://dash.cloudflare.com/" target="_blank" rel="noopener noreferrer">打開 Cloudflare ↗</a></div><div><strong>GitHub Pages</strong><p>不想使用 Cloudflare、願意公開原始碼時也可以選。</p><a href="https://github.com/" target="_blank" rel="noopener noreferrer">打開 GitHub ↗</a></div></div><div class="prompt"><div class="prompt-head"><strong>{prompts[1].title}</strong><button class="button alt copy" type="button" data-prompt="1">複製提示詞</button></div><p>{prompts[1].text}</p></div>{/if}
{#if i===4}<div class="prompt"><div class="prompt-head"><strong>{prompts[2].title}</strong><button class="button alt copy" type="button" data-prompt="2">複製提示詞</button></div><p>{prompts[2].text}</p></div>{/if}
{#if i===5}<div class="prompt"><div class="prompt-head"><strong>{prompts[3].title}</strong><button class="button alt copy" type="button" data-prompt="3">複製提示詞</button></div><p>{prompts[3].text}</p></div>{/if}
{#if i===6}<div class="prompt"><div class="prompt-head"><strong>{prompts[4].title}</strong><button class="button alt copy" type="button" data-prompt="4">複製提示詞</button></div><p>{prompts[4].text}</p></div>{/if}
<p class="small"><strong>AI 負責：</strong>{st.ai}</p></section>)}
<section class="section"><h2>看不懂畫面，怎麼辦？</h2><p>把你現在看到的網頁截圖傳給 AI，告訴它「請照這張畫面，一次只教我下一個要按的按鈕。」</p><div class="note">不要傳密碼、驗證碼、API 金鑰或不願公開的私人資料。沒有真正收到預覽網址，不代表網站已經完成。</div></section>
<section class="last"><h2>GitHub 常用頁面</h2><p>只要記得：<strong>Pull requests</strong> 看修改、<strong>Actions</strong> 看網站建置狀態。真的看不懂可以截圖問 AI。</p><p><a href="https://github.com/pikaOne1138/astro-personal-site-starter/pulls" target="_blank" rel="noopener noreferrer">PR 範例 ↗</a>　·　<a href="https://github.com/pikaOne1138/astro-personal-site-starter/actions" target="_blank" rel="noopener noreferrer">Actions 範例 ↗</a></p><p class="small">這裡是工作坊的示範頁面。請讓 AI 提供你自己的網站相對應連結。</p><p id="progress" aria-live="polite"></p></section>
</main><footer>Astro 架站工作坊 · <a href={link('guide/prepare/')}>前置準備</a></footer>
<script is:inline define:vars={{prompts:prompts.map(x=>x.text),builderFiles}}>
const tasks=[...document.querySelectorAll('[data-task]')];
function refresh(){let n=tasks.filter(x=>x.checked).length;document.getElementById('progress').textContent='本機操作進度：'+n+' / '+tasks.length+' 項；勾選不等於網站已正式驗收。'}
tasks.forEach(x=>{try{x.checked=localStorage.getItem('workshop-guide-v2-'+x.dataset.task)==='1'}catch{}x.addEventListener('change',()=>{try{localStorage.setItem('workshop-guide-v2-'+x.dataset.task,x.checked?'1':'0')}catch{}refresh()})});refresh();
document.querySelectorAll('.copy').forEach(b=>b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(prompts[Number(b.dataset.prompt)]);b.textContent='已複製'}catch{b.textContent='請手動選取'}setTimeout(()=>b.textContent='複製提示詞',1500)}));
// Small dependency-free ZIP writer (STORE, UTF-8 filenames) for beginner download.
function makeZip(files){
 const enc=new TextEncoder(), parts=[], central=[];let offset=0;
 const u16=n=>new Uint8Array([n&255,n>>>8&255]);
 const u32=n=>new Uint8Array([n&255,n>>>8&255,n>>>16&255,n>>>24&255]);
 const cat=(...a)=>{let size=a.reduce((s,x)=>s+x.length,0),out=new Uint8Array(size),i=0;for(let x of a){out.set(x,i);i+=x.length}return out};
 const crc32=data=>{let c=-1;for(let b of data){c^=b;for(let k=0;k<8;k++)c=(c>>>1)^((c&1)?0xEDB88320:0)}return(c^-1)>>>0};
 for(const [name,content] of Object.entries(files)){
   let fn=enc.encode(name),data=enc.encode(content),crc=crc32(data),flag=0x0800;
   let local=cat(u32(0x04034b50),u16(20),u16(flag),u16(0),u16(0),u16(0),u32(crc),u32(data.length),u32(data.length),u16(fn.length),u16(0),fn,data);
   parts.push(local);
   central.push(cat(u32(0x02014b50),u16(20),u16(20),u16(flag),u16(0),u16(0),u16(0),u32(crc),u32(data.length),u32(data.length),u16(fn.length),u16(0),u16(0),u16(0),u16(0),u32(0),u32(offset),fn));
   offset+=local.length;
 }
 const body=cat(...parts),dir=cat(...central),end=cat(u32(0x06054b50),u16(0),u16(0),u16(central.length),u16(central.length),u32(dir.length),u32(body.length),u16(0));
 return new Blob([body,dir,end],{type:'application/zip'});
}
document.getElementById('download-builder-zip')?.addEventListener('click',()=>{const blob=makeZip(builderFiles),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='Astro-AI-建站資料包.zip';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)});
document.getElementById('download-intake-zip')?.addEventListener('click',()=>{
 const a=document.createElement('a'),blob=makeZip(intakeFiles),url=URL.createObjectURL(blob);
 a.href=url;a.download='Astro-建站前AI訪談包.zip';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);
});

</script></body></html>