<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="給零程式學員的 Astro 獨立網站實作 SOP：GitHub、Cloudflare Pages、AI 提示詞、PR 預覽、微調、發布與維護。"/>
<meta name="robots" content="noindex"/>
<title>從零到網站上線｜Astro 工作坊操作手冊</title>
<style>
:root{color-scheme:light;--paper:#f6f3ed;--ink:#242620;--muted:#646961;--line:#dcded6;--green:#254d3f;--surface:#fffefa}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:system-ui,"Noto Sans TC",sans-serif;line-height:1.85}a{color:var(--green);text-underline-offset:4px}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #bc7345;outline-offset:3px}button{font:inherit;cursor:pointer}h1,h2,h3{line-height:1.35;letter-spacing:-.025em}h1{font-family:Georgia,"Noto Serif TC",serif;font-size:clamp(2.25rem,5vw,4.7rem);margin:.7rem 0 1.1rem}h2{font-size:clamp(1.55rem,3vw,2.2rem);margin:0 0 1rem}h3{font-size:1.12rem;margin:0 0 .45rem}.kicker{font-size:.73rem;letter-spacing:.16em;font-weight:800;color:var(--green)}.nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem max(1.5rem,calc((100vw - 1170px)/2));border-bottom:1px solid var(--line);background:var(--surface)}.nav strong{font-family:Georgia,serif}.nav a{font-size:.86rem}.hero{max-width:1180px;margin:0 auto;padding:5rem 1.5rem 4rem;display:grid;grid-template-columns:1.4fr .6fr;gap:3rem}.lead{font-size:1.18rem;max-width:690px;color:#50574f}.note{padding:1.4rem;border:1px solid #c7d2c4;background:#e8eee6;border-radius:12px;align-self:end}.layout{display:grid;grid-template-columns:235px minmax(0,860px);gap:4rem;max-width:1180px;margin:auto;padding:0 1.5rem 7rem}.side{position:sticky;top:1.3rem;align-self:start}.side a{display:block;padding:.3rem 0;color:var(--muted);text-decoration:none;font-size:.87rem}.side a:hover{color:var(--green)}.side small{display:block;margin-top:1rem;color:var(--muted)}.chapter{padding:3rem 0;border-top:1px solid #c8cdc4;scroll-margin-top:1rem}.chapter-number{font-family:Georgia,serif;font-size:1.05rem;color:#557165}.card{border:1px solid var(--line);border-radius:12px;background:var(--surface);padding:1.3rem 1.5rem;margin:1rem 0}.card h3{margin-top:0}.steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.steps .card{margin:0}.small{font-size:.9rem;color:var(--muted)}.task{display:flex;gap:.65rem;align-items:flex-start;padding:.65rem 0;border-bottom:1px solid #eceee8}.task input{margin-top:.55rem;accent-color:var(--green);width:17px;height:17px;flex:none}.task:has(input:checked) span{text-decoration:line-through;color:#7b827a}.btn{border:1px solid var(--green);background:var(--green);color:white;padding:.55rem 1rem;border-radius:6px;font-weight:700}.btn.ghost{background:transparent;color:var(--green)}.prompt{background:#f0f2ec;border:1px solid #cfd8ca;padding:1.2rem;border-radius:10px;margin:1.2rem 0}.prompt-top{display:flex;justify-content:space-between;gap:.7rem;align-items:center;margin-bottom:1rem}.prompt-top strong{font-size:.95rem}.prompt pre{font:inherit;font-size:.9rem;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere;margin:0}code{background:#e7eae2;padding:.1rem .25rem;border-radius:3px;overflow-wrap:anywhere}.links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.links a{border:1px solid var(--line);border-radius:8px;background:white;padding:.8rem 1rem;text-decoration:none}.links a:hover{border-color:var(--green)}.links span{display:block;font-size:.78rem;color:var(--muted)}.warning{border-left:4px solid #a76139;padding:1rem;background:#fff4e8}.stage{display:grid;grid-template-columns:2.5rem 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}.stage b{font-family:Georgia,serif;color:var(--green)}.stage p{margin:.15rem 0;color:var(--muted);font-size:.9rem}table{border-collapse:collapse;width:100%;font-size:.9rem}th,td{text-align:left;border-bottom:1px solid var(--line);padding:.75rem .6rem;vertical-align:top}th{color:var(--green)}footer{padding:3rem 1.5rem;text-align:center;border-top:1px solid var(--line);color:var(--muted)}@media(max-width:850px){.hero{grid-template-columns:1fr;padding-top:3rem}.layout{grid-template-columns:1fr;gap:0}.side{position:static;padding:1rem 0 2rem}.side-links{display:flex;gap:1rem;overflow:auto;white-space:nowrap}.side a{display:inline-block}.steps,.links{grid-template-columns:1fr}.chapter{padding:2.5rem 0}.prompt-top{align-items:flex-start}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
