---
import intakeReadme from '../../../docs/student-intake/README.md?raw';
import intakeHost from '../../../docs/student-intake/01-AI-訪談主持人.md?raw';
import intakeAbout from '../../../docs/student-intake/02-網站定位與個人介紹.md?raw';
import intakeContent from '../../../docs/student-intake/03-內容準備-二選一.md?raw';
import intakeAssets from '../../../docs/student-intake/04-圖片與發布準備.md?raw';
import intakeVisual from '../../../docs/student-intake/05-AI-品牌識別與圖片共創.md?raw';
import intakeResearch from '../../../docs/student-intake/06-Logo與圖片設計研究.md?raw';
const intakeFiles={'README.md':intakeReadme,'01-AI-訪談主持人.md':intakeHost,'02-網站定位與個人介紹.md':intakeAbout,'03-內容準備-二選一.md':intakeContent,'04-圖片與發布準備.md':intakeAssets,'05-AI-品牌識別與圖片共創.md':intakeVisual,'06-Logo與圖片設計研究.md':intakeResearch};
const base=import.meta.env.BASE_URL;
const link=(path:string)=>base+path.replace(/^\//,'');
const steps=[
{n:'00',name:'認識流程與成果',time:'先讀',desc:'這是一份真正可以拿來測試的操作手冊。你會建立自己的獨立網站，而不是修改工作坊的展示站。'},
{n:'01',name:'前置準備入口',time:'前置',desc:'確認 GitHub、AI 開發工具、網站文字、圖片、聯絡資訊。Cloudflare 可以晚一點再連接。'},
{n:'02',name:'GitHub 常用捷徑',time:'前置',desc:'學會分辨 Repo、Code、Branch、Pull requests、Actions、Settings，以及正式網站。'},
{n:'03',name:'規劃網站並匯出 JSON',time:'規劃',desc:'先選網站用途、首頁 Layout、配色、導航和 Section Patterns；把規劃器的 Site Brief JSON 保存好。'},
{n:'04',name:'建立獨立網站原始碼',time:'建置',desc:'讓 AI 根據 Site Brief 產生 Astro 骨架，然後照選定 Layout 完成真正的設計與內頁。'},
{n:'05',name:'將獨立網站放上 GitHub',time:'建置',desc:'自己的網站要使用自己的 Repository，不要推送到工作坊展示 Repo。'},
{n:'06',name:'連接 Cloudflare Pages',time:'發布前',desc:'推薦初次測試採 GitHub + Cloudflare Pages；也提供只用 GitHub Pages 的替代路線。'},
{n:'07',name:'開 PR、看預覽、微調',time:'反覆測試',desc:'所有修改先開 Branch/PR，檢查 Build、預覽網址和四種螢幕尺寸，再回報 AI 修正。'},
{n:'08',name:'核准發布、驗收網站',time:'上線',desc:'親自確認後才 Merge。檢查網址、文章、搜尋、聯絡、手機、SEO，不以綠色 Build 當成完成。'},
{n:'09',name:'日常更新、備份與還原',time:'後續',desc:'學會新增文章、修正網站、檢查部署記錄，以及如何透過 PR 撤回錯誤變更。'}
];
const prompts=[
{title:'01｜先讓 AI 檢查前置條件',body:`我完全不會寫程式，要照著 Astro 架站工作坊建立自己的「獨立個人網站」。請先協助我確認：GitHub 是否已登入並授權你操作、是否有可編輯的程式碼工作環境、是否已準備網站文字/圖片，以及我選擇 Cloudflare Pages 還是 GitHub Pages。沒有授權的事情請告訴我應該在哪個官方介面按哪個選項；不要索取或顯示 API Token、密碼。請按「已完成／缺少／下一步」回覆，不要直接修改工作坊展示站。`},
{title:'02｜請 AI 幫我整理網站素材',body:`我要做一個 Astro 個人網站。類型是【知識／部落格 或 助人者／專業服務】。讀者是【填寫】，最重要的行動是【讀文章／聯絡／預約】。我已有的內容是【填寫】。請先整理：網站名稱與一句介紹、必需頁面、每頁需要的文字與圖片、哪些真實資訊不足、不可虛構的資料。不要替我編造證照、評論、服務成效、價格、聯絡方式或文章。`},
{title:'03｜根據 Site Brief 組裝網站',body:`我已附上從 /starter/ 匯出的 Site Brief JSON。請先閱讀此 Repo 的 AGENTS.md、.ai/astro-starter-onboarding/SKILL.md、.ai/astro-site-assembly/SKILL.md、.ai/astro-layout-craft/SKILL.md、.ai/astro-editorial-layout-design/SKILL.md、.ai/astro-ui-craft/SKILL.md，以及現有 Blocks 與 Section Patterns Registry。驗證 JSON 後，請由你在具備檔案／程式碼操作能力的環境建立獨立 Astro 網站骨架；我只透過網頁上傳 JSON、授權 GitHub 和確認結果，不操作終端機。你可以依專案 Skill 使用必要的內部工具或指令，但不必把程式指令當成我的學員步驟。絕對不要覆蓋原展示站。接著依我選的真實 Layout Prototype 做第二階段構圖移植（Hero 比例、資訊順序、圖文、手機重排），完成所有啟用內頁及真實連結，而不只換顏色。未配置的功能要隱藏或標示，不能假裝成功。請先列出建立的檔案、缺少的內容及完整建置計畫。`},
{title:'04｜建立自己的 GitHub Repository',body:`請幫我將目前產生的「獨立 Astro 網站」放到我自己的 GitHub Repository，建議名稱【我的網站英文名稱】。先確認我是否授權 GitHub，以及現在目錄確實是獨立網站而不是工作坊展示倉庫。不得把研究展示站的 GitHub Pages 網址、base 路徑、PR 預覽 Workflow 原封不動帶過來。若需要我到 GitHub 建立新 Repository，請提供清楚的操作步驟；涉及刪除、公開敏感資料或覆蓋既有 Repo 必須先問我。`},
{title:'05｜設定 Cloudflare Pages',body:`我要讓自己的獨立 Astro 靜態網站用 GitHub + Cloudflare Pages 發布。請閱讀 .ai/astro-starter-deploy/SKILL.md，先確認 Repo、靜態產出、Astro site/base 與部署分支。引導我在 Cloudflare Dashboard → Workers & Pages → Create application → Pages → Import an existing Git repository 授權 GitHub 並選對 Repo；Production branch 用 main、Build command 用 npm run build、Output directory 用 dist。請先驗證目前 Cloudflare 官方介面與方案仍適用。不得要求我把 Token 貼在聊天或 Commit，也不得宣稱網站已部署，直到我提供實際部署成功頁面或你查核到結果。`},
{title:'06｜建立修改 PR 與預覽',body:`請在我的「獨立網站 Repo」建立 feature branch 和 Pull Request，這次只修改【具體頁面或問題】。先讀 AGENTS.md 和相關 UI/部署 Skills，確認原有 Layout、Blocks 和 tokens。由你執行建置檢查並提供實際結果，列出修改檔案與可能影響。若 Cloudflare Pages 已連上 GitHub，請提供真正成功部署的 Preview URL；若我走 GitHub Pages，請先確認是否有正確配置的 PR Preview，不能憑空捏造預覽網址。不要替我 Merge，我要先驗收。`},
{title:'07｜用畫面回饋做微調',body:`我在 PR 預覽中發現以下問題：【貼上截圖、問題網址、裝置寬度及具體問題】。請只修正這次提到的地方，優先改善 Typography、Hierarchy、Grid、Spacing、Image treatment、CJK 與 RWD，不新增多餘效果或重做整個版型。檢查 1440、1280、768、390px，包含鍵盤與觸控、prefers-reduced-motion；重新 Build，把修正推到同一 PR。提供前後差異、測試證據與仍未驗收項目，等待我確認。`},
{title:'08｜正式上線前逐項檢查',body:`我準備發布此獨立 Astro 網站。請按 .ai/astro-content-readiness/SKILL.md、.ai/astro-navigation-tree-test/SKILL.md、.ai/astro-starter-deploy/SKILL.md 檢查所有啟用頁面、真實內容、主 CTA、文章、Pagefind、圖片授權、SEO 與不同裝置。真人 Tree Test 要列成待我實際操作，不能假裝測過。請給我「已驗證／未驗證／阻擋上線」清單，並停在等待我明確同意合併 PR 的階段。`},
{title:'09｜合併後檢查與日常維護',body:`我已明確核准這次 PR 可以合併。合併後請檢查 Cloudflare Pages 或 GitHub Pages 的最新 Production deployment，確認正式 URL 的首頁、內頁、手機選單、文章搜尋、RSS/sitemap/404 都可用。再依 .ai/astro-launch-health-check/SKILL.md 和 .ai/astro-site-maintenance/SKILL.md 提供下次寫文章、修改內容、備份、回復錯誤版本的簡明 SOP。不要把 GitHub Commit 當成外部表單、DNS 或電子報資料的完整備份。`}
];
