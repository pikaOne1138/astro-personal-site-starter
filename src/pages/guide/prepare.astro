const pages=[
{title:'GitHub 是什麼？',id:'account',desc:'GitHub 是存放網站原始碼的地方；Repository（倉庫）就是每一個網站專案的資料夾。'},
{title:'建立自己的倉庫',id:'repo',desc:'第一次先建一個自己的空白倉庫。之後 AI 才知道要把網站放在哪裡。'},
{title:'讓 AI 存取倉庫',id:'access',desc:'AI 能聊天，不代表它已經取得 GitHub 存取權。'},
