<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>前置準備｜Astro 架站工作坊</title><style>
:root{--bg:#f6f3ed;--ink:#242620;--green:#254d3f;--line:#d7dcd2}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.85 system-ui,"Noto Sans TC",sans-serif}a{color:var(--green)}a:focus-visible,button:focus-visible{outline:3px solid #bb7748;outline-offset:3px}.top{background:#fffefa;border-bottom:1px solid var(--line);padding:18px max(24px,calc((100vw - 1040px)/2));display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}.top nav{display:flex;gap:12px}.top nav a{border:1px solid var(--line);padding:7px 16px;border-radius:6px;text-decoration:none}.top nav a[aria-current=page]{background:var(--green);color:white}main{max-width:1040px;padding:48px 24px 96px;margin:auto}h1{font:600 clamp(36px,5vw,62px)/1.3 Georgia,"Noto Serif TC",serif}h2{font-size:27px;line-height:1.4}h3{font-size:20px}section{padding:32px 0;border-top:1px solid var(--line)}.lead{font-size:19px;max-width:800px}.card{padding:20px 24px;background:#fffefa;border:1px solid var(--line);border-radius:12px;margin:18px 0}.steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.steps a{display:block;padding:20px;border:1px solid var(--line);border-radius:10px;background:white;text-decoration:none}.steps small{display:block;color:#6b6d67}.button{border:0;border-radius:7px;background:var(--green);color:white;padding:11px 17px;cursor:pointer;font:inherit}.button.secondary{background:white;color:var(--green);border:1px solid var(--green)}.prompt{background:#eef1eb;padding:20px;border-radius:10px;white-space:pre-wrap;overflow-wrap:anywhere}ol li{margin-bottom:9px}aside{border-left:4px solid #a86946;padding:12px 18px;background:#fff3e8}.fine{font-size:14px;color:#60665d}footer{border-top:1px solid var(--line);text-align:center;padding:35px}@media(max-width:650px){.steps{grid-template-columns:1fr}main{padding:32px 20px 70px}.top{padding:12px 20px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}html{scroll-behavior:smoot