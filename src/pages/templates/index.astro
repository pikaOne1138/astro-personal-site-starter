---
import directions from '../../data/layout-directions.json';
import {layoutDefinitions} from '../../data/layout-assembly/definitions.mjs';
const statusBySlug=Object.fromEntries(layoutDefinitions.map(item=>[item.slug,item.assemblyStatus]));
const base=import.meta.env.BASE_URL;
const ready=new Set(layoutDefinitions.filter(x=>x.assemblyStatus==='ready').map(x=>x.slug)); const developing=new Set(layoutDefinitions.filter(x=>x.assemblyStatus==='in-progress').map(x=>x.slug));
const selected=directions.filter(x=>x.kind==='knowledge'||x.kind==='helper');
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>網站設計圖鑑｜Astro 工作坊</title><meta name="description" content="依照實際 Astro 首頁原型，觀看桌機及手機設計，選擇自己喜歡的網站方向。"/>
<style>
:root{--paper:#f7f4ee;--ink:#27231f;--line:#d8d0c3;--accent:#8a4535}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.8 system-ui,"Noto Sans TC",sans-serif}a{color:inherit}a:focus-visible,button:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.back{display:inline-block;margin:2rem max(20px,calc((100% - 1160px)/2));text-decoration:none}.intro,.gallery{max-width:1200px;margin:auto;padding:1rem 24px}.intro{padding-top:4rem;padding-bottom:2rem}.intro h1{font:500 clamp(2.4rem,5vw,4.7rem)/1.2 Georgia,"Noto Serif TC",serif;letter-spacing:-.03em}.intro>p{max-width:68ch}.filters{border:0;display:flex;gap:12px;margin:2rem 0;flex-wrap:wrap;padding:0}.filters label{border:1px solid var(--line);border-radius:100px;padding:9px 18px;cursor:pointer}.filters label:has(input:checked){background:var(--ink);color:#fff}.filters input{accent-color:var(--accent)}.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;padding-bottom:6rem}.template{background:#fff;border:1px solid var(--line);border-radius:15px;overflow:hidden;min-width:0}.template[hidden]{display:none}.template-images{padding:16px 16px 0;background:#e8e7e2}.template-images:has(img[data-missing="true"])::before{content:"網站截圖產製中";display:block;text-align:center;padding:5rem 1rem}.template-images:has(img[data-missing="true"]) img{display:none}.template-images img{display:block;width:100%;height:auto;max-height:310px;object-fit:cover;object-position:top;background:#e5e7e5;border:1px solid #d0d0cc}.template-images .phone{display:none;width:180px;height:310px;object-fit:cover;border:7px solid #333;border-radius:18px;margin:auto}.template-images[data-view="mobile"]{min-height:340px;display:grid;place-items:center}.template-images[data-view="mobile"] .desktop{display:none}.template-images[data-view="mobile"] .phone{display:block}.template-controls{display:flex;gap:8px;margin-top:12px;padding-bottom:14px}.template-controls button{border:1px solid #aaa;background:white;padding:7px 15px;border-radius:8px;cursor:pointer;font:inherit;font-size:.8rem}.template-controls button[aria-pressed="true"]{color:white;background:#333}.template-body{padding:22px}.template-head{display:flex;justify-content:space-between;gap:12px;align-items:start}.template-head h2{font:600 1.65rem/1.3 Georgia,"Noto Serif TC",serif;margin:0}.template-head span{font-size:.76rem;color:#675c4c;white-space:nowrap}.template-body p{margin:.7rem 0;color:#665f55}.template-body small{display:block;color:#6a645a}.template-actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:18px}.template-actions a{padding:10px 14px;min-height:44px;border-radius:8px;text-decoration:none;border:1px solid #7c7368;font-size:.9rem}.template-actions a:last-child{background:var(--ink);color:white}.template-actions a:hover{text-decoration:underline}@media(max-width:790px){.gallery{grid-template-columns:1fr}.intro{padding-top:2rem}}@media(prefers-reduced-motion:no-preference){.template{transition:box-shadow .2s}.template:hover{box-shadow:0 12px 28px #25221e16}}
</style></head><body><a class="back" href={base}>← 工作坊設計總覽</a><div class="intro"><p>VISUAL TEMPLATE GALLERY / 12 ASTRO LAYOUT DIRECTIONS</p><h1>先挑喜歡的網站模樣。</h1><p>比較 12 款實際 Astro 原型的桌機及手機畫面；選擇後再到規劃器調整配色、文字與頁面。截圖僅採實際 Astro 頁面擷取；未擷取成功時不使用無關圖片冒充。</p><p>目前田野筆記與清晰臨床已有獨立網站組裝器，其餘仍是原型，不會假裝已能完整套用。</p><fieldset class="filters"><legend>網站用途</legend><label><input type="radio" name="galleryKind" value="all" checked/> 全部 12 款</label><label><input type="radio" name="galleryKind" value="knowledge"/> 知識／部落格</label><label><input type="radio" name="galleryKind" value="helper"/> 助人者／專業服務</label></fieldset></div><div class="gallery" id="gallery">{selected.map(item=><article class="template" data-kind={item.kind}><div class="template-images" data-view="desktop"><img class="desktop" src={base+'template-gallery/'+item.slug+'-desktop.webp'} width="1440" height="900" loading="lazy" alt={item.title+' Astro 首頁桌機實際截圖'}/><img class="phone" src={base+'template-gallery/'+item.slug+'-mobile.webp'} width="390" height="844" loading="lazy" alt={item.title+' Astro 首頁手機實際截圖'}/><div class="template-controls" role="group" aria-label={item.title+' 畫面切換'}><button type="button" data-view="desktop" aria-pressed="true">桌機</button><button type="button" data-view="mobile" aria-pressed="false">手機</button></div></div><div class="template-body"><div class="template-head"><h2>{item.title}</h2><span>{ready.has(item.slug)?'Starter Ready':developing.has(item.slug)?'Assembly in Progress':'Prototype'}</span></div><p>{item.structure}</p><small>適合：{item.audience}</small><p>{item.description}</p><div class="template-actions"><a href={base+'layouts/'+item.slug+'/'} target="_blank" rel="noopener noreferrer">查看完整首頁 ↗</a><a href={base+'starter/?layout='+encodeURIComponent(item.slug)+'&kind='+item.kind}>{ready.has(item.slug)?'選擇並建立網站 →':'選擇設計、儲存規劃 →'}</a></div></div></article>)}</div>
<script is:inline>
document.querySelectorAll('input[name=galleryKind]').forEach(input=>input.addEventListener('change',()=>document.querySelectorAll('.template').forEach(card=>{card.hidden=input.value!=='all'&&card.dataset.kind!==input.value})));
document.querySelectorAll('.template-images img').forEach(img=>img.addEventListener('error',()=>img.dataset.missing='true'));
document.querySelectorAll('.template-controls').forEach(group=>group.querySelectorAll('button').forEach(btn=>btn.addEventListener('click',()=>{group.parentElement.dataset.view=btn.dataset.view;group.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(b===btn)))})));
</script></body></html>
