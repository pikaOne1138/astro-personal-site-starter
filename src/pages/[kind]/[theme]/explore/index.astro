---
import {kinds,themes,type Kind,type Theme} from '../../../../data';
export function getStaticPaths(){return kinds.flatMap(kind=>themes.map(theme=>({params:{kind,theme},props:{kind,theme}})));}
interface Props {kind:Kind;theme:Theme;}
const {kind,theme}=Astro.props;
const base=import.meta.env.BASE_URL;
const destination=base+kind+'/'+theme+'/articles/';
---
<html lang="zh-Hant"><head><meta charset="UTF-8"/><meta name="robots" content="noindex,follow"/><meta http-equiv="refresh" content={`0;url=${destination}`}/><title>前往文章列表</title></head>
<body><main><p>文章探索已整合至文章列表。<a href={destination}>前往全部文章</a></p></main>
<script is:inline define:vars={{destination}}>
 const target=new URL(destination,window.location.origin);
 target.search=window.location.search;
 target.hash=window.location.hash;
 window.location.replace(target.href);
</script>
</body></html>
