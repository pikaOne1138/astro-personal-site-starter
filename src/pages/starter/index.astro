.pattern-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.pattern-option{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:20px;min-width:0}
.pattern-option[hidden],.pattern-config[hidden]{display:none}
.pattern-option>p{color:var(--muted);font-size:14px}
.pattern-option>label{display:flex;align-items:center;gap:10px}
.pattern-config{display:grid;gap:14px;margin-top:18px}
.pattern-config label{display:grid;gap:6px;font-size:14px}
.pattern-config input,.pattern-config select{width:100%;min-width:0;padding:10px;border:1px solid #bdb3a5;border-radius:8px;font:inherit;background:var(--white)}
@media(max-width:650px){.pattern-options{grid-template-columns:1fr}}
</style>
<style>
.notes-field{display:flex;flex-direction:column;align-items:stretch;gap:12px;width:100%;margin-top:12px}
.notes-field label{display:block;font-weight:600}
.notes-field textarea{display:block;width:100%;min-width:0;max-width:100%;min-height:150px;resize:vertical;box-sizing:border-box;line-height:1.65}
</style>
<style>.advanced-image-paths{grid-column:1/-1;border:1px solid var(--line);border-radius:10px;padding:12px 16px}.advanced-image-paths summary{cursor:pointer;font-weight:600}.advanced-image-paths[open]{display:grid;gap:12px}.advanced-image-paths p{color:var(--muted);margin:8px 0}.brand-design-controls small{color:var(--muted);font-weight:400;font-size:13px}</style><style>.logo-handoff-steps{padding-left:1.5rem;margin:0;line-height:1.8}.logo-handoff-steps li{margin:0 0 8px}.logo-handoff-steps a{color:var(--accent)} </style><style>.starter-journey{margin-top:22px;padding:20px;border:1px solid var(--line);border-radius:12px;background:var(--white)}.starter-journey ol{padding-left:24px;margin:8px 0}.starter-journey li{margin:8px 0}.intake-download{padding:18px;border:1px solid var(--line);border-radius:10px;display:grid;gap:10px}.intake-download p{margin:0}.intake-download button{justify-self:start}</style><style>.ai-interview-panel{border:1px solid var(--line);border-radius:12px;background:var(--white);padding:22px;display:grid;gap:12px}.ai-interview-panel h3,.ai-interview-panel p{margin:0}.ai-interview-panel h3:not(:first-child){margin-top:12px}.ai-interview-panel label{font-weight:700}.ai-interview-panel textarea{display:block;width:100%;min-height:180px;padding:12px;border-radius:8px;border:1px solid var(--line);background:var(--white);font:inherit;resize:vertical}.ai-interview-panel button{justify-self:start}</style><style>.layout-content-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1.5rem 0}.layout-content-fields[hidden]{display:none}.layout-content-fields h3,.layout-content-fields p{grid-column:1/-1}.layout-content-fields label{display:flex;flex-direction:column;gap:.5rem}.layout-content-fields input,.layout-content-fields select,.layout-content-fields textarea{font:inherit;border:1px solid var(--line);background:var(--white);color:inherit;border-radius:8px;padding:.7rem;width:100%}@media(max-width:650px){.layout-content-fields{grid-template-columns:1fr}}</style><style>.handoff-guide{margin:1.5rem 0;border:1px solid var(--line);border-radius:12px;padding:1rem 1.4rem;background:var(--white)}.handoff-guide summary{font-weight:700;cursor:pointer}.handoff-guide li{margin:.75rem 0;line-height:1.8}.handoff-guide p{color:var(--muted)}</style><script is:inline define:vars={{intakeFiles}}>
function zipFiles(files){
 const enc=new TextEncoder(),parts=[],central=[];let offset=0;
 const u16=n=>new Uint8Array([n&255,(n>>>8)&255]),u32=n=>new Uint8Array([n&255,(n>>>8)&255,(n>>>16)&255,(n>>>24)&255]);
 const cat=(...xs)=>{const out=new Uint8Array(xs.reduce((a,x)=>a+x.length,0));let p=0;for(const x of xs){out.set(x,p);p+=x.length;}return out;};
 const crc32=data=>{let c=-1;for(const b of data){c^=b;for(let i=0;i<8;i++)c=(c>>>1)^((c&1)?0xedb88320:0);}return(c^-1)>>>0;};
 for(const [name,content] of Object.entries(files)){const fn=enc.encode(name),data=enc.encode(content),crc=crc32(data),flag=0x800;
 const loc=cat(u32(0x04034b50),u16(20),u16(flag),u16(0),u16(0),u16(0),u32(crc),u32(data.length),u32(data.length),u16(fn.length),u16(0),fn,data);parts.push(loc);
 central.push(cat(u32(0x02014b50),u16(20),u16(20),u16(flag),u16(0),u16(0),u16(0),u32(crc),u32(data.length),u32(data.length),u16(fn.length),u16(0),u16(0),u16(0),u16(0),u32(0),u32(offset),fn));offset+=loc.length;}
 const body=cat(...parts),dir=cat(...central),end=cat(u32(0x06054b50),u16(0),u16(0),u16(central.length),u16(central.length),u32(dir.length),u32(body.length),u16(0));
 return new Blob([body,dir,end],{type:'application/zip'});
}
document.getElementById('download-intake-zip')?.addEventListener('click',()=>{const url=URL.createObjectURL(zipFiles(intakeFiles)),a=document.createElement('a');a.href=url;a.download='AI-需求訪談包.zip';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);});
</script>
