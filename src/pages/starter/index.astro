---
import intakeReadme from '../../../docs/student-intake/README.md?raw';
import intakeHost from '../../../docs/student-intake/01-AI-訪談主持人.md?raw';
import intakeAbout from '../../../docs/student-intake/02-網站定位與個人介紹.md?raw';
import intakeContent from '../../../docs/student-intake/03-內容準備-二選一.md?raw';
import intakeAssets from '../../../docs/student-intake/04-圖片與發布準備.md?raw';
import intakeVisual from '../../../docs/student-intake/05-AI-品牌識別與圖片共創.md?raw';
import intakeResearch from '../../../docs/student-intake/06-Logo與圖片設計研究.md?raw';
const intakeFiles={"README.md":intakeReadme,"01-AI-訪談主持人.md":intakeHost,"02-網站定位與個人介紹.md":intakeAbout,"03-內容準備-二選一.md":intakeContent,"04-圖片與發布準備.md":intakeAssets,"05-AI-品牌識別與圖片共創.md":intakeVisual,"06-Logo與圖片設計研究.md":intakeResearch};
import originals from '../../data/layout-directions.json';
import expansion from '../../data/layout-assembly/expansion-directions.json';
const directions=[...originals,...expansion];
import {layoutDefinitions} from '../../data/layout-assembly/definitions.mjs';
const statusBySlug=Object.fromEntries(layoutDefinitions.map(item=>[item.slug,item.assemblyStatus]));
import patternRegistry from '../../data/section-patterns.registry.json';
import { starterPages, starterThemeSeeds, starterThemePalettes } from '../../data/starter-config';
const base=import.meta.env.BASE_URL;
const themes=[{id:'paper',title:'紙墨',description:'編輯感與深色文字'},{id:'morning',title:'晨光',description:'溫暖與柔和留白'},{id:'studio',title:'靜室',description:'清晰且精準的格線'},{id:'botanical',title:'植感',description:'自然與舒緩的色彩'},{id:'ocean',title:'海岸',description:'藍綠與清爽留白'},{id:'sand',title:'暖沙',description:'暖土與柔和中性色'},{id:'slate',title:'石板',description:'冷靜灰藍與清晰閱讀'},{id:'lavender',title:'暮紫',description:'霧紫與柔和灰調'}];
---
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex"/>
<title>規劃我的網站｜Astro 工作坊</title>
<meta name="description" content="依序選擇 Astro 首頁版型、品牌視覺、頁面與導覽，產生可交給 AI 的網站規格。"/>
<link rel="stylesheet" href={base+'starter-planner.css'}/>
<style>.layout-option{padding:0;overflow:hidden}.layout-option>img{display:block;width:100%;height:195px;object-fit:cover;object-position:top;border-bottom:1px solid var(--line)}.layout-option>label{display:flex;flex-direction:column;gap:6px;padding:18px 18px 6px;cursor:pointer;flex:1}.layout-option>a{margin:0 18px 18px}.layout-option:has(input:checked){outline:2px solid var(--accent);outline-offset:2px}.assembly-status{font-size:12px;font-weight:700;color:#765244}</style><style>.brand-design-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:20px 0}.brand-design-controls label{display:grid;gap:6px;font-weight:600}.brand-design-controls select,.brand-design-controls input{font:inherit;background:var(--white);border:1px solid var(--line);border-radius:8px;padding:12px;width:100%;min-width:0}@media(max-width:650px){.brand-design-controls{grid-template-columns:1fr}}</style></head>
<body>
<header class="planner-nav"><a href={base}>← 回設計展示總覽</a><span>WEBSITE / STARTER PLANNER</span></header>
<main class="planner-wrap" id="main">
<div class="planner-head"><p class="eyebrow">SITE BRIEF / GUIDED SETUP</p><h1>從喜歡的設計開始<br/>規劃自己的網站</h1><p>這裡不是要你寫程式，而是把網站想法整理成 AI 看得懂的建站規格（Site Brief）。依照 01～07 步挑選版型、調整品牌與內容，最後下載設定檔。</p><p class="notice">不知道某個答案可以先留白。需求訪談與 Logo 設計是選填，日後都能與 AI 調整；這裡<strong>不會直接建立或發布網站</strong>。</p><div class="starter-journey"><strong>如何使用 Starter？</strong><p>選好 Layout、品牌與網站內容；有不確定的地方，可以在第 04 步下載訪談包交給 AI 討論，再把 AI 整理的文字貼回同一步的欄位。訪談不是必做。第 07 步下載 Site Brief，交給建站指南接續。</p><p>Logo、圖片或內容沒決定也沒關係，之後可以再與 AI 修改。</p></div></div>

<form id="starter-form">
<section class="step" aria-labelledby="step-kind"><div class="step-head"><span>01</span><div><h2 id="step-kind">網站用途與版型</h2><p>先看首頁縮圖，或到視覺圖鑑比較桌機與手機。不必一次決定所有細節。若已從版型庫選好設計，會自動帶入所選版型；需要比較其他方向可回到版型庫。</p></div></div>
<fieldset class="kind-choice"><legend>我想建立的是</legend><label><input type="radio" name="kind" value="knowledge" checked/> 知識／部落格</label><label><input type="radio" name="kind" value="helper"/> 助人者／專業服務</label></fieldset>
<p><a href={base+'layouts/'}>回到 25 種網站版型庫 ↗</a></p><div class="layout-grid" id="layout-grid">
{directions.map((item,i)=>(<div class="layout-option" data-kind={item.kind}>{!expansion.some(x=>x.slug===item.slug)&&<img src={base+'template-gallery/'+item.slug+'-desktop.webp'} alt={item.title+' Astro 首頁實際縮圖'} width="1440" height="900" loading="lazy" onerror="this.hidden=true"/>}<label><input type="radio" name="layout" value={item.slug} checked={i===0}/><span class="layout-id">{item.kind==='knowledge'?'A':'B'}{String((i%6)+1).padStart(2,'0')}</span><strong>{item.title}</strong><span class="assembly-status">{statusBySlug[item.slug]==='ready'?'Starter Ready':statusBySlug[item.slug]==='in-progress'?'Assembly in Progress':'Prototype'}</span><small>{item.structure}</small><span>{item.description}</span></label><a href={base+'layouts/'+item.slug+'/'} target="_blank" rel="noopener noreferrer">完整首頁預覽 ↗</a></div>))}
</div></section>

<section class="step" aria-labelledby="step-brand"><div class="step-head"><span>02</span><div><h2 id="step-brand">品牌視覺</h2><p>先選一組配色起點，再自由調整五色盤。這些是配色預設，不會改變你在步驟 01 選的整頁 Layout。</p></div></div>
<div class="form-grid"><label>網站名稱<input name="siteName" required maxlength="80" value="我的個人網站"/></label><label>一句話介紹<input name="tagline" maxlength="150" value="把我想分享的事，整理成自己的網站"/></label></div>
<div class="brand-design-controls"><label>字體感覺<select name="typography"><option value="editorial-serif">書刊編輯感（襯線標題）</option><option value="clear-sans">清楚現代感（無襯線）</option><option value="balanced">柔和平衡（標題襯線、內文清楚）</option></select></label><label>圖片處理<select name="imageStyle"><option value="natural">自然原色</option><option value="documentary">紀實低飽和</option><option value="minimal">簡潔中性</option></select></label></div>
<fieldset class="theme-choice"><legend>視覺風格</legend>{themes.map((t,i)=><label class="theme-option"><input type="radio" name="theme" value={t.id} checked={i===0}/><span class="theme-swatch" style={'--seed:'+starterThemeSeeds[t.id]}/><strong>{t.title}</strong><small>{t.description}</small></label>)}</fieldset>
<div class="brand-palette-intro"><h3>品牌配色（五色盤）</h3><p>先從上方風格取得一組搭配，再自行調整五個角色。不是五種顏色都要大量使用，背景與文字也有自己的工作。</p></div><div class="brand-palette-fields"><label class="palette-field" for="palette-primary"><span>品牌主色</span><input id="palette-primary" data-palette="primary" type="color" value="#9A3B2E"/><input id="palette-primary-hex" class="palette-hex-input" data-hex-for="primary" type="text" inputmode="text" autocomplete="off" spellcheck="false" maxlength="7" aria-label="primary HEX 色碼" value="#9A3B2E"/></label>
<label class="palette-field" for="palette-secondary"><span>輔助色</span><input id="palette-secondary" data-palette="secondary" type="color" value="#806A54"/><input id="palette-secondary-hex" class="palette-hex-input" data-hex-for="secondary" type="text" inputmode="text" autocomplete="off" spellcheck="false" maxlength="7" aria-label="secondary HEX 色碼" value="#806A54"/></label>
<label class="palette-field" for="palette-accent"><span>強調色</span><input id="palette-accent" data-palette="accent" type="color" value="#C58D63"/><input id="palette-accent-hex" class="palette-hex-input" data-hex-for="accent" type="text" inputmode="text" autocomplete="off" spellcheck="false" maxlength="7" aria-label="accent HEX 色碼" value="#C58D63"/></label>
<label class="palette-field" for="palette-background"><span>背景色</span><input id="palette-background" data-palette="background" type="color" value="#F8F5EF"/><input id="palette-background-hex" class="palette-hex-input" data-hex-for="background" type="text" inputmode="text" autocomplete="off" spellcheck="false" maxlength="7" aria-label="background HEX 色碼" value="#F8F5EF"/></label>
<label class="palette-field" for="palette-text"><span>文字色</span><input id="palette-text" data-palette="text" type="color" value="#28231F"/><input id="palette-text-hex" class="palette-hex-input" data-hex-for="text" type="text" inputmode="text" autocomplete="off" spellcheck="false" maxlength="7" aria-label="text HEX 色碼" value="#28231F"/></label></div><div id="palette-live-preview" class="brand-palette-preview"><span>BRAND PALETTE PREVIEW</span><strong>讓內容清楚，也讓品牌有自己的樣子。</strong><p>這段文字展示背景與文字色，按鈕展示主色與強調色。</p><span class="brand-palette-preview__actions"><b>主要按鈕</b><em>輔助元素</em></span></div><p class="muted">正式網站仍需要檢查對比：一般文字與背景至少 4.5:1，大字至少 3:1；AI 不能直接假定所有配色都合格。</p><aside class="palette-resource-links" aria-labelledby="palette-resource-title">
<h3 id="palette-resource-title">不知道怎麼配色？先到這三個工具看看</h3>
<p>找到喜歡的色彩後，把 HEX 色碼帶回上方色盤，再確認背景、文字和按鈕是否清楚易讀。</p>
<div class="palette-resource-grid">
<a href="https://coolors.co/" target="_blank" rel="noopener noreferrer"><strong>Coolors ↗</strong><span>快速產生五色組合，可鎖定喜歡的顏色再重新搭配。</span></a>
<a href="https://www.happyhues.co/" target="_blank" rel="noopener noreferrer"><strong>Happy Hues ↗</strong><span>不只看色票，還能看背景、標題、按鈕在真實版面中的搭配。</span></a>
<a href="https://color.adobe.com/" target="_blank" rel="noopener noreferrer"><strong>Adobe Color ↗</strong><span>用色輪、照片建立配色，並檢查文字與背景對比。</span></a>
</div>
<p class="palette-resource-credit">外部工具僅供配色靈感參考，不會自動讀取或套用配色；仍請檢查實際文字與按鈕對比。</p>
</aside>
<div class="color-row" hidden><label for="brand-color">相容主色</label><input type="color" id="brand-color" name="brandColor" value="#9a3b2e"/><output id="brand-hex">#9A3B2E</output></div>
</section>

<section class="step" aria-labelledby="step-content"><div class="step-head"><span>03</span><div><h2 id="step-content">我的網站內容（依版型顯示）</h2><p>不用編輯 JSON。選擇「閱讀年鑑」、「聲音通信」或任一助人者版型時，填寫真實資料；未填的欄位會保留待設定提示。</p></div></div>
<div class="layout-content-fields"><h3>首頁文字（依所選 Layout 使用）</h3><label>首頁大標題（選填）<input id="home-headline" maxlength="120" placeholder="留空時保留原 Layout 的設計標題"/></label><label>首頁介紹（選填）<textarea id="home-intro" maxlength="800" rows="3" placeholder="你希望訪客第一眼理解的內容；留空使用版型示範"></textarea></label></div>
<div class="layout-content-fields"><h3>關於頁（可依需要使用）</h3><p class="muted">這些是獨立內頁內容，不會被首頁介紹覆蓋。只寫真實資料；不清楚可以留空。</p><label>我的介紹<textarea id="about-bio" maxlength="1200" rows="4" placeholder="真實的個人背景或目前在做的事"></textarea></label><label>網站或服務目的<textarea id="about-purpose" maxlength="1200" rows="3" placeholder="為什麼建立這個網站"></textarea></label><label>我的方法<textarea id="about-approach" maxlength="1200" rows="3" placeholder="寫作／整理／協助他人的實際方式"></textarea></label><label>作品、經歷與可查證資訊<textarea id="about-background" maxlength="1200" rows="3" placeholder="沒有資料就留空，不編造資格或見證"></textarea></label></div>
<div class="layout-content-fields" data-content-layout="reading-atlas" hidden><h3>閱讀年鑑</h3><label>閱讀月份<select id="reading-month">{Array.from({length:12},(_,i)=><option value={String(i+1).padStart(2,'0')}>{i+1} 月</option>)}</select></label><label>一本真正讀過的書<input id="reading-title" maxlength="150" placeholder="請填入書名"/></label><label>閱讀評註<textarea id="reading-note" maxlength="1000" rows="3" placeholder="自己的真實心得"></textarea></label><label>年度選書<input id="annual-title" maxlength="150" placeholder="選填，自己實際讀過的書"/></label><label>年度選擇理由<textarea id="annual-note" maxlength="1000" rows="3"></textarea></label><p class="muted">這一版先支援一筆閱讀紀錄；其餘紀錄可由 AI 依相同格式加入。</p></div>
<div class="layout-content-fields" data-content-layout="radio-letter" hidden><h3>聲音通信</h3><label>自有音訊檔案路徑<input id="episode-audio" placeholder="/audio/episode-01.mp3"/></label><label>逐字稿第一段時間<input id="episode-time" placeholder="00:00" maxlength="32"/></label><label>逐字稿第一段文字<textarea id="episode-text" maxlength="2000" rows="4"></textarea></label><p class="muted">產生器只接受本地有授權的音檔，請把音檔放在 Site Brief 所在資料夾的 public/audio/；不會自動錄音或生成逐字稿。</p></div>
<div class="layout-content-fields" data-content-kind="helper" hidden><h3>助人者網站：真實的服務資訊</h3><label>服務範圍與適合對象<textarea id="fact-scope" maxlength="500" rows="3" placeholder="清楚寫出真正提供的服務，未確認可留空"></textarea></label><label>服務界線／不提供的服務<textarea id="fact-exclusions" maxlength="500" rows="3" placeholder="不虛構醫療資格或效果"></textarea></label><label>合作方法<textarea id="fact-method" maxlength="500" rows="3" placeholder="實際合作流程"></textarea></label><label>第一次聯絡或見面的流程<textarea id="fact-first-visit" maxlength="500" rows="3" placeholder="站長確認後填入"></textarea></label><label>一次服務時間<input id="fact-duration" maxlength="100" placeholder="待確定就留空"/></label><label>服務費用<input id="fact-price" maxlength="100"/></label><label>取消規則<input id="fact-cancellation" maxlength="200"/></label><label>專業資格（需可查證）<input id="fact-qualification" maxlength="200"/></label><label>公開聯絡方式<input id="fact-contact" maxlength="200"/></label><p class="muted">不必填滿。沒有資料就顯示待確認，不能自行編造資格、價格或預約成功。</p></div>
</section>
<section class="step" aria-labelledby="step-ai-interview">
  <div class="step-head"><span>04</span><div><h2 id="step-ai-interview">AI 需求訪談與 Logo 設計（選填）</h2><p>可以現在與 AI 討論，也可以等網站有初稿後再調整。這不影響接下來的規劃、下載或建站。</p></div></div>
  <div class="ai-interview-panel">
    <h3>需要 AI 幫忙釐清需求時</h3>
    <p>沒有訪談需求可以跳過。想請 AI 協助時，下載訪談包或複製簡短提示詞，交給你使用的 AI 對話工具。</p>
    <div class="intake-download"><strong>AI 需求訪談包（選用）</strong><p>這份資料包包含訪談主持流程、網站定位、內容準備、品牌與 Logo 設計參考。下載後解壓縮，將相關文件交給你慣用的 AI，讓它一次問你一個問題。</p><button class="button secondary" type="button" id="download-intake-zip">下載 AI 需求訪談包 ZIP ↓</button><p class="muted">訪談後，請 AI 整理文字摘要，貼在下方「AI 訪談結果」欄位。第 07 步下載的 Site Brief 會包含這段文字；建站時不用再上傳訪談包。</p></div><button class="button secondary" type="button" id="copy-interview-prompt">只複製簡短訪談指令</button>
    <label for="interview-summary">AI 訪談結果（選填，保留原文）</label>
    <textarea id="interview-summary" rows="8" placeholder="貼上 AI 整理的網站需求摘要。未完成可留白；不需轉成 JSON。"></textarea>
    <h3>Logo 與品牌圖片（選填）</h3>
    <p>如要設計 Logo，可複製提示詞到 AI 對話；還沒決定就先跳過。</p>
    <ol class="logo-handoff-steps"><li>按下方按鈕複製提示詞，切換到你慣用的 AI 對話，貼上並開始討論 Logo 風格。</li><li>如果 AI 產出 Logo 圖片，先儲存到電腦，再到 <a href="#brand-logo-upload">本步下方的「Logo 與主視覺圖片上傳」</a> 上傳。</li><li>如果 AI 只整理了 Logo 方向、配色、設計概念等文字，請把這段文字貼到<strong>本步上方「AI 訪談結果」</strong>文字框，並註明是 Logo 設計需求。</li><li>若暫時沒有 Logo，可先跳過，網站有初稿後再補充。</li></ol>
    <button class="button secondary" type="button" id="copy-logo-prompt">複製給 AI 的 Logo 設計提示詞</button>
    <h3 id="brand-logo-upload">Logo 與主視覺圖片上傳（選填）</h3>
    <p>如果已經有圖片，可以直接上傳；還沒有就先使用上方提示詞請 AI 設計，完成後回到這裡上傳。兩種圖片都可以不提供，之後再補。</p>
    <div class="brand-design-controls">
<label><span id="logo-upload-label">Logo 圖片（選填）</span><input id="logo-upload" type="file" accept="image/png,image/jpeg,image/webp,image/avif"/><small>網站名稱旁或頁首使用的品牌識別圖。還沒有 Logo 可以先不選。</small></label>
<label>網站主視覺圖片（選填）<input id="hero-upload" type="file" accept="image/png,image/jpeg,image/webp,image/avif"/><small>通常是首頁最醒目區塊（Hero）的照片或插畫，例如工作環境、作品、品牌形象；沒有圖片可以先留空。</small></label>
<details class="advanced-image-paths"><summary>進階設定：使用網站專案內已有的圖片路徑</summary><p>只有已經有 Astro 網站專案、且知道圖片放在哪個路徑時才需要。一般學員直接使用上面的檔案選擇即可，系統會自動建立路徑。</p>
<label>Logo 專案圖片路徑<input name="logoPath" placeholder="/images/my-logo.png"/></label>
<label>主視覺專案圖片路徑<input name="heroImagePath" placeholder="/images/my-hero.webp" pattern="/images/[a-zA-Z0-9/_-]+\\.(webp|png|jpg|jpeg|avif)"/></label></details>
<label>主視覺圖片描述（選填）<input name="heroImageAlt" maxlength="180" placeholder="例如：明亮工作室內的一張木桌與筆記本"/></label>
    </div>
    <p class="muted">選擇圖片後，系統會自動設定路徑並放進下載的 Site Brief，無須輸入檔案位置。圖片只在瀏覽器中處理，不會上傳本站伺服器；每張最多 4 MB。若使用進階路徑，必須確認建站專案中確實存在對應檔案。</p>
    <p class="muted">若摘要與規劃器設定有明確差異，建站 AI 應先向你確認，不能直接忽略任何一方。</p>
    <p id="interview-copy-status" class="muted" role="status" aria-live="polite"></p>
  </div>
</section>
<section class="step" aria-labelledby="step-nav"><div class="step-head"><span>05</span><div><h2 id="step-nav">頁面架構與導航列</h2><p>這裡會依照步驟 01 選擇的網站方向，帶入一組預設導航項目：A01–A06（知識／部落格）使用內容型預設，B01–B06（助人者／專業服務）使用服務型預設。目前同類型 Layout 使用共通的初始導航項目，並非每款都有獨立選單；你可以自由新增、刪除、排序及設定第二層選單。</p></div></div>
<div class="navigation-builder">
  <div><h3>網站導覽</h3><div id="nav-items"></div><button type="button" id="add-nav-page" class="nav-add">＋ 新增自訂頁面</button><p class="muted">拖曳 ⠿ 調整順序；→ 縮排為子選單、← 提升層級。觸控或鍵盤可使用 ↑ ↓ 排序。所有頁面都可刪除或暫時取消勾選；有子選單的頁面刪除前會先詢問。</p></div>
  <aside class="navigation-preview"><p class="eyebrow">NAVIGATION PREVIEW</p><strong id="preview-name">我的個人網站</strong><div id="preview-menu"></div><div class="cta-field"><label for="cta-target">主要按鈕前往</label><select id="cta-target" name="ctaTarget"></select><label for="cta-label">按鈕文字</label><input name="ctaLabel" id="cta-label" maxlength="24" value="閱讀文章"/></div></aside>
</div>
