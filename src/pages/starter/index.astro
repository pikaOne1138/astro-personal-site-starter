---
import directions from '../../data/layout-directions.json';
import { starterPages, starterThemeSeeds } from '../../data/starter-config';
const base=import.meta.env.BASE_URL;
const themes=[{id:'paper',title:'紙墨',description:'編輯感與深色文字'},{id:'morning',title:'晨光',description:'溫暖與柔和留白'},{id:'studio',title:'靜室',description:'清晰且精準的格線'},{id:'botanical',title:'植感',description:'自然與舒緩的色彩'}];
---
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex"/>
<title>規劃我的網站｜Astro 工作坊</title>
<meta name="description" content="依序選擇 Astro 首頁版型、品牌視覺、頁面與導覽，產生可交給 AI 的網站規格。"/>
<link rel="stylesheet" href={base+'starter-planner.css'}/>
</head>
<body>
<header class="planner-nav"><a href={base}>← 回設計展示總覽</a><span>WEBSITE / STARTER PLANNER</span></header>
<main class="planner-wrap" id="main">
<div class="planner-head"><p class="eyebrow">SITE BRIEF / GUIDED SETUP</p><h1>從喜歡的設計開始<br/>規劃自己的網站</h1><p>先選用途與首頁的閱讀動線，再決定品牌色、頁面與導航。最後取得一份可以交給 AI 接續開發的網站規格。</p><p class="notice">這裡是**規劃工具**，不會直接修改正式網站、建立新 Repository 或發布。</p></div>

<form id="starter-form">
<section class="step" aria-labelledby="step-kind"><div class="step-head"><span>01</span><div><h2 id="step-kind">網站用途與版型</h2><p>先選最接近你想要的設計就好，不必一次決定所有細節。後續可以參考八款 Demo、12 款版型與構圖配方，再調整版面、增減區塊、修改導航與品牌視覺。</p></div></div>
<fieldset class="kind-choice"><legend>我想建立的是</legend><label><input type="radio" name="kind" value="knowledge" checked/> 知識／部落格</label><label><input type="radio" name="kind" value="helper"/> 助人者／專業服務</label></fieldset>
<div class="layout-grid" id="layout-grid">
{directions.map((item,i)=><label class="layout-option" data-kind={item.kind}><input type="radio" name="layout" value={item.slug} checked={i===0}/><span class="layout-id">{item.kind==='knowledge'?'A':'B'}{String((i%6)+1).padStart(2,'0')}</span><strong>{item.title}</strong><small>{item.structure}</small><span>{item.description}</span><a href={base+'layouts/'+item.slug+'/'} target="_blank" rel="noopener noreferrer">預覽版型 ↗</a></label>)}
</div></section>

<section class="step" aria-labelledby="step-brand"><div class="step-head"><span>02</span><div><h2 id="step-brand">品牌視覺</h2><p>先挑一個視覺起點，再調整自己的主色。</p></div></div>
<div class="form-grid"><label>網站名稱<input name="siteName" required maxlength="80" value="我的個人網站"/></label><label>一句話介紹<input name="tagline" maxlength="150" value="把我想分享的事，整理成自己的網站"/></label></div>
<fieldset class="theme-choice"><legend>視覺風格</legend>{themes.map((t,i)=><label class="theme-option"><input type="radio" name="theme" value={t.id} checked={i===0}/><span class="theme-swatch" style={'--seed:'+starterThemeSeeds[t.id]}/><strong>{t.title}</strong><small>{t.description}</small></label>)}</fieldset>
<div class="color-row"><label for="brand-color">品牌主色</label><input type="color" id="brand-color" name="brandColor" value="#9a3b2e"/><output id="brand-hex">#9A3B2E</output><span class="muted">這裡示範主色；正式組裝仍需檢查背景、文字與 CTA 的對比。</span></div>
</section>

<section class="step" aria-labelledby="step-nav"><div class="step-head"><span>03</span><div><h2 id="step-nav">頁面架構與導航列</h2><p>勾選要保留的頁面，改名稱與順序。未啟用的頁面不會出現在建議選單。</p></div></div>
<div class="navigation-builder">
  <div><h3>網站導覽</h3><div id="nav-items"></div><p class="muted">導覽通常保留 4–5 項。主要按鈕會指向其中一個已啟用頁面。</p></div>
  <aside class="navigation-preview"><p class="eyebrow">NAVIGATION PREVIEW</p><strong id="preview-name">我的個人網站</strong><div id="preview-menu"></div><div class="cta-field"><label for="cta-target">主要按鈕前往</label><select id="cta-target" name="ctaTarget"></select><label for="cta-label">按鈕文字</label><input name="ctaLabel" id="cta-label" maxlength="24" value="閱讀文章"/></div></aside>
</div>
</section>
<section class="step" aria-labelledby="step-output"><div class="step-head"><span>04</span><div><h2 id="step-output">交給 AI 接續組裝</h2><p>這份 Site Brief 描述你的選擇；不代表版型已自動轉換為完整網站。</p></div></div>
<label for="notes">還有什麼要 AI 注意的？</label><textarea id="notes" rows="3" placeholder="例如：想把文章放首頁第一區、手機選單優先顯示聯絡方式"></textarea>
<div class="form-actions"><button type="button" id="copy-plan">複製網站規格</button><button type="button" id="save-plan" class="secondary">下載 JSON 設定</button></div>
<p id="form-status" role="status" aria-live="polite"></p><pre id="plan-preview" aria-label="網站設定預覽"></pre></section>
</form>
</main>
<script>
import { starterPages, starterThemeSeeds, checkStarterPlan, type StarterKind, type StarterTheme, type StarterPlan } from '../../data/starter-config';
import directions from '../../data/layout-directions.json';
const form=document.querySelector<HTMLFormElement>('#starter-form')!;
const layoutOptions=Array.from(document.querySelectorAll<HTMLElement>('.layout-option'));
const rows=document.querySelector<HTMLElement>('#nav-items')!;
const menu=document.querySelector<HTMLElement>('#preview-menu')!;
const target=document.querySelector<HTMLSelectElement>('#cta-target')!;
const color=document.querySelector<HTMLInputElement>('#brand-color')!;
const status=document.querySelector<HTMLElement>('#form-status')!;
const output=document.querySelector<HTMLElement>('#plan-preview')!;
let nav:Array<{id:string;label:string;enabled:boolean}>=[];
let priorKind:StarterKind='knowledge';
const value=(name:string)=> (form.querySelector<HTMLInputElement>(`[name="${name}"]:checked`)?.value||'');
function renderNav(){
  rows.replaceChildren();
  for(let i=0;i<nav.length;i++){
    const n=nav[i],row=document.createElement('div');row.className='nav-row';
    const check=document.createElement('input');check.type='checkbox';check.checked=n.enabled;check.setAttribute('aria-label','顯示'+n.label);check.addEventListener('change',()=>{n.enabled=check.checked;renderNav()});
    const label=document.createElement('input');label.type='text';label.maxLength=24;label.value=n.label;label.setAttribute('aria-label',n.id+' 選單名稱');label.addEventListener('input',()=>{n.label=label.value;renderMenu()});
    const up=document.createElement('button');up.type='button';up.textContent='↑';up.disabled=i===0;up.setAttribute('aria-label','上移'+n.label);up.addEventListener('click',()=>{[nav[i-1],nav[i]]=[nav[i],nav[i-1]];renderNav()});
    const down=document.createElement('button');down.type='button';down.textContent='↓';down.disabled=i===nav.length-1;down.setAttribute('aria-label','下移'+n.label);down.addEventListener('click',()=>{[nav[i+1],nav[i]]=[nav[i],nav[i+1]];renderNav()});
    row.append(check,label,up,down);rows.append(row);
  }renderMenu();
}
function renderMenu(){
  menu.replaceChildren();const enabled=nav.filter(x=>x.enabled);
  for(const n of enabled){const span=document.createElement('span');span.textContent=n.label;menu.append(span)}
  const selected=target.value;target.replaceChildren();
  for(const n of enabled){const option=document.createElement('option');option.value=n.id;option.textContent=n.label;target.append(option)}
  if(enabled.some(x=>x.id===selected))target.value=selected;
  const name=form.querySelector<HTMLInputElement>('[name="siteName"]')!.value.trim();
  document.querySelector<HTMLElement>('#preview-name')!.textContent=name||'網站名稱';
}
function update(){
 const kind=value('kind') as StarterKind;
 if(kind!==priorKind || !nav.length){nav=starterPages[kind].map(p=>({...p}));priorKind=kind;renderNav();
   form.querySelector<HTMLInputElement>('#cta-label')!.value=kind==='knowledge'?'閱讀文章':'了解服務';
 }
 const eligible=layoutOptions.filter(e=>e.dataset.kind===kind);
 layoutOptions.forEach(e=>e.hidden=e.dataset.kind!==kind);
 const checked=form.querySelector<HTMLInputElement>('input[name="layout"]:checked');
 if(!checked||!eligible.some(e=>e.contains(checked))){const first=eligible[0]?.querySelector<HTMLInputElement>('input');if(first)first.checked=true}
 color.value=starterThemeSeeds[value('theme') as StarterTheme];
 document.querySelector<HTMLElement>('#brand-hex')!.textContent=color.value.toUpperCase();
 renderMenu();showPlan();
}
function plan():StarterPlan {
 const kind=value('kind') as StarterKind;
 return {version:1,kind,layoutSlug:value('layout'),visualTheme:value('theme') as StarterTheme,
 brand:{name:form.querySelector<HTMLInputElement>('[name="siteName"]')!.value,primaryColor:color.value.toUpperCase(),tagline:form.querySelector<HTMLInputElement>('[name="tagline"]')!.value},
 navigation:nav.map(x=>({...x})),
 primaryCta:{label:form.querySelector<HTMLInputElement>('#cta-label')!.value,pageId:target.value},
 notes:document.querySelector<HTMLTextAreaElement>('#notes')!.value};
}
function showPlan(){const p=plan();output.textContent=JSON.stringify(p,null,2)}
form.querySelectorAll<HTMLInputElement>('input[name="kind"],input[name="theme"]').forEach(e=>e.addEventListener('change',update));
form.querySelectorAll<HTMLInputElement>('input[name="layout"]').forEach(e=>e.addEventListener('change',showPlan));
color.addEventListener('input',()=>{document.querySelector<HTMLElement>('#brand-hex')!.textContent=color.value.toUpperCase();showPlan()});
form.addEventListener('input',()=>{renderMenu();showPlan()});
target.addEventListener('change',showPlan);
document.querySelector<HTMLButtonElement>('#copy-plan')!.addEventListener('click',async()=>{
 const p=plan(),errors=checkStarterPlan(p,directions);
 if(errors.length){status.textContent=errors.join('；');return}
 try {await navigator.clipboard.writeText(JSON.stringify(p,null,2));status.textContent='已複製，可交給 AI 依 astro-starter-onboarding Skill 繼續。'} catch {status.textContent='無法使用剪貼簿，請選取下方 JSON 手動複製。'}
});
document.querySelector<HTMLButtonElement>('#save-plan')!.addEventListener('click',()=>{
 const p=plan(),errors=checkStarterPlan(p,directions);if(errors.length){status.textContent=errors.join('；');return}
 const blob=new Blob([JSON.stringify(p,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob);
 const a=document.createElement('a');a.href=url;a.download='my-astro-site-plan.json';a.click();URL.revokeObjectURL(url);
 status.textContent='已下載網站設定，這是規劃檔案，不是已部署的網站。';
});
update();
</script>
</body></html>
