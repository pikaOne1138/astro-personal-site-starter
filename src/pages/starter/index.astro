---
import directions from '../../data/layout-directions.json';
import patternRegistry from '../../data/section-patterns.registry.json';
import { starterPages, starterThemeSeeds } from '../../data/starter-config';
const base=import.meta.env.BASE_URL;
const themes=[{id:'paper',title:'紙墨',description:'編輯感與深色文字'},{id:'morning',title:'晨光',description:'溫暖與柔和留白'},{id:'studio',title:'靜室',description:'清晰且精準的格線'},{id:'botanical',title:'植感',description:'自然與舒緩的色彩'}];
---
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex"/>
<title>規劃我的網站｜Astro 工作坊</title>
<meta name="description" content="依序選擇 Astro 首頁版型、品牌視覺、頁面與導覽，產生可交給 AI 的網站規格。"/>
<link rel="stylesheet" href={base+'starter-planner.css'}/>
</head>
<body>
<header class="planner-nav"><a href={base}>← 回設計展示總覽</a><span>WEBSITE / STARTER PLANNER</span></header>
<main class="planner-wrap" id="main">
<div class="planner-head"><p class="eyebrow">SITE BRIEF / GUIDED SETUP</p><h1>從喜歡的設計開始<br/>規劃自己的網站</h1><p>先選用途與首頁的閱讀動線，再決定品牌色、頁面與導航。最後取得一份可以交給 AI 接續開發的網站規格。</p><p class="notice">這裡是<strong>規劃工具</strong>，不會直接修改正式網站、建立新 Repository 或發布。</p></div>

<form id="starter-form">
<section class="step" aria-labelledby="step-kind"><div class="step-head"><span>01</span><div><h2 id="step-kind">網站用途與版型</h2><p>先選最接近你想要的設計就好，不必一次決定所有細節。後續可以參考八款 Demo、12 款版型與構圖配方，再調整版面、增減區塊、修改導航與品牌視覺。</p></div></div>
<fieldset class="kind-choice"><legend>我想建立的是</legend><label><input type="radio" name="kind" value="knowledge" checked/> 知識／部落格</label><label><input type="radio" name="kind" value="helper"/> 助人者／專業服務</label></fieldset>
<div class="layout-grid" id="layout-grid">
{directions.map((item,i)=><label class="layout-option" data-kind={item.kind}><input type="radio" name="layout" value={item.slug} checked={i===0}/><span class="layout-id">{item.kind==='knowledge'?'A':'B'}{String((i%6)+1).padStart(2,'0')}</span><strong>{item.title}</strong><small>{item.structure}</small><span>{item.description}</span><a href={base+'layouts/'+item.slug+'/'} target="_blank" rel="noopener noreferrer">預覽版型 ↗</a></label>)}
</div></section>

<section class="step" aria-labelledby="step-brand"><div class="step-head"><span>02</span><div><h2 id="step-brand">品牌視覺</h2><p>先挑一個視覺起點，再調整自己的主色。</p></div></div>
<div class="form-grid"><label>網站名稱<input name="siteName" required maxlength="80" value="我的個人網站"/></label><label>一句話介紹<input name="tagline" maxlength="150" value="把我想分享的事，整理成自己的網站"/></label></div>
<fieldset class="theme-choice"><legend>視覺風格</legend>{themes.map((t,i)=><label class="theme-option"><input type="radio" name="theme" value={t.id} checked={i===0}/><span class="theme-swatch" style={'--seed:'+starterThemeSeeds[t.id]}/><strong>{t.title}</strong><small>{t.description}</small></label>)}</fieldset>
<div class="color-row"><label for="brand-color">品牌主色</label><input type="color" id="brand-color" name="brandColor" value="#9a3b2e"/><output id="brand-hex">#9A3B2E</output><span class="muted">這裡示範主色；正式組裝仍需檢查背景、文字與 CTA 的對比。</span></div>
</section>

<section class="step" aria-labelledby="step-nav"><div class="step-head"><span>03</span><div><h2 id="step-nav">頁面架構與導航列</h2><p>勾選要保留的頁面，改名稱與順序。未啟用的頁面不會出現在建議選單。</p></div></div>
<div class="navigation-builder">
  <div><h3>網站導覽</h3><div id="nav-items"></div><button type="button" id="add-nav-page" class="nav-add">＋ 新增自訂頁面</button><p class="muted">拖曳 ⠿ 調整順序；→ 縮排為子選單、← 提升層級。觸控或鍵盤可使用 ↑ ↓ 排序。自訂頁面可刪除，預設頁面可取消勾選。</p></div>
  <aside class="navigation-preview"><p class="eyebrow">NAVIGATION PREVIEW</p><strong id="preview-name">我的個人網站</strong><div id="preview-menu"></div><div class="cta-field"><label for="cta-target">主要按鈕前往</label><select id="cta-target" name="ctaTarget"></select><label for="cta-label">按鈕文字</label><input name="ctaLabel" id="cta-label" maxlength="24" value="閱讀文章"/></div></aside>
</div>
</section>
<section class="step" aria-labelledby="step-patterns">
<div class="step-head"><span>04</span><div><h2 id="step-patterns">選擇組合樣板（選填）</h2><p>選擇喜歡的完整區段與放置頁面。三種頁腳擇一，不一定每個網站都需要額外區段。</p><a href={base+'section-patterns/'} target="_blank" rel="noopener noreferrer">看看組合樣板的完整預覽 ↗</a></div></div>
<div class="pattern-options" id="pattern-options">
{patternRegistry.map(x=><div class="pattern-option" data-pattern-id={x.id} data-kind={x.kind.join(',')}>
<label><input type="checkbox" class="pattern-choice" value={x.id}/><strong>{x.title}</strong></label>
<p>{x.purpose}</p>
<div class="pattern-config" hidden>
<label>放在哪頁<select class="pattern-page" aria-label={x.title+'要放在哪頁'}></select></label>
<label>放置位置<input class="pattern-position" maxlength="180" placeholder="例如：作者介紹之後" value={x.id.startsWith('footer-')?'每頁內容之後':'主要內容之後'}/></label>
</div></div>)}
</div></section>
<section class="step" aria-labelledby="step-output"><div class="step-head"><span>05</span><div><h2 id="step-output">交給 AI 接續組裝</h2><p>這份 Site Brief 描述你的選擇；不代表版型已自動轉換為完整網站。</p></div></div>
<div class="notes-field"><label for="notes">還有什麼要 AI 注意的？</label><textarea id="notes" rows="5" placeholder="例如：想把文章放首頁第一區、手機選單優先顯示聯絡方式"></textarea></div>
<div class="form-actions"><button type="button" id="copy-plan">複製網站規格</button><button type="button" id="save-plan" class="secondary">下載 JSON 設定</button></div>
<p id="form-status" role="status" aria-live="polite"></p><pre id="plan-preview" aria-label="網站設定預覽"></pre></section>
</form>
</main>
<script>
import { starterPages, starterThemeSeeds, checkStarterPlan, type StarterKind, type StarterTheme, type StarterPlan } from '../../data/starter-config';
import directions from '../../data/layout-directions.json';
import patternRegistry from '../../data/section-patterns.registry.json';
const form=document.querySelector<HTMLFormElement>('#starter-form')!;
const layoutOptions=Array.from(document.querySelectorAll<HTMLElement>('.layout-option'));
const rows=document.querySelector<HTMLElement>('#nav-items')!;
const menu=document.querySelector<HTMLElement>('#preview-menu')!;
const target=document.querySelector<HTMLSelectElement>('#cta-target')!;
const color=document.querySelector<HTMLInputElement>('#brand-color')!;
const status=document.querySelector<HTMLElement>('#form-status')!;
const output=document.querySelector<HTMLElement>('#plan-preview')!;
let nav:Array<{id:string;label:string;enabled:boolean}>=[];
let priorKind:StarterKind='knowledge';

function renderPatterns(){
 const kind=value('kind') as StarterKind;
 const pages=nav.filter(x=>x.enabled);
 document.querySelectorAll<HTMLElement>('.pattern-option').forEach(box=>{
  const isFooter=(box.dataset.patternId||'').startsWith('footer-');
  const valid=(box.dataset.kind||'').split(',').includes(kind);
  box.hidden=!valid;
  const check=box.querySelector<HTMLInputElement>('.pattern-choice')!;
  if(!valid)check.checked=false;
  box.querySelector<HTMLElement>('.pattern-config')!.hidden=!check.checked;
  const select=box.querySelector<HTMLSelectElement>('.pattern-page')!;
  const old=select.value;
  select.replaceChildren();
  const choices=isFooter?[{id:'site-wide',label:'整站所有頁面'}]:[{id:'/',label:'首頁'},...pages.map(x=>({id:x.id,label:x.label}))];
  for(const x of choices){const option=document.createElement('option');option.value=x.id;option.textContent=x.label;select.append(option)}
  if(choices.some(x=>x.id===old))select.value=old;
 });
}
document.querySelectorAll<HTMLInputElement>('.pattern-choice').forEach(check=>check.addEventListener('change',()=>{
 if(check.checked&&check.value.startsWith('footer-'))document.querySelectorAll<HTMLInputElement>('.pattern-choice').forEach(other=>{if(other!==check&&other.value.startsWith('footer-'))other.checked=false});
 renderPatterns();showPlan();
}));

const value=(name:string)=> (form.querySelector<HTMLInputElement>(`[name="${name}"]:checked`)?.value||'');
function orderedNav(){
 const roots=nav.filter(x=>!x.parentId||!nav.some(p=>p.id===x.parentId));
 return roots.flatMap(root=>[root,...nav.filter(x=>x.parentId===root.id)]);
}
function syncNav(){
 nav=orderedNav();renderNav();
}
function shiftItem(id:string,delta:number){
 const ordered=orderedNav(),current=ordered.find(x=>x.id===id);
 if(!current)return;
 const siblings=ordered.filter(x=>(x.parentId||'')===(current.parentId||''));
 const index=siblings.findIndex(x=>x.id===id),next=siblings[index+delta];
 if(!next)return;
 const a=ordered.findIndex(x=>x.id===id),b=ordered.findIndex(x=>x.id===next.id);
 [ordered[a],ordered[b]]=[ordered[b],ordered[a]];
 nav=ordered;syncNav();
}
function indentItem(id:string){
 const ordered=orderedNav(),i=ordered.findIndex(x=>x.id===id),item=ordered[i];
 if(!item||item.parentId||!item.enabled||ordered.some(x=>x.parentId===id))return;
 const parent=ordered.slice(0,i).reverse().find(x=>!x.parentId&&x.enabled);
 if(!parent||ordered.filter(x=>x.parentId===parent.id).length>=10)return;
 item.parentId=parent.id;syncNav();
}
function outdentItem(id:string){
 const item=nav.find(x=>x.id===id);
 if(!item?.parentId)return;
 const parentId=item.parentId;item.parentId=undefined;
 nav=orderedNav();
 const last=nav.findLastIndex(x=>x.id===parentId||x.parentId===parentId);
 const index=nav.findIndex(x=>x.id===id);
 const [moved]=nav.splice(index,1);
 nav.splice(last>=index?last:last+1,0,moved);
 syncNav();
}
function moveItem(id:string,targetId:string){
 if(id===targetId)return;
 const ordered=orderedNav(),item=ordered.find(x=>x.id===id),target=ordered.find(x=>x.id===targetId);
 if(!item||!target)return;
 if(target.parentId===id)return;
 const subtree=[item,...ordered.filter(x=>x.parentId===id)];
 const rest=ordered.filter(x=>!subtree.includes(x));
 const pos=rest.findIndex(x=>x.id===targetId);
 if(pos<0)return;
 if(target.parentId){
  if(item.parentId!==target.parentId&&rest.filter(x=>x.parentId===target.parentId).length>=10)return;
  item.parentId=target.parentId;
 }else{
  item.parentId=undefined;
 }
 rest.splice(pos,0,...subtree);
 nav=rest;syncNav();
}
function removeCustom(id:string){
 const item=nav.find(x=>x.id===id);
 if(!item||!id.startsWith('page-custom-'))return;
 const children=nav.filter(x=>x.parentId===id);
 const usedByPattern=Array.from(document.querySelectorAll<HTMLElement>('.pattern-option')).some(box=>box.querySelector<HTMLInputElement>('.pattern-choice')?.checked&&box.querySelector<HTMLSelectElement>('.pattern-page')?.value===id);
 if((children.length||usedByPattern)&&!window.confirm('刪除這個頁面會讓其子選單回到第一層，並清除以它為目標的組合樣板選擇。確定刪除嗎？'))return;
 for(const child of children)child.parentId=undefined;
 for(const box of document.querySelectorAll<HTMLElement>('.pattern-option')){
  if(box.querySelector<HTMLSelectElement>('.pattern-page')?.value===id)box.querySelector<HTMLInputElement>('.pattern-choice')!.checked=false;
 }
 nav=nav.filter(x=>x.id!==id);
 if(target.value===id)target.value='';
 syncNav();
 status.textContent='已刪除自訂頁面，請確認導航與主要按鈕目標。';
}
function renderNav(){
 rows.replaceChildren();nav=orderedNav();
 for(let i=0;i<nav.length;i++){
  const n=nav[i],row=document.createElement('div');row.className='nav-row';
  row.dataset.navId=n.id;row.draggable=true;
  if(n.parentId)row.classList.add('nav-row-child');
  const handle=document.createElement('span');handle.className='nav-drag-handle';handle.textContent='⠿';handle.title='拖曳調整順序';handle.setAttribute('aria-hidden','true');
  const check=document.createElement('input');check.type='checkbox';check.checked=n.enabled;check.setAttribute('aria-label','顯示'+n.label);
  check.addEventListener('change',()=>{
   n.enabled=check.checked;
   if(!n.enabled)for(const child of nav.filter(x=>x.parentId===n.id))child.parentId=undefined;
   renderNav();
  });
  const label=document.createElement('input');label.type='text';label.maxLength=24;label.value=n.label;label.setAttribute('aria-label',n.id+' 選單名稱');
  label.addEventListener('input',()=>{n.label=label.value;renderMenu();showPlan()});
  const tools=document.createElement('div');tools.className='nav-row-actions';
  const action=(symbol:string,name:string,fn:()=>void,disabled=false)=>{
   const btn=document.createElement('button');btn.type='button';btn.textContent=symbol;btn.title=name;btn.setAttribute('aria-label',name+'：'+n.label);btn.disabled=disabled;btn.addEventListener('click',fn);tools.append(btn);
  };
  action('↑','上移',()=>shiftItem(n.id,-1));
  action('↓','下移',()=>shiftItem(n.id,1));
  action('→','縮排為子選單',()=>indentItem(n.id),Boolean(n.parentId)||!n.enabled||i===0);
  action('←','提升至第一層',()=>outdentItem(n.id),!n.parentId);
  if(n.id.startsWith('page-custom-'))action('×','刪除自訂頁面',()=>removeCustom(n.id));
  row.append(handle,check,label,tools);
  row.addEventListener('dragstart',event=>{event.dataTransfer?.setData('text/plain',n.id);row.classList.add('is-dragging')});
  row.addEventListener('dragend',()=>row.classList.remove('is-dragging'));
  row.addEventListener('dragover',event=>{event.preventDefault();row.classList.add('is-drag-over')});
  row.addEventListener('dragleave',()=>row.classList.remove('is-drag-over'));
  row.addEventListener('drop',event=>{event.preventDefault();row.classList.remove('is-drag-over');const moved=event.dataTransfer?.getData('text/plain');if(moved)moveItem(moved,n.id)});
  rows.append(row);
 }
 renderMenu();renderPatterns();showPlan();
}
function renderMenu(){
  menu.replaceChildren();const enabled=nav.filter(x=>x.enabled);
  for(const n of enabled.filter(x=>!x.parentId)){
    const group=document.createElement('div');group.className='nav-preview-group';
    const heading=document.createElement('strong');heading.textContent=n.label;group.append(heading);
    const children=enabled.filter(x=>x.parentId===n.id);
    if(children.length){const sub=document.createElement('ul');for(const child of children){const li=document.createElement('li');li.textContent=child.label;sub.append(li)}group.append(sub)}
    menu.append(group);
  }
  const selected=target.value;target.replaceChildren();
  for(const n of enabled){const option=document.createElement('option');option.value=n.id;option.textContent=n.label;target.append(option)}
  if(enabled.some(x=>x.id===selected))target.value=selected;
  const name=form.querySelector<HTMLInputElement>('[name="siteName"]')!.value.trim();
  document.querySelector<HTMLElement>('#preview-name')!.textContent=name||'網站名稱';
}
document.querySelector<HTMLButtonElement>('#add-nav-page')!.addEventListener('click',()=>{
  if(nav.length>=20){status.textContent='最多可建立 20 個網站頁面';return}
  const used=new Set(nav.map(x=>x.id));let i=1;while(used.has('page-custom-'+i))i++;
  nav.push({id:'page-custom-'+i,label:'自訂頁面 '+i,enabled:true});
  renderNav();
});
function update(){
 const kind=value('kind') as StarterKind;
 if(kind!==priorKind || !nav.length){nav=starterPages[kind].map(p=>({...p}));priorKind=kind;renderNav();
   form.querySelector<HTMLInputElement>('#cta-label')!.value=kind==='knowledge'?'閱讀文章':'了解服務';
 }
 const eligible=layoutOptions.filter(e=>e.dataset.kind===kind);
 layoutOptions.forEach(e=>e.hidden=e.dataset.kind!==kind);
 const checked=form.querySelector<HTMLInputElement>('input[name="layout"]:checked');
 if(!checked||!eligible.some(e=>e.contains(checked))){const first=eligible[0]?.querySelector<HTMLInputElement>('input');if(first)first.checked=true}
 renderPatterns();
 color.value=starterThemeSeeds[value('theme') as StarterTheme];
 document.querySelector<HTMLElement>('#brand-hex')!.textContent=color.value.toUpperCase();
 renderMenu();showPlan();
}
function plan():StarterPlan {
 const kind=value('kind') as StarterKind;
 return {version:1,kind,layoutSlug:value('layout'),visualTheme:value('theme') as StarterTheme,
 brand:{name:form.querySelector<HTMLInputElement>('[name="siteName"]')!.value,primaryColor:color.value.toUpperCase(),tagline:form.querySelector<HTMLInputElement>('[name="tagline"]')!.value},
 navigation:nav.map(x=>({...x})),
 sectionPatterns:Array.from(document.querySelectorAll<HTMLInputElement>('.pattern-choice:checked')).map(check=>{const box=check.closest<HTMLElement>('.pattern-option')!;return {patternId:check.value,targetPage:box.querySelector<HTMLSelectElement>('.pattern-page')!.value,insertAfter:box.querySelector<HTMLInputElement>('.pattern-position')!.value.trim()}}),
 primaryCta:{label:form.querySelector<HTMLInputElement>('#cta-label')!.value,pageId:target.value},
 notes:document.querySelector<HTMLTextAreaElement>('#notes')!.value};
}
function showPlan(){const p=plan();output.textContent=JSON.stringify(p,null,2)}
form.querySelectorAll<HTMLInputElement>('input[name="kind"],input[name="theme"]').forEach(e=>e.addEventListener('change',update));
form.querySelectorAll<HTMLInputElement>('input[name="layout"]').forEach(e=>e.addEventListener('change',showPlan));
color.addEventListener('input',()=>{document.querySelector<HTMLElement>('#brand-hex')!.textContent=color.value.toUpperCase();showPlan()});
form.addEventListener('input',()=>{renderMenu();showPlan()});
target.addEventListener('change',showPlan);
document.querySelector<HTMLButtonElement>('#copy-plan')!.addEventListener('click',async()=>{
 const p=plan(),errors=checkStarterPlan(p,directions);
 if(errors.length){status.textContent=errors.join('；');return}
 try {await navigator.clipboard.writeText(JSON.stringify(p,null,2));status.textContent='已複製，可交給 AI 依 astro-starter-onboarding Skill 繼續。'} catch {status.textContent='無法使用剪貼簿，請選取下方 JSON 手動複製。'}
});
document.querySelector<HTMLButtonElement>('#save-plan')!.addEventListener('click',()=>{
 const p=plan(),errors=checkStarterPlan(p,directions);if(errors.length){status.textContent=errors.join('；');return}
 const blob=new Blob([JSON.stringify(p,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob);
 const a=document.createElement('a');a.href=url;a.download='my-astro-site-plan.json';a.click();URL.revokeObjectURL(url);
 status.textContent='已下載網站設定，這是規劃檔案，不是已部署的網站。';
});
update();
</script>
<style>
.pattern-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.pattern-option{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:20px;min-width:0}
.pattern-option[hidden],.pattern-config[hidden]{display:none}
.pattern-option>p{color:var(--muted);font-size:14px}
.pattern-option>label{display:flex;align-items:center;gap:10px}
.pattern-config{display:grid;gap:14px;margin-top:18px}
.pattern-config label{display:grid;gap:6px;font-size:14px}
.pattern-config input,.pattern-config select{width:100%;min-width:0;padding:10px;border:1px solid #bdb3a5;border-radius:8px;font:inherit;background:var(--white)}
@media(max-width:650px){.pattern-options{grid-template-columns:1fr}}
</style>
<style>
.nav-row{grid-template-columns:24px minmax(0,1fr) minmax(110px,.8fr) 38px 38px}
.nav-row-child{padding-left:12px;border-left:2px solid var(--accent)}
.nav-row select{min-width:0;padding:9px 4px;border:1px solid var(--line);border-radius:8px;background:var(--white);font:inherit;font-size:13px}
.nav-add{margin-top:12px;background:var(--white);border:1px solid var(--line);padding:10px 16px;border-radius:8px;font:inherit;cursor:pointer}
.nav-preview-group{padding:4px 0;min-width:100px}.nav-preview-group strong{font-size:14px}
.nav-preview-group ul{padding-left:20px;margin:6px 0 0;font-size:13px}
@media(max-width:600px){.nav-row{grid-template-columns:24px minmax(0,1fr) 34px 34px}.nav-row select{grid-column:2 / -1;grid-row:2;width:100%}}
</style>
<style>
#nav-items{display:grid;gap:10px}
.nav-row{display:grid;grid-template-columns:26px 22px minmax(0,1fr);align-items:center;gap:8px 10px;padding:12px;border:1px solid var(--line);border-radius:12px;background:var(--white);min-width:0}
.nav-row-child{margin-left:clamp(18px,4vw,36px);border-left:4px solid var(--accent);background:#faf5ed}
.nav-row input[type=text]{width:100%;min-width:0}
.nav-drag-handle{font-size:24px;cursor:grab;line-height:1;text-align:center;color:var(--muted)}
.nav-row-actions{grid-column:3;display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-start}
.nav-row-actions button{display:grid;place-items:center;width:39px;height:39px;border-radius:8px;border:1px solid var(--line);background:var(--white);font:inherit;cursor:pointer}
.nav-row-actions button:disabled{opacity:.35;cursor:default}
.nav-row-actions button:hover:not(:disabled){border-color:var(--accent)}
.nav-row.is-drag-over{outline:2px dashed var(--accent)}
