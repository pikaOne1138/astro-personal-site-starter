---
import DirectionLayout from '../../../layouts/DirectionLayout.astro';
import {getDirectionContent} from '../../../data/art-direction-content';
export function getStaticPaths(){return [{params:{page:undefined}},{params:{page:'services'}},{params:{page:'services/individual'}},{params:{page:'about'}}];}
const route=Astro.params.page??'';
const root=import.meta.env.BASE_URL+'layouts/studio-chapters/';
const site=getDirectionContent('studio-chapters','helper',root,'services/individual/');
const chapters=site.questions.length?site.questions.map((q,i)=>[String(i+1).padStart(2,'0'),q.question,q.answer]):[['01','工作空間','服務資訊尚未設定']];
const service=site.primary;
const info=[['服務名稱',service?.name??'尚未設定'],['服務形式',service?.format??'待設定'],['時長與費用',(service?.duration??'待設定')+'／'+(service?.price??'待設定')],['工作資格',service?.credential??'尚未核實'],['服務界線',service?.scope??'待設定']];
const title=route==='services'?'服務與合作':route==='services/individual'?'服務詳細章節':route==='about'?'關於工作室':'工作室章節';
---
<DirectionLayout title={title+'｜工作室章節（原型）'} description="章節目錄貫穿首頁、服務詳情與關於頁的助人者多頁構圖。">
<main id="main" class="chapters"><div class="shell">
<div class="content-contract" data-layout-content="studio-chapters" aria-label="可編輯網站資料"><span>{site.siteName}</span><span>{site.intro}</span><a href={root+'about/'}>關於本站</a></div><header class="nav"><a class="brand" href={root}>一間工作室 <span>STUDIO / CHAPTERS</span></a><nav aria-label="主要導覽"><a href={root}>首頁</a><a href={root+'services/'}>服務</a><a href={root+'about/'}>關於</a><a href={import.meta.env.BASE_URL+'layouts/'}>版型庫 ↗</a></nav></header>
{route===''&&<><section class="stage"><div class="stage-art"><span>SPACE / OPTIONAL IMAGE</span><span class="stage-art-title">一處能夠<br/>好好說明<br/>工作的地方。</span><small>未使用真實照片，不假裝存在實體工作室。</small></div><div class="stage-copy"><p class="tag">INTRO / 00</p><h1>從空間，讀懂一種工作方式。</h1><p>本原型以章節、文字與工作流程構成網站。沒有工作室照片，也不會使用他人的形象資產。</p><a class="link" href="#sections">閱讀章節 ↓</a></div></section><div id="sections" class="book"><aside class="chapter-nav"><span class="tag">TABLE OF CONTENTS</span>{chapters.map(([n,name])=><a href={'#chapter-'+n}>{n} / {name}</a>)}</aside><div class="chapter-body">{chapters.map(([n,name,desc],i)=><section id={'chapter-'+n} class="chapter"><p class="tag">CHAPTER / {n}</p><h2>{name}</h2><p>{desc}</p>{i===0?<div class="image-space">IMAGE / UNCONFIGURED</div>:i===1?<a class="link" href={root+'services/'}>閱讀服務與工作方式 →</a>:<a class="link" href={root+'about/'}>關於提供服務的人 →</a>}</section>)}</div></div></>}
{route==='services'&&<><section class="pagehead"><p class="tag">CHAPTER / SERVICE INDEX</p><h1>服務如何開始。</h1><p>只有一項服務也可以完整介紹；不憑空補出三種療程、客戶見證或價目。</p></section><div class="book"><aside class="chapter-nav"><span class="tag">ON THIS PAGE</span><a href="#service">01 / 一項服務</a><a href="#boundaries">02 / 必要資訊</a></aside><div class="chapter-body"><section class="chapter" id="service"><p class="tag">01 / SERVICE</p><h2>個別專業服務</h2><p>正式網站由服務者寫入真實名稱、服務對象與專業方法。</p><a class="link" href={root+'services/individual/'}>開啟詳細章節 →</a></section><section class="chapter" id="boundaries"><p class="tag">02 / WHAT TO KNOW</p><h2>開始之前，先清楚知道。</h2><dl>{info.map(([name,value])=><div><dt>{name}</dt><dd>{value}</dd></div>)}</dl></section></div></div></>}
{route==='services/individual'&&<><section class="pagehead"><p class="tag">SERVICE / CHAPTER 01</p><h1>{site.primary?.title??'尚未設定服務'}</h1><p>把服務頁做成可依章節閱讀的資訊敘事，而不是一般三卡銷售頁。</p></section><div class="book"><aside class="chapter-nav"><span class="tag">READING GUIDE</span><a href="#approach">01 / 如何進行</a><a href="#facts">02 / 事前資訊</a><a href="#next">03 / 聯絡以前</a></aside><div class="chapter-body"><section class="chapter" id="approach"><div class="article-contract-body">{(site.primary?.body??[]).map(paragraph=><p>{paragraph}</p>)}</div><p class="tag">01 / APPROACH</p><h2>如何進行？</h2><p>具體的專業方法、適合對象、以及不適合的情境，均需由實際提供者填寫。</p><div class="image-space">SERVICE IMAGE / OPTIONAL</div></section><section class="chapter" id="facts"><p class="tag">02 / FACTS</p><h2>有哪些必要條件？</h2><dl>{info.map(([name,value])=><div><dt>{name}</dt><dd>{value}</dd></div>)}</dl></section><section class="chapter" id="next"><p class="tag">03 / CONTACT</p><h2>聯絡前的知情選擇。</h2><p>正式預約平台與聯絡方式尚未配置，示範頁無法收件。急迫危機請聯絡所在地正式緊急服務。</p><a class="link" href={root+'services/'}>← 返回服務總覽</a></section></div></div></>}
{route==='about'&&<><section class="pagehead"><p class="tag">STUDIO / ABOUT</p><h1>{site.about}</h1><p>這裡展示章節式 About 版面，不假設每位助人者都有工作室、團隊或專業證照。</p></section><div class="book"><aside class="chapter-nav"><span class="tag">ABOUT CHAPTERS</span><a href="#person">01 / 本人</a><a href="#method">02 / 方法</a><a href="#credentials">03 / 真實背景</a></aside><div class="chapter-body"><section class="chapter" id="person"><p class="tag">01 / PERSON</p><h2>關於我</h2><p>請使用自己的經驗、自述與真實照片；若沒有照片，以排版良好的文字提供認識入口。</p></section><section class="chapter" id="method"><p class="tag">02 / APPROACH</p><h2>我的工作方式</h2><p>提供可核實的工作方法與服務界線，不以臆測療效替代專業說明。</p><div class="image-space">WORKSPACE IMAGE / OPTIONAL</div></section><section class="chapter" id="credentials"><p class="tag">03 / BACKGROUND</p><h2>經歷與資格</h2><p>資格、證照來源、所在地及聯絡管道，均為正式網站待配置資料。</p><a class="link" href={root+'services/'}>閱讀服務章節 →</a></section></div></div></>}
<footer><span>工作室章節 / 設計原型</span><a href={root}>回首頁 ↑</a><p>未提供真實執業聲明、預約、表單或緊急支援。</p></footer>
</div></main>
</DirectionLayout>
<style>
.chapters{--ink:#242a24;--rule:#b5bdb1;--soft:#e7ece5;background:#f4f1e8;color:var(--ink);font:17px/1.85 'Noto Sans TC',system-ui,sans-serif;min-height:100vh}.shell{width:min(calc(100% - 48px),1200px);margin:auto}.chapters a{color:inherit;text-decoration:none}.chapters a:hover{text-decoration:underline;text-underline-offset:5px}.nav{display:flex;justify-content:space-between;gap:24px;align-items:center;padding:32px 0;border-bottom:1px solid var(--ink)}.brand{font:400 28px Georgia,'Noto Serif TC',serif}.brand span{display:block;font:12px ui-monospace,monospace}.nav nav{display:flex;gap:16px 32px;flex-wrap:wrap}.nav nav a{display:inline-flex;min-height:44px;align-items:center}.tag{font:12px ui-monospace,monospace;letter-spacing:.1em;color:#496251}.stage{padding:64px 0 128px;display:grid;grid-template-columns:1.15fr 1fr;gap:96px;align-items:center}.stage-art{min-height:560px;background:var(--soft);padding:32px;display:flex;flex-direction:column;justify-content:space-between}.stage-art>span:first-child,.stage-art small{font:12px ui-monospace,monospace;color:#496251}.stage-art-title{font:400 clamp(40px,5vw,76px)/1.3 Georgia,'Noto Serif TC',serif}.chapters h1{font:400 clamp(44px,6vw,76px)/1.2 Georgia,'Noto Serif TC',serif;letter-spacing:-.03em;text-wrap:balance}.stage-copy p:not(.tag),.pagehead p:not(.tag){font-size:20px;max-width:45ch}.link{display:inline-flex;min-height:48px;align-items:center;margin-top:24px;border-bottom:1px solid currentColor}.book{display:grid;grid-template-columns:260px minmax(0,1fr);gap:96px;border-top:1px solid var(--ink);padding:64px 0 128px}.chapter-nav{display:flex;flex-direction:column;gap:8px;position:sticky;top:32px;align-self:start}.chapter-nav .tag{margin-bottom:24px}.chapter-nav a{border-bottom:1px solid var(--rule);padding:12px 0;min-height:48px}.chapter{padding:0 0 96px;scroll-margin-top:32px}.chapter+.chapter{padding-top:96px;border-top:1px solid var(--rule)}.chapter h2{font:400 clamp(36px,4vw,60px)/1.3 Georgia,'Noto Serif TC',serif;letter-spacing:-.02em}.chapter>p{font-size:19px;max-width:52ch}.image-space{background:var(--soft);margin-top:48px;min-height:280px;display:grid;place-items:center;font:12px ui-monospace,monospace;letter-spacing:.08em;color:#496251}.pagehead{padding:96px 0 64px;max-width:900px}.chapter dl{border-top:1px solid var(--rule);margin-top:48px}.chapter dl>div{display:grid;grid-template-columns:180px 1fr;gap:24px;border-bottom:1px solid var(--rule);padding:24px 0}.chapter dt{font-weight:700}.chapter dd{margin:0}.chapters footer{border-top:1px solid var(--ink);padding:32px 0 64px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;font-size:14px}.chapters footer p{flex-basis:100%}.chapters h1,.chapters h2,.chapters p,.chapters dd{overflow-wrap:anywhere}@media(max-width:900px){.stage{gap:48px}.book{grid-template-columns:200px 1fr;gap:48px}}@media(max-width:700px){.shell{width:min(calc(100% - 40px),1200px)}.nav{display:block}.nav nav{margin-top:24px}.stage,.book{display:block}.stage{padding:32px 0 64px}.stage-art{min-height:360px}.stage-copy{margin-top:48px}.book{padding:32px 0 64px}.chapter-nav{position:static;flex-flow:row wrap;gap:8px 16px;border-bottom:1px solid var(--rule);padding-bottom:24px;margin-bottom:48px}.chapter-nav .tag{flex-basis:100%;margin:0}.chapter{padding-bottom:64px}.chapter+.chapter{padding-top:64px}.chapter dl>div{display:block}.chapter dt{margin-bottom:8px}.pagehead{padding:48px 0}.image-space{min-height:200px}}
.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 system-ui,sans-serif;padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
.article-contract-body{font-size:1rem;line-height:1.8;max-width:65ch}
</style>