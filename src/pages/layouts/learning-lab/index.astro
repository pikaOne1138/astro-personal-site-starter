---
import directions from '../../../data/layout-directions.json';
const item=directions.find(d=>d.slug==='learning-lab')!;
const base=import.meta.env.BASE_URL;
const image='https://tenwebs-6qkx6x5p.manus.space/images/directions/'+item.image;
const all=base+'layouts/';
const previous=directions[1];
const next=directions[3];
---
<!doctype html>
<html lang="zh-Hant" data-layout="learning-lab">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content={item.description}/>
<title>{item.title+'｜網站版型庫'}</title>
<link rel="stylesheet" href={base+'layout-library.css'}/>
</head>
<body>
<a class="lay-skip" href="#layout-main">跳到網站內容</a>
<main id="layout-main" class:list={['lay-site','lay--'+item.slug]}>

<header class="lay-lab-head">
  <strong class="lay-lab-logo"><span aria-hidden="true">L</span><span>LEARNING<br/>LAB / 07</span></strong>
  <nav aria-label="學習實驗室導覽"><a href="#section-a">學習路徑</a><a href="#section-b">課程單元</a><a href={all}>其他站型 ↗</a></nav>
  <span class="lay-lab-dot">● OPEN CLASSROOM</span>
</header>
<section class="lay-lab-hero">
  <div class="lay-lab-hero-copy">
    <small>A CLEARER WAY TO LEARN</small>
    <h1>把好奇心<br/><em>變成一條<br/>路。</em></h1>
    <p>不用一次弄懂所有事。從一個小概念開始，學會觀察、整理，再把它用在自己的生活裡。</p>
    <div class="lay-lab-hero-action"><a href="#section-a">學習路徑 <span aria-hidden="true">↘</span></a><small>由學也可以有方向。</small></div>
  </div>
  <figure class="lay-lab-hero-figure"><img src={image} alt="學習地圖與幾何紙張拼貼" loading="eager"/><figcaption>學習地圖 / 第一版</figcaption></figure>
</section>
<section id="section-a" class="lay-lab-path">
  <div class="lay-lab-path-intro"><small>THE LEARNING PATH / 03 STEPS</small>
    <h2>走一遍，<br/>就知道怎麼<br/>繼續。</h2>
    <p>每個主題都有成可完成的幾個小步驟；勾選完成項目，看看自己的學習路徑走到哪裡。</p>
    <div class="lay-lab-progress-meta"><span>目前路徑</span><span class="lay-lab-count" data-lab-count aria-live="polite">0 / 3 個步驟</span></div>
    <progress max="3" value="0" data-lab-progress>0</progress>
  </div>
  <ol class="lay-lab-steps">
    <li><span class="lay-lab-step-no">01</span><div class="lay-lab-step-text"><small>START HERE</small><strong>看見問題</strong><p>先分辨線索、問題與你真正想理解的事。</p></div><label><input type="checkbox" data-lab-check/> 完成</label></li>
    <li><span class="lay-lab-step-no">02</span><div class="lay-lab-step-text"><small>FIELD NOTE</small><strong>整理線索</strong><p>把零散資訊放進一張看得懂的地圖。</p></div><label><input type="checkbox" data-lab-check/> 完成</label></li>
    <li><span class="lay-lab-step-no">03</span><div class="lay-lab-step-text"><small>TRY IT</small><strong>動手練習</strong><p>把概念帶進生活，測試它是否真的有用。</p></div><label><input type="checkbox" data-lab-check/> 完成</label></li>
  </ol>
</section>
<section id="section-b" class="lay-lab-modules">
  <div class="lay-lab-modules-intro"><small>OPEN MODULES</small><h2>最近開放的<br/><em>學習單元。</em></h2><a href="#section-a">比較 10 種網站方向 ↗</a></div>
  <ol class="lay-lab-modules-list">
    <li><span>01</span><div><small>閱讀方法 / 12 分鐘</small><strong>如何從筆記找到自己的問題</strong></div><span aria-hidden="true">↗</span></li>
    <li><span>02</span><div><small>概念整理 / 8 分鐘</small><strong>用一張圖整理複雜概念</strong></div><span aria-hidden="true">↗</span></li>
    <li><span>03</span><div><small>寫作實驗 / 15 分鐘</small><strong>把一個想法，寫成能和人分享的文字</strong></div><span aria-hidden="true">↗</span></li>
  </ol>
</section>
<script is:inline>const checks=[...document.querySelectorAll('[data-lab-check]')],bar=document.querySelector('[data-lab-progress]'),count=document.querySelector('[data-lab-count]');checks.forEach(check=>check.addEventListener('change',()=>{const done=checks.filter(c=>c.checked).length;bar.value=done;count.textContent=done+' / '+checks.length+' 已完成'}));</script>
</main>
<footer class="lay-preview-footer"><a href={all+previous.slug+'/'}>← 上一款</a><a href={all}>← 返回版型庫</a><a href={all+next.slug+'/'}>下一款 →</a></footer>
</body>
</html>