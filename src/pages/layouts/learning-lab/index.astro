---
import directions from '../../../data/layout-directions.json';
const item=directions.find(d=>d.slug==='learning-lab')!;
const base=import.meta.env.BASE_URL;
const image='https://tenwebs-6qkx6x5p.manus.space/images/directions/k-learning-lab.webp';
const all=base+'layouts/';
const lessons=[
  {n:'01',type:'START HERE',title:'看見問題',text:'先分辨現象、問題與你真正想理解的事。',color:'yellow'},
  {n:'02',type:'FIELD NOTE',title:'整理線索',text:'把零散資訊放進一張看得懂的地圖。',color:'blue'},
  {n:'03',type:'TRY IT',title:'動手練習',text:'把概念帶進生活，測試它是否真的有用。',color:'coral'}
];
---
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content={item.description}/><title>學習實驗室｜網站版型庫</title>
<link rel="stylesheet" href={base+'learning-lab-source.css'}/>
</head>
<body>
<a class="direction-skip" href="#main">跳到主要內容</a>
<main id="main" class="ll-site">
  <header class="ll-header"><a href={all} class="ll-brand"><span class="ll-brand-mark">L</span>LEARNING<br />LAB / 07</a><nav><a href="#path">學習路徑</a><a href="#units">課程單元</a><a href={all}>其他站型 ↗</a></nav><span class="ll-status"><i></i> OPEN CLASSROOM</span></header>
  <section class="ll-hero"><div class="ll-hero-copy"><p class="ll-overline">A CLEARER WAY TO LEARN</p><h1>把好奇心<br /><span>變成一條路。</span></h1><p>不用一次弄懂所有事。從一個小概念開始，學會觀察、整理，再把它用在自己的生活裡。</p><div class="ll-actions"><a class="ll-button" href="#path">看學習路徑 <b>↘</b></a><span>自學也可以有方向。</span></div></div><figure class="ll-hero-art"><img src={image} alt="紙張拼貼的學習地圖與幾何路徑"/><figcaption>學習地圖 / 第一版</figcaption></figure><div class="ll-side-index"><span>INTRO</span><span>01 / 05</span><span>→</span></div></section>
  <section class="ll-path" id="path"><header><p class="ll-overline">THE LEARNING PATH / 03 STEPS</p><h2>走一遍，<br />就知道怎麼繼續。</h2><p>每個主題都拆成可完成的幾個小步驟；勾選完成項目，看看自己的學習路徑走到哪裡。</p><div class="ll-progress"><div><label for="ll-progress">目前路徑</label><span id="ll-progress-label" aria-live="polite">0 / 3 個步驟</span></div><progress id="ll-progress" max="3" value="0" aria-label="學習路徑完成進度">0%</progress></div></header><ol class="ll-track">{lessons.map(lesson=><li class:list={['ll-unit','ll-unit--'+lesson.color]}><span class="ll-unit-no">{lesson.n}</span><div><p>{lesson.type}</p><h3>{lesson.title}</h3><span>{lesson.text}</span></div><label class="ll-complete"><input class="ll-check" type="checkbox"/><span>完成</span></label></li>)}</ol></section>
  <section class="ll-modules" id="units"><div class="ll-modules-heading"><p class="ll-overline">OPEN MODULES</p><h2>最近開放的<br /><i>學習單元。</i></h2><a href={all}>比較 12 種網站方向 ↗</a></div><div class="ll-module-list"><article><span class="ll-module-num">01</span><div><p>讀書方法 / 12 分鐘</p><h3>如何從筆記裡找到自己的問題</h3></div><span class="ll-module-arrow">↗</span></article><article><span class="ll-module-num">02</span><div><p>觀察練習 / 8 分鐘</p><h3>用一張簡單的圖整理複雜概念</h3></div><span class="ll-module-arrow">↗</span></article><article><span class="ll-module-num">03</span><div><p>寫作實驗 / 15 分鐘</p><h3>把一個想法，寫成能和人分享的文字</h3></div><span class="ll-module-arrow">↗</span></article></div></section>
  <footer class="ll-footer"><span>LEARNING LAB / 教學與知識設計</span><span>學會怎麼學，然後把方法帶走。</span><a href={all}>返回比較頁</a></footer>
</main>
<script is:inline>
(() => {
 const site=document.querySelector('.ll-site');if(!site)return;
 const checks=Array.from(site.querySelectorAll('.ll-check'));
 const progress=site.querySelector('#ll-progress');
 const label=site.querySelector('#ll-progress-label');
 const update=()=>{const complete=checks.filter(check=>check.checked).length;
   if(progress)progress.value=complete;
   if(label)label.textContent=`${complete} / ${checks.length} 個步驟`;
   checks.forEach(check=>check.closest('.ll-unit')?.classList.toggle('is-done',check.checked));
 };
 checks.forEach(check=>check.addEventListener('change',update));update();
})();
</script>
</body></html>