---
import DirectionLayout from '../../../../layouts/DirectionLayout.astro';
const root=import.meta.env.BASE_URL+'layouts/clinician/';
const labels=["姓名與專業身分","服務所在地","專業資格及核發機構","專業訓練與核驗來源","適用服務範圍","資訊更新日期"];
---
<DirectionLayout title="專業背景資料冊｜清晰臨床原型" description="沒有填入資格來源，就明確顯示未設定，絕不杜撰證照與服務成果。">
<main id="main" class="record"><div class="wrap">
<header class="nav"><a class="brand" href={root}>清晰練習所 <small>CLINICAL / DOSSIER</small></a><nav aria-label="主導覽"><a href={root}>首頁</a><a href={root+'services/'}>服務資料</a><a href={root+'about/'}>背景核驗</a></nav></header>
<section class="head"><p class="kicker">PRACTITIONER / VERIFIED PROFILE</p><h1>專業背景資料冊</h1><p>沒有填入資格來源，就明確顯示未設定，絕不杜撰證照與服務成果。</p></section>
<div class="record-body"><aside><p class="kicker">PUBLIC DISCLOSURES</p><strong>公開資訊<br/>查核清單</strong><p>未配置正式執業資料。這是版型原型，不提供醫療或危機服務。</p></aside><div class="ledger">{labels.map((label,i)=><section><span class="number">{String(i+1).padStart(2,'0')}</span><h2>{label}</h2><p>待實際服務提供者設定並確認資料來源。</p></section>)}<p class="notice">驗證狀態：未提供核實資料。不得將這些欄位解讀為某個人已取得資格。</p><a href={root+'services/individual/'}>查看詳細服務揭露 →</a></div></div>
<footer><span>CLINICAL DOSSIER / NOT A LIVE PRACTICE</span><a href={root}>返回首頁 ↑</a></footer>
</div></main></DirectionLayout>
<style>
.record{--ink:#18313a;--line:#cdd8d5;background:#f4f7f5;color:var(--ink);font:17px/1.85 'Noto Sans TC',system-ui,sans-serif;min-height:100vh}.wrap{width:min(100% - 48px,1180px);margin:auto}.record a{color:inherit;text-decoration:none}.record a:hover{text-decoration:underline;text-underline-offset:4px}.record a:focus-visible{outline:3px solid var(--ink)}.nav{border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:24px;padding:28px 0}.nav nav{display:flex;flex-wrap:wrap;gap:24px}.nav nav a{min-height:44px;display:flex;align-items:center}.brand{font-weight:700;font-size:24px}.brand small{display:block;font:11px ui-monospace,monospace}.kicker{font:12px ui-monospace,monospace;letter-spacing:.08em;color:#496b78}.head{padding:96px 0 64px;max-width:850px}.head h1{font:400 clamp(44px,6vw,76px)/1.2 Georgia,'Noto Serif TC',serif}.head p:last-child{max-width:55ch;font-size:20px}.record-body{display:grid;grid-template-columns:1fr 2.3fr;gap:72px;border-top:1px solid var(--ink);padding:48px 0 112px}.record-body aside{align-self:start;position:sticky;top:24px}.record-body aside strong{font:400 32px/1.4 Georgia,'Noto Serif TC',serif}.ledger section{border-bottom:1px solid var(--line);display:grid;grid-template-columns:44px 1.3fr 1fr;gap:20px;padding:28px 0;align-items:baseline}.ledger .number{font:12px ui-monospace,monospace}.ledger h2{font-size:20px;margin:0}.ledger section p{margin:0}.notice{background:#e7ece5;padding:24px;margin:32px 0}.record footer{border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;padding:32px 0 64px;font-size:13px}@media(max-width:780px){.record-body{display:block}.record-body aside{position:static;margin-bottom:48px}.ledger section{grid-template-columns:36px 1fr}.ledger section p{grid-column:2}}@media(max-width:600px){.wrap{width:min(100% - 40px,1180px)}.nav{display:block}.nav nav{margin-top:20px}.head{padding:48px 0 40px}.record-body{padding:32px 0 64px}}
</style>