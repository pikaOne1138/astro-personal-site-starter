---
import DirectionLayout from '../../../layouts/DirectionLayout.astro';
---
<DirectionLayout title="收藏者目錄｜知識網站方向 04" description="以展牆、目錄與收藏檔案呈現的編輯策展型知識網站。">
  <main id="main" class="cu-site">
    <header class="cu-header"><a href={import.meta.env.BASE_URL + 'layouts/'} class="cu-wordmark"><span>THE</span> CURATOR'S<br />CABINET</a><nav><a href="#collection">收藏目錄</a><a href="#shelf">本月選集</a><a href={import.meta.env.BASE_URL + 'layouts/'}>其他方向 ↗</a></nav><span class="cu-edition">CAT. 24 — 2026</span></header>
    <section class="cu-hero"><div class="cu-hero-copy"><p class="cu-kicker">一份不追求收盡一切的目錄</p><h1>我替你<br /><i>先選過一輪。</i></h1><p>書、文章、工具和偶然發現的好想法。每一項都有被放進來的理由，也有一條可以繼續探索的線索。</p><a href="#collection" class="cu-enter">進入收藏目錄 <span>↓</span></a></div><figure class="cu-still"><img src="https://tenwebs-6qkx6x5p.manus.space/images/directions/k-curator.webp" alt="藝術書籍、石雕與色紙組成的策展靜物" /><figcaption>OBJECTS / IDEAS / 2026</figcaption></figure><span class="cu-stamp">CABINET<br />OF CURIOSITIES</span></section>
    <section class="cu-catalog" id="collection"><aside class="cu-index"><p class="cu-kicker">INDEX / 04</p><h2>收藏<br />目錄</h2><ol><li><a href="#shelf">01 / 值得一讀</a></li><li><a href="#shelf">02 / 思考工具</a></li><li><a href="#shelf">03 / 最近發現</a></li><li><a href={import.meta.env.BASE_URL + 'layouts/'}>04 / 其他站型 ↗</a></li></ol><p class="cu-index-note">這不是排行榜。只是某個人替你讀過、用過之後，留下的選擇。</p></aside><div class="cu-shelves" id="shelf"><div class="cu-shelf-head"><p>COLLECTION 01 — 03</p><span>更新日期 2026.10.08</span></div><details class="cu-featured"><summary class="cu-featured-summary"><span class="cu-object-no">01</span><div><p class="cu-label">值得一讀 / BOOK</p><h3>一本讓人重新學會提問的書</h3><p>不是替你整理答案，而是把那些原本以為不必問的事，重新放回桌上。</p></div><div class="cu-cover cu-cover--one"><span>BOOK<br />01</span><b>問<br />題<br />的<br />形<br />狀</b></div></summary><div class="cu-drawer-body"><p>策展札記：選入收藏不代表它適合每一個人；這裡記下的是我為什麼留下它，以及它可能連到的下一個問題。</p><a href="#shelf">打開選書札記 ↗</a></div></details><div class="cu-object-row"><article><span>02 / TOOL</span><h3>一個把想法連起來的工具</h3><p>適合手上有很多線索，卻還不急著把它們變成結論的人。</p><a href="#shelf">看使用筆記 ↗</a></article><article><span>03 / FIND</span><h3>一篇談記憶與地方的文章</h3><p>從小小的日常物件，開始理解一個地方如何被記住。</p><a href="#shelf">讀完整收藏 ↗</a></article></div></div></section>
    <footer class="cu-footer"><span>THE CURATOR'S CABINET / 私人選集</span><span>保存選擇的理由，也保存繼續探索的空間。</span><a href={import.meta.env.BASE_URL + 'layouts/'}>回到十種方向 ↗</a></footer>
  </main>
</DirectionLayout>
<style>
.cu-site{--cu-ink:#30252f;--cu-plum:#5b4055;--cu-paper:#efebe6;--cu-gold:#76572c;background:var(--cu-paper);color:var(--cu-ink);min-height:100vh;padding:0 clamp(1rem,4vw,4rem) 2rem;font-family:Georgia,"Noto Serif TC",serif}.cu-header{height:88px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #c8c0bb}.cu-wordmark{font-size:.85rem;line-height:.92;letter-spacing:.04em;text-decoration:none;color:var(--cu-plum)}.cu-wordmark span{font: .5rem ui-monospace,monospace;letter-spacing:.2em}.cu-header nav{display:flex;gap:1.6rem;font: .68rem ui-monospace,monospace}.cu-header nav a{text-decoration:none}.cu-edition{font: .6rem ui-monospace,monospace;color:#575052}.cu-hero{position:relative;max-width:1300px;margin:0 auto;min-height:560px;display:grid;grid-template-columns:1fr .85fr;align-items:center;gap:6vw;padding:5rem 0}.cu-kicker,.cu-label{font: .63rem ui-monospace,monospace;letter-spacing:.14em;color:var(--cu-plum);text-transform:uppercase}.cu-hero h1{font-size:clamp(4.2rem,9vw,9rem);line-height:.9;letter-spacing:-.08em;font-weight:400;margin:.8rem 0 1.3rem}.cu-hero h1 i{font-weight:400;color:var(--cu-plum)}.cu-hero-copy>p:not(.cu-kicker){max-width:440px;line-height:1.85;color:#655a60}.cu-enter{display:inline-block;margin-top:1.2rem;font: .7rem ui-monospace,monospace;color:var(--cu-plum);border-bottom:1px solid var(--cu-gold);padding-bottom:.4rem;text-decoration:none}.cu-enter span{margin-left:.9rem;color:var(--cu-gold)}.cu-still{margin:0;transform:rotate(1.8deg);background:#fff;padding:.7rem .7rem 2.2rem;box-shadow:0 18px 50px #30252f19}.cu-still img{width:100%;aspect-ratio:3/2;object-fit:cover}.cu-still figcaption{font: .57rem ui-monospace,monospace;color:#575757;padding:.7rem .2rem 0}.cu-stamp{position:absolute;right:37%;bottom:3.4rem;display:grid;place-items:center;width:94px;height:94px;border:1px solid var(--cu-gold);border-radius:50%;font: .52rem ui-monospace,monospace;color:var(--cu-gold);text-align:center;line-height:1.5;transform:rotate(-13deg)}.cu-catalog{max-width:1300px;margin:0 auto 6rem;border-top:1px solid #b8b0ab;padding-top:1.5rem;display:grid;grid-template-columns:260px 1fr;gap:5vw}.cu-index h2{font-size:3rem;line-height:.9;letter-spacing:-.07em;margin:.6rem 0 1.7rem}.cu-index ol{list-style:none;padding:0;margin:0}.cu-index li{border-top:1px solid #cfc7c2;padding:.65rem 0;font: .67rem ui-monospace,monospace}.cu-index a{text-decoration:none}.cu-index-note{font-size:.8rem;line-height:1.7;color:#575057;max-width:220px;margin-top:2rem}.cu-shelf-head{display:flex;justify-content:space-between;border-bottom:1px solid #b8b0ab;padding:.3rem 0 .6rem;font: .58rem ui-monospace,monospace;color:#595159}.cu-featured{display:block;border-bottom:1px solid #b8b0ab;padding:1.5rem 0}.cu-featured-summary{position:relative;display:grid;grid-template-columns:42px 1fr 170px;gap:1.2rem;align-items:center;padding-right:2rem;cursor:pointer;list-style:none}.cu-featured-summary::-webkit-details-marker{display:none}.cu-featured-summary::marker{content:""}.cu-featured-summary::after{content:"＋";position:absolute;right:.15rem;top:45%;font: .8rem ui-monospace,monospace;color:var(--cu-plum)}.cu-featured[open] .cu-featured-summary::after{content:"−"}.cu-drawer-body{margin:.8rem 0 0 3.3rem;padding:.9rem 0 .2rem;border-top:1px dashed #b8b0ab;display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center}.cu-drawer-body p{font-size:.82rem;line-height:1.7;color:#51464e;margin:0}.cu-object-no{font: .72rem ui-monospace,monospace;color:var(--cu-gold);align-self:start}.cu-featured h3,.cu-object-row h3{font-size:1.6rem;line-height:1.08;font-weight:400;margin:.4rem 0}.cu-featured p:not(.cu-label),.cu-object-row p{font-size:.82rem;line-height:1.7;color:#6a6067}.cu-featured a,.cu-object-row a{font: .63rem ui-monospace,monospace;color:var(--cu-plum)}.cu-cover{width:150px;height:196px;box-shadow:8px 8px 0 #d1c8be;display:flex;justify-content:space-between;padding:.7rem;background:var(--cu-plum);color:#f4e9d5}.cu-cover--one b{font-size:1.2rem;line-height:1.05;writing-mode:vertical-rl;letter-spacing:.1em}.cu-cover span{font: .55rem ui-monospace,monospace}.cu-object-row{display:grid;grid-template-columns:1fr 1fr}.cu-object-row article{padding:1.3rem 1rem 1rem 0;border-right:1px solid #c2b9b2}.cu-object-row article+article{padding-left:1.3rem;border-right:0}.cu-object-row article>span{font: .58rem ui-monospace,monospace;color:var(--cu-gold)}.cu-object-row h3{font-size:1.2rem}.cu-footer{max-width:1300px;margin:auto;border-top:1px solid #c8c0bb;padding:1rem 0;display:flex;justify-content:space-between;gap:1rem;font: .58rem ui-monospace,monospace;color:#585156}.cu-footer a{color:var(--cu-plum)}@media(max-width:800px){.cu-hero{grid-template-columns:1fr 1fr;gap:2rem}.cu-stamp{right:40%;bottom:2rem}.cu-catalog{grid-template-columns:200px 1fr;gap:2rem}.cu-featured{grid-template-columns:30px 1fr 120px}.cu-cover{width:110px;height:160px}}@media(max-width:600px){.cu-header{height:auto;padding:1rem 0;align-items:flex-start;gap:1rem;flex-wrap:wrap}.cu-header nav{order:3;width:100%;gap:.8rem;font-size:.62rem}.cu-hero{grid-template-columns:1fr;padding:3.5rem 0;gap:2rem}.cu-hero h1{font-size:17vw}.cu-still{width:85%;margin-left:auto}.cu-stamp{right:4%;bottom:1rem;width:74px;height:74px}.cu-catalog{grid-template-columns:1fr;gap:1rem}.cu-index ol{display:flex;flex-wrap:wrap;gap:.5rem 1rem}.cu-index li{border-top:0;padding:.2rem 0}.cu-index-note{max-width:100%;margin:1rem 0}.cu-featured-summary{grid-template-columns:28px 1fr 88px;gap:.6rem}.cu-drawer-body{margin-left:2.4rem;grid-template-columns:1fr;gap:.5rem}.cu-cover{width:82px;height:128px}.cu-featured h3{font-size:1.25rem}.cu-object-row{grid-template-columns:1fr}.cu-object-row article,.cu-object-row article+article{padding:1rem 0;border-right:0;border-bottom:1px solid #c2b9b2}.cu-footer{flex-direction:column}}
</style>