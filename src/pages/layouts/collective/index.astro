---
import DirectionLayout from '../../../layouts/DirectionLayout.astro';
const people = [
  { initials:'林', name:'林以安', role:'心理教育／社群對話', color:'rose' },
  { initials:'陳', name:'陳柏宇', role:'生涯支持／工作設計', color:'blue' },
  { initials:'周', name:'周佳寧', role:'身體練習／團體引導', color:'yellow' },
];
---
<DirectionLayout title="共好工作室｜助人服務方向 10" description="以共同立場、團隊成員與共學活動為主體的集體助人服務網站。">
  <main id="main" class="cg-site">
    <header class="cg-header"><a href={import.meta.env.BASE_URL + 'layouts/'} class="cg-brand"><span class="cg-mark">C</span><span>共好工作室<small>COMMON GROUND / 10</small></span></a><nav><a href="#belief">我們相信</a><a href="#people">一起工作的人</a><a href="#calendar">共學日曆</a><a href={import.meta.env.BASE_URL + 'layouts/'}>其他方向 ↗</a></nav><a class="cg-join" href="#calendar">找一場一起參與 ↗</a></header>
    <section class="cg-hero"><div class="cg-hero-copy"><p class="cg-kicker">MORE THAN ONE WAY TO HELP</p><h1>一起工作，<br /><i>不用把答案交給一個人。</i></h1><p>我們由不同背景的助人工作者組成，分享練習、彼此轉介，也一起討論服務的邊界。</p><a href="#people">認識工作室成員 <span>↓</span></a></div><figure><img src="https://tenwebs-6qkx6x5p.manus.space/images/directions/c-collective.webp" alt="不同背景的成員圍桌合作，整理空白卡片與想法" /><figcaption>共學工作坊 / 團隊示意</figcaption></figure><div class="cg-hero-sticker">LISTEN<br />LEARN<br />SHARE</div></section>
    <section class="cg-belief" id="belief"><div class="cg-belief-label"><p class="cg-kicker">A SHARED POSITION</p><span>不是一種方法，<br />而是一種一起工作的方式。</span></div><blockquote>每個人都帶著自己的經驗來。<br /><i>支持，也可以有很多種形狀。</i></blockquote><p>我們尊重專業差異，也不把所有需求放進同一個服務。當需要的支持不在我們的範圍內，轉介與合作同樣重要。</p></section>
    <section class="cg-people" id="people"><header><div><p class="cg-kicker">THE PEOPLE / 03 VOICES</p><h2>不同專業，<br />共同照看。</h2></div><p class="cg-demo-note">以下人物為版型示範資料；正式網站請替換成真實團隊簡介與經當事人同意的照片。</p></header><div class="cg-people-grid">{people.map((person,i)=><article class:list={['cg-person',`cg-person--${person.color}`]}><span class="cg-person-no">0{i+1}</span><span class="cg-avatar" aria-hidden="true">{person.initials}</span><h3>{person.name}</h3><p>{person.role}</p><a href="#calendar">看看工作方式 ↗</a></article>)}</div></section>
    <section class="cg-calendar" id="calendar"><div class="cg-calendar-head"><p class="cg-kicker">OPEN TABLE / UPCOMING</p><h2>留一張椅子，<br /><i>一起練習。</i></h2><p>以下主題與日期均是版型示意，不代表真實活動、時間或名額；正式內容需由團隊確認後更新。</p></div><ol><li><span class="cg-date"><b>--</b> TBD</span><div><p>示意主題 / 開放對話</p><h3>如何在助人工作裡練習說不？</h3><span>日期、形式與名額待團隊確認</span></div><a href="#calendar">活動資訊 ↗</a></li><li><span class="cg-date"><b>--</b> TBD</span><div><p>示意主題 / 共同備課</p><h3>把一個服務流程畫給彼此看</h3><span>日期、時間與名額待團隊確認</span></div><a href="#calendar">活動資訊 ↗</a></li></ol></section>
    <section class="cg-join-band"><p class="cg-kicker">AN OPEN INVITATION</p><h2>你可以先來看看，<br />不必立刻加入任何事。</h2><a href={import.meta.env.BASE_URL + 'layouts/'}>回到十二種設計方向 ↗</a></section>
    <footer class="cg-footer"><span>共好工作室 / 團隊與社群服務示意</span><span>合作方式、資格與活動均需由真實團隊確認。</span></footer>
  </main>
</DirectionLayout>
<style>
.cg-site{--cg-ink:#203d68;--cg-blue:#2d55cf;--cg-yellow:#f5cb47;--cg-paper:#f8f5eb;--cg-rose:#e9bcb3;min-height:100vh;background:var(--cg-paper);color:var(--cg-ink);padding:0 clamp(1rem,4vw,4rem) 2rem;font-family:Arial,"Noto Sans TC",sans-serif}.cg-header{height:88px;display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid #d7d3c9}.cg-brand{text-decoration:none;display:flex;align-items:center;gap:.6rem;font-size:.84rem;font-weight:800}.cg-brand small{display:block;font: .48rem ui-monospace,monospace;letter-spacing:.09em;color:#4d5c76;margin-top:.25rem}.cg-mark{width:34px;height:34px;border-radius:50%;background:var(--cg-yellow);display:grid;place-items:center;font-size:1.2rem}.cg-header nav{display:flex;gap:1.1rem;font-size:.65rem}.cg-header nav a{text-decoration:none}.cg-join{background:var(--cg-blue);color:white;padding:.7rem .9rem;text-decoration:none;font-size:.63rem;border-radius:30px}.cg-hero{max-width:1320px;margin:0 auto;padding:4rem 0 5rem;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:5vw;position:relative}.cg-kicker{font: .6rem ui-monospace,monospace;letter-spacing:.13em;color:var(--cg-blue)}.cg-hero h1{font-size:clamp(3.5rem,7vw,7rem);line-height:1;letter-spacing:-.08em;margin:1rem 0}.cg-hero h1 i{font-family:Georgia,serif;font-weight:400;color:var(--cg-blue)}.cg-hero-copy>p:not(.cg-kicker){max-width:480px;line-height:1.9;color:#5c6d89}.cg-hero-copy>a{display:inline-block;margin-top:1.3rem;background:var(--cg-yellow);padding:.8rem 1rem;text-decoration:none;font-size:.72rem;font-weight:700}.cg-hero-copy>a span{margin-left:1.5rem}.cg-hero figure{margin:0;position:relative}.cg-hero figure img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:46% 46% 3px 3px}.cg-hero figcaption{font: .58rem ui-monospace,monospace;color:#4a5870;text-align:right;margin-top:.5rem}.cg-hero-sticker{position:absolute;right:39%;bottom:2.5rem;width:86px;height:86px;background:var(--cg-yellow);border-radius:50%;display:grid;place-content:center;text-align:center;font: .54rem/1.45 ui-monospace,monospace;transform:rotate(9deg);box-shadow:4px 4px 0 var(--cg-blue)}.cg-belief{max-width:1320px;margin:0 auto 6rem;background:#e9ebf5;padding:clamp(1.5rem,4vw,3rem);display:grid;grid-template-columns:.65fr 1.25fr .8fr;gap:3vw;align-items:start}.cg-belief-label>span{display:block;margin-top:2rem;font-size:.74rem;line-height:1.7;color:#4d5d7b}.cg-belief blockquote{font-size:clamp(1.8rem,4vw,3.8rem);line-height:1.25;letter-spacing:-.06em;margin:0}.cg-belief blockquote i{font-family:Georgia,serif;font-weight:400;color:var(--cg-blue)}.cg-belief>p{font-size:.76rem;line-height:1.85;color:#586b8d;margin:0}.cg-people{max-width:1320px;margin:0 auto 6rem}.cg-people>header{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:1.5rem}.cg-people h2,.cg-calendar h2,.cg-join-band h2{font-size:clamp(2.8rem,5vw,5rem);line-height:1;letter-spacing:-.08em;margin:.5rem 0}.cg-demo-note{max-width:390px;font-size:.66rem;line-height:1.7;color:#586581}.cg-people-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.cg-person{position:relative;min-height:270px;padding:1.2rem;border:1px solid #d8d4c9;display:flex;flex-direction:column;align-items:flex-start}.cg-person--rose{background:#f0ddd7}.cg-person--blue{background:#dfe6f8}.cg-person--yellow{background:#f5e8bb}.cg-person-no{font: .57rem ui-monospace,monospace;color:#586c9b}.cg-avatar{align-self:center;margin:.4rem 0 .5rem;width:82px;height:82px;border-radius:50%;background:#fbf5e9;display:grid;place-items:center;font-size:2rem;color:var(--cg-blue);border:1px solid #d8d4c9}.cg-person h3{font-size:1.25rem;margin:.2rem 0}.cg-person p{font-size:.7rem;color:#586c82;margin:0}.cg-person a{margin-top:auto;padding-top:1rem;font: .6rem ui-monospace,monospace;color:var(--cg-blue)}.cg-calendar{max-width:1320px;margin:0 auto 5rem;display:grid;grid-template-columns:.8fr 1.2fr;gap:5vw;border-top:1px solid #d2cec3;padding-top:1.5rem}.cg-calendar-head>p:last-child{max-width:350px;font-size:.76rem;line-height:1.8;color:#4c5c78}.cg-calendar ol{list-style:none;margin:0;padding:0}.cg-calendar li{display:grid;grid-template-columns:72px 1fr auto;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid #d2cec3}.cg-date{width:58px;height:58px;border-radius:50%;background:var(--cg-yellow);display:grid;place-content:center;text-align:center;font: .53rem ui-monospace,monospace}.cg-date b{font-size:1.35rem;line-height:1}.cg-calendar li div>p{font: .57rem ui-monospace,monospace;color:var(--cg-blue);margin:0}.cg-calendar li h3{font-size:1rem;margin:.3rem 0}.cg-calendar li div>span{font-size:.61rem;color:#4c5c78}.cg-calendar li>a{font-size:.6rem;color:var(--cg-blue)}.cg-join-band{max-width:1320px;margin:0 auto 2rem;background:var(--cg-blue);color:white;padding:2rem clamp(1.2rem,4vw,3rem);display:flex;flex-direction:column;align-items:flex-start}.cg-join-band .cg-kicker{color:#f7d864}.cg-join-band h2{font-size:clamp(2rem,4vw,4rem)}.cg-join-band>a{color:white;border-bottom:1px solid #f7d864;padding-bottom:.35rem;font-size:.7rem}.cg-footer{border-top:1px solid #d7d3c9;padding:1rem 0;display:flex;justify-content:space-between;gap:1rem;font: .56rem ui-monospace,monospace;color:#4f5e79}@media(max-width:900px){.cg-header{height:auto;padding:1rem 0;flex-wrap:wrap}.cg-header nav{order:3;width:100%;justify-content:space-between}.cg-hero{grid-template-columns:1fr 1fr;gap:2rem}.cg-belief{grid-template-columns:.5fr 1.5fr}.cg-belief>p{grid-column:2}.cg-calendar{grid-template-columns:1fr;gap:1rem}}@media(max-width:580px){.cg-header nav{font-size:.57rem;gap:.4rem}.cg-join{font-size:.56rem;padding:.55rem .7rem}.cg-hero{grid-template-columns:1fr;padding:3rem 0;gap:2rem}.cg-hero h1{font-size:15vw}.cg-hero figure{width:90%;margin-left:auto}.cg-hero-sticker{right:3%;bottom:1rem}.cg-belief{grid-template-columns:1fr;gap:1.1rem}.cg-belief>p{grid-column:auto}.cg-belief-label>span{margin-top:.5rem}.cg-people>header{flex-direction:column;align-items:flex-start;gap:.3rem}.cg-people-grid{grid-template-columns:1fr}.cg-person{min-height:230px}.cg-calendar li{grid-template-columns:55px 1fr}.cg-calendar li>a{grid-column:2}.cg-date{width:48px;height:48px}.cg-calendar li h3{font-size:.9rem}.cg-footer{flex-direction:column}}
</style>