---
import directions from '../../../data/layout-directions.json';
const item=directions.find(d=>d.slug==='collective')!;
const base=import.meta.env.BASE_URL;
const image='https://tenwebs-6qkx6x5p.manus.space/images/directions/'+item.image;
const all=base+'layouts/';
const previous=directions[9];
const next=directions[11];
---
<!doctype html>
<html lang="zh-Hant" data-layout="collective">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content={item.description}/>
<title>{item.title+'｜網站版型庫'}</title>
<link rel="stylesheet" href={base+'layout-library.css'}/>
</head>
<body>
<a class="lay-skip" href="#layout-main">跳到網站內容</a>
<main id="layout-main" class:list={['lay-site','lay--'+item.slug]}>

<header class="lay-community-head"><strong>COMMON GROUND ◌</strong><nav><a href="#section-a">我們一起做</a><a href="#section-b">近期活動</a></nav></header>
<section class="lay-community-hero"><div><small>PEOPLE / PRACTICE / COMMON GOOD</small><h1>不同專業一起，<br/><em>讓陪伴有更多種可能。</em></h1><p>一個能讓不同背景的實作者、來訪者與社群相遇的地方。</p><a href="#section-a">認識我們 ↘</a></div><figure><img src={image} alt="團隊共作與卡片討論場景" loading="eager"/></figure></section>
<section class="lay-community-team" id="section-a"><h2>一個工作室，<br/>好幾種看事情的方法。</h2><div><article><span>01 / BODY</span><h3>身體與覺察</h3><p>從感受理解日常的節奏。</p></article><article><span>02 / RELATION</span><h3>關係與對話</h3><p>從溝通尋找連結與界線。</p></article><article><span>03 / PRACTICE</span><h3>學習與行動</h3><p>從小步驟開始實際嘗試。</p></article></div></section>
<section class="lay-community-events" id="section-b"><h2>近期共學與相遇</h2><p>活動日期與名額皆為示範，正式上線請接入真實日曆或報名系統。</p><div><span>COMING SOON</span><strong>開放工作室 / 共同閱讀</strong><span>↗</span></div></section>
</main>
<footer class="lay-preview-footer"><a href={all+previous.slug+'/'}>← 上一款</a><a href={all}>← 返回版型庫</a><a href={all+next.slug+'/'}>下一款 →</a></footer>
</body>
</html>