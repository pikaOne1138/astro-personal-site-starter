---
import DirectionLayout from '../../../layouts/DirectionLayout.astro';
import {getDirectionContent} from '../../../data/art-direction-content';
import contentSource from '../../../data/art-direction-layout-content.json';
export function getStaticPaths() {
  const fixed=[{params:{page:undefined}},{params:{page:'articles'}},{params:{page:'articles/sample'}},{params:{page:'about'}}];
  const additional=(contentSource.knowledge.articles??[]).slice(1).filter(entry=>entry.published===true && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(entry.slug));
  return [...fixed,...additional.map(entry=>({params:{page:'articles/'+entry.slug}}))];
}
const page=Astro.params.page??'',root=import.meta.env.BASE_URL+'layouts/card-journal/';
const site=getDirectionContent('card-journal','knowledge',root,'articles/sample/');
const detailRecord=site.articles.find(entry=>entry.href && entry.href.endsWith((Astro.params.page??'')+'/'))??site.primary;
const posts=site.posts;
const name=page==='articles'?'文章總覽':page==='about'?'關於作者':page?'把每天的線索記成一篇':'卡片刊物';
---
<DirectionLayout title={name+'｜卡片刊物（設計原型）'} description="等權重卡片文章流、卡片式分類與無圖片備案的個人內容網站">
<main id="main" class="cards"><div class="shell"><div class="content-contract" data-layout-content="card-journal" aria-label="可編輯網站資料">{site.kind==='knowledge'&&site.articles.filter(item=>item.published).length===0&&<span>目前沒有公開文章。</span>}{site.kind==='helper'&&site.services.filter(item=>item.href).length===0&&<span>尚未提供正式服務。</span>}<span>{site.siteName}</span><span>{site.intro}</span><a href={root+'about/'}>關於本站</a></div><header><a class="logo" href={root}>日常刊物 <small>THE CARD JOURNAL</small></a><nav aria-label="主要導覽"><a href={root}>首頁</a><a href={root+'articles/'}>文章</a><a href={root+'about/'}>關於</a><a href={import.meta.env.BASE_URL+'layouts/'}>版型庫 ↗</a></nav></header>
{(page===''||page==='articles')&&<><section class="intro"><span class="label">{page===''?'NOTES / START HERE':'ALL POSTS / DEMO'}</span><h1>{page===''?'一篇一篇，把想法保存下來。':'文章總覽'}</h1><p>每一篇都是同等重要的記錄，不靠巨型頭條、拼貼展牆或品牌口號。僅有一篇實際示範全文。</p></section><section class="toolbar"><strong>全部文章 <span>{String(posts.length).padStart(2,'0')} / DEMO</span></strong><span>觀察　/　閱讀　/　生活</span></section><section class="grid" aria-label="文章卡片">{posts.map(post=><article class="post"><div class="cover"><span>RECORD / {post.id}</span><strong>{post.tag}</strong><small>無照片也能成立</small></div><div class="card-body"><span class="label">{post.tag} · 2026</span><h2>{post.href?<a href={post.href}>{post.title} ↗</a>:post.title}</h2><p>{post.text}</p>{!post.href&&<small>尚無文章全文</small>}</div></article>)}</section>{page===''&&<section class="ending"><h2>先寫第一篇，之後慢慢增加。</h2><p>作者與文章的連結，是這個簡單內容基地的起點。</p><a href={root+'about/'}>關於作者 →</a></section>}</>}
{(Astro.params.page??'').startsWith('articles/')&&<><div class="article-intro"><span class="label">觀察 · DEMO RECORD 01</span><h1>{detailRecord?.title??'目前沒有公開文章'}</h1><p>以下示範卡片文章進入詳細頁後如何以單欄閱讀，不代表作者真實經歷。</p></div><div class="article-cover">RECORD 01 / OBSERVATION</div><article class="prose"><div class="article-contract-body">{(detailRecord?.body??[]).map(paragraph=><p>{paragraph}</p>)}</div><h2>從問題開始</h2><p>一篇筆記不一定要提出完整理論。今天的一個小疑問，可能就是下一次閱讀的起點。</p><p>先寫下眼前的事，保留情境，將文章歸到能讓自己和讀者重新找到的分類。</p><h2>重新閱讀</h2><p>當幾篇文章累積起來，整齊的同權重卡片讓人自由挑選，而不必先判斷哪篇是最重要的。</p><a href={root+'articles/'}>← 返回文章列表</a></article><section class="related"><span class="label">OTHER DEMO TOPICS</span>{posts.slice(1).map(post=><article><h3>{post.title}</h3><small>目前尚無全文</small></article>)}</section></>}
{page==='about'&&<><section class="intro"><span class="label">ABOUT / THE AUTHOR</span><h1>{site.about}</h1><p>這是一套可依實際作者身分填寫的版型，沒有虛構姓名、履歷或社群數據。</p></section><section class="about"><div class="avatar">照片<br/>選填</div><div><h2>寫下什麼？</h2><p>可以是知識整理、生活紀錄、文章練習或長期觀察。缺少照片時，以清楚的文字欄位代替。</p><h2>如何維護？</h2><p>正式資料應從既有 Astro Content Collections 取得，搜尋維持 Pagefind，不另建靜態假索引。</p><a href={root+'articles/'}>看全部文章 →</a></div></section></>}
<footer><span>卡片刊物 / 編排原型</span><a href={root}>回首頁 ↑</a><span>示範內容非真實出版紀錄</span></footer></div></main>
</DirectionLayout>
<style>
.cards{--ink:#242a24;--line:#c6c8bc;background:#f4f1e8;color:var(--ink);min-height:100vh;font-family:'Noto Sans TC',system-ui,sans-serif;line-height:1.8}.shell{width:min(calc(100% - 48px),1200px);margin:auto}.cards a{color:inherit;text-decoration:none}.cards a:hover{text-decoration:underline;text-underline-offset:4px}.cards header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:32px 0;border-bottom:1px solid var(--line)}.logo{font:400 30px Georgia,'Noto Serif TC',serif}.logo small{display:block;font:12px ui-monospace,monospace}.cards nav{display:flex;flex-wrap:wrap;gap:16px 32px}.cards nav a{display:inline-flex;align-items:center;min-height:44px}.label{font:12px ui-monospace,monospace;letter-spacing:.09em;color:#58645a}.intro{max-width:850px;padding:96px 0 64px}.cards h1{font:400 clamp(40px,5vw,72px)/1.2 Georgia,'Noto Serif TC',serif;letter-spacing:-.02em;text-wrap:balance}.intro p,.article-intro p{font-size:20px;max-width:48ch}.toolbar{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;padding:24px 0;border-top:1px solid var(--ink);border-bottom:1px solid var(--line)}.toolbar strong span{font:12px ui-monospace,monospace;color:#58645a;margin-left:16px}.grid{padding:48px 0 128px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}.post{background:#fffefa;border:1px solid var(--line);min-width:0}.cover{aspect-ratio:4/3;background:#e7ece5;display:flex;flex-direction:column;justify-content:space-between;padding:24px;color:#355747}.cover span,.cover small{font:12px ui-monospace,monospace}.cover strong{font:400 44px Georgia,'Noto Serif TC',serif;text-align:center}.card-body{padding:24px}.card-body h2{font:400 clamp(24px,2.3vw,30px)/1.35 Georgia,'Noto Serif TC',serif}.card-body p{font-size:16px}.card-body small{font-size:13px;color:#58645a}.ending{border-top:1px solid var(--ink);padding:80px 0 128px}.ending h2,.about h2{font:400 clamp(28px,4vw,48px) Georgia,'Noto Serif TC',serif}.ending a,.about a,.prose a{min-height:48px;display:inline-flex;align-items:center;border-bottom:1px solid currentColor}.article-intro{max-width:870px;padding:96px 0 48px}.article-cover{background:#e7ece5;min-height:300px;padding:32px;display:grid;place-content:center;font:24px ui-monospace,monospace;color:#355747}.prose{max-width:720px;margin:96px auto 128px;font-size:18px;line-height:1.95}.prose h2{font:400 36px Georgia,'Noto Serif TC',serif;margin-top:64px}.related{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;border-top:1px solid var(--ink);padding:64px 0 96px}.related>.label{grid-column:1/-1}.related article{border-top:1px solid var(--line);padding:24px 0}.related h3{font:400 24px Georgia,'Noto Serif TC',serif}.about{display:grid;grid-template-columns:1fr 2fr;gap:64px;padding:32px 0 128px}.avatar{background:#e7ece5;min-height:320px;display:grid;place-content:center;text-align:center;font:36px Georgia,'Noto Serif TC',serif}.about p{font-size:18px;max-width:55ch}.cards footer{border-top:1px solid var(--ink);padding:32px 0 64px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;font-size:14px}.cards h1,.cards h2,.cards h3,.cards p{overflow-wrap:anywhere}@media(max-width:950px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.shell{width:min(calc(100% - 40px),1200px)}.cards header{align-items:flex-start;flex-direction:column}.intro,.article-intro{padding:48px 0}.grid{grid-template-columns:1fr;gap:24px;padding-bottom:64px}.cover{aspect-ratio:5/3}.about{display:block}.avatar{min-height:200px;margin-bottom:48px}.prose{margin:48px auto 64px;font-size:17px}.related{display:block}.related article{margin:24px 0}.ending{padding:64px 0}}
.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 system-ui,sans-serif;padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
.article-contract-body{font-size:1rem;line-height:1.8;max-width:65ch}
</style>