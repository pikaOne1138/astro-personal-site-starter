---
import DirectionLayout from '../../../layouts/DirectionLayout.astro';
export function getStaticPaths() {
  return [{params:{page:undefined}},{params:{page:'articles'}},{params:{page:'articles/first-note'}},{params:{page:'about'}}];
}
const route=Astro.params.page ?? '';
const base=import.meta.env.BASE_URL+'layouts/sidebar-journal/';
const articles=[
 {id:'01',date:'10.14',tag:'觀察',title:'從日常的小事開始記錄',summary:'一篇展示如何將零散的觀察整理成可重訪筆記的示範文章。',href:base+'articles/first-note/'},
 {id:'02',date:'10.08',tag:'閱讀',title:'一頁讀書筆記的構造',summary:'此為標題示意，尚未建立文章全文。'},
 {id:'03',date:'10.02',tag:'生活',title:'慢慢累積自己的寫作線索',summary:'此為標題示意，尚未建立文章全文。'}
];
const title=route==='articles'?'文章索引':route==='about'?'關於作者':route?'從日常的小事開始記錄':'側欄日誌';
---
<DirectionLayout title={title+'｜側欄日誌（原型）'} description="以長駐側欄、個人短箋與日期順序構成的知識型多頁設計原型">
<main id="main" class="journal">
  <div class="frame">
    <aside class="rail" aria-label="網站側欄">
      <a class="brand" href={base}>日常 / 手記<span>SIDE NOTES · PROTOTYPE</span></a>
      <p class="rail-intro">替那些尚未想清楚的事，保留一個位置。</p>
      <nav aria-label="主要導覽">
        <a href={base} aria-current={route===''?'page':undefined}>01 <span>首頁</span></a>
        <a href={base+'articles/'} aria-current={route.startsWith('articles')?'page':undefined}>02 <span>文章</span></a>
        <a href={base+'about/'} aria-current={route==='about'?'page':undefined}>03 <span>關於</span></a>
      </nav>
      <div class="rail-bottom"><strong>FIELD / 2026</strong><p>沒有社群、訂閱或外部連結的假設定。正式網站可依需求配置。</p><a href={import.meta.env.BASE_URL+'layouts/'}>← 返回版型庫</a></div>
    </aside>
    <div class="body">
      <header class="top"><span>PRIVATE PUBLICATION / DEMO</span><span>繁體中文 · 靜態內容原型</span></header>
      {route==='' && <>
        <section class="intro"><p class="eyebrow">NOTEBOOK № 01 / HOME</p><h1>把日子記下來，<em>留待日後重讀。</em></h1><p class="lead">這裡不是媒體首頁，而是個人持續更新的筆記本。從一小段文字、一本書，或一件普通的小事開始。</p><a class="line-link" href={base+'articles/'}>翻閱全部文章 ↗</a></section>
        <section class="desk"><div class="desk-label"><p class="eyebrow">ON THE DESK</p><h2>最近的三則</h2><p>可以先用一篇文章開始，未完成的項目保留明確提示。</p></div><div class="entries">{articles.map(a=><article class="entry"><div class="meta">{a.id} / {a.date} / {a.tag}</div><h3>{a.href?<a href={a.href}>{a.title}</a>:a.title}</h3><p>{a.summary}</p>{!a.href&&<small>僅為示範標題，尚無全文</small>}</article>)}</div></section>
        <section class="signature"><span class="eyebrow">A SMALL INTRODUCTION</span><p>文字不需要先成為宏大的作品，才值得被保存。</p><a href={base+'about/'}>關於這本手記 →</a></section>
      </>}
      {route==='articles' && <><section class="pagehead"><p class="eyebrow">ALL NOTES / 01–03</p><h1>文章索引</h1><p>以日期與主題排列的個人文章，不靠大量封面圖或複雜分類才能成立。</p></section><div class="archive">{articles.map(a=><article><span class="meta">{a.date}<br/>{a.tag}</span><div><h2>{a.href?<a href={a.href}>{a.title} ↗</a>:a.title}</h2><p>{a.summary}</p>{!a.href&&<small>尚未撰寫全文</small>}</div></article>)}</div></>}
      {route==='articles/first-note' && <><article class="reading"><p class="eyebrow">01 / OBSERVATION · 2026-10-14</p><h1>從日常的小事開始記錄</h1><p class="lead">示範文章：展示窄欄閱讀、側欄索引與正文節奏；內容並非作者的真實經歷。</p><div class="prose"><p>有時候，一篇文章只是注意到一件過去沒有察覺的小事。與其急著提出結論，不如先記下當時看見的細節。</p><h2>留下線索</h2><p>把觀察放進自己的語言裡，加入日期與主題，往後就能從同一個問題再次出發。</p><blockquote>筆記的價值，不一定是答案；也可能是讓問題有地方生長。</blockquote><h2>下一次再讀</h2><p>這篇示範沒有留言後端、虛構閱讀數字或訂閱成功訊息。正式文章會由既有 Astro 內容系統提供。</p></div><a class="line-link" href={base+'articles/'}>← 回文章索引</a></article></>}
      {route==='about' && <><section class="pagehead"><p class="eyebrow">AUTHOR / ABOUT</p><h1>這是一位作者的空間。</h1><p>這是個人網站版型示範，不以不存在的人名、資歷或社群數字冒充真實人物。</p></section><section class="about-grid"><div class="initial" aria-label="尚未配置作者照片">照片<br/>選填</div><div><h2>寫作從哪裡開始？</h2><p>可以從生活記錄、專業心得或閱讀筆記開始，慢慢建立自己的文章分類。</p><h2>如何持續整理？</h2><p>把文章交給既有的 Astro Content Collections 管理；這套原型不建立重複的搜尋或內容資料庫。</p><a class="line-link" href={base+'articles/'}>看看筆記 →</a></div></section></>}
      <footer>側欄日誌 / 結構設計原型 <a href={base}>回首頁 ↑</a></footer>
    </div>
  </div>
</main>
</DirectionLayout>
<style>
.journal{--j-ink:#242a24;--j-muted:#58645a;--j-rule:#c6c8bc;background:#f4f1e8;color:var(--j-ink);font-family:'Noto Sans TC',system-ui,sans-serif;line-height:1.85;min-height:100vh}.journal a{color:inherit;text-decoration:none}.journal a:hover{text-decoration:underline;text-underline-offset:5px}.frame{max-width:1360px;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) 280px;min-height:100vh}.rail{grid-column:2;grid-row:1;border-left:1px solid var(--j-ink);padding:48px 32px;position:sticky;top:0;align-self:start;height:100vh;display:flex;flex-direction:column}.brand{font-size:24px;font-weight:700;line-height:1.4}.brand span{display:block;font:12px ui-monospace,monospace;letter-spacing:.08em;margin-top:8px}.rail-intro{font-size:16px;max-width:20ch;margin:64px 0}.rail nav{display:grid}.rail nav a{border-top:1px solid var(--j-rule);padding:16px 0;display:flex;gap:24px;font:14px ui-monospace,monospace;min-height:56px}.rail nav a span{font:16px 'Noto Sans TC',sans-serif}.rail nav a[aria-current]{font-weight:700}.rail-bottom{margin-top:auto;font-size:13px;line-height:1.8}.rail-bottom strong,.eyebrow,.meta,.top{font:12px ui-monospace,monospace;letter-spacing:.06em}.rail-bottom a{display:inline-flex;min-height:44px;align-items:center}.body{grid-column:1;grid-row:1;min-width:0;padding:0 64px}.top{padding:24px 0;border-bottom:1px solid var(--j-rule);display:flex;justify-content:space-between;gap:24px}.intro{padding:96px 0 128px;max-width:800px}.eyebrow,.meta{color:var(--j-muted)}h1,h2,h3,p{overflow-wrap:anywhere}h1{font:400 clamp(44px,5vw,76px)/1.22 Georgia,'Noto Serif TC',serif;letter-spacing:-.025em;text-wrap:balance;margin:32px 0}h1 em{display:block;font-style:normal;color:#355747}.lead{font-size:20px;max-width:34ch}.line-link{display:inline-flex;align-items:center;min-height:44px;border-bottom:1px solid currentColor;margin-top:24px}.desk{display:grid;grid-template-columns:minmax(150px,1fr) minmax(0,2fr);gap:48px;border-top:1px solid var(--j-ink);padding:64px 0 96px}.desk-label h2{font:400 32px Georgia,'Noto Serif TC',serif}.desk-label p{max-width:25ch}.entry{padding:24px 0 32px;border-bottom:1px solid var(--j-rule)}.entry:first-child{padding-top:0}.entry h3{font:400 clamp(24px,3vw,36px)/1.3 Georgia,'Noto Serif TC',serif;margin:16px 0}.entry p{max-width:52ch}.entry small,.archive small{color:var(--j-muted)}.signature{background:#e7ece5;padding:48px;margin-bottom:96px}.signature>p{font:400 clamp(24px,3vw,40px)/1.5 Georgia,'Noto Serif TC',serif;max-width:26ch}.pagehead{padding:80px 0 64px;max-width:760px}.pagehead>p:last-child{font-size:18px;max-width:50ch}.archive article{display:grid;grid-template-columns:110px minmax(0,1fr);gap:32px;padding:32px 0;border-top:1px solid var(--j-rule)}.archive h2{font:400 clamp(24px,3vw,36px) Georgia,'Noto Serif TC',serif;margin:0}.archive p{max-width:60ch}.reading{padding:80px 0 96px;max-width:780px}.reading h1{font-size:clamp(40px,5vw,68px)}.prose{max-width:65ch;margin:64px 0;font-size:18px;line-height:1.95}.prose h2{font:400 32px Georgia,'Noto Serif TC',serif;margin-top:64px}.prose blockquote{margin:48px 0;border-left:2px solid #355747;padding-left:24px;font:italic 24px/1.7 Georgia,'Noto Serif TC',serif}.about-grid{display:grid;grid-template-columns:1fr 2fr;gap:64px;padding:32px 0 96px}.initial{background:#e7ece5;min-height:320px;display:grid;place-content:center;text-align:center;color:var(--j-muted)}.about-grid h2{font:400 32px Georgia,'Noto Serif TC',serif}.about-grid p{max-width:55ch}.body footer{border-top:1px solid var(--j-rule);padding:32px 0 64px;display:flex;gap:24px;flex-wrap:wrap;justify-content:space-between;font-size:14px}@media(max-width:980px){.frame{grid-template-columns:minmax(0,1fr) 220px}.rail{padding:32px 24px}.body{padding:0 32px}.desk{gap:24px}}@media(max-width:700px){.frame{display:block}.rail{grid-column:auto;grid-row:auto;position:static;height:auto;border-left:0;border-bottom:1px solid var(--j-ink);padding:24px 20px}.rail-intro,.rail-bottom{display:none}.rail nav{display:flex;flex-wrap:wrap;gap:16px;margin-top:16px}.rail nav a{border:0;padding:0;min-height:44px}.rail nav a span{font-size:16px}.body{grid-column:auto;grid-row:auto;padding:0 20px}.top{padding:16px 0;flex-wrap:wrap}.intro{padding:64px 0 96px}.desk{display:block;padding:40px 0 64px}.desk-label{margin-bottom:40px}.signature{margin:0 0 64px;padding:24px}.pagehead,.reading{padding:48px 0}.archive article{grid-template-columns:68px minmax(0,1fr);gap:16px}.about-grid{display:block}.initial{min-height:200px;margin-bottom:32px}.prose{font-size:17px}}
</style>