---
import DirectionLayout from '../../../layouts/DirectionLayout.astro';
import {getDirectionContent} from '../../../data/art-direction-content';
export function getStaticPaths(){return [{params:{page:undefined}},{params:{page:'services'}},{params:{page:'services/individual'}},{params:{page:'about'}}];}
const page=Astro.params.page??'';
const root=import.meta.env.BASE_URL+'layouts/portrait-profile/';
const pageContentIntro=site.headline;
const title=page==='services'?'服務總覽':page==='services/individual'?'個別服務詳情':page==='about'?'關於':'人物名片';
const site=getDirectionContent('portrait-profile','helper',root,'services/individual/');
const facts=[['服務對象',site.primary?.fit??'待設定'],['服務形式',site.primary?.format??'待設定'],['服務時間與費用',site.primary?.duration+'／'+site.primary?.price],['專業資格及可查證來源',site.primary?.credential??'尚未核實'],['聯絡與預約','尚未配置有效管道']];
---
<DirectionLayout title={title+'｜人物名片原型'} description="人物介紹為主角的個人專業服務網站，包含服務及About內頁">
<main id="main" class="profile">
 <div class="content-contract" data-layout-content="portrait-profile" aria-label="可編輯網站資料"><span>{site.siteName}</span><span>{site.intro}</span><a href={root+'about/'}>關於本站</a></div><header class="header"><a class="brand" href={root}>人的專業空間 <small>PORTRAIT / PROTOTYPE</small></a><nav aria-label="主要導覽"><a href={root}>首頁</a><a href={root+'services/'}>服務說明</a><a href={root+'about/'}>關於</a><a href={import.meta.env.BASE_URL+'layouts/'}>版型庫 ↗</a></nav></header>
 {page===''&&<>
 <section class="hero"><div class="picture"><span>PORTRAIT</span><strong class="initial-mark" aria-hidden="true">人</strong><b>個人照片選填</b><small>明確示意，不是真實人物</small></div><div class="identity"><span class="label">PERSON FIRST / SERVICE SECOND</span><h1>先認識這個人，<em>再了解他的工作。</em></h1><p class="lead">人物、工作取向與服務界線是首頁重心。這裡不虛構姓名、證照、經驗、見證或預約成功。</p><a class="cta" href={root+'about/'}>先認識我 ↗</a><a class="textlink" href={root+'services/'}>了解服務方式 →</a></div></section>
 <section class="statement"><p class="label">01 / APPROACH</p><h2>專業如何被理解，從清楚的介紹開始。</h2><p>正式網站以本人真實專業經驗、能提供的服務與清楚界線填寫，不使用空泛療效承諾。</p></section>
 <section class="steps"><div><p class="label">02 / BEFORE CONTACT</p><h2>第一次接觸之前</h2></div><div>{[['閱讀服務範圍','確認是否符合需求，了解哪些事情不在服務範圍。'],['核對實際資料','資格、形式、費用及取消規則須有真實來源。'],['再選擇聯絡方式','確認正式管道完成設定後才展示可使用的按鈕。']].map(([name,desc],i)=><article><b>0{i+1}</b><div><h3>{name}</h3><p>{desc}</p></div></article>)}</div></section>
 <section class="end"><p class="label">SERVICE / NEXT</p><h2>只有一項服務，也能清楚介紹。</h2><a class="cta" href={root+'services/'}>閱讀服務資訊 ↗</a></section>
 </>}
 {page==='services'&&<><section class="pagehead"><p class="label">SERVICES / OVERVIEW</p><h1>服務說明。</h1><p class="lead">本原型只展示一個服務條目，不為了填滿版面虛構三種專業服務。</p></section><section class="service"><span class="label">01 / SERVICE</span><div><h2>個別專業服務</h2><p>實際名稱、適合對象與方法待填；示範的是資訊結構而非已提供的諮商或治療。</p><a class="textlink" href={root+'services/individual/'}>查看詳細頁 →</a></div></section><section class="facts"><h2>應公開的基本資訊</h2><dl>{facts.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></section></>}
 {page==='services/individual'&&<><section class="pagehead"><p class="label">SERVICE / DETAIL</p><h1>個別專業服務。</h1><p class="lead">讓讀者理解範圍、限制、形式、費用及下一步；不宣稱已啟用預約。</p></section><div class="detail"><aside><span class="label">本頁目錄</span><a href="#fit">適合與限制</a><a href="#terms">必要資訊</a><a href="#contact">下一步</a></aside><div><section id="fit"><h2>先確認服務是否適合</h2><div class="pair"><div><h3>適合誰</h3><p>依真實服務範圍填入，不能預設任何專業資格。</p></div><div><h3>不適合與界線</h3><p>待由真實提供者核實。緊急危機需求應使用當地正式緊急服務。</p></div></div></section><section id="terms"><h2>合作資訊</h2><dl>{facts.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></section><section id="contact"><h2>由訪客決定下一步</h2><p>沒有配置有效聯絡平台，本頁不顯示假表單或預約成功。</p><a class="textlink" href={root+'services/'}>← 回服務總覽</a></section></div></div></>}
 {page==='about'&&<><section class="about"><div><p class="label">ABOUT / PERSON</p><h1>認識專業背後的人。</h1><p class="lead">本頁的姓名、專長、資格與照片全部待設定，不以匿名的虛構故事製造信任。</p></div><div class="picture"><span>OPTIONAL IMAGE</span><strong>真實照片<br/>待配置</strong></div></section><section class="biography"><div><p class="label">MY PRACTICE</p><h2>如何工作，比頭銜更值得清楚說明。</h2></div><div><h3>工作方式</h3><p>可由本人填寫真實的服務理念、工作流程與專業界線。</p><h3>背景與資格</h3><p>應填入可驗證的資格名稱、證照資訊及來源；沒有就明示待填。</p><h3>聯絡安排</h3><p>正式聯絡管道尚未配置。</p><a class="textlink" href={root+'services/'}>理解服務內容 →</a></div></section></>}
 <footer><strong>人的專業空間</strong><span>設計原型｜非真實執業者或可預約服務</span><a href={root}>回首頁 ↑</a><p>本網站不是緊急支援管道；立即危險時請使用所在地正式緊急服務。</p></footer>
</main>
</DirectionLayout>
<style>
.profile{--ink:#242a24;--line:#c6c8bc;--paper:#f4f1e8;--soft:#e7ece5;background:var(--paper);color:var(--ink);font-family:'Noto Sans TC',system-ui,sans-serif;line-height:1.85;min-height:100vh}.profile a{color:inherit;text-decoration:none}.profile a:hover{text-decoration:underline;text-underline-offset:4px}.header,.hero,.statement,.steps,.end,.pagehead,.service,.facts,.detail,.about,.biography,footer{padding-inline:max(24px,calc((100% - 1200px)/2))}.header{display:flex;justify-content:space-between;align-items:center;gap:24px;border-bottom:1px solid var(--line);min-height:112px}.brand{font:400 24px Georgia,'Noto Serif TC',serif}.brand small{display:block;font:12px ui-monospace,monospace}.header nav{display:flex;gap:16px 32px;flex-wrap:wrap}.header nav a{display:inline-flex;align-items:center;min-height:44px}.hero{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,7fr);gap:clamp(32px,6vw,96px);align-items:center;padding-block:64px 96px}.picture{min-height:480px;padding:32px;background:var(--soft);display:flex;flex-direction:column;justify-content:space-between;color:#355747;position:relative}.picture:after{position:absolute;content:'';inset:16px;border:1px solid #aab9ac;pointer-events:none}.picture span,.picture small,.label{font:12px ui-monospace,monospace;letter-spacing:.06em}.picture strong{font:400 clamp(32px,4vw,56px)/1.3 Georgia,'Noto Serif TC',serif;text-align:center}.profile h1{font:400 clamp(40px,5vw,76px)/1.2 Georgia,'Noto Serif TC',serif;letter-spacing:-.025em;text-wrap:balance}.profile h1 em{display:block;font-style:normal;color:#355747}.profile h2{font:400 clamp(32px,4vw,48px)/1.3 Georgia,'Noto Serif TC',serif}.profile h3{font-size:20px}.lead{font-size:20px;max-width:45ch}.cta,.textlink{min-height:48px;display:inline-flex;align-items:center;margin:16px 20px 0 0}.cta{background:var(--ink);color:var(--paper)!important;padding:12px 24px}.textlink{border-bottom:1px solid currentColor}.statement{background:var(--soft);padding-block:96px;display:grid;grid-template-columns:1fr 2fr 1fr;gap:32px}.statement h2{margin:0}.steps{padding-block:128px;display:grid;grid-template-columns:1fr 1.4fr;gap:64px}.steps article{display:grid;grid-template-columns:64px minmax(0,1fr);gap:24px;padding:24px 0;border-top:1px solid var(--line)}.steps article b{font:32px Georgia,serif}.steps article h3,.steps article p{margin:0}.end{padding-block:96px 128px;background:var(--soft)}.pagehead{padding-block:96px}.pagehead h1{max-width:14ch}.service{display:grid;grid-template-columns:1fr 2fr;gap:64px;padding-block:64px;border-top:1px solid var(--line)}.facts{padding-block:64px 96px;background:var(--soft)}.facts dl,.detail dl{max-width:850px}.facts dl>div,.detail dl>div{display:grid;grid-template-columns:220px minmax(0,1fr);gap:24px;padding:20px 0;border-bottom:1px solid var(--line)}dd{margin:0}dt{font-weight:700}.detail{display:grid;grid-template-columns:180px minmax(0,1fr);gap:64px;padding-block:64px 128px}.detail aside{align-self:start;position:sticky;top:24px;display:flex;flex-direction:column;gap:8px}.detail aside a{display:flex;align-items:center;min-height:44px}.detail section{padding-block:48px;scroll-margin-top:32px}.detail section+section{border-top:1px solid var(--line)}.pair{display:grid;grid-template-columns:1fr 1fr;gap:24px}.pair>div{background:var(--soft);padding:24px}.about{display:grid;grid-template-columns:1.2fr .8fr;gap:64px;padding-block:96px}.about .picture{min-height:420px}.biography{display:grid;grid-template-columns:1fr 1fr;gap:64px;padding-block:96px 128px;border-top:1px solid var(--line)}.biography p{font-size:18px}.profile footer{display:flex;gap:16px 32px;flex-wrap:wrap;align-items:center;padding-block:48px;border-top:1px solid var(--line);font-size:14px}.profile footer p{flex-basis:100%}.profile h1,.profile h2,.profile p,.profile dd{overflow-wrap:anywhere}@media(max-width:900px){.header{display:block;padding-block:24px}.header nav{margin-top:24px}.statement{grid-template-columns:1fr 2fr}.statement p:last-child{grid-column:2}}@media(max-width:700px){.hero,.statement,.steps,.service,.detail,.about,.biography{display:block}.hero{padding-block:32px 64px}.picture{min-height:320px}.hero .identity{padding-top:48px}.statement,.steps,.end,.pagehead,.about,.biography{padding-block:48px}.statement h2{margin-block:24px}.steps article{grid-template-columns:48px 1fr}.service{padding-block:48px}.detail aside{position:static;border-bottom:1px solid var(--line);padding-bottom:32px}.facts dl>div,.detail dl>div{display:block}.facts dt,.detail dt{margin-bottom:8px}.pair{display:block}.pair>div+div{margin-top:16px}.about .picture{margin-top:48px}.profile h1{font-size:clamp(40px,9vw,56px)}}
.initial-mark{font:400 clamp(88px,12vw,180px)/1 Georgia,'Noto Serif TC',serif;display:block;opacity:.45}.picture b{font-weight:500;letter-spacing:.04em}.picture:has(.initial-mark){align-items:center;text-align:center}.hero .picture{border:1px solid var(--line)}\n.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 system-ui,sans-serif;padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
</style>