---
import PrototypeNav from '../../../../components/art-direction/PrototypeNav.astro';
import DirectionLayout from '../../../../layouts/DirectionLayout.astro';
const root=import.meta.env.BASE_URL+'layouts/practice-compass/';
---
<DirectionLayout title="常見問題與使用界線｜服務羅盤" description="在決定是否聯絡之前，先了解網站能回答什麼、目前又有哪些資訊尚未提供。">
<main id="main" class="compass interior"><div class="shell"><PrototypeNav kind="helper" /><section class="hero"><span class="eyebrow">FAQ / NO FALSE PROMISES</span><h1>常見問題與使用界線</h1><p class="lead">在決定是否聯絡之前，先了解網站能回答什麼、目前又有哪些資訊尚未提供。</p><p class="demo">設計原型｜以下內容為示範，不代表真實服務或出版紀錄。</p></section><div class="page"><aside aria-label="本頁目錄"><span class="eyebrow">ON THIS PAGE</span><a href="#section-1">01 / 服務與預約</a><a href="#section-2">02 / 收費與資格</a><a href="#section-3">03 / 安全與隱私</a></aside><div class="content"><section id="section-1"><span class="eyebrow">01 / 服務與預約</span><h2>服務是否已可預約？</h2><details><summary>現在能直接預約嗎？</summary><p>不能。此網站目前只是設計原型，未配置第三方預約服務。</p></details><details><summary>有哪些服務形式？</summary><p>尚待實際服務者確認線上、實體、地區與提供方式。</p></details></section><section id="section-2"><span class="eyebrow">02 / 收費與資格</span><h2>費用、資格怎麼確認？</h2><details><summary>服務費用是多少？</summary><p>尚未提供真實價格，不應將示範數字誤當正式報價。</p></details><details><summary>資格與證照可在哪裡查詢？</summary><p>正式版需要提供可供核實的資格名稱與資料來源。本原型沒有提供這些資料。</p></details></section><section id="section-3"><span class="eyebrow">03 / 安全與隱私</span><h2>聯絡會不會留下個資？</h2><details><summary>這裡有收集資料的表單嗎？</summary><p>本原型沒有送出表單或聯絡後端。</p></details><details><summary>緊急狀況適合使用這裡嗎？</summary><p>不適合。本原型不提供即時危機處理，請使用所在地可信的緊急資源。</p></details><p><a href={root+'privacy/'}>閱讀隱私資訊 ↗</a></p></section></div></div><footer><a href={root}>← 返回服務羅盤首頁</a><span>PROTOTYPE · CONTENT TO BE VERIFIED</span></footer></div></main>
</DirectionLayout>
<style>
.interior{--ink:#243431;--tint:#315a50;--paper:#f7f5ed;color:var(--ink);background:var(--paper);min-height:100vh;font-family:Arial,'Noto Sans TC',sans-serif;line-height:1.85}.shell{width:min(100% - 40px,1250px);margin:auto}.interior a{color:inherit;text-decoration:none}.interior a:hover{text-decoration:underline;text-underline-offset:4px}.interior a:focus-visible{outline:3px solid var(--tint);outline-offset:3px}.interior header{display:flex;justify-content:space-between;gap:20px;align-items:center;min-height:84px;border-bottom:1px solid var(--ink)}.brand{font-weight:700;font-size:20px}.interior nav{display:flex;gap:20px;flex-wrap:wrap}.interior nav a{display:inline-flex;align-items:center;min-height:44px}.hero{padding:80px 0 72px;border-bottom:1px solid var(--ink)}.eyebrow{font:12px ui-monospace,monospace;letter-spacing:.1em;color:var(--tint)}.interior h1{text-wrap:balance;font:400 clamp(40px,6vw,76px) Georgia,'Noto Serif TC',serif;line-height:1.22;letter-spacing:-.02em;max-width:17ch}.lead{font-size:clamp(18px,2vw,24px);max-width:38ch}.demo{font-size:13px;color:var(--tint);border-left:3px solid var(--tint);padding-left:16px}.page{display:grid;grid-template-columns:180px minmax(0,1fr);gap:80px;padding:72px 0}.page aside{position:sticky;top:24px;align-self:start;display:flex;flex-direction:column;gap:12px}.page aside a{border-bottom:1px solid #bec4b8;padding:12px 0;min-height:44px}.content{min-width:0}.content section{padding:0 0 60px;scroll-margin-top:30px}.content section+section{padding-top:60px;border-top:1px solid #bec4b8}.content h2{font:400 clamp(30px,4vw,46px) Georgia,'Noto Serif TC',serif;line-height:1.3}.content p,.content li{font-size:18px;overflow-wrap:anywhere}.content :global(a){text-decoration:underline;text-underline-offset:5px}.content :global(ul){padding-left:24px}.content :global(li){margin:12px 0}.content :global(details){border-top:1px solid #bec4b8;padding:16px 0}.content :global(summary){cursor:pointer;font-weight:700;min-height:44px}.content :global(details:last-child){border-bottom:1px solid #bec4b8}.interior footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;border-top:1px solid var(--ink);padding:32px 0 64px;font-size:13px}@media(max-width:760px){.interior header{align-items:flex-start;flex-direction:column;padding:18px 0;gap:6px}.interior nav{gap:8px 20px}.hero{padding:48px 0}.page{display:block;padding:40px 0}.page aside{position:static;display:flex;flex-flow:row wrap;gap:8px 16px;padding-bottom:32px;margin-bottom:32px;border-bottom:1px solid #bec4b8}.page aside .eyebrow{flex-basis:100%}.page aside a{font-size:14px}.content section+section{padding-top:40px}.content section{padding-bottom:40px}}
</style>
