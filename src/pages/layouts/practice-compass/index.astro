---
import PrototypeNav from '../../../components/art-direction/PrototypeNav.astro';
import DirectionLayout from '../../../layouts/DirectionLayout.astro';
const base=import.meta.env.BASE_URL,root=base+'layouts/practice-compass/';
const paths=[{n:'01',title:'我想先看清楚自己的狀況',detail:'先了解哪些問題屬於服務範圍、哪些需要其他專業支持。',href:'#fit',cta:'查看適配範圍'},{n:'02',title:'我想知道合作怎麼進行',detail:'了解服務形式、必要揭露與第一次聯絡前應確認的事項。',href:root+'services/',cta:'閱讀服務說明'},{n:'03',title:'我還沒打算聯絡任何人',detail:'先閱讀常見問題與界線，不必留下任何個人資料。',href:root+'faq/',cta:'閱讀常見問題'}];
---
<DirectionLayout title="服務羅盤｜助人者原型" description="以訪客決策、適配與透明服務資訊設計的獨立 Astro 助人者網站原型">
<main id="main" class="compass">
<div class="shell">
<PrototypeNav kind="helper" />
<section class="hero"><p class="mono">00 / BEFORE ANY APPOINTMENT</p><div class="hero-grid"><div><p class="eyebrow">一份可以慢慢看的服務指南</p><h1>先知道自己<span>需要什麼支持，</span><em>再決定下一步。</em></h1></div><aside><p>好的助人者網站，不需要一開始就要求預約。先看提供什麼、不提供什麼，才能做知情選擇。</p><p class="disclaimer">設計原型：真實資格、時段、費用、聯絡方式尚未提供。</p><a class="button" href="#choose">從自己的問題開始 ↓</a></aside></div></section>
</div>
<section class="decision" id="choose"><div class="shell"><p class="mono">01 / VISITOR DECISIONS</p><h2>你現在比較接近哪一種情況？</h2><p>選擇只是閱讀入口，不收集資料，也不是診斷工具。</p>{paths.map(p=><article class="decision-row"><div class="num">{p.n}<small>PATH</small></div><div><h3>{p.title}</h3><p>{p.detail}</p></div><a href={p.href}>{p.cta} ↗</a></article>)}</div></section>
<div class="shell"><section class="fit" id="fit"><div><p class="mono">02 / SCOPE & BOUNDARIES</p><h2>適不適合，<em>比催促預約更重要。</em></h2><p>以下示範如何公開資訊，並不宣稱任何真實專業者提供服務。</p></div><div class="fit-grid"><article><h3>可用於初步整理的示範方向</h3><ul><li>認識不同支持方式與服務形式</li><li>釐清自己的生活或工作選擇</li><li>了解聯絡前的必要資訊</li></ul></article><article><h3>不應由此原型承接的需求</h3><ul><li>需要即時危機處理的狀況</li><li>診斷、治療、藥物或法律判斷</li><li>未經查核的療效、證照或成效承諾</li></ul></article></div></section><section class="information"><span class="mono">03 / OPEN INFORMATION</span><div><h2>服務流程，不該藏在預約按鈕後面。</h2><p>內容、時間、費用、資格、取消規則與聯絡方式，正式上線前必須逐一核實。</p></div><a href={root+'services/'}>閱讀完整服務資訊 ↗</a></section><section class="faq" id="faq"><div><p class="mono">04 / QUESTIONS</p><h2>先問清楚，也可以。</h2></div><div><details><summary>這個網站可以直接預約嗎？</summary><p>不能，這是獨立 Astro 原型，尚未配置任何正式預約工具。</p></details><details><summary>專業資格與服務費用在哪裡？</summary><p>請到服務說明查看目前標示「待核實、待設定」的資訊。原型不虛構資格或價格。</p></details><details><summary>急迫情況可以透過本頁得到支援嗎？</summary><p>不能。本網站不提供即時危機處理；請聯繫所在地可信任的緊急服務。</p></details></div></section><footer><div><strong>服務羅盤</strong><p>先理解，再選擇。</p></div><div><p>資格、價格、危機管道及預約服務均待正式核實。</p><a href={root+'privacy/'}>隱私資訊</a><a href={base+'layouts/'}>回到版型庫 ↑</a></div></footer></div></main>
</DirectionLayout>
<style>
.compass{background:#f7f5ed;color:#243431;font-family:Arial,'Noto Sans TC',sans-serif;line-height:1.8}.shell{width:min(100% - 40px,1250px);margin:auto}.compass a{color:inherit;text-decoration:none}.compass a:hover{text-decoration:underline;text-underline-offset:5px}.compass a:focus-visible,.compass summary:focus-visible{outline:3px solid #315a50;outline-offset:4px}.header{min-height:88px;border-bottom:1px solid #243431;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font-size:20px;font-weight:800}.brand small{display:block;font:12px ui-monospace,monospace}.header nav{display:flex;flex-wrap:wrap;gap:24px}.header nav a{min-height:44px;display:flex;align-items:center}.mono{font:12px ui-monospace,monospace;letter-spacing:.1em}.hero{padding:64px 0 96px}.hero-grid{display:grid;grid-template-columns:2fr 1fr;gap:64px;align-items:end}.eyebrow{color:#315a50}.compass h1{text-wrap:balance;font:400 clamp(44px,6.5vw,92px) Georgia,'Noto Serif TC',serif;line-height:1.18;letter-spacing:-.03em;margin:24px 0 0}.compass h1 span,.compass h1 em{display:block}.compass h1 em{color:#315a50}.hero aside{padding-left:32px;border-left:1px solid #b8c4bb}.hero aside>p:first-child{font-size:20px}.disclaimer{font-size:14px}.button{display:inline-flex;align-items:center;background:#315a50;color:#fff!important;padding:12px 24px;min-height:48px}.decision{background:#243431;color:#f7f5ed;padding:64px 0 80px}.decision h2,.fit h2,.faq h2{font:400 clamp(32px,4vw,54px) Georgia,'Noto Serif TC',serif;line-height:1.25}.decision-row{display:grid;grid-template-columns:100px 1fr 210px;gap:32px;align-items:center;border-top:1px solid #85938c;padding:32px 0}.decision-row:first-of-type{margin-top:48px}.num{font:36px Georgia,serif}.num small{display:block;font:12px ui-monospace,monospace}.decision-row h3{font-size:24px;font-weight:500;margin:0}.decision-row p{font-size:16px;color:#d8dfd9}.decision-row>a{border:1px solid #ced8d0;min-height:48px;display:flex;align-items:center;justify-content:center;padding:8px}.fit{padding:112px 0;display:grid;grid-template-columns:1fr 1.5fr;gap:48px}.fit h2 em{color:#315a50}.fit-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.fit-grid article{background:#e7ece5;border-top:4px solid #315a50;padding:24px}.fit-grid article:last-child{background:#eee7df;border-color:#78594b}.fit-grid li{margin:16px 0}.fit-grid h3{font-size:20px}.information{display:grid;grid-template-columns:140px 1fr 220px;gap:32px;align-items:center;border-block:1px solid #243431;padding:64px 0}.information h2{font:400 36px Georgia,'Noto Serif TC',serif}.information>a{border-bottom:1px solid #315a50;padding-bottom:12px}.faq{padding:112px 0;display:grid;grid-template-columns:1fr 1.5fr;gap:48px}.faq details{border-top:1px solid #b8c4bb;padding:24px 0}.faq details:last-child{border-bottom:1px solid #b8c4bb}.faq summary{min-height:44px;font-size:18px;font-weight:700;cursor:pointer}.compass footer{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;border-top:1px solid #b8c4bb;background:#e7ece5;padding:48px}.compass footer strong{font:36px Georgia,'Noto Serif TC',serif}@media(max-width:950px){.header{flex-wrap:wrap;padding:20px 0}.hero-grid{gap:24px}.decision-row{grid-template-columns:64px 1fr;gap:16px}.decision-row>a{grid-column:2}.fit{display:block}.fit-grid{margin-top:32px}.information{grid-template-columns:1fr 2fr}.information>a{grid-column:2}.faq{gap:24px}}@media(max-width:700px){.hero{padding:40px 0 64px}.hero-grid{display:block}.compass h1{font-size:clamp(40px,10vw,60px)}.hero aside{border-left:0;border-top:1px solid #b8c4bb;padding:24px 0 0;margin-top:32px}.decision{padding:48px 0}.decision-row h3{font-size:20px}.fit{padding:64px 0}.fit-grid{grid-template-columns:1fr}.information{display:block;padding:48px 0}.information>a{display:inline-block;margin-top:24px}.faq{display:block;padding:64px 0}.faq details:first-child{margin-top:32px}.compass footer{padding:32px 0}}
</style>