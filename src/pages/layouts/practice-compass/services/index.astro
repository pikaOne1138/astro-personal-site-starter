---
import PrototypeNav from '../../../../components/art-direction/PrototypeNav.astro';
import DirectionLayout from '../../../../layouts/DirectionLayout.astro';
const root=import.meta.env.BASE_URL+'layouts/practice-compass/';
const rows=[['服務範圍','待由真實服務提供者確認，不能以示範敘述冒充醫療或諮商服務'],['資格與證照','待核實：姓名、資格名稱、可查詢資料'],['服務形式','待設定：實體、線上或其他形式'],['時間與費用','待設定：時長、價格、取消與退款規則'],['聯絡方式','尚未配置真實聯絡、預約或表單服務']];
const steps=[['確認服務是否適合','先檢視服務範圍與必要的專業界線。'],['核實實際資訊','確認費用、形式、資格、保密與取消規則。'],['使用正式聯絡管道','待正式配置後才能提供聯絡入口；原型不收件。']];
---
<DirectionLayout title="服務說明｜服務羅盤" description="以服務範圍、資格揭露、合作流程與知情選擇設計的內頁">
<main id="main" class="service"><PrototypeNav kind="helper" />
<section class="hero"><p class="mono">TRANSPARENT SERVICES / DESIGN PROTOTYPE</p><h1>先了解範圍，<em>再討論可能性。</em></h1><p>看過服務形式與界線後再決定是否聯絡。這些欄位不代表真實機構、專業者或目前提供的服務。</p><a href="#information">查看必要資訊 ↓</a></section>
<div class="body"><aside><p class="mono">READ THIS FIRST</p><p>本頁是原型，資格、費用與預約皆尚未設定。</p></aside><div><section id="information"><p class="mono">01 / DISCLOSURE LEDGER</p><h2>公開需要確認的資訊。</h2><dl>{rows.map(([label,detail])=><div><dt>{label}</dt><dd>{detail}</dd></div>)}</dl></section><section id="process"><p class="mono">02 / CONTACT PATH</p><h2>聯絡之前的三個步驟。</h2><ol>{steps.map(([title,detail],i)=><li><strong>{String(i+1).padStart(2,'0')}</strong><div><h3>{title}</h3><p>{detail}</p></div></li>)}</ol></section><section class="ending"><h2>尚未啟用預約服務。</h2><p>完成真實資料核實及第三方工具設定後，才能提供聯絡入口。急迫或危機需求請使用所在地可信緊急管道。</p><a href={root}>← 返回首頁</a></section></div></div><footer><a href={root}>服務羅盤 / 首頁 ↑</a></footer></main>
</DirectionLayout>
<style>
.service{background:#f7f5ed;color:#243431;min-height:100vh;padding:0 max(20px,calc((100% - 1250px)/2));font-family:Arial,'Noto Sans TC',sans-serif;line-height:1.8}.service a{color:inherit;text-decoration:none}.service a:hover{text-decoration:underline}.service a:focus-visible{outline:3px solid #315a50;outline-offset:4px}.service header{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;padding:24px 0;border-bottom:1px solid #243431}.service nav{display:flex;flex-wrap:wrap;gap:24px}.service nav a{min-height:44px;display:flex;align-items:center}.mono{font:12px ui-monospace,monospace;letter-spacing:.1em;color:#315a50}.hero{padding:64px 0 96px;display:grid;grid-template-columns:1.5fr 1fr;gap:24px 64px}.hero>.mono{grid-column:1/-1}.service h1{font:400 clamp(44px,6vw,88px) Georgia,'Noto Serif TC',serif;line-height:1.2;margin:0}.service h1 em{display:block;color:#315a50}.hero>p:not(.mono){font-size:18px;max-width:38ch}.hero>a{grid-column:2;min-height:44px}.body{border-top:1px solid #243431;padding:64px 0;display:grid;grid-template-columns:220px minmax(0,780px);gap:64px}.body aside{font-size:14px}.body h2{font:400 clamp(32px,4vw,48px) Georgia,'Noto Serif TC',serif}.body dl>div{display:grid;grid-template-columns:150px 1fr;gap:24px;padding:24px 0;border-bottom:1px solid #b8c4bb}.body dt{font-weight:700}.body dd{margin:0}.body section+section{margin-top:80px}.body ol{padding:0;list-style:none}.body li{display:grid;grid-template-columns:60px 1fr;gap:24px;padding:24px 0;border-top:1px solid #b8c4bb}.body li strong{font:32px Georgia,serif}.body h3{margin:0}.ending{background:#e7ece5;padding:32px}.ending a{display:inline-block;min-height:44px;border-bottom:1px solid #315a50}.service footer{border-top:1px solid #243431;padding:32px 0 64px}@media(max-width:760px){.hero{display:block;padding:48px 0}.service h1{font-size:44px}.hero>p:not(.mono){margin:32px 0}.body{display:block;padding:40px 0}.body aside{border-bottom:1px solid #b8c4bb;margin-bottom:40px}.body dl>div{display:block}.body dt{margin-bottom:8px}}
</style>