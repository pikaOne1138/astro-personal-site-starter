---
import PrototypeNav from '../../../../components/art-direction/PrototypeNav.astro';
import DirectionLayout from '../../../../layouts/DirectionLayout.astro';
const root=import.meta.env.BASE_URL+'layouts/practice-compass/';
---
<DirectionLayout title="隱私資訊與原型說明｜服務羅盤" description="清楚區分尚未收集個資的示範網站，與正式營運時需要公開的隱私政策。">
<main id="main" class="compass interior"><div class="shell"><PrototypeNav kind="helper" /><section class="hero"><span class="eyebrow">PRIVACY / PROTOTYPE</span><h1>隱私資訊與原型說明</h1><p class="lead">清楚區分尚未收集個資的示範網站，與正式營運時需要公開的隱私政策。</p><p class="demo">設計原型｜以下內容為示範，不代表真實服務或出版紀錄。</p></section><div class="page"><aside aria-label="本頁目錄"><span class="eyebrow">ON THIS PAGE</span><a href="#section-1">01 / 目前狀態</a><a href="#section-2">02 / 正式上線前</a><a href="#section-3">03 / 其他服務</a></aside><div class="content"><section id="section-1"><span class="eyebrow">01 / 目前狀態</span><h2>未配置聯絡或預約表單</h2><p>這是靜態網站原型，本站沒有自行建立資料提交後端。本段不代表部署平台、第三方嵌入工具或瀏覽器本身不會處理任何技術資料。</p></section><section id="section-2"><span class="eyebrow">02 / 正式上線前</span><h2>需要補齊的說明</h2><ul><li>實際資料控制者與聯絡方式</li><li>所蒐集資料類型與目的</li><li>第三方預約或表單的資料處理與保留方式</li><li>刪除、更正與其他權利的聯絡管道</li></ul></section><section id="section-3"><span class="eyebrow">03 / 其他服務</span><h2>不以模板替代法律判斷</h2><p>網站營運者應依實際業務及所在地適用規定撰寫政策。第三方工具啟用後，必須同步更新本頁。</p></section></div></div><footer><a href={root}>← 返回服務羅盤首頁</a><span>PROTOTYPE · CONTENT TO BE VERIFIED</span></footer></div></main>
</DirectionLayout>
<style>
.interior{--ink:#243431;--tint:#315a50;--paper:#f7f5ed;color:var(--ink);background:var(--paper);min-height:100vh;font-family:Arial,'Noto Sans TC',sans-serif;line-height:1.85}.shell{width:min(100% - 40px,1120px);margin:auto}.interior a{color:inherit;text-decoration:none}.interior a:hover{text-decoration:underline;text-underline-offset:4px}.interior a:focus-visible{outline:3px solid var(--tint);outline-offset:3px}.interior header{display:flex;justify-content:space-between;gap:20px;align-items:center;min-height:84px;border-bottom:1px solid var(--ink)}.brand{font-weight:700;font-size:20px}.interior nav{display:flex;gap:20px;flex-wrap:wrap}.interior nav a{display:inline-flex;align-items:center;min-height:44px}.hero{padding:80px 0 72px;border-bottom:1px solid var(--ink)}.eyebrow{font:12px ui-monospace,monospace;letter-spacing:.1em;color:var(--tint)}.interior h1{text-wrap:balance;font:400 clamp(40px,6vw,76px) Georgia,'Noto Serif TC',serif;line-height:1.22;letter-spacing:-.02em;max-width:17ch}.lead{font-size:clamp(18px,2vw,24px);max-width:38ch}.demo{font-size:13px;color:var(--tint);border-left:3px solid var(--tint);padding-left:16px}.page{display:grid;grid-template-columns:180px minmax(0,1fr);gap:80px;padding:72px 0}.page aside{position:sticky;top:24px;align-self:start;display:flex;flex-direction:column;gap:12px}.page aside a{border-bottom:1px solid #bec4b8;padding:12px 0;min-height:44px}.content{min-width:0}.content section{padding:0 0 60px;scroll-margin-top:30px}.content section+section{padding-top:60px;border-top:1px solid #bec4b8}.content h2{font:400 clamp(30px,4vw,46px) Georgia,'Noto Serif TC',serif;line-height:1.3}.content p,.content li{font-size:18px;overflow-wrap:anywhere}.content :global(a){text-decoration:underline;text-underline-offset:5px}.content :global(ul){padding-left:24px}.content :global(li){margin:12px 0}.content :global(details){border-top:1px solid #bec4b8;padding:16px 0}.content :global(summary){cursor:pointer;font-weight:700;min-height:44px}.content :global(details:last-child){border-bottom:1px solid #bec4b8}.interior footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;border-top:1px solid var(--ink);padding:32px 0 64px;font-size:13px}@media(max-width:760px){.interior header{align-items:flex-start;flex-direction:column;padding:18px 0;gap:6px}.interior nav{gap:8px 20px}.hero{padding:48px 0}.page{display:block;padding:40px 0}.page aside{position:static;display:flex;flex-flow:row wrap;gap:8px 16px;padding-bottom:32px;margin-bottom:32px;border-bottom:1px solid #bec4b8}.page aside .eyebrow{flex-basis:100%}.page aside a{font-size:14px}.content section+section{padding-top:40px}.content section{padding-bottom:40px}}
</style>
