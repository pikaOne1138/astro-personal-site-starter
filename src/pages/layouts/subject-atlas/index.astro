---
import PrototypeNav from '../../../components/art-direction/PrototypeNav.astro';
import DirectionLayout from '../../../layouts/DirectionLayout.astro';
import {atlasTopics, atlasEntries} from '../../../data/subject-atlas';
const base=import.meta.env.BASE_URL;
const root=base+'layouts/subject-atlas/';
const topics=atlasTopics;
---
<DirectionLayout title="主題標本室｜知識型網站" description="以主題索引、檔案與文章關係為主體的獨立 Astro 原型">
<main id="main" class="atlas">
<div class="shell">
<PrototypeNav kind="knowledge" />
<section class="hero"><p class="mono">PERSONAL KNOWLEDGE LIBRARY / AN OPEN INDEX</p><div class="hero-grid"><div><span>不是一篇接著一篇，而是找到內容彼此連結的位置。</span><h1>把想法，<em>放回相互連結的位置。</em></h1></div><aside><div class="count"><strong>04</strong>主題入口</div><p>這裡不是依日期推送的文章牆。先找到自己在意的問題，再沿著筆記一路閱讀。</p><a class="action" href="#directory">打開主題索引 ↓</a><p class="note">8 個示範條目，僅 1 篇有示範全文。</p></aside></div></section>
<div class="columns"><aside class="rail" aria-label="主題快速導航"><p class="mono">INDEX / TOPICS</p>{topics.map(t=><a href={'#topic-'+t.id}><span>{t.id}</span>{t.name}</a>)}</aside><div class="body"><section id="directory"><p class="mono">01 / TOPIC DIRECTORY</p><h2>循著主題，而不是時間。</h2><div class="topics">{topics.map((t,i)=><article class:list={['topic',{'lead-topic':i===0}]} id={'topic-'+t.id}><div class="top"><span>{t.id} / {t.en}</span><span>{String(t.notes.length).padStart(2,'0')} ENTRIES</span></div><h3>{t.name}</h3><a class="action" href={root+'topics/'+t.slug+'/'}>探索{t.name}主題 ↗</a><ol>{t.notes.map((n,j)=><li><span>{String(j+1).padStart(2,'0')}</span>{atlasEntries.find(e=>e.title===n)?.articleSlug ? <a href={root+'articles/sample/'}>{n} ↗</a> : <span>{n}<small class="entry-status">標題示意・尚無全文</small></span>}</li>)}</ol></article>)}</div></section><section class="latest" id="latest"><div><p class="mono">02 / MOST RECENT NOTE</p><h2>最近新增的線索。</h2></div><div><span class="mono">METHOD / DEMO ARTICLE</span><h3>怎麼建立一份真正有用的主題索引？</h3><p>內容越多，最重要的問題可能不是新增了多少，而是讀者能否再次找到需要的文章。</p><a class="action" href={root+'articles/sample/'}>閱讀示範文章 ↗</a></div></section><section class="foot-cta" id="archive"><p>你不必從第一篇開始。</p><a class="action" href={root+'articles/'}>開啟完整檔案清單 ↗</a></section></div></div>
<footer><span>TOPIC ATLAS / STRUCTURE FIRST</span><span>示範排版，非真實出版內容</span><a href={base+'layouts/'}>版型庫 ↑</a></footer></div>
</main>
</DirectionLayout>
<style>
.entry-status{display:block;font-size:12px;color:#355747}.atlas{background:#f4f1e8;color:#242a24;min-height:100vh;font-family:Arial,'Noto Sans TC',sans-serif;line-height:1.8}.shell{width:min(100% - 40px,1320px);margin:auto}.atlas a{color:inherit;text-decoration:none}.atlas a:hover{text-decoration:underline;text-underline-offset:5px}.atlas a:focus-visible{outline:3px solid #355747;outline-offset:4px}.nav{display:flex;justify-content:space-between;align-items:center;min-height:80px;gap:24px;border-bottom:1px solid #242a24}.brand{font-size:20px;font-weight:bold}.brand small{display:block;font:12px ui-monospace,monospace;letter-spacing:.1em}.nav nav{display:flex;gap:24px;flex-wrap:wrap}.nav nav a{min-height:44px;display:flex;align-items:center}.mono,.top,footer{font:12px ui-monospace,monospace;letter-spacing:.1em}.hero{padding:64px 0 96px}.hero-grid{display:grid;grid-template-columns:minmax(0,3fr) minmax(250px,1fr);gap:64px;align-items:end}.hero-grid>div>span{color:#355747}.hero h1{text-wrap:balance;font:400 clamp(44px,7vw,104px) Georgia,'Noto Serif TC',serif;line-height:1.16;letter-spacing:-.035em;max-width:12em;margin:24px 0 0}.hero h1 em{display:block;color:#355747;font-weight:400}.hero aside{border-left:1px solid #c6c8bc;padding-left:32px}.count{display:flex;align-items:baseline;gap:16px}.count strong{font:90px Georgia,serif}.hero aside p{font-size:16px}.action{display:inline-block;border-bottom:1px solid currentColor;min-height:44px;padding:8px 0;font-weight:700}.note{font-size:13px!important}.columns{display:grid;grid-template-columns:160px minmax(0,1fr);gap:48px;border-top:1px solid #242a24}.rail{align-self:start;position:sticky;top:24px;padding:32px 0}.rail>a{display:flex;gap:20px;padding:12px 0;border-bottom:1px solid #c6c8bc;min-height:44px}.rail>a span{font:12px ui-monospace,monospace}.body{min-width:0;padding:32px 0}.atlas h2{font:400 clamp(30px,4vw,50px) Georgia,'Noto Serif TC',serif}.topics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid #c6c8bc;border-left:1px solid #c6c8bc}.topic{padding:32px;border-right:1px solid #c6c8bc;border-bottom:1px solid #c6c8bc;min-width:0}.lead-topic{grid-column:span 2;background:#e4e8de}.top{display:flex;justify-content:space-between;gap:16px}.topic h3{font:400 64px Georgia,'Noto Serif TC',serif;margin:24px 0}.topic ol{margin:0;padding:0;list-style:none}.topic li{display:grid;grid-template-columns:32px 1fr;gap:12px;padding:12px 0;border-top:1px solid #c6c8bc}.topic li>span{font:12px ui-monospace,monospace}.latest{display:grid;grid-template-columns:1fr 1.5fr;gap:48px;padding:48px;background:#355747;color:white;margin-top:64px}.latest h3{font:400 30px Georgia,'Noto Serif TC',serif}@media(min-width:701px) and (max-width:950px){.latest{grid-template-columns:1fr;padding:32px}}.foot-cta{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:64px 0}.foot-cta p{font:32px Georgia,'Noto Serif TC',serif}footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;padding:32px 0;border-top:1px solid #c6c8bc}@media(max-width:900px){.nav{flex-wrap:wrap;padding:20px 0}.hero-grid{gap:24px}.columns{grid-template-columns:110px minmax(0,1fr);gap:24px}.topic{padding:24px}}@media(max-width:700px){.hero{padding:40px 0}.hero-grid{display:block}.hero h1{font-size:clamp(40px,10vw,64px)}.hero aside{border-left:0;border-top:1px solid #c6c8bc;padding:24px 0 0;margin-top:32px}.count strong{font-size:64px}.columns{display:block}.rail{position:static;display:flex;flex-wrap:wrap;gap:12px}.rail p{width:100%}.rail>a{display:block}.topics{grid-template-columns:1fr}.lead-topic{grid-column:auto}.topic h3{font-size:50px}.latest{display:block;margin-top:40px;padding:32px}.foot-cta{padding:40px 0;display:block}}
</style>