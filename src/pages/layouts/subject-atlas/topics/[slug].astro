---
import DirectionLayout from '../../../../layouts/DirectionLayout.astro';
import PrototypeNav from '../../../../components/art-direction/PrototypeNav.astro';
import {atlasTopics, atlasEntries} from '../../../../data/subject-atlas';
export function getStaticPaths() { return atlasTopics.map(topic => ({params:{slug:topic.slug},props:{topic}})); }
const {topic} = Astro.props;
const root=import.meta.env.BASE_URL+'layouts/subject-atlas/';
const entries=atlasEntries.filter(entry=>entry.topic===topic.slug);
---
<DirectionLayout title={topic.name+'｜主題索引｜主題標本室'} description={'從'+topic.name+'主題進入示範知識地圖。'}>
<main id="main" class="atlas interior"><div class="shell"><PrototypeNav kind="knowledge" /><section class="hero"><span class="eyebrow">TOPIC {topic.id} / {topic.en}</span><h1>{topic.name}｜主題索引</h1><p class="lead">沿著同一個問題，探索不同的閱讀線索。</p><p class="demo">設計原型｜{entries.length} 個示範條目；僅標示「示範全文」的文章可閱讀。</p></section><div class="page"><aside aria-label="本頁目錄"><span class="eyebrow">ON THIS PAGE</span><a href="#section-1">01 / 閱讀路徑</a><a href="#section-2">02 / 相關主題</a><a href="#section-3">03 / 所有條目</a></aside><div class="content"><section id="section-1"><span class="eyebrow">01 / 閱讀路徑</span><h2>從一個問題開始</h2><p>以下是版型用的示範標題，不代表真實出版紀錄。</p><ul>{entries.map(entry=><li>{entry.articleSlug ? <a href={root+'articles/'+entry.articleSlug+'/'}>{entry.title}（示範全文）↗</a> : <span>{entry.title}<small>標題示意・尚無全文</small></span>}</li>)}</ul></section><section id="section-2"><span class="eyebrow">02 / 相關主題</span><h2>換一個角度探索</h2><p>以下為其他分類入口，不宣稱已建立文章關係網。</p><ul>{atlasTopics.filter(t=>t.slug!==topic.slug).map(t=><li><a href={root+'topics/'+t.slug+'/'}>{t.name}主題 ↗</a></li>)}</ul></section><section id="section-3"><span class="eyebrow">03 / 所有條目</span><h2>回到總檔案</h2><p><a href={root+'articles/'}>查看示範文章總目錄 ↗</a></p></section></div></div><footer><a href={root}>← 返回主題標本室首頁</a><span>PROTOTYPE · CONTENT TO BE VERIFIED</span></footer></div></main>
</DirectionLayout>
<style>
.content small{display:block;font-size:12px;color:var(--tint)}.content :global(a){display:inline-block;min-height:44px}.interior{--ink:#242a24;--tint:#355747;--paper:#f4f1e8;color:var(--ink);background:var(--paper);min-height:100vh;font-family:Arial,'Noto Sans TC',sans-serif;line-height:1.85}.shell{width:min(100% - 40px,1120px);margin:auto}.interior a{color:inherit;text-decoration:none}.interior a:hover{text-decoration:underline;text-underline-offset:4px}.interior a:focus-visible{outline:3px solid var(--tint);outline-offset:3px}.interior header{display:flex;justify-content:space-between;gap:20px;align-items:center;min-height:84px;border-bottom:1px solid var(--ink)}.brand{font-weight:700;font-size:20px}.interior nav{display:flex;gap:20px;flex-wrap:wrap}.interior nav a{display:inline-flex;align-items:center;min-height:44px}.hero{padding:80px 0 72px;border-bottom:1px solid var(--ink)}.eyebrow{font:12px ui-monospace,monospace;letter-spacing:.1em;color:var(--tint)}.interior h1{text-wrap:balance;font:400 clamp(40px,6vw,76px) Georgia,'Noto Serif TC',serif;line-height:1.22;letter-spacing:-.02em;max-width:17ch}.lead{font-size:clamp(18px,2vw,24px);max-width:38ch}.demo{font-size:13px;color:var(--tint);border-left:3px solid var(--tint);padding-left:16px}.page{display:grid;grid-template-columns:180px minmax(0,1fr);gap:80px;padding:72px 0}.page aside{position:sticky;top:24px;align-self:start;display:flex;flex-direction:column;gap:12px}.page aside a{border-bottom:1px solid #bec4b8;padding:12px 0;min-height:44px}.content{min-width:0}.content section{padding:0 0 60px;scroll-margin-top:30px}.content section+section{padding-top:60px;border-top:1px solid #bec4b8}.content h2{font:400 clamp(30px,4vw,46px) Georgia,'Noto Serif TC',serif;line-height:1.3}.content p,.content li{font-size:18px;overflow-wrap:anywhere}.content :global(a){text-decoration:underline;text-underline-offset:5px}.content :global(ul){padding-left:24px}.content :global(li){margin:12px 0}.content :global(details){border-top:1px solid #bec4b8;padding:16px 0}.content :global(summary){cursor:pointer;font-weight:700;min-height:44px}.content :global(details:last-child){border-bottom:1px solid #bec4b8}.interior footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;border-top:1px solid var(--ink);padding:32px 0 64px;font-size:13px}@media(max-width:760px){.interior header{align-items:flex-start;flex-direction:column;padding:18px 0;gap:6px}.interior nav{gap:8px 20px}.hero{padding:48px 0}.page{display:block;padding:40px 0}.page aside{position:static;display:flex;flex-flow:row wrap;gap:8px 16px;padding-bottom:32px;margin-bottom:32px;border-bottom:1px solid #bec4b8}.page aside .eyebrow{flex-basis:100%}.page aside a{font-size:14px}.content section+section{padding-top:40px}.content section{padding-bottom:40px}}
</style>
