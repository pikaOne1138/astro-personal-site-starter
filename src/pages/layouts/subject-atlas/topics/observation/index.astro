---
import DirectionLayout from '../../../../../layouts/DirectionLayout.astro';
const root=import.meta.env.BASE_URL+'layouts/subject-atlas/';
---
<DirectionLayout title="觀察｜主題索引｜主題標本室" description="沿著同一個問題，閱讀不同時間留下的觀察。">
<main id="main" class="atlas interior"><div class="shell"><header><a class="brand" href={root}>◎ 主題標本室</a><nav aria-label="內頁導覽"><a href={root}>首頁</a><a href={root+'topics/observation/'}>主題</a><a href={root+'articles/'}>文章</a><a href={root+'about/'}>關於</a></nav></header><section class="hero"><span class="eyebrow">TOPIC 01 / OBSERVATION</span><h1>觀察｜主題索引</h1><p class="lead">沿著同一個問題，閱讀不同時間留下的觀察。</p><p class="demo">設計原型｜以下內容為示範，不代表真實服務或出版紀錄。</p></section><div class="page"><aside aria-label="本頁目錄"><span class="eyebrow">ON THIS PAGE</span><a href="#section-1">01 / 閱讀路徑</a><a href="#section-2">02 / 相關主題</a><a href="#section-3">03 / 所有條目</a></aside><div class="content"><section id="section-1"><span class="eyebrow">01 / 閱讀路徑</span><h2>從一個看似微小的場景開始</h2><p>主題頁不只是標籤結果清單，還應給讀者一個進入議題的理由。以下為示範文章標題。</p><ul><li><a href={root+'articles/sample/'}>城市裡被忽略的五種停留 ↗</a></li><li><a href={root+'articles/sample/'}>一張椅子如何改變一個角落 ↗</a></li><li><a href={root+'articles/sample/'}>把散步變成觀察練習 ↗</a></li></ul></section><section id="section-2"><span class="eyebrow">02 / 相關主題</span><h2>跨主題的閱讀線索</h2><p>這類文章可以與閱讀、方法、提問的筆記建立交叉關聯；正式網站應由真實文章 metadata 驅動。</p></section><section id="section-3"><span class="eyebrow">03 / 所有條目</span><h2>回到總檔案</h2><p><a href={root+'articles/'}>查看示範文章總目錄 ↗</a></p></section></div></div><footer><a href={root}>← 返回主題標本室首頁</a><span>PROTOTYPE · CONTENT TO BE VERIFIED</span></footer></div></main>
</DirectionLayout>
<style>
.interior{--ink:#242a24;--tint:#355747;--paper:#f4f1e8;color:var(--ink);background:var(--paper);min-height:100vh;font-family:Arial,'Noto Sans TC',sans-serif;line-height:1.85}.shell{width:min(100% - 40px,1120px);margin:auto}.interior a{color:inherit;text-decoration:none}.interior a:hover{text-decoration:underline;text-underline-offset:4px}.interior a:focus-visible{outline:3px solid var(--tint);outline-offset:3px}.interior header{display:flex;justify-content:space-between;gap:20px;align-items:center;min-height:84px;border-bottom:1px solid var(--ink)}.brand{font-weight:700;font-size:20px}.interior nav{display:flex;gap:20px;flex-wrap:wrap}.interior nav a{display:inline-flex;align-items:center;min-height:44px}.hero{padding:80px 0 72px;border-bottom:1px solid var(--ink)}.eyebrow{font:12px ui-monospace,monospace;letter-spacing:.1em;color:var(--tint)}.interior h1{font:400 clamp(40px,6vw,76px) Georgia,'Noto Serif TC',serif;line-height:1.22;letter-spacing:-.02em;max-width:17ch}.lead{font-size:clamp(18px,2vw,24px);max-width:38ch}.demo{font-size:13px;color:var(--tint);border-left:3px solid var(--tint);padding-left:16px}.page{display:grid;grid-template-columns:180px minmax(0,1fr);gap:80px;padding:72px 0}.page aside{position:sticky;top:24px;align-self:start;display:flex;flex-direction:column;gap:12px}.page aside a{border-bottom:1px solid #bec4b8;padding:12px 0;min-height:44px}.content{min-width:0}.content section{padding:0 0 60px;scroll-margin-top:30px}.content section+section{padding-top:60px;border-top:1px solid #bec4b8}.content h2{font:400 clamp(30px,4vw,46px) Georgia,'Noto Serif TC',serif;line-height:1.3}.content p,.content li{font-size:18px;overflow-wrap:anywhere}.content :global(a){text-decoration:underline;text-underline-offset:5px}.content :global(ul){padding-left:24px}.content :global(li){margin:12px 0}.content :global(details){border-top:1px solid #bec4b8;padding:16px 0}.content :global(summary){cursor:pointer;font-weight:700;min-height:44px}.content :global(details:last-child){border-bottom:1px solid #bec4b8}.interior footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;border-top:1px solid var(--ink);padding:32px 0 64px;font-size:13px}@media(max-width:760px){.interior header{align-items:flex-start;flex-direction:column;padding:18px 0;gap:6px}.interior nav{gap:8px 20px}.hero{padding:48px 0}.page{display:block;padding:40px 0}.page aside{position:static;display:flex;flex-flow:row wrap;gap:8px 16px;padding-bottom:32px;margin-bottom:32px;border-bottom:1px solid #bec4b8}.page aside .eyebrow{flex-basis:100%}.page aside a{font-size:14px}.content section+section{padding-top:40px}.content section{padding-bottom:40px}}
</style>
