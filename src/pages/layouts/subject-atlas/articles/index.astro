---
import PrototypeNav from '../../../../components/art-direction/PrototypeNav.astro';
import DirectionLayout from '../../../../layouts/DirectionLayout.astro';
import {atlasEntries} from '../../../../data/subject-atlas';
const root=import.meta.env.BASE_URL+'layouts/subject-atlas/';
const posts=atlasEntries;
---
<DirectionLayout title="文章檔案｜主題標本室" description="主題分類與條目編號構成的知識站文章索引示範">
<main id="main" class="archive"><PrototypeNav kind="knowledge" /><p class="label">CATALOGUE / DEMO ENTRIES</p><h1>全部文章 <small>依主題搜尋路徑</small></h1><p>8 個示範條目；只有方法主題的索引文章有全文，其餘為標題示意。</p><table><caption>主題標本室示範文章清單</caption><thead><tr><th>編號</th><th>主題</th><th>文章</th></tr></thead><tbody>{posts.map((p,i)=><tr><td>{String(i+1).padStart(2,'0')}</td><td><a href={root+'topics/'+p.topic+'/'}>{p.topicName}</a></td><td>{p.articleSlug ? <a href={root+'articles/'+p.articleSlug+'/'}>{p.title} ↗</a> : <span>{p.title}<small>標題示意・尚無全文</small></span>}</td></tr>)}</tbody></table><footer><a href={root}>← 返回主題入口</a></footer></main>
</DirectionLayout><style>.archive td small{display:block;font-size:12px;color:#355747}.archive{background:#f4f1e8;color:#242a24;min-height:100vh;font-family:Arial,'Noto Sans TC',sans-serif;padding:0 max(20px,calc((100% - 1320px)/2));line-height:1.7}.archive a{color:inherit;text-decoration:none}.archive a:hover{text-decoration:underline}.archive a:focus-visible{outline:3px solid #355747;outline-offset:4px}.archive header{display:flex;justify-content:space-between;gap:16px;border-bottom:1px solid #242a24;padding:16px 0}.archive .label{font:14px ui-monospace,monospace;color:#355747;margin-top:72px}.archive h1{font:400 clamp(44px,7vw,80px) Georgia,'Noto Serif TC',serif}.archive h1 small{display:block;font-size:.4em}.archive table{border-collapse:collapse;width:100%;margin-top:64px}.archive th{text-align:left}.archive th,.archive td{border-bottom:1px solid #c6c8bc;padding:24px 12px 24px 0}.archive td:last-child{font-size:20px}.archive td a{display:inline-block;min-height:44px}.archive footer{margin-top:64px;padding:24px 0;border-top:1px solid #242a24}@media(max-width:600px){.archive td:last-child{font-size:16px}.archive th,.archive td{padding:16px 6px 16px 0}}</style>