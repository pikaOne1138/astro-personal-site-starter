---
import DirectionLayout from '../../../../layouts/DirectionLayout.astro';
const root=import.meta.env.BASE_URL+'layouts/subject-atlas/';
const posts=[['觀察','城市裡被忽略的五種停留'],['觀察','一張椅子如何改變一個角落'],['觀察','把散步變成觀察練習'],['閱讀','不是每一頁都需要筆記'],['閱讀','一本書與三次重讀'],['方法','怎麼建立一份主題索引'],['方法','當標籤多到沒有意義'],['提問','有些問題值得留久一點']];
---
<DirectionLayout title="文章檔案｜主題標本室" description="主題分類與條目編號構成的知識站文章索引示範">
<main id="main" class="archive"><header><a href={root}>◎ 主題標本室</a><a href={root}>回首頁 ↑</a></header><p class="label">CATALOGUE / DEMO ENTRIES</p><h1>全部文章 <small>依主題搜尋路徑</small></h1><p>所有條目皆為示範內容，並非真實出版紀錄。</p><table><caption>主題標本室示範文章清單</caption><thead><tr><th>編號</th><th>主題</th><th>文章</th></tr></thead><tbody>{posts.map((p,i)=><tr><td>{String(i+1).padStart(2,'0')}</td><td>{p[0]}</td><td><a href={root+'articles/sample/'}>{p[1]} ↗</a></td></tr>)}</tbody></table><footer><a href={root}>← 返回主題入口</a></footer></main>
</DirectionLayout><style>.archive{background:#f4f1e8;color:#242a24;min-height:100vh;font-family:Arial,'Noto Sans TC',sans-serif;padding:24px max(20px,calc((100% - 1100px)/2));line-height:1.7}.archive a{color:inherit;text-decoration:none}.archive a:hover{text-decoration:underline}.archive a:focus-visible{outline:3px solid #355747;outline-offset:4px}.archive header{display:flex;justify-content:space-between;gap:16px;border-bottom:1px solid #242a24;padding:16px 0}.archive .label{font:14px ui-monospace,monospace;color:#355747;margin-top:72px}.archive h1{font:400 clamp(44px,7vw,80px) Georgia,'Noto Serif TC',serif}.archive h1 small{display:block;font-size:.4em}.archive table{border-collapse:collapse;width:100%;margin-top:64px}.archive th{text-align:left}.archive th,.archive td{border-bottom:1px solid #c6c8bc;padding:24px 12px 24px 0}.archive td:last-child{font-size:20px}.archive td a{display:inline-block;min-height:44px}.archive footer{margin-top:64px;padding:24px 0;border-top:1px solid #242a24}@media(max-width:600px){.archive td:last-child{font-size:16px}.archive th,.archive td{padding:16px 6px 16px 0}}</style>