---
import DesignLibraryNav from '../../components/DesignLibraryNav.astro';
import originals from '../../data/layout-directions.json';
import {layoutDefinitions} from '../../data/layout-assembly/definitions.mjs';
const directions=layoutDefinitions.filter(d=>originals.some(o=>o.slug===d.slug)).map(d=>({...originals.find(o=>o.slug===d.slug),...d}));
import handoff from '../../../docs/art-direction/pr47-layout-handoff-registry.json';
const extensions=handoff.items.filter(item=>item.origin!=='main-12');
const base=import.meta.env.BASE_URL;
const sections=[{kind:'knowledge',label:'知識與內容網站',en:'KNOWLEDGE / EDITORIAL',description:'不一定從文章卡片開始。試著比較田野觀察、長篇閱讀、課程路徑、策展收藏、聲音內容與年度主題索引的閱讀方法。'},{kind:'helper',label:'助人者與專業服務',en:'CARE / PROFESSIONAL',description:'清晰的專業說明、溫柔的故事入口、身體感受、行動導向教練、多人工作室，以及訪客優先的信任路徑。'}];
---
<!doctype html><html lang="zh-Hant">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="25 種真正不同的網站版型：閱讀動線、內容架構、區塊比例與互動方式，適合架站工作坊學員參考。"/><title>網站版型庫｜25 種獨立網站方向</title><link rel="stylesheet" href={base+'layout-gallery.css'}/></head>
<body>
<a class="gallery-skip" href="#main">跳到版型列表</a>
<header class="gallery-nav"><a href={base}>WEBSITE / WORKSHOP</a></header>
<div class="design-library-shell"><DesignLibraryNav current="layouts" /></div>
<main id="main">
<section class="gallery-hero"><p class="gallery-kicker">LAYOUT LIBRARY / 25 DISTINCT DIRECTIONS</p><h1>網站不只換顏色。<br/><em>也可以換一種說故事的方法。</em></h1><p class="gallery-lead">這裡比較的是<strong>整頁版面與資訊動線</strong>：先放什麼、哪裡留白、圖片與文字怎麼互相安排，以及訪客會如何往下閱讀。它不綁定原本的紙墨、晨光、靜室、植感四套視覺主題。</p><div class="gallery-summary"><span>25 種首頁設計方向</span><span>13 知識／內容</span><span>12 助人／專業服務</span></div></section>
<section class="gallery-recipe-entry"><div><p class="gallery-kicker">EDITORIAL COMPOSITION LIBRARY / 40 RECIPES</p><h2>網站的設計感，來自構圖選擇。</h2><p>除了比較 25 款首頁方向，還能拆開看 12 種 Hero、8 種內容分區、6 種列表、6 種節奏和 8 種信任／CTA 形式。</p></div><a href={base+'layouts/recipes/'}>探索 40 種構圖配方 ↗</a></section>
<nav class="gallery-jump" aria-label="版型分類"><a href="#knowledge">探索知識網站 ↓</a><a href="#helper">探索助人者網站 ↓</a><a href="#extensions">新增 13 款 ↓</a><a href="#compare">怎麼挑版型？ ↓</a></nav>
{sections.map(section=><section class="gallery-section" id={section.kind==='helper'?'helper':'knowledge'}>
  <header class="gallery-section-head"><div><p class="gallery-kicker">{section.en}</p><h2>{section.label} <small>06</small></h2></div><p>{section.description}</p></header>
  <div class="gallery-grid">
    {directions.filter(d=>d.kind===section.kind).map((item,i)=><article class:list={['gallery-card','gallery-card--'+item.palette]}>
      <a href={base+'layouts/'+item.slug+'/'} aria-label={'預覽'+item.title+'完整首頁'}>
        <div class="gallery-card-image">
          <picture><source media="(max-width:600px)" srcset={base+item.screenshots.mobile.slice(1)}/><img src={base+item.screenshots.desktop.slice(1)} alt={item.title+' Astro 首頁實際截圖'} loading="lazy" width="1440" height="900"/></picture>
          <span class="gallery-card-no">{String(i+1+(section.kind==='helper'?6:0)).padStart(2,'0')}</span><span class="gallery-card-open">開啟完整版面 ↗</span></div>
        <div class="gallery-card-body"><p class="gallery-card-en">{item.en}</p><h3>{item.title}</h3><p class="gallery-card-audience">{item.audience}</p><p class="gallery-card-description">{item.description}</p><div class="gallery-card-structure"><span>版面結構</span><b>{item.structure}</b></div></div>
      </a>
    <a class="layout-select-cta" href={base+'starter/?layout='+encodeURIComponent(item.slug)+'&kind='+item.kind}>選用此版型並開始規劃 →</a></article>)}
  </div>
</section>)}
<section id="extensions" class="additional-layouts">
  <div class="additional-intro"><p class="gallery-kicker">PR #47 / ART DIRECTION EXPANSION</p><h2>再看 13 種不同的編排方式。</h2><p>這裡包含 2 款有獨立 Adapter 的方向，以及 11 款可編輯資料的多頁原型。可以實際點進首頁、文章或服務內頁比較，但<strong>尚不是 13 套 Ready Starter</strong>。</p></div>
  {(['knowledge','helper'] as const).map(kind=><div class="additional-group">
   <h3>{kind==='knowledge'?'知識／部落格型 · 新增 7 款':'助人／個人專業服務型 · 新增 6 款'}</h3>
   <div class="additional-grid">{extensions.filter(item=>item.kind===kind).map((item,i)=><article class="additional-card">
    <a class="additional-link" href={base+'layouts/'+item.slug+'/'} aria-label={'開啟'+item.name+'的獨立首頁原型'}>
     <div class="additional-preview"><picture><source media="(max-width:600px)" srcset={base+'template-gallery/'+item.slug+'-mobile.webp'}/><img src={base+'template-gallery/'+item.slug+'-desktop.webp'} width="1440" height="900" loading="lazy" alt={item.name+' Astro 首頁實際截圖'}/></picture></div>
     <div class="additional-copy"><span class="additional-label">{item.origin==='pr47-existing-2'?'獨立 Adapter 已有技術驗證':'多頁原型／內容契約已接線'}</span><h4>{item.name}</h4><p>{item.structuralIdentity}</p><span class="additional-slug">{item.slug}</span></div>
    </a><a class="layout-select-cta" href={base+'starter/?layout='+encodeURIComponent(item.slug)+'&kind='+item.kind}>選用此版型並開始規劃 →</a>
    {item.origin==='pr47-new-11'&&<nav aria-label={item.name+'其他頁面'}><a href={base+item.prototype.archive.slice(1)}>索引 ↗</a><a href={base+item.prototype.detail.slice(1)}>詳情 ↗</a><a href={base+item.prototype.about.slice(1)}>About ↗</a></nav>}
   </article>)}</div>
  </div>)}
 </section>
<section id="compare" class="gallery-compare"><div><p class="gallery-kicker">HOW TO CHOOSE</p><h2>先選閱讀動線，<br/>再決定顏色。</h2></div><div><p><strong>01．你希望訪客先做什麼？</strong> 閱讀觀點、探索文章、跟著學習、收聽節目，還是確認專業服務。</p><p><strong>02．你最主要的內容是什麼？</strong> 長文、分類資料庫、課程、影像、影音、服務流程，會決定適合哪種首頁排列。</p><p><strong>03．最後才調整品牌視覺。</strong> 色彩、字體、圓角、動效，都可以在選定版面結構後再更改。</p><a href={base+'blocks/'}>到元件庫挑選區塊 ↗</a></div></section>
</main><footer class="gallery-footer"><span>WEBSITE / LAYOUT LIBRARY</span><a href={base}>回工作坊首頁 ↑</a></footer>
<style>.layout-select-cta{display:block;padding:13px 18px;margin:0 16px 16px;border:1px solid currentColor;border-radius:8px;text-align:center;text-decoration:none;font-weight:700;color:#254d3f;background:#fffefa}.layout-select-cta:focus-visible{outline:3px solid #315b43;outline-offset:3px}.additional-layouts{max-width:1180px;margin:0 auto;padding:80px 18px}.additional-intro{max-width:70ch}.additional-intro h2{font-size:clamp(32px,4vw,56px);line-height:1.2}.additional-intro p{line-height:1.8}.additional-group{margin-top:52px}.additional-group h3{font-size:24px;margin:0 0 22px}.additional-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.additional-card{border:1px solid #bbc5ba;min-width:0;background:#f6f5ef}.additional-link{display:block;color:#223329;text-decoration:none}.additional-preview{display:flex;flex-direction:column;justify-content:space-between;min-height:220px;padding:22px;background:#dce8df}.additional-preview small,.additional-preview span,.additional-label,.additional-slug{font:12px/1.5 ui-monospace,monospace;letter-spacing:.03em}.additional-preview strong{font:500 clamp(22px,2.6vw,32px)/1.35 Georgia,'Noto Serif TC',serif;overflow-wrap:anywhere}.additional-copy{padding:20px}.additional-copy h4{font-size:25px;margin:12px 0}.additional-copy p{line-height:1.6}.additional-slug{opacity:.75;overflow-wrap:anywhere}.additional-card nav{display:flex;flex-wrap:wrap;gap:12px 18px;padding:0 20px 20px}.additional-card nav a{min-height:44px;display:inline-flex;align-items:center;color:#244a38}.additional-link:focus-visible,.additional-card nav a:focus-visible{outline:3px solid #315b43;outline-offset:3px}@media(max-width:900px){.additional-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.additional-grid{grid-template-columns:1fr}.additional-preview{min-height:180px}.additional-layouts{padding:48px 18px}}.design-library-shell{width:min(100% - 36px,1180px);margin-inline:auto}
.gallery-card>a:first-child{height:auto}.gallery-card>.layout-select-cta{display:inline-flex;grid-template-columns:none;height:auto;min-height:44px;align-items:center}.gallery-card-image picture{position:absolute;inset:0}.gallery-card-image img,.additional-preview img{display:block;width:100%;height:100%;object-fit:cover;object-position:top}.gallery-card-image picture{display:block;width:100%;height:100%}.additional-preview{display:block;padding:0;overflow:hidden;aspect-ratio:16/10;min-height:0}.additional-preview picture{display:block;width:100%;height:100%}.layout-select-cta{display:inline-block;margin:16px 24px;min-height:44px}.gallery-card-image img{aspect-ratio:auto}
@media(max-width:600px){.gallery-card-image,.additional-preview{height:390px;min-height:390px;aspect-ratio:auto}.gallery-card-image picture,.additional-preview picture{display:flex;justify-content:center}.gallery-card-image img,.additional-preview img{width:180px;height:390px;min-height:0;object-fit:cover;object-position:top}}</style></body></html>
