---
import DirectionLayout from '../../../layouts/DirectionLayout.astro';
import {getDirectionContent} from '../../../data/art-direction-content';
export function getStaticPaths(){return [{params:{page:undefined}},{params:{page:'articles'}},{params:{page:'articles/lead-story'}},{params:{page:'about'}}];}
const page=Astro.params.page??'';
const base=import.meta.env.BASE_URL+'layouts/editorial-frontpage/';
const site=getDirectionContent('editorial-frontpage','knowledge',base,'articles/lead-story/');
const rows=site.rows;
const title=page==='articles'?'文章檔案':page==='about'?'關於作者':page?'我們怎麼開始理解日常？':'個人刊物';
---
<DirectionLayout title={title+'｜個人刊物（原型）'} description="單一作者大頭條與次級文章並列、跨首頁及內頁的編輯式網站構圖">
<main id="main" class="publication">
<div class="canvas">
 <div class="content-contract" data-layout-content="editorial-frontpage" aria-label="可編輯網站資料"><span>{site.siteName}</span><span>{site.intro}</span><a href={base+'about/'}>關於本站</a></div><header class="masthead"><div class="mast-meta"><span>ISSUE / 001</span><span>獨立個人刊物 · 設計原型</span></div><a class="brand" href={base}>一個人的刊物</a><nav aria-label="主要導覽"><a href={base}>本期首頁</a><a href={base+'articles/'}>全部文章</a><a href={base+'about/'}>關於作者</a><a href={import.meta.env.BASE_URL+'layouts/'}>版型庫 ↗</a></nav></header>
 {page===''&&<>
 <section class="front"><p class="section-label">FEATURED STORIES / 2026</p><div class="spread"><article class="lead"><span class="tag">01 · 觀察 / FEATURE</span><h1><a href={(rows[0]?.href??base+'articles/')}>{(rows[0]?.title??'目前沒有公開文章')}</a></h1><p class="summary">{(rows[0]?.sub??'請先新增文章')}</p><a class="read" href={(rows[0]?.href??base+'articles/')}>閱讀本期主文 ↗</a></article><div class="secondary">{rows.slice(1).map(row=><article><span class="tag">{row.no} · {row.topic}</span><h2>{row.title}</h2><p>{row.sub}，尚無文章全文。</p></article>)}</div></div></section>
 <section class="lower"><div><span class="section-label">EDITOR'S NOTE</span><h2>從自己好奇的地方開始。</h2><p>這是單一作者的個人刊物，不需要編輯團隊、新聞時效、熱門排行或會員訂閱。</p><a class="read" href={base+'about/'}>關於寫作者 →</a></div><div><span class="section-label">CONTENTS / ALL</span>{rows.map(row=><article class="contents"><b>{row.no}</b><div><span class="tag">{row.topic}</span>{row.href?<h3><a href={row.href}>{row.title}</a></h3>:<h3>{row.title}</h3>}</div></article>)}<a class="read" href={base+'articles/'}>全部索引 →</a></div></section>
 </>}
 {page==='articles'&&<><section class="pagehead"><span class="section-label">ISSUE / ARCHIVE</span><h1>全部文章</h1><p>有主次層級的索引，不把每一篇文章套成三張一樣的卡。</p></section><section class="archive"><article class="featured"><span class="tag">FEATURE / {rows[0].topic}</span><h2><a href={(rows[0]?.href??base+'articles/')}>{(rows[0]?.title??'目前沒有公開文章')}</a></h2><p>{(rows[0]?.sub??'請先新增文章')}</p><a class="read" href={(rows[0]?.href??base+'articles/')}>閱讀 →</a></article><div>{rows.slice(1).map(row=><article class="archive-row"><span class="tag">{row.no} / {row.topic}</span><h3>{row.title}</h3><p>尚未建立全文</p></article>)}</div></section></>}
 {page==='articles/lead-story'&&<><section class="article-head"><span class="tag">ISSUE 001 / 觀察 · DEMO</span><h1>{(rows[0]?.title??'目前沒有公開文章')}</h1><p class="summary">{(rows[0]?.sub??'請先新增文章')} 以下是示範內容，並非真實作者的經歷。</p></section><div class="reading"><aside><span class="section-label">IN THIS ARTICLE</span><a href="#seeing">01 看見</a><a href="#sorting">02 整理</a><a href={base+'articles/'}>← 文章目錄</a></aside><article class="prose"><h2 id="seeing">從看見開始</h2><p>好的問題通常來自日常。先將發現記下，再尋找相關的材料，最後用自己的話表達。</p><p>文章不必每次都有完整答案，卻可以逐次讓想法更清楚。</p><blockquote>個人刊物讓文章具有前後呼應的關係，而不必變成新聞編輯室。</blockquote><h2 id="sorting">把線索整理成文字</h2><p>保留日期、主題及相關的閱讀入口，讓下次走回這篇文章的讀者還能辨識原本的問題。</p><p>正式內容需使用網站現有 Astro Content Collections 與 Pagefind，不另建假資料庫。</p></article></div><section class="related"><span class="section-label">NEXT IN THE ISSUE</span>{rows.slice(1).map(row=><article><span>{row.no} / {row.topic}</span><h3>{row.title}</h3><small>全文待撰寫</small></article>)}</section></>}
 {page==='about'&&<><section class="pagehead"><span class="section-label">THE WRITER / ABOUT</span><h1>這份刊物，屬於一個人的觀點。</h1><p>作者身份、照片與經歷尚未設定；不虛構報社、團隊或媒體曝光。</p></section><section class="bio"><div class="initial"><span>AUTHOR IMAGE</span><strong>作者照片<br/>可選填</strong></div><div><h2>寫什麼，為何寫？</h2><p>用第一人稱介紹持續關心的問題、文章的整理方法與希望留給讀者的閱讀入口。</p><h2>從哪篇開始？</h2><p>如果只有一篇文章，就用一篇清楚的代表文章，不補造排行榜或多篇精選。</p><a class="read" href={(rows[0]?.href??base+'articles/')}>閱讀示範文章 →</a></div></section></>}
 <footer><span>個人刊物 · 編輯式版型示範</span><a href={base}>回首頁 ↑</a><span>沒有虛構電子報或註冊成功</span></footer>
</div>
</main>
</DirectionLayout>
<style>
.publication{--ink:#242a24;--rule:#aeb5ab;background:#f4f1e8;color:var(--ink);font-family:'Noto Sans TC',system-ui,sans-serif;line-height:1.8;min-height:100vh}.canvas{width:min(calc(100% - 48px),1200px);margin:auto}.publication a{color:inherit;text-decoration:none}.publication a:hover{text-decoration:underline;text-underline-offset:5px}.masthead{border-bottom:3px double var(--ink);padding:24px 0 32px;text-align:center}.mast-meta{display:flex;justify-content:space-between;gap:24px;font:12px ui-monospace,monospace}.brand{display:block;font:400 clamp(40px,6vw,82px)/1.2 Georgia,'Noto Serif TC',serif;margin:32px auto}.masthead nav{display:flex;justify-content:center;flex-wrap:wrap;gap:16px 48px;border-top:1px solid var(--rule);padding-top:16px}.masthead nav a{display:inline-flex;min-height:44px;align-items:center}.section-label,.tag{font:12px ui-monospace,monospace;letter-spacing:.08em;color:#58645a}.front{padding:64px 0 96px}.spread{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:64px}.lead{padding-top:32px;border-top:3px solid var(--ink)}.publication h1{font:400 clamp(48px,6vw,88px)/1.15 Georgia,'Noto Serif TC',serif;letter-spacing:-.025em;text-wrap:balance}.lead h1{max-width:13ch}.summary{font-size:20px;max-width:42ch}.read{display:inline-flex;min-height:48px;align-items:center;border-bottom:1px solid currentColor;margin-top:24px}.secondary article{padding:24px 0 48px;border-top:1px solid var(--ink)}.secondary article+article{margin-top:32px}.secondary h2{font:400 clamp(28px,3vw,42px)/1.3 Georgia,'Noto Serif TC',serif}.secondary p{font-size:16px}.lower{display:grid;grid-template-columns:5fr 7fr;gap:96px;padding:96px 0;border-top:1px solid var(--ink)}.lower h2,.bio h2{font:400 clamp(28px,4vw,48px) Georgia,'Noto Serif TC',serif}.contents{display:grid;grid-template-columns:48px 1fr;gap:16px;padding:20px 0;border-top:1px solid var(--rule)}.contents b{font:24px Georgia,serif}.contents h3{font:400 24px Georgia,'Noto Serif TC',serif;margin:8px 0}.pagehead{padding:96px 0 64px;border-bottom:1px solid var(--ink)}.pagehead h1{margin-bottom:24px}.pagehead p{font-size:20px;max-width:48ch}.archive{display:grid;grid-template-columns:7fr 5fr;gap:64px;padding:64px 0 128px}.archive .featured{border-top:3px solid var(--ink);padding-top:24px}.featured h2{font:400 clamp(36px,5vw,64px)/1.25 Georgia,'Noto Serif TC',serif}.archive-row{border-top:1px solid var(--rule);padding:20px 0 40px}.archive-row h3,.related h3{font:400 28px Georgia,'Noto Serif TC',serif}.article-head{max-width:1000px;padding:96px 0 64px}.article-head h1{max-width:16ch}.reading{display:grid;grid-template-columns:220px minmax(0,700px);gap:64px;padding:48px 0 128px;border-top:1px solid var(--ink)}.reading aside{display:flex;flex-direction:column;gap:16px;align-self:start;position:sticky;top:24px}.reading aside a{min-height:44px;display:flex;align-items:center}.prose{font-size:18px;line-height:1.95}.prose h2{font:400 36px Georgia,'Noto Serif TC',serif;scroll-margin-top:32px}.prose blockquote{font:italic 28px/1.6 Georgia,'Noto Serif TC',serif;border-left:2px solid currentColor;margin:48px 0;padding-left:24px}.related{display:grid;grid-template-columns:1fr 1fr;gap:32px;border-top:1px solid var(--ink);padding:64px 0 96px}.related>.section-label{grid-column:1/-1}.related article{border-top:1px solid var(--rule);padding:24px 0}.bio{display:grid;grid-template-columns:4fr 7fr;gap:96px;padding:64px 0 128px}.initial{min-height:400px;padding:24px;background:#e7ece5;display:flex;flex-direction:column;justify-content:space-between}.initial strong{font:400 36px Georgia,'Noto Serif TC',serif;text-align:center}.publication footer{border-top:3px double var(--ink);display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;padding:32px 0 64px;font-size:14px}.publication h1,.publication h2,.publication h3,.publication p{overflow-wrap:anywhere}@media(max-width:850px){.spread,.lower,.archive,.reading,.bio{gap:32px}}@media(max-width:700px){.canvas{width:min(calc(100% - 40px),1200px)}.mast-meta{display:block;text-align:center}.mast-meta span{display:block}.brand{font-size:clamp(36px,10vw,56px)}.masthead nav{gap:8px 24px}.front,.pagehead,.article-head{padding:48px 0}.spread,.lower,.archive,.reading,.bio{display:block;padding:48px 0}.secondary{margin-top:64px}.lower>div+div,.archive>div,.bio>div+div{margin-top:64px}.reading aside{position:static;flex-flow:row wrap;border-bottom:1px solid var(--rule);padding-bottom:24px;margin-bottom:40px}.reading aside .section-label{flex-basis:100%}.reading aside a{margin-right:16px}.related{display:block}.related article{margin-top:24px}.initial{min-height:280px}}
.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 system-ui,sans-serif;padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
</style>