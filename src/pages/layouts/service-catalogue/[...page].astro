---
import DirectionLayout from '../../../layouts/DirectionLayout.astro';
import {getDirectionContent} from '../../../data/art-direction-content';
import contentSource from '../../../data/art-direction-layout-content.json';
export function getStaticPaths() {
  const fixed=[{params:{page:undefined}},{params:{page:'services'}},{params:{page:'services/individual'}},{params:{page:'about'}}];
  const additional=(contentSource.helper.services??[]).slice(1).filter(entry=>entry.published===true && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(entry.slug));
  return [...fixed,...additional.map(entry=>({params:{page:'services/'+entry.slug}}))];
}
const route=Astro.params.page??'';
const root=import.meta.env.BASE_URL+'layouts/service-catalogue/';
const site=getDirectionContent('service-catalogue','helper',root,'services/individual/');
const detailRecord=site.services.find(entry=>entry.href && entry.href.endsWith((Astro.params.page??'')+'/'))??site.primary;
const service=site.primary??{name:'尚未設定服務',description:'請填入已核實的服務內容',fit:'待設定',format:'待設定',duration:'待設定',price:'待設定',scope:'待設定',href:undefined};
const facts=[['適合對象',service.fit],['服務形式',service.format],['時間',service.duration],['費用',service.price],['界線',service.scope]];
const title=route==='services'?'服務一覽':(Astro.params.page??'').startsWith('services/')?'服務詳細資訊':route==='about'?'關於工作者':'服務目錄';
---
<DirectionLayout title={title+'｜服務目錄設計原型'} description="以可比較的服務資料為視覺主角，完整延伸至服務詳細頁與關於頁。">
<main id="main" class="catalog"><div class="shell">
<div class="content-contract" data-layout-content="service-catalogue" aria-label="可編輯網站資料">{site.kind==='knowledge'&&site.articles.filter(item=>item.published).length===0&&<span>目前沒有公開文章。</span>}{site.kind==='helper'&&site.services.filter(item=>item.href).length===0&&<span>尚未提供正式服務。</span>}<span>{site.siteName}</span><span>{site.intro}</span><a href={root+'about/'}>關於本站</a></div><header class="nav"><a class="brand" href={root}>服務目錄 <span>THE SERVICE CATALOGUE</span></a><nav aria-label="主要導覽"><a href={root}>首頁</a><a href={root+'services/'}>全部服務</a><a href={root+'about/'}>關於</a><a href={import.meta.env.BASE_URL+'layouts/'}>版型庫 ↗</a></nav></header>
{route===''&&<><section class="hero"><div><span class="tag">SERVICE DIRECTORY / 001</span><h1>看清楚服務，<br/>再決定下一步。</h1></div><div><p>不同於以個人故事或三步方法為首屏的網站，這個方向把服務內容、形式與界線放在第一順位。</p><a class="action" href={root+'services/'}>查看服務目錄 ↗</a></div></section><section class="index"><div class="index-head"><span class="tag">01 / AVAILABLE INFORMATION</span><h2>服務目錄</h2><p>沒有真實的第二、第三項服務，就只展示一項。</p></div><article class="service-card"><div class="card-number">01 <span>ENTRY</span></div><div><h3>{service.name}</h3><p>{service.description}</p><dl>{facts.slice(0,4).map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>{service.href?<a class="action" href={service.href}>查看完整資訊 →</a>:<span>沒有已公開服務詳細頁</span>}</div></article><div class="additional-services">{site.services.slice(1).map(item=><article><h3>{item.name}</h3><p>{item.description}</p>{item.href?<a href={item.href}>查看服務詳情 →</a>:<span>尚未公開服務詳情</span>}</article>)}</div></section><section class="stripe"><p class="tag">HOW TO CHOOSE</p><h2>服務清楚，不等於必須預約。</h2><p>先核對專業範圍、真實資格與合作條件。尚未設定聯絡服務時，不提供無效預約按鈕。</p><a href={root+'about/'}>關於提供服務的人 →</a></section></>}
{route==='services'&&<><section class="pagehead"><p class="tag">CATALOGUE / INDEX</p><h1>服務一覽。</h1><p>每項以相同欄位呈現；只提供一項時採完整橫向資料卡，不複製空卡。</p></section><article class="service-card wide"><div class="card-number">01 <span>SERVICE</span></div><div><h2>{service.name}</h2><p>{service.description}</p><dl>{facts.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl><a class="action" href={service.href??root+'services/'}>閱讀服務詳細頁 →</a></div></article></>}
{(Astro.params.page??'').startsWith('services/')&&<><section class="pagehead"><p class="tag">CATALOGUE / ENTRY 01</p><h1>{service.name}</h1><p>{service.description}</p></section><div class="detail"><aside><span class="tag">SERVICE RECORD</span><strong>01</strong><a href={root+'services/'}>← 返回目錄</a></aside><div><section><h2>詳細說明</h2><div class="article-contract-body">{(detailRecord?.body??[]).map(paragraph=><p>{paragraph}</p>)}</div><p>這份資料夾式詳細頁讓訪客先理解服務，而不強迫購買或預約。</p><dl>{facts.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></section><section><h2>不適合與界線</h2><p>{service.scope}。如有急迫或危險狀況，應聯繫所在地正式緊急服務。</p></section><section><h2>合作流程</h2><ol><li>閱讀服務範圍及適合對象</li><li>核對實際費用、形式、取消政策及資格</li><li>由服務者配置真實聯絡入口後再詢問</li></ol><p class="notice">目前未配置收件表單或預約平台。</p></section></div></div></>}
{route==='about'&&<><section class="pagehead"><p class="tag">ABOUT / PRACTICE</p><h1>{site.about}</h1><p>姓名、資格、背景、經歷與聯絡方式由本人填寫；原型不創造任何醫療資格。</p></section><div class="about"><div><h2>工作方式</h2><p>說明自己服務的對象、工作方法與不能提供的項目。沒有個人照片時仍可用文字完成介紹。</p></div><div class="about-ledger"><div><strong>專業身分</strong><span>待真實提供者填寫</span></div><div><strong>可查證資料</strong><span>證照及來源尚未配置</span></div><div><strong>合作方式</strong><span>請參考服務目錄的實際設定</span></div><a class="action" href={root+'services/'}>回服務目錄 →</a></div></div></>}
<footer><span>服務目錄 · 靜態構圖原型</span><a href={root}>回首頁 ↑</a><p>非正式執業者網站，沒有預約、表單或危機支援服務。</p></footer>
</div></main>
</DirectionLayout>
<style>
.catalog{--ink:#242a24;--line:#b5bdb1;--soft:#e7ece5;background:#f4f1e8;color:var(--ink);font:17px/1.8 'Noto Sans TC',system-ui,sans-serif;min-height:100vh}.shell{width:min(calc(100% - 48px),1200px);margin:auto}.catalog a{color:inherit;text-decoration:none}.catalog a:hover{text-decoration:underline;text-underline-offset:4px}.nav{display:flex;justify-content:space-between;align-items:center;gap:24px;border-bottom:1px solid var(--ink);padding:24px 0}.brand{font:400 28px Georgia,'Noto Serif TC',serif}.brand span{display:block;font:12px ui-monospace,monospace}.nav nav{display:flex;flex-wrap:wrap;gap:12px 32px}.nav nav a{display:inline-flex;align-items:center;min-height:44px}.tag{font:12px ui-monospace,monospace;letter-spacing:.1em;color:#496251}.hero{display:grid;grid-template-columns:7fr 5fr;gap:64px;padding:96px 0 128px;align-items:end}.hero h1,.pagehead h1{font:400 clamp(44px,6vw,80px)/1.18 Georgia,'Noto Serif TC',serif;letter-spacing:-.03em;text-wrap:balance}.hero p{font-size:20px;max-width:35ch}.action{display:inline-flex;min-height:48px;padding:10px 24px;align-items:center;background:var(--ink);color:#f4f1e8!important;margin-top:24px}.index{border-top:1px solid var(--ink);padding:64px 0 128px}.index-head{display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:32px;align-items:start;margin-bottom:48px}.index-head h2,.stripe h2,.about h2,.detail h2{font:400 clamp(30px,4vw,48px)/1.3 Georgia,'Noto Serif TC',serif;margin:0}.service-card{display:grid;grid-template-columns:1fr 3fr;gap:48px;border:1px solid var(--ink);background:#fffefa;padding:48px}.card-number{font:400 76px Georgia,serif;line-height:1}.card-number span{display:block;font:12px ui-monospace,monospace}.service-card h2,.service-card h3{font:400 clamp(30px,4vw,52px)/1.25 Georgia,'Noto Serif TC',serif;margin:0}.service-card dl,.detail dl{border-top:1px solid var(--line)}.service-card dl>div,.detail dl>div{display:grid;grid-template-columns:160px 1fr;gap:24px;border-bottom:1px solid var(--line);padding:16px 0}.catalog dt{font-weight:700}.catalog dd{margin:0}.stripe{background:var(--soft);margin:0 0 128px;padding:64px;display:grid;grid-template-columns:1fr 2fr;gap:24px 64px}.stripe .tag{grid-column:1/-1}.stripe p:not(.tag){max-width:40ch}.stripe a{display:inline-flex;min-height:48px;align-items:center;text-decoration:underline}.pagehead{padding:96px 0 64px;max-width:880px}.pagehead>p:last-child{font-size:20px}.wide{margin-bottom:128px}.detail{display:grid;grid-template-columns:200px 1fr;gap:64px;padding:48px 0 128px;border-top:1px solid var(--ink)}.detail aside{display:flex;flex-direction:column;gap:16px;align-self:start;position:sticky;top:24px}.detail aside strong{font:76px Georgia,serif}.detail aside a{min-height:44px;display:flex;align-items:center}.detail section{padding:24px 0 64px}.detail section+section{border-top:1px solid var(--line)}.detail ol li{margin:16px 0}.notice{padding:24px;background:var(--soft)}.about{display:grid;grid-template-columns:1fr 1.5fr;gap:96px;padding:48px 0 128px;border-top:1px solid var(--ink)}.about-ledger>div{display:flex;justify-content:space-between;gap:32px;border-bottom:1px solid var(--line);padding:24px 0}.catalog footer{border-top:1px solid var(--ink);padding:32px 0 64px;display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;font-size:14px}.catalog footer p{flex-basis:100%}.catalog h1,.catalog h2,.catalog h3,.catalog p,.catalog dd{overflow-wrap:anywhere}@media(max-width:900px){.index-head{grid-template-columns:1fr 1fr}.index-head p{grid-column:2}}@media(max-width:700px){.shell{width:min(calc(100% - 40px),1200px)}.nav{display:block}.nav nav{margin-top:24px}.hero,.index-head,.service-card,.stripe,.detail,.about{display:block}.hero{padding:48px 0 64px}.hero>div+div{margin-top:32px}.index{padding:40px 0 64px}.index-head{margin-bottom:32px}.service-card{padding:24px}.card-number{font-size:48px;margin-bottom:32px}.service-card dl>div,.detail dl>div{display:block}.catalog dt{margin-bottom:8px}.stripe{margin-bottom:64px;padding:32px}.pagehead{padding:48px 0}.wide{margin-bottom:64px}.detail aside{position:static;flex-direction:row;flex-wrap:wrap;align-items:center;border-bottom:1px solid var(--line);padding-bottom:24px}.detail aside strong{font-size:40px}.about{padding:40px 0 64px}.about-ledger{margin-top:48px}.about-ledger>div{display:block}}
.content-contract{display:flex;gap:12px 24px;align-items:center;flex-wrap:wrap;font:13px/1.6 system-ui,sans-serif;padding:12px 24px;border-bottom:1px solid currentColor}.content-contract a{text-decoration:underline} 
.article-contract-body{font-size:1rem;line-height:1.8;max-width:65ch}
</style>