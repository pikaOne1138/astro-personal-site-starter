---
import DemoLayout from '../layouts/DemoLayout.astro';
import blockRegistry from '../data/blocks.registry.json';
import { kindMeta, themeMeta, kinds, themes } from '../data';
import { helperPractice } from '../data/helper-content';
const base = import.meta.env.BASE_URL;
---
<DemoLayout title="網站設計工作坊 · 八款網站示範" description="網站工作坊：兩種網站架構與四種視覺風格">
  <main class="demo-index">
    <header class="index-hero">
      <p class="eyebrow">PERSONAL WEBSITE · DESIGN STUDIO</p>
      <h1>兩種網站任務，四種視覺人格。</h1>
      <p>這不是八套互不相干的網站，而是 <strong>2 種內容架構 × 4 種 Design System</strong>。點進去比較同一套設計語言如何因「網站任務」而改變。</p>
    </header>
    <div class="matrix">
      {kinds.map((kind)=><section class="matrix-group">
        <div class="matrix-heading">
          <span>{kind === 'knowledge' ? 'A' : 'B'}</span>
          <div><h2>{kindMeta[kind].label}</h2><p>{kindMeta[kind].intro}</p>{kind === 'knowledge' && <p class="matrix-interaction-note">四種風格不只有外觀差異，也能進入網站體驗文章搜尋、主題標籤、月份與日期篩選，以及完整文章閱讀。</p>}</div>
        </div>
        <div class="demo-grid">
          {themes.map((theme)=><a class={`demo-card theme-${theme}`} href={`${base}${kind}/${theme}/`}>
            <div class="demo-swatch"><span></span><span></span><span></span></div>
            <small>{themeMeta[theme].label}</small>
            <h3>{themeMeta[theme].zh}{kind==='helper' ? ' · '+helperPractice[theme].specialty : ''}</h3>
            <p>{kind==='helper' ? helperPractice[theme].intro : themeMeta[theme].mood}</p>
            <b>開啟 Demo →</b>
          </a>)}
        </div>
      </section>)}
    </div>
    <section class="matrix-group blocks-entry" aria-labelledby="libraries-title">
      <div class="matrix-heading">
        <span>C</span>
        <div>
          <h2 id="libraries-title">元件、特效、版型 · 三座網站靈感庫</h2>
          <p>先從 12 種不同的頁面結構找方向，再挑選 {blockRegistry.length} 個內容元件與 7 組互動特效。版型庫比較的是整體編排，不是替四種舊主題換顏色。</p>
        </div>
      </div>
      <div class="library-entry-grid">
        <a class="demo-card library-entry-card" href={`${base}blocks/`}>
          <p class="eyebrow">WEBSITE BLOCKS · COMPONENT LIBRARY</p>
          <h3>元件庫 · 網站怎麼組成</h3>
          <p>文章、首頁、服務、導覽、搜尋與各種內容排版。探索 {blockRegistry.length} 個元件，切換四套風格，直接比較實際網站。</p>
          <b>進入元件展示站 →</b>
        </a>
        <a class="demo-card library-entry-card" href={base+'effects/'}>
          <p class="eyebrow">MOTION · EFFECTS LIBRARY</p>
          <h3>特效庫 · 網站怎麼互動</h3>
          <p>Reveal、Stagger、Tilt／Spotlight、Zoom／Pan、磁吸按鈕、動態底線與 FAQ。實際播放與調整動效強度。</p>
          <b>進入互動特效庫 →</b>
        </a>
        <a class="demo-card library-entry-card" href={base+'layouts/'}>
          <p class="eyebrow">LAYOUTS · STRUCTURAL DESIGN LIBRARY</p>
          <h3>版型庫 · 網站怎麼說故事</h3>
          <p>12 種獨立的網站結構與內容閱讀動線：六款知識內容、六款助人專業。比較首頁區塊如何排列，而不只看顏色或導覽列。</p>
          <b>進入 12 種版型庫 →</b>
        </a>
      </div>
    </section>
    <section class="matrix-group blocks-entry" aria-labelledby="search-features-title">
      <div class="matrix-heading">
        <span>D</span>
        <div>
          <h2 id="search-features-title">全站搜尋與文章瀏覽 · 五種找內容的方法</h2>
          <p>搜尋不只有一個輸入框。依照訪客記得的是關鍵字、主題或日期，選擇最適合的入口。這五個元件可以各自使用，也能組合在同一個網站。</p>
        </div>
      </div>
      <div class="demo-grid">
        <a class="demo-card" href={base+'knowledge/paper/'}>
          <small>SITE SEARCH DIALOG</small>
          <h3>放大鏡 · 全站搜尋</h3>
          <p>點網站導覽列的放大鏡，直接跳出搜尋視窗，查找頁面、文章與服務；也能按 Ctrl+K／⌘K 開啟、Esc 關閉。</p>
          <b>到網站試用放大鏡 →</b>
        </a>
        <a class="demo-card" href={base+'knowledge/paper/articles/'}>
          <small>ARTICLE SEARCH</small>
          <h3>關鍵字 · 文章搜尋</h3>
          <p>輸入文章標題、摘要、分類或標籤中的關鍵字，立即篩選文章清單，找到後直接開啟內頁。</p>
          <b>試用文章搜尋 →</b>
        </a>
        <a class="demo-card" href={base+'knowledge/paper/articles/?tag='+encodeURIComponent('資訊架構')}>
          <small>TAG CLOUD</small>
          <h3>標籤雲 · 依主題探索</h3>
          <p>不確定關鍵字時，可以從標籤開始瀏覽；點一下就只顯示擁有相同標籤的文章。</p>
          <b>試試「資訊架構」標籤 →</b>
        </a>
        <a class="demo-card" href={base+'knowledge/paper/articles/?month=2026-10'}>
          <small>ARCHIVE MONTHS</small>
          <h3>月份列表 · 回顧舊文章</h3>
          <p>依年月整理發表紀錄，列出每個月份有幾篇文章；點選月份就能查看該段時間的內容。</p>
          <b>查看 2026 年 10 月文章 →</b>
        </a>
        <a class="demo-card" href={base+'knowledge/paper/articles/?date=2026-10-08'}>
          <small>POST CALENDAR</small>
          <h3>文章日曆 · 按日期查找</h3>
          <p>在日曆上標出有文章的日期；只有實際有發文的日期可點擊，按下後顯示當天的文章。</p>
          <b>查看 10 月 8 日文章 →</b>
        </a>
      </div>
      <p class="microcopy">目前使用六篇教材文章；放大鏡採用建置時產生的全文索引，可搜尋各類靜態頁面的實際內容。文章列表另提供標籤、月份與日期篩選。</p>
    </section>
    <footer class="index-footer">Research → Structure → Visual System → Prototype → Workshop</footer>
  </main>
</DemoLayout>

<style>
  .library-entry-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;align-items:stretch}
  .library-entry-card{min-width:0;max-width:none!important;display:flex!important;flex-direction:column;gap:12px;min-height:250px}
  .library-entry-card h3{margin:0}
  .library-entry-card p{margin:0}
  .library-entry-card b{display:block;margin-top:auto;padding-top:26px}
  @media(max-width:940px){.library-entry-grid{grid-template-columns:1fr}.library-entry-card{min-height:220px}}
</style>
