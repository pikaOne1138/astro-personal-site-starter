---
import DemoLayout from '../../layouts/DemoLayout.astro';
import ArticleSearch from '../../components/blocks/ArticleSearch.astro';
import TagCloud from '../../components/blocks/TagCloud.astro';
import ArchiveMonths from '../../components/blocks/ArchiveMonths.astro';
import PostCalendar from '../../components/blocks/PostCalendar.astro';
import { articlesV2, articleTags, articleMonths } from '../../data/articles-v2';
const base=import.meta.env.BASE_URL;
const root=base+'explore/';
const articleRoot=base+'knowledge/paper/articles/';
---
<DemoLayout title="文章探索 · 網站元件" description="實際運作的文章搜尋、標籤雲、月份索引與日期日曆">
  <link rel="stylesheet" href={base+'blocks.css'} />
  <link rel="stylesheet" href={base+'blocks-v2.css'} />
  <main class="ab-gallery v2-explorer">
    <header class="ab-gallery-header">
      <a class="ab-gallery-back" href={base+'blocks/'}>← 返回元件庫</a>
      <p class="ab-eyebrow" style="margin-top:32px">WEBSITE CONTENT · ARTICLE DISCOVERY</p>
      <h1>用搜尋、標籤與日期，重新找到文章。</h1>
      <p>這是可操作的文章探索示範：搜尋標題／摘要／分類／標籤，或點擊月份和日曆上有文章的日期。下方六篇文章均為工作坊示範資料，不是真實發布紀錄。</p>
      <a class="ab-chip" href={root}>清除條件，顯示全部</a>
    </header>
    <div class="v2-explorer-layout">
      <div class="v2-primary">
        <section aria-label="文章搜尋與結果">
          <ArticleSearch action={root}/>
          <div class="v2-results-heading"><h2>文章列表</h2><p data-result-counter role="status" aria-live="polite">載入文章中…</p></div>
          <p data-active-filter class="v2-active-filter" hidden></p>
          <div class="v2-results">
            {articlesV2.map(article=><article class="v2-result" data-article data-title={article.title} data-excerpt={article.excerpt} data-category={article.category} data-tags={article.tags.join('|')} data-date={article.publishedAt}>
              <p class="ab-eyebrow">{article.category} · <time datetime={article.publishedAt}>{article.publishedAt}</time></p>
              <h3><a href={articleRoot+article.slug+'/'}>{article.title}</a></h3>
              <p>{article.excerpt}</p>
              <div class="v2-result-tags">{article.tags.map(tag=><a href={root+'?tag='+encodeURIComponent(tag)}>{tag}</a>)}<span>{article.readingMinutes} 分鐘閱讀</span></div>
            </article>)}
          </div>
          <p data-empty hidden>目前沒有符合條件的文章。<a href={root}>查看全部文章 →</a></p>
        </section>
      </div>
      <aside class="v2-explorer-aside" aria-label="文章探索工具">
        <section><h2>標籤雲</h2><TagCloud tags={articleTags} baseHref={root}/></section>
        <section><h2>月份列表</h2><ArchiveMonths months={articleMonths} baseHref={root}/></section>
        <section><h2>文章日曆</h2><p class="v2-side-note">示範資料按實際設定的日期顯示；沒有文章的日期無法點擊。</p>
          {articleMonths.map(({month},i)=><details class="v2-calendar-disclosure" open={i===0}><summary>{month.replace('-', ' 年 ')} 月</summary><PostCalendar dates={articlesV2.filter(a=>a.publishedAt.startsWith(month)).map(a=>a.publishedAt)} month={month} baseHref={root}/></details>)}
        </section>
      </aside>
    </div>
  </main>
  <script>
    const url=new URL(window.location.href);
    const q=(url.searchParams.get('q')||'').trim().toLocaleLowerCase();
    const tag=url.searchParams.get('tag')||'';
    const month=url.searchParams.get('month')||'';
    const date=url.searchParams.get('date')||'';
    const input=document.querySelector<HTMLInputElement>('#v2-article-search');
    if(input)input.value=url.searchParams.get('q')||'';
    const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-article]'));
    let count=0;
    cards.forEach(el=>{
      const haystack=[el.dataset.title,el.dataset.excerpt,el.dataset.category,el.dataset.tags].join(' ').toLocaleLowerCase();
      const matches=(!q||haystack.includes(q))&&(!tag||(el.dataset.tags||'').split('|').includes(tag))&&(!month||(el.dataset.date||'').startsWith(month))&&(!date||el.dataset.date===date);
      el.hidden=!matches;
      if(matches)count++;
    });
    const counter=document.querySelector<HTMLElement>('[data-result-counter]');
    if(counter)counter.textContent='符合條件：'+count+' 篇';
    const current=document.querySelector<HTMLElement>('[data-active-filter]');
    const active=[q&&'搜尋：'+q,tag&&'標籤：'+tag,month&&'月份：'+month,date&&'日期：'+date].filter(Boolean);
    if(current&&active.length){current.hidden=false;current.textContent='目前條件｜'+active.join(' / ');}
    const empty=document.querySelector<HTMLElement>('[data-empty]');
    if(empty)empty.hidden=count!==0;
    document.querySelectorAll<HTMLAnchorElement>('.v2-tags a,.v2-archive a,.v2-calendar-day.has-post').forEach(a=>{
      const target=new URL(a.href);
      const selected=[['tag',tag],['month',month],['date',date]].some(([key,value])=>!!value&&target.searchParams.get(key)===value);
      if(selected)a.setAttribute('aria-current','true');
    });
  </script>
</DemoLayout>
